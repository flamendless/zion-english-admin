APP_ENV=local
PORT=8080
SECRET=""

SUPERUSER_USERNAME=""
SUPERUSER_PASSWORD=""

# Zoom OAuth — use Development credentials + redirect URL from Marketplace while testing locally.
# For production teachers on their own Zoom accounts: Production credentials, matching redirect URL,
# and Beta Test → Request to Share approved (or publish the app).
# Optional ZOOM_AUTHORIZE_URL: paste the Production beta authorization URL from Marketplace (without state).
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_REDIRECT_URI="http://localhost:8080/zion-english-admin/profile/zoom/callback"
# ZOOM_AUTHORIZE_URL=""
MEETING_SERVICE=zoom

GOOSE_DRIVER="sqlite3"
GOOSE_DBSTRING="./data/zion.db"
GOOSE_MIGRATION_DIR="./migrations/sqlite3"
