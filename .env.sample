APP_ENV=local
PORT=8080
SECRET=""

SUPERUSER_USERNAME=""
SUPERUSER_PASSWORD=""

# Zoom OAuth — copy the authorization URL from Zoom Marketplace (Local Test or Production → Beta Test).
# Use Development credentials + redirect URL while testing locally; Production for live teachers.
# Beta Test → Request to Share must be approved (or publish the app) so external Zoom accounts can connect.
# Zoom Marketplace public URLs (no auth):
#   Support URL:        http://localhost:8080/zion-english-admin/support
#   Documentation URL:  http://localhost:8080/zion-english-admin/docs/connect-zoom
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_REDIRECT_URI="http://localhost:8080/zion-english-admin/profile/zoom/callback"
ZOOM_AUTHORIZE_URL=""
MEETING_SERVICE=zoom

GOOSE_DRIVER="sqlite3"
GOOSE_DBSTRING="./data/zion.db"
GOOSE_MIGRATION_DIR="./migrations/sqlite3"
