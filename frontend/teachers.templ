package frontend

import (
	"fmt"
	"zion-english/internal/utils"
)

type TeacherData struct {
	Teachers       []TeacherItem
	Query          string
	Status         string
	Email          string
	PageNumber     int
	PageTotalPages int
	PageTotal      int64
	PrevURL        string
	NextURL        string
	HasPrev        bool
	HasNext        bool
	FilterPath     string
}

type TeacherItem struct {
	ID             string
	Name           string
	Birthdate      string
	Address        string
	JoiningDate    string
	MobileNumber   string
	Email          string
	Certifications string
	AssignedColor  string
	RatePerClass   float64
	Currency       string
	DriveUrl       string
	Sex            string
	Status         string
	CreatedAt      string
}

func getTeacherRowClass(status string) string {
	if status == "pending" {
		return "teacher-pending"
	}
	if status == "approved" {
		return "teacher-approved"
	}
	return ""
}

func getTeacherStatusClass(status string) string {
	if status == "approved" {
		return "status-active"
	}
	return "status-inactive"
}

templ CopyableTextCell(value string) {
	if value != "" {
		<div class="copyable-cell">
			<span class="copyable-text" title={ value }>{ value }</span>
			<button type="button" class="copy-btn" data-copy={ value } onclick="copyCellText(this)" title="Copy to clipboard" aria-label="Copy to clipboard">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
				</svg>
			</button>
		</div>
	} else {
		<span>-</span>
	}
}

templ Teachers(data TeacherData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Teachers - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		<script>
			function copyCellText(btn) {
				const text = btn.dataset.copy;
				if (!text) return;
				navigator.clipboard.writeText(text).then(function () {
					btn.classList.add('copied');
					setTimeout(function () { btn.classList.remove('copied'); }, 1500);
				});
			}
		</script>
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@HubHeader("Teachers", "New Teacher", utils.URL("/teachers/register"), true)

			@ListFilterForm(data.FilterPath, data.Query, data.Status, "", data.Email, "", "", "", false, true, false, false)

			if len(data.Teachers) > 0 {
				<div class="table-wrapper">
					<table id="teachersTable">
						<thead>
							<tr>
								<th>#</th>
								<th>Name</th>
								<th>Status</th>
								<th>Email</th>
								<th>Mobile Number</th>
								<th>Google Sheet URL</th>
								<th>Sex</th>
								<th>Address</th>
								<th>Certifications</th>
								<th>Birthdate</th>
								<th>Joining Date</th>
								<th>Rates Per Class</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for i, teacher := range data.Teachers {
								<tr class={ getTeacherRowClass(teacher.Status) }>
									<td class="num-cell">{ fmt.Sprintf("%d", i+1) }</td>
									<td>{ teacher.Name }</td>
									<td class={ getTeacherStatusClass(teacher.Status) }>{ teacher.Status }</td>
									<td class="email-cell">{ getDisplayValue(teacher.Email) }</td>
									<td>{ getDisplayValue(teacher.MobileNumber) }</td>
									<td>@displayURL(teacher.DriveUrl)</td>
									<td>{ getDisplayValue(teacher.Sex) }</td>
									<td>@CopyableTextCell(teacher.Address)</td>
									<td>@CopyableTextCell(teacher.Certifications)</td>
									<td class="date-cell">{ getDisplayValue(teacher.Birthdate) }</td>
									<td class="date-cell">{ teacher.JoiningDate }</td>
									<td class="rate-cell">{ formatRate(teacher.RatePerClass, teacher.Currency) }</td>
									<td>
										<a href={ utils.URL("/teachers/" + teacher.ID + "/edit") } class="edit-btn">Edit</a>
										if teacher.Status == "pending" {
											<button
												type="button"
												class="approve-btn"
												hx-post={ utils.URL("/teachers/approve") }
												hx-vals={ `{"id": "` + teacher.ID + `"}` }
												hx-swap="none"
											>Approve</button>
										}
										if teacher.Status == "approved" {
											<button
												type="button"
												class="unapprove-btn"
												hx-post={ utils.URL("/teachers/unapprove") }
												hx-vals={ `{"id": "` + teacher.ID + `"}` }
												hx-swap="none"
											>Un-approve</button>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				@PaginationBar(data.HasPrev, data.PrevURL, data.HasNext, data.NextURL, data.PageNumber, data.PageTotalPages, data.PageTotal)
			} else {
				<div class="empty-state">
					<p>No teachers found.</p>
				</div>
			}
		</div>
	</body>
	</html>
}
