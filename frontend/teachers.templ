package frontend

import (
	"zion-english/internal/utils"
)

type TeacherData struct {
	Teachers       []TeacherItem
	Query          string
	Status         string
	Email          string
	PageNumber     int
	PageTotalPages int
	PageTotal      int64
	PrevURL        string
	NextURL        string
	HasPrev        bool
	HasNext        bool
	FilterPath     string
}

type TeacherItem struct {
	ID             string
	Name           string
	Birthdate      string
	Address        string
	JoiningDate    string
	MobileNumber   string
	Email          string
	Certifications string
	AssignedColor  string
	RatePerClass   float64
	Currency       string
	DriveUrl       string
	Sex            string
	Status         string
	CreatedAt      string
}

func getTeacherRowClass(status string) string {
	if status == "pending" {
		return "teacher-pending"
	}
	if status == "approved" {
		return "teacher-approved"
	}
	return ""
}

func getTeacherStatusClass(status string) string {
	if status == "approved" {
		return "status-active"
	}
	return "status-inactive"
}

templ CopyableTextCell(value string) {
	if value != "" {
		<div class="copyable-cell">
			<span class="copyable-text" title={ value }>{ value }</span>
			<button type="button" class="copy-btn" data-copy={ value } onclick="copyCellText(this)" title="Copy to clipboard" aria-label="Copy to clipboard">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
				</svg>
			</button>
		</div>
	} else {
		<span>-</span>
	}
}

templ Teachers(data TeacherData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Teachers - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@AvatarStyles()
		<script>
			window.closeTeacherViewModal = function () {
				const host = document.getElementById('teacherViewModalHost');
				if (host) host.innerHTML = '';
				document.body.classList.remove('modal-open');
			};

			window.switchTeacherProfileTab = function (targetTab) {
				const root = document.getElementById('teacherViewModal');
				if (!root || !targetTab) return;
				root.querySelectorAll('[data-profile-tab]').forEach(function (t) {
					const active = t.getAttribute('data-profile-tab') === targetTab;
					t.classList.toggle('is-active', active);
					t.setAttribute('aria-selected', active ? 'true' : 'false');
				});
				root.querySelectorAll('[data-profile-panel]').forEach(function (panel) {
					const active = panel.getAttribute('data-profile-panel') === targetTab;
					panel.classList.toggle('is-active', active);
				});
			};

			document.body.addEventListener('htmx:afterSwap', function (evt) {
				if (evt.detail.target.id !== 'teacherViewModalHost') return;
				document.body.classList.add('modal-open');
				const overlay = evt.detail.target.querySelector('#teacherViewModal');
				const closeBtn = overlay && overlay.querySelector('.teacher-view-close');
				if (closeBtn) closeBtn.focus();
			});

			document.body.addEventListener('click', function (e) {
				if (e.target.closest('.teacher-view-close')) {
					window.closeTeacherViewModal();
					return;
				}
				const overlay = e.target.closest('#teacherViewModal');
				if (overlay && e.target === overlay) window.closeTeacherViewModal();
			});

			document.addEventListener('keydown', function (e) {
				if (e.key === 'Escape' && document.getElementById('teacherViewModal')) {
					window.closeTeacherViewModal();
				}
			});
		</script>
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@HubHeader("Teachers", "New Teacher", utils.URL("/teachers/register"), true)

			@ListFilterForm(data.FilterPath, data.Query, data.Status, "", data.Email, "", "", "", false, true, false, false, true)

			if len(data.Teachers) > 0 {
				<div class="table-wrapper">
					<table id="teachersTable" class="table-stack-mobile">
						<thead>
							<tr>
								<th>Name</th>
								<th>Status</th>
								<th>Email</th>
								<th>Mobile Number</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, teacher := range data.Teachers {
								<tr class={ getTeacherRowClass(teacher.Status) }>
									<td data-label="Name">
										<button
											type="button"
											class="name-link"
											hx-get={ utils.URL("/teachers/" + teacher.ID + "/view") }
											hx-target="#teacherViewModalHost"
											hx-swap="innerHTML"
										>{ teacher.Name }</button>
									</td>
									<td class={ getTeacherStatusClass(teacher.Status) } data-label="Status">{ teacher.Status }</td>
									<td class="email-cell" data-label="Email">{ getDisplayValue(teacher.Email) }</td>
									<td data-label="Mobile">{ getDisplayValue(teacher.MobileNumber) }</td>
									<td data-label="Actions">
										<div class="table-actions">
											<button
												type="button"
												class="view-btn"
												hx-get={ utils.URL("/teachers/" + teacher.ID + "/view") }
												hx-target="#teacherViewModalHost"
												hx-swap="innerHTML"
											>View</button>
											<a href={ utils.URL("/teachers/" + teacher.ID + "/edit") } class="edit-btn">Edit</a>
											if teacher.Status == "pending" {
												<button
													type="button"
													class="approve-btn"
													hx-post={ utils.URL("/teachers/approve") }
													hx-vals={ `{"id": "` + teacher.ID + `"}` }
													hx-swap="none"
												>Approve</button>
											}
											if teacher.Status == "approved" {
												<button
													type="button"
													class="unapprove-btn"
													hx-post={ utils.URL("/teachers/unapprove") }
													hx-vals={ `{"id": "` + teacher.ID + `"}` }
													hx-swap="none"
												>Un-approve</button>
											}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				@PaginationBar(data.HasPrev, data.PrevURL, data.HasNext, data.NextURL, data.PageNumber, data.PageTotalPages, data.PageTotal)
			} else {
				<div class="empty-state">
					<p>No teachers found.</p>
				</div>
			}
			<div id="teacherViewModalHost"></div>
		</div>
	</body>
	</html>
}
