package frontend

import "zion-english/internal/utils"

type TeacherData struct {
	Teachers []TeacherItem
}

type TeacherItem struct {
	ID             string
	Name           string
	Birthdate      string
	Address        string
	JoiningDate    string
	MobileNumber   string
	Email          string
	Certifications string
	AssignedColor  string
	RatePerClass   float64
	Currency       string
	DriveUrl       string
	Sex            string
	Status         string
	CreatedAt      string
}

func getTeacherRowClass(status string) string {
	if status == "pending" {
		return "teacher-pending"
	}
	return ""
}

func getTeacherStatusClass(status string) string {
	if status == "approved" {
		return "status-active"
	}
	return "status-inactive"
}

templ Teachers(data TeacherData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Teachers - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		<style>
			.teacher-pending {
				background-color: #fff5f5;
			}

			.approve-btn {
				background-color: var(--color-primary);
				color: #333;
				border: none;
				padding: 6px 12px;
				border-radius: 4px;
				cursor: pointer;
				font-size: 13px;
				font-weight: 500;
			}

			.approve-btn:hover {
				opacity: 0.9;
			}
		</style>
	</head>
	<body>
		<div class="container">
			@HeaderSimple()

			<div class="button-group">
				<a href={utils.URL("/teachers/register")} class="add-btn">Register New Teacher</a>
			</div>

			if len(data.Teachers) > 0 {
				<div class="table-wrapper">
					<table id="teachersTable">
						<thead>
							<tr>
								<th>Name</th>
								<th>Status</th>
								<th>Sex</th>
								<th>Birthdate</th>
								<th>Address</th>
								<th>Joining Date</th>
								<th>Mobile</th>
								<th>Email</th>
								<th>Rate Per Class</th>
								<th>Spreadsheet URL</th>
								<th>Certifications</th>
								<th>Assigned Color</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
							for _, teacher := range data.Teachers {
								<tr class={ getTeacherRowClass(teacher.Status) }>
									<td>{ teacher.Name }</td>
									<td class={ getTeacherStatusClass(teacher.Status) }>{ teacher.Status }</td>
									<td>{ getDisplayValue(teacher.Sex) }</td>
									<td class="date-cell">{ getDisplayValue(teacher.Birthdate) }</td>
									<td>{ getDisplayValue(teacher.Address) }</td>
									<td class="date-cell">{ teacher.JoiningDate }</td>
									<td>{ getDisplayValue(teacher.MobileNumber) }</td>
									<td class="email-cell">{ getDisplayValue(teacher.Email) }</td>
									<td class="rate-cell">{ formatRate(teacher.RatePerClass, teacher.Currency) }</td>
									<td>@displayURL(teacher.DriveUrl)</td>
									<td>{ getDisplayValue(teacher.Certifications) }</td>
									<td>
										<div class="color-cell">
											<div class="color-box" style={ "background-color: " + teacher.AssignedColor }></div>
											<span>{ teacher.AssignedColor }</span>
										</div>
									</td>
									<td>
										if teacher.Status == "pending" {
											<button
												type="button"
												class="approve-btn"
												hx-post={ utils.URL("/teachers/approve") }
												hx-vals={ `{"id": "` + teacher.ID + `"}` }
												hx-swap="none"
											>Approve</button>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<div class="empty-state">
					<p>No teachers registered yet.</p>
					<p>Click "Register New Teacher" to add one.</p>
				</div>
			}
		</div>
	</body>
	</html>
}
