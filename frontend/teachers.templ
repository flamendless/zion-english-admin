package frontend

import "zion-english/internal/utils"

type TeacherData struct {
	Teachers []TeacherItem
}

type TeacherItem struct {
	ID             string
	Name           string
	Birthdate      string
	Address        string
	JoiningDate    string
	MobileNumber   string
	Email          string
	Certifications string
	AssignedColor  string
	RatePerClass   float64
	Currency       string
	CreatedAt      string
}

templ Teachers(data TeacherData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Teachers - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" id="favicon">
		<style>
			.add-btn {
				background-color: var(--color-primary);
				color: white;
				padding: 10px 20px;
				border: none;
				border-radius: 4px;
				cursor: pointer;
				font-size: 14px;
				font-weight: 500;
				text-decoration: none;
				display: inline-block;
			}

			.add-btn:hover {
				opacity: 0.9;
			}

			table {
				width: 100%;
				border-collapse: collapse;
				margin-bottom: 20px;
			}

			.color-cell {
				display: flex;
				align-items: center;
				gap: 10px;
			}

			.color-box {
				width: 24px;
				height: 24px;
				border-radius: 4px;
				border: 1px solid #ddd;
			}

			.empty-state {
				text-align: center;
				padding: 40px;
				color: #666;
			}

			.currency-cell {
				white-space: nowrap;
				font-family: 'Courier New', monospace;
			}

			.rate-cell {
				white-space: nowrap;
				font-family: 'Courier New', monospace;
			}

			.email-cell {
				color: var(--color-primary);
			}

			.date-cell {
				white-space: nowrap;
			}
		</style>
	</head>
	<body>
		<div class="container">
			@HeaderSimple()

			<div class="button-group">
				<a href={utils.URL("/teachers/register")} class="add-btn">Register New Teacher</a>
			</div>

			if len(data.Teachers) > 0 {
				<table id="teachersTable">
					<thead>
						<tr>
							<th>Name</th>
							<th>Birthdate</th>
							<th>Address</th>
							<th>Joining Date</th>
							<th>Mobile</th>
							<th>Email</th>
							<th>Certifications</th>
							<th>Color</th>
							<th>Rate Per Class</th>
							<th>Created At</th>
						</tr>
					</thead>
					<tbody>
						for _, teacher := range data.Teachers {
							<tr>
								<td>{ teacher.Name }</td>
								<td class="date-cell">{ getDisplayValue(teacher.Birthdate) }</td>
								<td>{ getDisplayValue(teacher.Address) }</td>
								<td class="date-cell">{ teacher.JoiningDate }</td>
								<td>{ getDisplayValue(teacher.MobileNumber) }</td>
								<td class="email-cell">{ getDisplayValue(teacher.Email) }</td>
								<td>{ getDisplayValue(teacher.Certifications) }</td>
								<td>
									<div class="color-cell">
										<div class="color-box" style={ "background-color: " + teacher.AssignedColor }></div>
										<span>{ teacher.AssignedColor }</span>
									</div>
								</td>
								<td class="rate-cell">{ formatRate(teacher.RatePerClass, teacher.Currency) }</td>
								<td class="date-cell">{ teacher.CreatedAt }</td>
							</tr>
						}
					</tbody>
				</table>
			} else {
				<div class="empty-state">
					<p>No teachers registered yet.</p>
					<p>Click "Register New Teacher" to add one.</p>
				</div>
			}
		</div>

		<script>
			const favicon = document.getElementById('favicon');

			function getBaseURL() {
				const pathname = window.location.pathname;
				const cleanPath = pathname.replace(/\/$/, '');
				const parts = cleanPath.split('/').filter(p => p !== '');

				if (parts.length === 0 || cleanPath.endsWith('.html')) {
					if (cleanPath.includes('/zion-english-admin')) {
						return '/zion-english-admin';
					}
					return '';
				}

				if (parts.length === 1) {
					return '/' + parts[0];
				}

				return '/' + parts.slice(0, -1).join('/');
			}

			const baseURL = getBaseURL();

			function buildURL(path) {
				return baseURL + path;
			}

			if (favicon) {
				favicon.href = buildURL('/static/favicon.ico');
			}
		</script>
	</body>
	</html>
}
