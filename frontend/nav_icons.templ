package frontend

templ NavIconBadge(kind NavIconKind) {
	<span class={ navIconBadgeClass(kind) } aria-hidden="true">
		@NavIconSVG(kind)
	</span>
}

templ NavChoiceIcon(kind NavIconKind) {
	<span class={ navChoiceIconClass(kind) } aria-hidden="true">
		@NavIconSVG(kind)
	</span>
}

templ NavIconSVG(kind NavIconKind) {
	switch kind {
		case NavIconProfile:
			@navIconSVGUser()
		case NavIconGuides:
			@navIconSVGBookOpen()
		case NavIconLibrary:
			@navIconSVGLibrary()
		case NavIconDocuments:
			@navIconSVGFileText()
		case NavIconTeachers:
			@navIconSVGUsers()
		case NavIconStudents:
			@navIconSVGUsers()
		case NavIconMyStudents:
			@navIconSVGUserCheck()
		case NavIconClasses:
			@navIconSVGCalendarDays()
		case NavIconSchedule:
			@navIconSVGCalendar()
		case NavIconScheduleSeries:
			@navIconSVGRepeat()
		case NavIconRecordClass:
			@navIconSVGRecordClass()
		case NavIconReports:
			@navIconSVGChartColumn()
		case NavIconAnalytics:
			@navIconSVGLineChart()
		case NavIconProcess:
			@navIconSVGSettings()
		case NavIconFeatureFlags:
			@navIconSVGFlag()
		case NavIconLogs:
			@navIconSVGScrollText()
		case NavIconAnnouncements:
			@navIconSVGMegaphone()
		case NavIconChangelogs:
			@navIconSVGList()
		case NavIconPeopleGroup:
			@navIconSVGUsers()
		case NavIconResourcesGroup:
			@navIconSVGFolderOpen()
		case NavIconInsightsGroup:
			@navIconSVGChartColumn()
		case NavIconAdminGroup:
			@navIconSVGSettings()
		default:
			@navIconSVGDefault()
	}
}

templ navIconSVGUser() {
	<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
		<circle cx="12" cy="7" r="4"></circle>
	</svg>
}

