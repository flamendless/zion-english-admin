package frontend

templ ReportSummaryViewModal(data ReportSummaryViewData) {
	<div class="modal-overlay" id="reportViewModal" role="presentation">
		<div class="modal-dialog modal-dialog-report" role="dialog" aria-modal="true" aria-labelledby="reportSummaryViewTitle">
			<div class="modal-header">
				<div>
					<h3 id="reportSummaryViewTitle">{ data.Title }</h3>
					if data.CutoffLabel != "" {
						<p class="report-summary-view-cutoff">{ data.CutoffLabel }</p>
					}
				</div>
				<button type="button" class="modal-close report-view-close" data-tooltip="Close" aria-label="Close" onclick="window.closeReportViewModal()">&times;</button>
			</div>
			<div class="modal-body report-summary-view-body">
				@ReportViewStyles()
				@ReportSummaryViewStyles()
				if data.IsParents() {
					if len(data.Parents) == 0 {
						<p class="empty-state">No teachers found.</p>
					} else {
						for _, teacher := range data.Parents {
							<section class="report-summary-teacher-section">
								<div class="report-summary-teacher-heading">
									@TeacherNameCell(teacher.TeacherName, teacher.Avatar)
								</div>
								for _, student := range teacher.Students {
									<div class="report-summary-student-block">
										<h4 class="report-summary-student-name">{ student.StudentName }</h4>
										if len(student.Classes) > 0 {
											<div class="table-wrapper data-list-view-root">
												<table class="table-stack-mobile report-summary-classes-table">
													<thead>
														<tr>
															<th>Status</th>
															<th>Date</th>
															<th>Duration</th>
															<th>Parent rate</th>
															<th>Class rate</th>
														</tr>
													</thead>
													<tbody>
														for _, class := range student.Classes {
															<tr class={ summaryClassRowClass(class.Status) }>
																<td data-label="Status">
																	@StatusPill(capitalizeStatus(class.Status), ClassRecordStatusPillTone(class.Status), false)
																</td>
																<td data-label="Date">{ class.Date }</td>
																<td data-label="Duration">{ class.Duration }</td>
																<td data-label="Parent rate">{ class.ParentRate }</td>
																<td data-label="Class rate">{ class.ClassRate }</td>
															</tr>
														}
													</tbody>
												</table>
											</div>
										}
										if student.HasTotal {
											<p class="report-summary-student-total">
												<span>{ student.TotalLabel }</span>
												<strong>{ student.TotalDisplay }</strong>
											</p>
										}
									</div>
								}
							</section>
						}
					}
				}
				if data.IsPayroll() {
					if len(data.Payroll) == 0 {
						<p class="empty-state">No class data for the selected range.</p>
					} else {
						<div class="table-wrapper data-list-view-root">
							<table class="table-stack-mobile report-summary-payroll-table">
								<thead>
									<tr>
										<th>Teacher</th>
										<th>Cutoff</th>
										<th>Total classes</th>
										<th>Total earnings</th>
									</tr>
								</thead>
								<tbody>
									for _, row := range data.Payroll {
										<tr>
											<td data-label="Teacher">
												@TeacherNameCell(row.TeacherName, row.TeacherAvatar)
											</td>
											<td data-label="Cutoff">{ row.CutoffLabel }</td>
											<td data-label="Total classes">{ row.ClassesLabel() }</td>
											<td data-label="Total earnings">
												@templ.Raw(row.EarningsHTML())
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				}
			</div>
		</div>
	</div>
}

templ ReportSummaryViewStyles() {
	<style>
		.report-summary-view-cutoff {
			margin: var(--space-1) 0 0;
			color: var(--color-muted-foreground);
			font-size: 0.875rem;
			font-weight: 400;
		}

		.report-summary-view-body {
			display: flex;
			flex-direction: column;
			gap: var(--space-5);
			max-height: min(70vh, 640px);
			overflow-y: auto;
		}

		.report-summary-teacher-section {
			display: flex;
			flex-direction: column;
			gap: var(--space-4);
			padding-bottom: var(--space-4);
			border-bottom: 1px solid var(--color-border-subtle);
		}

		.report-summary-teacher-section:last-child {
			border-bottom: none;
			padding-bottom: 0;
		}

		.report-summary-teacher-heading .teacher-name-cell {
			font-size: 1rem;
			font-weight: 600;
		}

		.report-summary-student-block {
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		.report-summary-student-name {
			margin: 0;
			font-size: 0.9375rem;
			font-weight: 600;
		}

		.report-summary-student-total {
			margin: 0;
			font-size: 0.875rem;
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
			align-items: baseline;
		}

		.report-summary-student-total strong {
			font-weight: 600;
		}

		.report-summary-classes-table tr.summary-class-row--conducted {
			background: var(--color-success-bg);
		}

		.report-summary-classes-table tr.summary-class-row--cancelled {
			background: var(--color-error-bg);
		}

		.report-summary-classes-table tr.summary-class-row--rescheduled {
			background: var(--color-warning-bg);
		}

		.report-summary-payroll-table .teacher-name-cell {
			min-width: 0;
		}
	</style>
}
