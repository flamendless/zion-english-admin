package frontend

import "zion-english/internal/auth"
import "zion-english/internal/utils"

templ WelcomeRole() {
	<h3
		hx-get={ utils.URL("/role") }
		hx-trigger="load once"
		hx-swap="textContent"
	>
		Welcome!
	</h3>
}

templ Header(loggedIn bool, role auth.Role) {
	<div class="header-section">
		<div class="header-top">
			<h1>
				<a href={ utils.URL("/dashboard") }>
					<img src={ utils.URL("/static/logo.png") } alt="Zion English" class="header-logo"/>
				</a>
			</h1>
			@DigitalClock("compact")
		</div>
		@AnnouncementBanners()
		if loggedIn {
			@WelcomeRole()
		}
		<div class="header-bottom">
			<div class="header-left">
				if loggedIn {
					<div class="header-account-tools">
						@HeaderAvatarPlaceholder()
						@NotificationBell()
					</div>
				}
				<div class="nav-links">
					for _, item := range NavItems(role) {
						@NavLink(item.Path, item.LinkID, item.Title)
					}
				</div>
			</div>
			<div class="header-right">
				if loggedIn {
					@Logout()
				} else {
					@LoginButton()
				}
			</div>
		</div>
	</div>
}

templ HeaderSimple() {
	{{
		role := auth.GetRole(ctx)
		loggedIn := role != ""
	}}
	@Header(loggedIn, role)
}

templ SuccessBanner() {
	<div id="successBanner" class="success-banner"></div>
}

templ SuccessBannerScript(message string) {
	<script>
		(function() {
			const msg = {{ message }};
			if (typeof showSuccessBanner === 'function') {
				showSuccessBanner(msg);
			} else {
				const banner = document.getElementById('successBanner');
				if (banner) {
					banner.textContent = msg;
					banner.classList.add('show');
					setTimeout(() => {
						banner.classList.remove('show');
					}, 3000);
				}
			}
		})();
	</script>
}

templ SuccessBannerHandlers() {
	<script>
		function showSuccessBanner(message) {
			const banner = document.getElementById('successBanner');
			if (banner) {
				banner.textContent = message;
				banner.classList.add('show');
				setTimeout(() => {
					banner.classList.remove('show');
				}, 3000);
			}
		}

		(function() {
			function readSuccessFlash() {
				const banner = document.getElementById('successBanner');
				const cookiePath = document.getElementById('errorBanner')?.dataset.basePath || '/';
				const match = document.cookie.match(/success_flash=([^;]+)/);
				if (match && banner) {
					showSuccessBanner(decodeURIComponent(match[1].replace(/\+/g, ' ')));
					document.cookie = 'success_flash=; Max-Age=0; path=' + encodeURIComponent(cookiePath);
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', readSuccessFlash);
			} else {
				readSuccessFlash();
			}
		})();

		document.addEventListener('htmx:afterRequest', function(evt) {
			if (evt.detail.successful) {
				const xhr = evt.detail.xhr;
				const responseText = xhr.responseText;
				if (responseText.includes('successfully')) {
					showSuccessBanner('Operation completed successfully!');
				}
			}
		});
	</script>
}

templ CsrfHandlers() {
	<script>
		function getCSRFToken() {
			const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]+)/);
			return match ? decodeURIComponent(match[1]) : '';
		}

		window.getCSRFHeaders = function () {
			const token = getCSRFToken();
			return token ? { 'X-CSRF-Token': token } : {};
		};

		function attachCSRFToken(input) {
			if (!input) return;
			const token = getCSRFToken();
			if (token) {
				input.value = token;
			}
		}

		function ensureFormCSRFToken(form) {
			if (!form || form.querySelector('input[name="csrf_token"]')) {
				return;
			}
			const input = document.createElement('input');
			input.type = 'hidden';
			input.name = 'csrf_token';
			attachCSRFToken(input);
			form.appendChild(input);
		}

		function wireCSRFForms(root) {
			const scope = root || document;
			scope.querySelectorAll('form').forEach(ensureFormCSRFToken);
		}

		document.addEventListener('htmx:configRequest', function (evt) {
			const token = getCSRFToken();
			if (token) {
				evt.detail.headers['X-CSRF-Token'] = token;
			}
		});

		document.addEventListener('htmx:configRequest', function (evt) {
			const elt = evt.detail.elt;
			if (elt && elt.tagName === 'FORM') {
				ensureFormCSRFToken(elt);
				attachCSRFToken(elt.querySelector('input[name="csrf_token"]'));
			}
		});

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', function () {
				wireCSRFForms();
			});
		} else {
			wireCSRFForms();
		}

		document.addEventListener('htmx:afterSwap', function (evt) {
			wireCSRFForms(evt.detail.target);
		});
	</script>
}

templ ErrorBanner() {
	<div id="errorBanner" class="error-banner" data-base-path={ utils.BasePath() }></div>
}

templ ErrorBannerScript(message string) {
	<script>
		(function() {
			const banner = document.getElementById('errorBanner');
			if (banner) {
				banner.textContent = $message$;
				banner.classList.add('show');
				setTimeout(() => {
					banner.classList.remove('show');
				}, 5000);
			}
		})();
	</script>
}

templ ErrorBannerHandlers() {
	<script>
		function showErrorBanner(message) {
			const banner = document.getElementById('errorBanner');
			if (banner) {
				banner.textContent = message;
				banner.classList.add('show');
				setTimeout(() => {
					banner.classList.remove('show');
				}, 5000);
			}
		}

		(function() {
			function readErrorFlash() {
				const banner = document.getElementById('errorBanner');
				if (!banner) {
					return;
				}
				const cookiePath = banner.dataset.basePath || '/';
				const match = document.cookie.match(/error_flash=([^;]+)/);
				if (match) {
					showErrorBanner(decodeURIComponent(match[1].replace(/\+/g, ' ')));
					document.cookie = 'error_flash=; Max-Age=0; path=' + encodeURIComponent(cookiePath);
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', readErrorFlash);
			} else {
				readErrorFlash();
			}
		})();

		document.addEventListener('htmx:responseError', function(evt) {
			const xhr = evt.detail.xhr;
			const message = (xhr.responseText || 'An error occurred').trim();
			showErrorBanner(message);
			const target = evt.detail.target;
			if (target && target.id === 'logOutput') {
				target.textContent = message;
			}
		});

		document.addEventListener('htmx:sendError', function(evt) {
			showErrorBanner('Network error. Please check your connection.');
		});
	</script>
}
