package frontend

import "zion-english/internal/utils"

templ WelcomeRole() {
	<h3
		hx-get={ utils.URL("/role") }
		hx-trigger="load once"
		hx-swap="textContent"
	>
		Welcome!
	</h3>
}

templ Header() {
	@GlobalIncludes()
	<div class="header-section">
		<h1>
			<a href={ utils.URL("/") }>
				<img src={ utils.URL("/static/logo.png") } alt="Zion English" class="header-logo"/>
			</a>
		</h1>
		@WelcomeRole()
		<div class="header-bottom">
			<div class="header-left">
				<div class="nav-links">
					<!-- INFO: (flam) this will be outdated after we centralized class records via admin tool -->
					<!-- @NavLink("/process", "process", "Process") -->
					<!-- @NavLink("/logs", "logsLink", "Process Logs") -->
					@NavLink("/students", "studentsLink", "Students")
					@NavLink("/students/register", "registerStudentLink", "+Student")
					@NavLink("/teachers", "teachersLink", "Teachers")
					@NavLink("/teachers/register", "registerTeacherLink", "+Teacher")
					@NavLink("/classes", "classesLink", "Classes")
					@NavLink("/classes/record", "recordClassLink", "+Class")
				</div>
			</div>
			<div class="header-right">
				@Logout()
				@Flam()
			</div>
		</div>
	</div>
}

templ HeaderSimple() {
	@Header()
}

templ SuccessBanner() {
	<div id="successBanner" class="success-banner"></div>
}

templ SuccessBannerScript(message string) {
	<script>
		(function() {
			const banner = document.getElementById('successBanner');
			if (banner) {
				banner.textContent = $message$;
				banner.classList.add('show');
				setTimeout(() => {
					banner.classList.remove('show');
				}, 3000);
			}
		})();
	</script>
}

templ ErrorBanner() {
	<div id="errorBanner" class="error-banner"></div>
}

templ ErrorBannerScript(message string) {
	<script>
		(function() {
			const banner = document.getElementById('errorBanner');
			if (banner) {
				banner.textContent = $message$;
				banner.classList.add('show');
				setTimeout(() => {
					banner.classList.remove('show');
				}, 5000);
			}
		})();
	</script>
}

templ SuccessBannerHandlers() {
	<script>
		function showSuccessBanner(message) {
			const banner = document.getElementById('successBanner');
			if (banner) {
				banner.textContent = message;
				banner.classList.add('show');
				setTimeout(() => {
					banner.classList.remove('show');
				}, 3000);
			}
		}

		document.addEventListener('htmx:afterRequest', function(evt) {
			if (evt.detail.successful) {
				const xhr = evt.detail.xhr;
				const responseText = xhr.responseText;
				if (responseText.includes('successfully')) {
					showSuccessBanner('Operation completed successfully!');
				}
			}
		});
	</script>
}

templ ErrorBannerHandlers() {
	<script>
		function showErrorBanner(message) {
			const banner = document.getElementById('errorBanner');
			if (banner) {
				banner.textContent = message;
				banner.classList.add('show');
				setTimeout(() => {
					banner.classList.remove('show');
				}, 5000);
			}
		}

		(function() {
			const match = document.cookie.match(/error_flash=([^;]+)/);
			if (match) {
				showErrorBanner(decodeURIComponent(match[1].replace(/\+/g, ' ')));
				document.cookie = 'error_flash=; Max-Age=0; path=/';
			}
		})();

		document.addEventListener('htmx:responseError', function(evt) {
			const xhr = evt.detail.xhr;
			const message = xhr.responseText || 'An error occurred';
			showErrorBanner(message);
		});

		document.addEventListener('htmx:sendError', function(evt) {
			showErrorBanner('Network error. Please check your connection.');
		});
	</script>
}
