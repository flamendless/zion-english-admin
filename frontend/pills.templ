package frontend

import "strconv"
templ Pill(label string, tone PillTone) {
	<span class={ pillClass(tone) }>{ label }</span>
}

templ RatePill(rate float64, currency string) {
	<span class={ pillClass(PillToneInfo) + " rate-pill" } aria-label={ ratePillAriaLabel(rate, currency) }>
		<span class="rate-pill-amount">{ formatRateAmount(rate, currency) }</span>
		<span class="rate-pill-currency">{ currency }</span>
	</span>
}

templ TimeRangePill(timeRange string) {
	<span class="time-range-pill" aria-label={ "Time: " + timeRange }>
		@Pill(timeRange, PillTonePrimary)
	</span>
}

templ StatusPill(label string, tone PillTone, withDot bool) {
	<span class={ statusPillClass(tone) }>
		if withDot {
			<span class="status-pill-dot" aria-hidden="true"></span>
		}
		{ label }
	</span>
}

templ CountBadge(count int64, tone BadgeTone, ariaLabel string) {
	if count > 0 {
		<span class={ badgeCountClass(tone) } aria-label={ ariaLabel }>{ badgeCountLabel(count) }</span>
	}
}

func badgeCountLabel(count int64) string {
	if count > 99 {
		return "99+"
	}
	return strconv.FormatInt(count, 10)
}
