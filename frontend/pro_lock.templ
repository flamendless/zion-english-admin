package frontend

import "fmt"

const ProLockTitle = "Teacher Pro"
const ProLockAnalyticsDetail = "This breakdown is available on Teacher Pro. Contact your administrator to upgrade your plan."
const ProLockAnalyticsRangeDetail = "Date ranges outside the current calendar month require Teacher Pro. Use the current month or upgrade your plan."

templ ProFeatureLockStyles() {
	<style>
		.pro-feature-lock {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: var(--space-2);
			padding: var(--space-6) var(--space-4);
			text-align: center;
		}
		.pro-feature-lock__icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2.75rem;
			height: 2.75rem;
			border-radius: var(--radius-full);
			background: var(--color-primary-light);
			color: var(--color-primary);
		}
		.pro-feature-lock__icon svg {
			display: block;
			width: 1.25rem;
			height: 1.25rem;
		}
		.pro-feature-lock__title {
			margin: 0;
			font-size: 0.9375rem;
			font-weight: 600;
			color: var(--color-foreground);
		}
		.pro-feature-lock__detail {
			margin: 0;
			max-width: 22rem;
			font-size: 0.8125rem;
			line-height: 1.45;
			color: var(--color-muted-foreground);
		}
		.pro-locked-table-row td {
			background: var(--color-background);
		}
		.analytics-chart-wrap.is-pro-locked {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 200px;
		}
		.analytics-chart-wrap.is-pro-locked canvas {
			display: none;
		}
	</style>
}

templ ProFeatureLockIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
		<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
	</svg>
}

templ ProFeatureLock(title string, detail string) {
	<div class="pro-feature-lock" role="status">
		<span class="pro-feature-lock__icon">
			@ProFeatureLockIcon()
		</span>
		<p class="pro-feature-lock__title">{ title }</p>
		<p class="pro-feature-lock__detail">{ detail }</p>
	</div>
}

templ ProLockedTableRow(colspan int, title string, detail string) {
	<tr class="pro-locked-table-row">
		<td colspan={ fmt.Sprintf("%d", colspan) }>
			@ProFeatureLock(title, detail)
		</td>
	</tr>
}
