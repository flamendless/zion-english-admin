package frontend

import "zion-english/internal/utils"

templ RegisterTeacher() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Register Teacher - Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		<style>
			.password-group {
				display: flex;
				gap: 10px;
				align-items: center;
			}
			.password-group input {
				flex: 1;
			}
			.suggest-btn {
				margin-top: 0;
				padding: 8px 12px;
				font-size: 12px;
				white-space: nowrap;
			}
			.password-strength {
				height: 4px;
				margin-top: 5px;
				background: #ddd;
				border-radius: 2px;
				overflow: hidden;
			}
			.password-strength-bar {
				height: 100%;
				transition: width 0.3s, background-color 0.3s;
			}
			.password-strength-bar.weak { width: 25%; background: #e74c3c; }
			.password-strength-bar.fair { width: 50%; background: #f39c12; }
			.password-strength-bar.good { width: 75%; background: #3498db; }
			.password-strength-bar.strong { width: 100%; background: #27ae60; }
			.password-requirements {
				font-size: 11px;
				color: #666;
				margin-top: 5px;
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
			}
			.password-requirements span {
				transition: color 0.2s;
			}
			.password-requirements span.met {
				color: #27ae60;
			}
		</style>
		@GlobalIncludes()

	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@SuccessBanner()
			@ErrorBanner()

			<form id="registerForm">
				<div class="form-row">
					<div class="form-group">
						<label for="name">Teacher Name *</label>
						<input type="text" id="name" name="name" required
						       placeholder="Enter teacher name">
						<div class="error-message" id="nameError">Name is required</div>
					</div>
					<div class="form-group">
						<label for="sex">Sex</label>
						<select id="sex" name="sex">
							<option value="">-- Select Sex --</option>
							<option value="M">M</option>
							<option value="F">F</option>
						</select>
					</div>
				</div>

				<div class="form-group">
					<label for="driveUrl">Spreadsheet URL *</label>
					<input type="text" id="driveUrl" name="driveUrl" required
					       placeholder="https://docs.google.com/spreadsheets/...">
					<div class="error-message" id="driveUrlError">Spreadsheet URL is required</div>
				</div>

				<div class="form-row">
					<div class="form-group">
						<label for="birthdate">Birthdate</label>
						<input type="date" id="birthdate" name="birthdate" required>
					</div>
					<div class="form-group">
						<label for="joiningDate">Joining Date *</label>
						<input type="date" id="joiningDate" name="joiningDate" required>
					</div>
				</div> required

				<div class="form-group">
					<label for="address">Address</label>
					<input type="text" id="address" name="address"
					       placeholder="Enter address" required>
				</div>

				<div class="form-row">
					<div class="form-group">
						<label for="mobileNumber">Mobile Number</label>
						<input type="text" id="mobileNumber" name="mobileNumber"
					       placeholder="Enter mobile number" required>
					</div>
					<div class="form-group">
						<label for="email">Email</label>
						<input type="email" id="email" name="email"
					       placeholder="Enter email" required>
					</div>
				</div>

				<div class="form-group">
					<label for="certifications">Certifications (comma-separated)</label>
					<input type="text" id="certifications" name="certifications"
					       placeholder="e.g., TESOL, CELTA, Bachelor in Education">
				</div>

				<div class="form-group">
					<label for="password">Password *</label>
					<div class="password-group">
						<input type="password" id="password" name="password" required
						       minlength="8" maxlength="32" placeholder="8-32 characters">
						<button type="button" id="suggestPasswordBtn" class="suggest-btn">Suggest Strong Password</button>
					</div>
					<div class="password-strength" id="passwordStrength"></div>
					<div class="password-requirements" id="passwordRequirements">
						<span id="reqLength">- 8-32 characters</span>
						<span id="reqUpper">- Uppercase</span>
						<span id="reqLower">- Lowercase</span>
						<span id="reqNumber">- Number</span>
						<span id="reqSymbol">- Symbol (!@#$%^&*)</span>
					</div>
					<div class="error-message" id="passwordError">Password does not meet requirements</div>
				</div>

				<div class="form-group">
					<label for="retypePassword">Retype Password *</label>
					<input type="password" id="retypePassword" name="retypePassword" required
					       minlength="8" maxlength="32" placeholder="Re-enter password">
					<div class="error-message" id="retypePasswordError">Passwords do not match</div>
				</div>

				<div class="form-row-3">
					@CurrencyDropdown()
					<div class="form-group">
						<label for="ratePerClass">Rate Per Class *</label>
						<input type="number" id="ratePerClass" name="ratePerClass" required
					       step="0.01" min="0" placeholder="0.00">
					</div>
					<div class="form-group">
						<label for="assignedColor">Assigned Color *</label>
						<div class="color-group">
							<input type="color" id="assignedColor" name="assignedColor" required
							       value="var(--color-primary)">
							<div class="color-preview" id="colorPreview" style="background-color: var(--color-primary);"></div>
							<span id="colorValue">var(--color-primary)</span>
						</div>
					</div>
				</div>

				<button type="submit" id="submitBtn">Register Teacher</button>
			</form>

			<div class="logs-section">
				<h3>Logs and Errors</h3>
				<div id="logOutput">Waiting for submission...</div>
			</div>
		</div>

		<script>
			const form = document.getElementById('registerForm');
			const logOutput = document.getElementById('logOutput');
			const submitBtn = document.getElementById('submitBtn');
			const nameInput = document.getElementById('name');
			const birthdateElementById = document.getElementById('birthdate');
			const joiningDateInput = document.getElementById('joiningDate');
			const addressInput = document.getElementById('address');
			const mobileNumberInput = document.getElementById('mobileNumber');
			const emailInput = document.getElementById('email');
			const certificationsInput = document.getElementById('certifications');
			const currencySelect = document.getElementById('currency');
			const ratePerClassInput = document.getElementById('ratePerClass');
			const assignedColorInput = document.getElementById('assignedColor');
			const colorPreview = document.getElementById('colorPreview');
			const colorValue = document.getElementById('colorValue');
			const driveUrlInput = document.getElementById('driveUrl');
			const sexSelect = document.getElementById('sex');
			const passwordInput = document.getElementById('password');
			const retypePasswordInput = document.getElementById('retypePassword');
			const suggestPasswordBtn = document.getElementById('suggestPasswordBtn');
			const passwordStrength = document.getElementById('passwordStrength');
			const passwordError = document.getElementById('passwordError');
			const retypePasswordError = document.getElementById('retypePasswordError');
			const reqLength = document.getElementById('reqLength');
			const reqUpper = document.getElementById('reqUpper');
			const reqLower = document.getElementById('reqLower');
			const reqNumber = document.getElementById('reqNumber');
			const reqSymbol = document.getElementById('reqSymbol');

			const PASSWORD_REGEX = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*])[A-Za-z\d!@#$%^&*]{8,32}$/;

			function getBaseURL() {
				const pathname = window.location.pathname;
				const cleanPath = pathname.replace(/\/$/, '');
				const parts = cleanPath.split('/').filter(p => p !== '');

				if (parts.length === 0 || cleanPath.endsWith('.html')) {
					if (cleanPath.includes('/zion-english-admin')) {
						return '/zion-english-admin';
					}
					return '';
				}

				if (parts.length === 1) {
					return '/' + parts[0];
				}

				return '/' + parts.slice(0, -1).join('/');
			}

			const baseURL = getBaseURL();

			function buildURL(path) {
				return baseURL + path;
			}

			assignedColorInput.addEventListener('input', () => {
				const color = assignedColorInput.value;
				colorPreview.style.backgroundColor = color;
				colorValue.textContent = color;
			});

			function generateStrongPassword() {
				const uppercase = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
				const lowercase = 'abcdefghijklmnopqrstuvwxyz';
				const numbers = '0123456789';
				const symbols = '!@#$%^&*';
				const allChars = uppercase + lowercase + numbers + symbols;

				let password = '';
				password += uppercase[Math.floor(Math.random() * uppercase.length)];
				password += lowercase[Math.floor(Math.random() * lowercase.length)];
				password += numbers[Math.floor(Math.random() * numbers.length)];
				password += symbols[Math.floor(Math.random() * symbols.length)];

				for (let i = 4; i < 16; i++) {
					password += allChars[Math.floor(Math.random() * allChars.length)];
				}

				return password.split('').sort(() => Math.random() - 0.5).join('');
			}

			function checkPasswordStrength(password) {
				const hasUpper = /[A-Z]/.test(password);
				const hasLower = /[a-z]/.test(password);
				const hasNumber = /\d/.test(password);
				const hasSymbol = /[!@#$%^&*]/.test(password);
				const isValidLength = password.length >= 8 && password.length <= 32;

				reqLength.classList.toggle('met', isValidLength);
				reqUpper.classList.toggle('met', hasUpper);
				reqLower.classList.toggle('met', hasLower);
				reqNumber.classList.toggle('met', hasNumber);
				reqSymbol.classList.toggle('met', hasSymbol);

				const metCount = [isValidLength, hasUpper, hasLower, hasNumber, hasSymbol].filter(Boolean).length;

				passwordStrength.innerHTML = '<div class="password-strength-bar ' +
					(metCount <= 2 ? 'weak' : metCount <= 3 ? 'fair' : metCount <= 4 ? 'good' : 'strong') +
					'"></div>';

				return isValidLength && hasUpper && hasLower && hasNumber && hasSymbol;
			}

			passwordInput.addEventListener('input', () => {
				const password = passwordInput.value;
				if (password.length === 0) {
					passwordStrength.innerHTML = '';
					passwordError.style.display = 'none';
				} else {
					const isValid = checkPasswordStrength(password);
					passwordError.style.display = isValid ? 'none' : 'block';
				}
			});

			retypePasswordInput.addEventListener('input', () => {
				if (retypePasswordInput.value.length === 0) {
					retypePasswordError.style.display = 'none';
				} else {
					retypePasswordError.style.display =
						passwordInput.value === retypePasswordInput.value ? 'none' : 'block';
				}
			});

			suggestPasswordBtn.addEventListener('click', () => {
				const password = generateStrongPassword();
				passwordInput.value = password;
				retypePasswordInput.value = password;
				checkPasswordStrength(password);
				retypePasswordError.style.display = 'none';
				passwordError.style.display = 'none';
			});

			function validateForm() {
				let isValid = true;

				const nameError = document.getElementById('nameError');
				if (!nameInput.value.trim()) {
					nameError.style.display = 'block';
					nameInput.setCustomValidity('Name is required');
					isValid = false;
				} else {
					nameError.style.display = 'none';
					nameInput.setCustomValidity('');
				}

				if (!joiningDateInput.value) {
					joiningDateInput.setCustomValidity('Joining date is required');
					isValid = false;
				} else {
					joiningDateInput.setCustomValidity('');
				}

				if (!currencySelect.value) {
					currencySelect.setCustomValidity('Please select a currency');
					isValid = false;
				} else {
					currencySelect.setCustomValidity('');
				}

				if (!ratePerClassInput.value || parseFloat(ratePerClassInput.value) < 0) {
					ratePerClassInput.setCustomValidity('Please enter a valid rate');
					isValid = false;
				} else {
					ratePerClassInput.setCustomValidity('');
				}

			if (!assignedColorInput.value) {
				assignedColorInput.setCustomValidity('Please select a color');
				isValid = false;
			} else {
				assignedColorInput.setCustomValidity('');
			}

			if (!driveUrlInput.value.trim()) {
				driveUrlInput.setCustomValidity('Spreadsheet URL is required');
				isValid = false;
			} else {
				driveUrlInput.setCustomValidity('');
			}

			const validSex = ['M', 'F'];
			if (sexSelect.value && !validSex.includes(sexSelect.value)) {
				sexSelect.setCustomValidity('Invalid sex');
				isValid = false;
			} else {
				sexSelect.setCustomValidity('');
			}

			if (!PASSWORD_REGEX.test(passwordInput.value)) {
				passwordError.style.display = 'block';
				passwordInput.setCustomValidity('Password does not meet requirements');
				isValid = false;
			} else {
				passwordError.style.display = 'none';
				passwordInput.setCustomValidity('');
			}

			if (passwordInput.value !== retypePasswordInput.value) {
				retypePasswordError.style.display = 'block';
				retypePasswordInput.setCustomValidity('Passwords do not match');
				isValid = false;
			} else {
				retypePasswordError.style.display = 'none';
				retypePasswordInput.setCustomValidity('');
			}

				return isValid;
			}

			nameInput.addEventListener('blur', validateForm);
			joiningDateInput.addEventListener('change', validateForm);
			currencySelect.addEventListener('change', validateForm);
			ratePerClassInput.addEventListener('blur', validateForm);
			assignedColorInput.addEventListener('change', validateForm);
			passwordInput.addEventListener('blur', validateForm);
			retypePasswordInput.addEventListener('blur', validateForm);

			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				if (!validateForm()) {
					return;
				}

				submitBtn.disabled = true;
				logOutput.textContent = 'Registering teacher...';

				const formData = {
					name: nameInput.value.trim(),
					birthdate: birthdateInput.value,
					address: addressInput.value.trim(),
					joiningDate: joiningDateInput.value,
					mobileNumber: mobileNumberInput.value.trim(),
					email: emailInput.value.trim(),
					certifications: certificationsInput.value.trim(),
					currency: currencySelect.value,
					ratePerClass: parseFloat(ratePerClassInput.value) || 0,
					assignedColor: assignedColorInput.value,
					driveUrl: driveUrlInput.value.trim(),
					sex: sexSelect.value,
					password: passwordInput.value,
					retypePassword: retypePasswordInput.value
				};

				try {
					const response = await fetch(buildURL('/register'), {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json'
						},
						body: JSON.stringify(formData)
					});

					const data = await response.json();

					logOutput.textContent = data.logs.join('\n') + '\n';

					if (data.success) {
						const banner = document.getElementById('successBanner');
						banner.textContent = '✓ Teacher registered successfully!';
						banner.classList.add('show');
						setTimeout(() => {
							banner.classList.remove('show');
						}, 3000);
						form.reset();
						assignedColorInput.value = 'var(--color-primary)';
						colorPreview.style.backgroundColor = 'var(--color-primary)';
						colorValue.textContent = 'var(--color-primary)';
						passwordStrength.innerHTML = '';
						reqLength.classList.remove('met');
						reqUpper.classList.remove('met');
						reqLower.classList.remove('met');
						reqNumber.classList.remove('met');
						reqSymbol.classList.remove('met');
					} else {
						logOutput.textContent += '\n✗ Error: ' + data.message;
					}
				} catch (error) {
					logOutput.textContent += '\n✗ Network error: ' + error.message;
				} finally {
					submitBtn.disabled = false;
				}
			});
		</script>
	</body>
	</html>
}
