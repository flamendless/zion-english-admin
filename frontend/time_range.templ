package frontend

import "zion-english/internal/utils"

templ TimeInput(id string, label string, value string, readonly bool) {
	<div class="form-group time-input-wrap">
		<label for={ id }>{ label }</label>
		if readonly && value != "" {
			<input type="time" id={ id } name={ id } step="300" required value={ value } readonly/>
		} else if value != "" {
			<input type="time" id={ id } name={ id } step="300" required value={ value }/>
		} else {
			<input type="time" id={ id } name={ id } step="300" required/>
		}
	</div>
}

templ DurationPreview(id string) {
	<div class="duration-bridge" id={ id } aria-live="polite" aria-label="Duration">
		<span class="duration-bridge-label">Duration:</span>
		<span class="pill pill--neutral duration-pill duration-pill--pending">
			<svg class="duration-pill-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="10"></circle>
				<polyline points="12 6 12 12 16 14"></polyline>
			</svg>
			<span class="duration-pill-value">-</span>
		</span>
	</div>
}

templ TimeRangeFields(startTime string, endTime string, readonly bool) {
	<div class="time-range-fields">
		<div class="time-range-group">
			@TimeInput("start_time", "Start time *", startTime, readonly)
			@TimeInput("end_time", "End time *", endTime, readonly)
		</div>
		@DurationPreview("durationPreview")
	</div>
}

templ ScrTimeRangeJS() {
	<script type="text/javascript" src={ templ.URL(utils.URL("/static/js/time-range.js")) }></script>
}

templ ScrScheduleRepeatCalendarJS() {
	<script type="text/javascript" src={ templ.URL(utils.URL("/static/js/schedule-repeat-calendar.js")) }></script>
}

templ ScrTimeRangeInit() {
	<script>
		if (window.initAllTimeRangePreviews) initAllTimeRangePreviews();
		else if (window.initTimeRangePreview) initTimeRangePreview();
		if (window.attachTimeRangeFormValidation) attachTimeRangeFormValidation();
	</script>
}
