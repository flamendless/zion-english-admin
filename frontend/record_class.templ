package frontend

import "zion-english/internal/constants"
import "zion-english/internal/models"
import "zion-english/internal/utils"

type RecordClassData struct {
	IsSuperuser       bool
	Prefill           models.RecordClassPrefill
	LearningMaterials []ClassLearningMaterialLink
}

templ RecordClass(data RecordClassData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Record a Class - Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@ScrTimeRangeJS()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@SuccessBanner()
			@ErrorBanner()

			if data.IsSuperuser {
				<form
					id="recordForm"
					hx-post={ utils.URL("/classes/record") }
					hx-swap="innerHTML"
					hx-target="#logOutput"
					hx-indicator="#submitBtn"
					_="
						on submit
							if #teacher.value is ''
								alert('Please select a teacher')
								halt
							end
							if #student.value is ''
								alert('Please select a student')
								halt
							end
							if #start_time.value is ''
								alert('Please set start time')
								halt
							end
							if #end_time.value is ''
								alert('Please set end time')
								halt
							end
							if #rate.value < 0
								alert('Invalid rate')
								halt
							end
							if #status.value is not 'conducted' and #reason.value.trim() is ''
								alert('Reason is required for cancelled or rescheduled classes')
								halt
							end
						end
					"
				>
					if data.Prefill.HasPrefill {
						<input type="hidden" id="fromSchedule" name="fromSchedule" value={ data.Prefill.FromSchedule }/>
						<input type="hidden" id="teacher" name="teacher" value={ data.Prefill.TeacherID }/>
						<input type="hidden" id="student" name="student" value={ data.Prefill.StudentID }/>
						<div class="form-row">
							<div class="form-group">
								<label>Teacher</label>
								<input type="text" value={ data.Prefill.TeacherName } disabled/>
							</div>
							<div class="form-group">
								<label>Student</label>
								<input type="text" value={ data.Prefill.StudentName } disabled/>
							</div>
							@ClassDateField(data.Prefill.Date, data.Prefill.Date != "")
						</div>
					} else {
						<div class="form-row">
							@TeacherDropdown()
							@StudentDropdown()
							@ClassDateField("", false)
						</div>
					}

					@RecordClassFields(data.Prefill, data.LearningMaterials)
				</form>
			} else {
				<form
					id="recordForm"
					hx-post={ utils.URL("/classes/record") }
					hx-swap="innerHTML"
					hx-target="#logOutput"
					hx-indicator="#submitBtn"
					_="
						on submit
							if #student.value is ''
								alert('Please select a student')
								halt
							end
							if #start_time.value is ''
								alert('Please set start time')
								halt
							end
							if #end_time.value is ''
								alert('Please set end time')
								halt
							end
							if #rate.value < 0
								alert('Invalid rate')
								halt
							end
							if #status.value is not 'conducted' and #reason.value.trim() is ''
								alert('Reason is required for cancelled or rescheduled classes')
								halt
							end
						end
					"
				>
					if data.Prefill.HasPrefill {
						<input type="hidden" id="fromSchedule" name="fromSchedule" value={ data.Prefill.FromSchedule }/>
						<input type="hidden" id="student" name="student" value={ data.Prefill.StudentID }/>
						<div class="form-row">
							<div class="form-group">
								<label>Student</label>
								<input type="text" value={ data.Prefill.StudentName } disabled/>
							</div>
							@ClassDateField(data.Prefill.Date, data.Prefill.Date != "")
						</div>
					} else {
						<div class="form-row">
							@TeacherStudentsDropdown()
							@ClassDateField("", false)
						</div>
					}

					@RecordClassFields(data.Prefill, data.LearningMaterials)
				</form>
			}

			<div class="logs-section">
				<h3>Logs and Errors</h3>
				<div id="logOutput">Waiting for submission...</div>
			</div>
		</div>
		@ScrTimeRangeInit()
		@ScrTrialClassJS()
	</body>
	</html>
}

templ RecordClassFields(prefill models.RecordClassPrefill, learningMaterials []ClassLearningMaterialLink) {
	if prefill.HasPrefill && prefill.StartTime != "" {
		@TimeRangeFields(prefill.StartTime, prefill.EndTime, true)
	} else {
		@TimeRangeFields("", "", false)
	}

	<div class="form-row">
		if prefill.HasPrefill && prefill.Currency != "" {
			@CurrencyDropdownWithValue(prefill.Currency)
		} else {
			@CurrencyDropdown()
		}
		<div class="form-group">
			<label for="rate">Rate *</label>
			if prefill.HasPrefill && prefill.Rate != "" {
				<input type="number" id="rate" name="rate" required min="0" step="0.01" value={ prefill.Rate } readonly/>
			} else {
				<input type="number" id="rate" name="rate" required min="0" step="0.01" placeholder="0.00"/>
			}
		</div>
	</div>
	if !(prefill.HasPrefill && prefill.Rate != "") {
		@TrialClassCheckbox(prefill.IsTrialClass, false)
	} else if prefill.IsTrialClass {
		@TrialClassCheckbox(true, true)
	}

	<div
		class="form-row"
		_="
			on change from #status
				if #status.value is 'conducted'
					add @hidden to #reasonGroup
					remove @required from #reason
					set #reason.value to ''
				else
					remove @hidden from #reasonGroup
					add @required to #reason
					set #rate.value to 0
				end
			end
		"
	>
		if prefill.HasPrefill && prefill.Status != "" {
			@ClassStatusDropdownWithValue(constants.ClassListFilterStatus(prefill.Status))
		} else {
			@ClassStatusDropdown()
		}
		<div class="form-group" id="reasonGroup" hidden?={ prefill.Status == "" || prefill.Status == constants.ClassStatusConducted }>
			<label for="reason">Reason *</label>
			<input
				type="text"
				id="reason"
				name="reason"
				placeholder="Reason for cancellation/reschedule"
				required?={ prefill.Status != "" && prefill.Status != constants.ClassStatusConducted }
			/>
		</div>
	</div>

	@ClassLearningMaterialPicker(learningMaterials)

	<div class="form-group">
		<label for="notes">Notes</label>
		<textarea id="notes" name="notes" rows="4" placeholder="Lesson notes..."></textarea>
	</div>

	<button type="submit" id="submitBtn">Record Class</button>
}
