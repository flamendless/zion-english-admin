package frontend

import "zion-english/internal/utils"
import "time"

templ RecordClass() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Record a Class - Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@SuccessBanner()
			@ErrorBanner()

			<form
				id="recordForm"
				hx-post={ utils.URL("/classes/record") }
				hx-swap="none"
				hx-target="#logOutput"
				hx-indicator="#submitBtn"
				_="
					on submit
						if #teacher.value is ''
							alert('Please select a teacher')
							halt
						end
						if #student.value is ''
							alert('Please select a student')
							halt
						end
						if #duration.value <= 0
							alert('Invalid duration')
							halt
						end
						if #rate.value < 0
							alert('Invalid rate')
							halt
						end
					end
				"
			>
				<div class="form-row">
					@TeacherDropdown()
					@StudentDropdown()
				</div>

				<div class="form-row">
					<div class="form-group">
						<label for="date">Date *</label>
						<input
							type="date"
							id="date"
							name="date"
							value={ time.Now().Format("2006-01-02") }
							required
						>
					</div>
					<div class="form-group">
						<label for="duration">Duration (minutes) *</label>
						<input type="number" id="duration" name="duration" required min="1" placeholder="e.g., 60">
					</div>
				</div>

				<div class="form-row">
					@CurrencyDropdown()
					<div class="form-group">
						<label for="rate">Rate *</label>
						<input type="number" id="rate" name="rate" required min="0" step="0.01" placeholder="0.00">
					</div>
				</div>

				<div class="form-row">
					@ClassStatusDropdown()
					<div class="form-group">
						<label for="reason">Reason</label>
						<input type="text" id="reason" name="reason" placeholder="Reason for cancellation/reschedule">
					</div>
				</div>

				<button type="submit" id="submitBtn">Record Class</button>
			</form>

			<div class="logs-section">
				<h3>Logs and Errors</h3>
				<div id="logOutput">Waiting for submission...</div>
			</div>
		</div>
	</body>
	</html>
}
