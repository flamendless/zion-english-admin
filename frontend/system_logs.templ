package frontend

type SystemLogData struct {
	Logs           []SystemLogItem
	HideCreatedBy  bool
	Query          string
	Module         string
	StartDate      string
	EndDate        string
	SortBy         string
	SortOrder      string
	PageNumber     int
	PageTotalPages int
	PageTotal      int64
	PrevURL        string
	NextURL        string
	HasPrev        bool
	HasNext        bool
	FilterPath     string
}

type SystemLogItem struct {
	ID              string
	Module          string
	Message         string
	CreatedBy       string
	CreatedByAvatar AvatarProps
	CreatedAt       string
}

templ SystemLogs(data SystemLogData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		if data.HideCreatedBy {
			@AdminPageHead("My Activity - Zion English Admin Tool")
		} else {
			@AdminPageHead("Logs - Zion English Admin Tool")
		}
		@AvatarStyles()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			if data.HideCreatedBy {
				@HubHeader("My Activity", "", "", false)
			} else {
				@HubHeader("Logs", "", "", false)
			}

			@ListFilterForm(data.FilterPath, data.Query, "", "", "", "", "", data.Module, data.StartDate, data.EndDate, false, false, true, true, false, "", false, "", false, false, false, false, data.SortBy, data.SortOrder, ListSortKindSystemLog, false, "", "", "", "")

			if len(data.Logs) > 0 {
				<div class="table-wrapper data-list-view-root">
					<table id="logsTable" class="table-stack-mobile">
						<thead>
							<tr>
								<th>ID</th>
								<th>Module</th>
								<th>Message</th>
								if !data.HideCreatedBy {
									@AdminOnlyTableHeader("Created By")
								}
								<th>Created At</th>
							</tr>
						</thead>
						<tbody>
							for _, log := range data.Logs {
								<tr>
									<td data-label="ID">{ log.ID }</td>
									<td data-label="Module">{ log.Module }</td>
									<td data-label="Message">{ log.Message }</td>
									if !data.HideCreatedBy {
										<td data-label="Created By">
											@TeacherNameCell(getDisplayValue(log.CreatedBy), log.CreatedByAvatar)
										</td>
									}
									<td class="date-cell" data-label="Created">{ log.CreatedAt }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				@PaginationBar(data.HasPrev, data.PrevURL, data.HasNext, data.NextURL, data.PageNumber, data.PageTotalPages, data.PageTotal)
			} else {
				<div class="empty-state">
					<p>No logs recorded yet.</p>
				</div>
			}
		</div>
	@LayoutEnd()
	</body>
	</html>
}
