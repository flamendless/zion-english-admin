package frontend

import (
	"fmt"
)

templ ClassRecordStatusIcon(record ClassRecordRowData) {
	if record.StatusIconKind() != "" {
		<span
			class={ "class-status-icon class-status-icon--" + string(record.StatusIconKind()) }
			data-tooltip={ record.StatusIconLabel() }
			role="img"
			aria-label={ record.StatusIconLabel() }
		>
			@IconSVG(record.StatusIconKind())
		</span>
	} else {
		<span class="class-status-icon class-status-icon--empty" aria-hidden="true">-</span>
	}
}

templ ClassRecordRow(record ClassRecordRowData, showTeacher bool) {
	<tr class={ record.RowClass() }>
		<td class="class-record-status-cell" data-label="Status">
			@ClassRecordStatusIcon(record)
		</td>
		<td data-label="Date">{ record.Date }</td>
		<td class="time-range-cell" data-label="Time" title={ record.TimeRangeDisplay() }>
			<span class="time-range-stack">
				<span class="time-range-stack__line">{ record.TimeRangeStartLine() }</span>
				<span class="time-range-stack__line">{ record.TimeRangeEndLine() }</span>
			</span>
		</td>
		if showTeacher {
			<td data-label="Teacher">
				@TeacherNameCell(record.TeacherName, record.TeacherAvatar)
			</td>
		}
		<td data-label="Student">
			@StudentNameCell(record.StudentName, record.StudentNumber, record.StudentAvatar)
		</td>
		<td data-label="Rate">@RatePill(record.Rate, record.Currency)</td>
		<td class="table-truncate-cell" data-label="Note / Reason">
			@TableTruncatedText(record.NoteOrReasonDisplay())
		</td>
		<td data-label="Actions">
			<div class="table-actions">
				if record.IsDeleted() {
					<span>-</span>
				} else if record.IsScheduled() {
					@ScheduledClassActions(record.ScheduledItemData())
				} else {
					@IconActionButton("View", IconKindView, templ.Attributes{
						"hx-get":    record.ViewURL(),
						"hx-target": "#classViewModalHost",
						"hx-swap":   "innerHTML",
					})
					@IconActionLink(record.EditURL(), "Edit", IconKindEdit)
					@IconActionTrigger("Delete", IconKindDelete, templ.Attributes{
						"data-delete-url": record.DeleteURL(),
						"data-delete-from": "classes",
					})
				}
			</div>
		</td>
	</tr>
}

templ ClassRecordTableRows(records []ClassRecordRowData, showTeacher bool, emptyColspan int, emptyMessage string) {
	if len(records) == 0 {
		<tr>
			<td colspan={ fmt.Sprintf("%d", emptyColspan) } class="empty-state">{ emptyMessage }</td>
		</tr>
	} else {
		for _, record := range records {
			@ClassRecordRow(record, showTeacher)
		}
	}
}

templ ClassRecordsPartial(records []ClassRecordRowData, showTeacher bool, emptyColspan int, emptyMessage string, page PaginationData, partialsURL string, includeSelector string, targetSelector string, paginationOOBID string) {
	@ClassRecordTableRows(records, showTeacher, emptyColspan, emptyMessage)
	<div id={ paginationOOBID } hx-swap-oob={ HxSwapInnerHTML }>
		@PaginationBarHTMX(partialsURL, includeSelector, targetSelector, page)
	</div>
}
