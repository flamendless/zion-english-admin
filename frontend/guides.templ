package frontend

import "zion-english/internal/constants"
import "zion-english/internal/utils"

type GuideEntry struct {
	Slug        constants.GuideSlug
	Title       string
	Description string
	Access      string
}

type GuidesData struct {
	Guides []GuideEntry
}

templ Guides(data GuidesData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Guides - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@GuideStyles()
	</head>
	<body>
		<div class="container guides-page">
			@HeaderSimple()
			@HubHeader("Guides", "", "", false)

			<div class="guides-hero">
				<p class="guides-subtitle">
					Step-by-step help for everyday tasks in the admin tool. Pick a guide below to get started.
				</p>
			</div>

			if len(data.Guides) == 0 {
				<p class="guides-empty">No guides are available yet.</p>
			} else {
				<div class="guides-grid" role="list">
					for _, guide := range data.Guides {
						@GuideCard(guide)
					}
				</div>
			}
		</div>
	</body>
	</html>
}

templ GuideCard(guide GuideEntry) {
	<a
		href={ utils.URL("/guides/" + string(guide.Slug)) }
		class={ "guide-card guide-card--" + guide.Access }
		role="listitem"
	>
		<span class={ "guide-card-ribbon guide-card-ribbon--" + guide.Access } aria-hidden="true">
			if guide.Access == "superuser" {
				SUPERUSER
			} else {
				TEACHER
			}
		</span>
		<span class="guide-card-icon" aria-hidden="true">
			@GuideBookIcon()
		</span>
		<span class="guide-card-body">
			if guide.Access == "superuser" {
				<span class="guide-card-title admin-only-label-wrap">
					{ guide.Title }
					@AdminOnlyIndicator()
				</span>
			} else {
				<span class="guide-card-title">{ guide.Title }</span>
			}
			<span class="guide-card-desc">{ guide.Description }</span>
		</span>
		<span class="guide-card-arrow" aria-hidden="true">
			@GuideArrowIcon()
		</span>
	</a>
}

templ GuideGettingStarted() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Getting Started - Guides - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@GuideStyles()
	</head>
	<body>
		<div class="container guides-page">
			@HeaderSimple()

			<nav class="guides-breadcrumb" aria-label="Breadcrumb">
				<a href={ utils.URL("/guides") } class="guides-breadcrumb-link">Guides</a>
				<span class="guides-breadcrumb-sep" aria-hidden="true">/</span>
				<span class="guides-breadcrumb-current" aria-current="page">Getting Started</span>
			</nav>

			@HubHeader("Getting Started", "", "", false)

			<div class="guides-hero">
				<p class="guides-subtitle">
					A quick walkthrough for teachers on profile settings, student registration, recording classes, planning your schedule, and editing past records.
				</p>
			</div>

			<div class="guide-content">
				@GuideBetaCallout()
				@GuideSection(
					"my-profile",
					"My Profile",
					utils.URL("/profile"),
					"Update your name, mobile number, or password.",
					[]string{
						"Open My Profile from the dashboard or navigation.",
						"Scroll to the Name section.",
						"Enter your first, middle (optional), and last name correctly. Each field can only be set once.",
						"Click Update name.",
						"Scroll to the Mobile number section, enter your new number, and click Update mobile number. Changes are limited to once every 7 days.",
						"Scroll to the Password section, enter your current password and a new strong password, then click Update password. Password changes are also limited to once every 7 days.",
					},
					false,
				)
				@GuideSection(
					"student-registration",
					"Student Registration",
					utils.URL("/students/register"),
					"Register your assigned students with names that match your Google Sheets exactly.",
					[]string{
						"Open My Students from the dashboard, then click Register Student in the page header (or go directly to Register Student).",
						"Enter the student name using the exact casing as in your Google Sheet (e.g. Kim Min-Ji, not kim min-ji). This is critical for matching records during processing.",
						"Select currency and status (active or inactive).",
						"Enter the rate per class and click Register Student.",
						"You are automatically assigned as the student's teacher, so no teacher picker is shown.",
						"Confirm the new student appears in My Students before scheduling or recording classes.",
					},
					false,
				)
				@GuideSection(
					"class-schedule",
					"Class Schedule",
					utils.URL("/schedule"),
					"Plan classes ahead and conduct or cancel scheduled sessions.",
					[]string{
						"Open Class Schedule to see today's classes and the monthly calendar.",
						"Click a day on the calendar to open the schedule modal for that date.",
						"To add a class, choose the student, set start and end times, confirm the rate, and click Schedule Class.",
						"Today's Classes lists everything scheduled for today. Use Conduct to record a class as completed, Edit to change the student or date/time, Cancel to mark it cancelled, or Delete to remove a scheduled class (reason required).",
						"Conduct opens a short modal where you can add optional notes. Cancel asks for a reason and optional notes.",
					},
					false,
				)
				@GuideSection(
					"my-classes",
					"My Classes",
					utils.URL("/classes"),
					"View your class history and record new classes.",
					[]string{
						"Open My Classes to see your recorded classes. Use the date range, status, and student filters to find specific entries.",
						"Click Record Class in the page header to log a new class.",
						"Select the student, date, start and end times, rate, and status (conducted, cancelled, or rescheduled).",
						"If the status is cancelled or rescheduled, a reason is required before you can submit.",
						"Click Record Class to save. A success message confirms the entry was added.",
						"Use Delete on a class row to remove it from your lists. A reason is required; the record is kept for audit.",
						"During the beta phase, continue recording classes in your Google Sheet as well for auditing.",
					},
					false,
				)
				@GuideSection(
					"editing-classes",
					"Editing classes",
					utils.URL("/classes"),
					"Update details for a class you already recorded.",
					[]string{
						"Open My Classes and find the class you want to change. Use filters if needed.",
						"For scheduled classes, click Edit to change the student, date, or time in a modal.",
						"For recorded classes, click Edit on the row to update date, times, status, reason, notes, or other fields.",
						"Click Save changes. A success message confirms the update.",
					},
					false,
				)
			</div>

			<div class="guides-footer-nav">
				<a href={ utils.URL("/guides") } class="guides-back-link">
					@GuideBackIcon()
					All guides
				</a>
			</div>
		</div>
		@GuideAnchorScript()
	</body>
	</html>
}

templ GuideReportsGeneration() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Reports &amp; Generation - Guides - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@GuideStyles()
	</head>
	<body>
		<div class="container guides-page">
			@HeaderSimple()

			<nav class="guides-breadcrumb" aria-label="Breadcrumb">
				<a href={ utils.URL("/guides") } class="guides-breadcrumb-link">Guides</a>
				<span class="guides-breadcrumb-sep" aria-hidden="true">/</span>
				<span class="guides-breadcrumb-current" aria-current="page">Reports &amp; Generation</span>
			</nav>

			<div class="hub-header">
				<h2 class="hub-title admin-only-label-wrap">
					Reports &amp; Generation
					@AdminOnlyIndicator()
				</h2>
			</div>

			<div class="guides-hero">
				<p class="guides-subtitle">
					How superusers review teacher payroll summaries, preview class records for a cutoff period, and generate downloadable XLSX reports.
				</p>
			</div>

			<div class="guide-content">
				@GuideSection(
					"reports-overview",
					"Reports overview",
					utils.URL("/reports"),
					"Open the Reports page to see every teacher's class totals and earnings for a date range.",
					[]string{
						"Open Reports from the dashboard or navigation.",
						"The table lists each teacher with conducted/total classes and earnings broken down by currency.",
						"Use the actions on each row to view details, generate an XLSX file, or download a report that is already ready.",
					},
					false,
				)
				@GuideSection(
					"date-range-and-search",
					"Date range and search",
					utils.URL("/reports"),
					"Filter the report list to the payroll cutoff you need.",
					[]string{
						"Choose a date preset from the dropdown (for example, this month or last month).",
						"Optionally type in the search box to narrow results by teacher or student name.",
						"Click Filter to refresh the table with the selected range and search term.",
					},
					false,
				)
				@GuideSection(
					"view-report",
					"View a teacher report",
					utils.URL("/reports"),
					"Preview a teacher's classes and earnings before exporting.",
					[]string{
						"Click View on the teacher's row.",
						"The modal shows the teacher name, cutoff period, total earnings, and a status summary (conducted, rescheduled, cancelled).",
						"Scroll through the class list to verify dates, students, rates, times, and statuses.",
						"Close the modal with the X button, Escape, or by clicking outside the dialog.",
					},
					false,
				)
				@GuideSection(
					"generate-and-download",
					"Generate and download XLSX",
					utils.URL("/reports"),
					"Build a spreadsheet from recorded classes and download it for payroll.",
					[]string{
						"Click Generate report on the teacher's row for the selected date range.",
						"When generation finishes, Download XLSX becomes available for that row.",
						"If class records have not changed since the last export, the system skips regeneration and keeps the existing file.",
						"Click Regenerate after teachers update class records if you need a fresh XLSX.",
						"The downloaded file uses the same format as the Process pipeline output.",
					},
					false,
				)
			</div>

			<div class="guides-footer-nav">
				<a href={ utils.URL("/guides") } class="guides-back-link">
					@GuideBackIcon()
					All guides
				</a>
			</div>
		</div>
		@GuideAnchorScript()
	</body>
	</html>
}

templ GuideResumeCV() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Resume / CV - Guides - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@GuideStyles()
	</head>
	<body>
		<div class="container guides-page">
			@HeaderSimple()

			<nav class="guides-breadcrumb" aria-label="Breadcrumb">
				<a href={ utils.URL("/guides") } class="guides-breadcrumb-link">Guides</a>
				<span class="guides-breadcrumb-sep" aria-hidden="true">/</span>
				<span class="guides-breadcrumb-current" aria-current="page">Resume / CV</span>
			</nav>

			@HubHeader("Resume / CV", "", "", false)

			<div class="guides-hero">
				<p class="guides-subtitle">
					Upload your resume or CV from My Profile. You can replace it once per day. Your file appears on My Documents with Approved status.
				</p>
			</div>

			<div class="guide-content">
				@GuideSection(
					"upload-resume",
					"Upload resume / CV",
					utils.URL("/profile"),
					"Add or replace your resume from the Resume / CV section on My Profile.",
					[]string{
						"Open My Profile from the dashboard or navigation.",
						"Scroll to the Resume / CV section.",
						"Choose a file in PNG, JPEG, JPG, or PDF format (max 5 MB).",
						"Click Upload resume/CV.",
						"A success message confirms the upload. Use View resume/CV to open the current file.",
					},
					false,
				)
				@GuideSection(
					"once-per-day",
					"Once-per-day upload limit",
					utils.URL("/profile"),
					"You can upload a new resume or CV at most once every 24 hours.",
					[]string{
						"The Resume / CV section shows a Once per day pill as a reminder.",
						"If you uploaded recently, the form is disabled and shows how long until you can upload again.",
						"Replacing your resume does not require admin review. The new file is approved immediately.",
					},
					false,
				)
				@GuideSection(
					"view-my-documents",
					"View on My Documents",
					utils.URL("/documents"),
					"See your uploaded resume alongside profile photos and ID documents.",
					[]string{
						"Open My Documents from the navigation.",
						"Your resume appears with type Resume/CV and status Approved.",
						"Use the view action to open or download the file.",
						"Valid ID documents are uploaded separately on My Profile and may require admin review before approval.",
					},
					false,
				)
				@GuideSection(
					"admin-view-resumes",
					"View teacher resumes",
					utils.URL("/documents"),
					"Administrators can browse all teacher resume uploads on the Documents page.",
					[]string{
						"Open Documents from the dashboard or navigation.",
						"Filter by type Resume/CV to see resume uploads only.",
						"Use the view action to open a teacher's file. Resume/CV entries do not use approve or reject actions.",
						"Use search and teacher filters to find a specific upload.",
					},
					true,
				)
			</div>

			<div class="guides-footer-nav">
				<a href={ utils.URL("/guides") } class="guides-back-link">
					@GuideBackIcon()
					All guides
				</a>
			</div>
		</div>
		@GuideAnchorScript()
	</body>
	</html>
}

templ GuideIntroVideos() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Intro Videos - Guides - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@GuideStyles()
	</head>
	<body>
		<div class="container guides-page">
			@HeaderSimple()

			<nav class="guides-breadcrumb" aria-label="Breadcrumb">
				<a href={ utils.URL("/guides") } class="guides-breadcrumb-link">Guides</a>
				<span class="guides-breadcrumb-sep" aria-hidden="true">/</span>
				<span class="guides-breadcrumb-current" aria-current="page">Intro Videos</span>
			</nav>

			@HubHeader("Intro Videos", "", "", false)

			<div class="guides-hero">
				<p class="guides-subtitle">
					Upload a short introduction video from My Profile. You can also submit a YouTube or Google Drive link if you prefer to host the video externally. Track status on My Intro Video.
				</p>
			</div>

			<div class="guide-content">
				@GuideSection(
					"submit-intro-video",
					"Submit an intro video",
					utils.URL("/profile"),
					"Upload a video file from the Introduction video section on My Profile. File upload is selected by default.",
					[]string{
						"Open My Profile from the dashboard or navigation.",
						"Scroll to the Introduction video section (visible when intro video uploads are enabled for your role).",
						"Keep Source set to Upload, choose your video file, and review the preview (name, size, duration, and dimensions).",
						"Click Submit intro video and confirm in the dialog.",
						"Wait for the upload progress bar to finish, then for processing to complete before the page redirects.",
						"A success message confirms your submission is pending review.",
					},
					false,
				)
				@GuideSection(
					"submit-intro-video-link",
					"Submit a YouTube or Google Drive link",
					utils.URL("/profile"),
					"Use an external link instead of uploading a file.",
					[]string{
						"Open the Introduction video section on My Profile.",
						"Change Source to YouTube or Google Drive.",
						"Paste the video URL and follow the sharing hint shown for your selected source.",
						"Click Submit intro video and confirm when prompted.",
					},
					false,
				)
				@GuideSection(
					"upload-requirements",
					"Upload requirements",
					utils.URL("/profile"),
					"Uploaded files are stored in app storage and validated before review.",
					[]string{
						"Accepted formats: MP4, WebM, MOV, AVI, MKV, OGV, M4V, or 3GP.",
						"Maximum file size: 20 MB.",
						"Maximum duration: 60 seconds.",
						"If the preview shows a duration warning, choose a shorter clip before submitting.",
						"After the upload bar reaches 100%, processing may take a moment while the server validates the video.",
					},
					false,
				)
				@GuideSection(
					"link-requirements",
					"Link sharing requirements",
					utils.URL("/profile"),
					"Reviewers must be able to open your link without signing in.",
					[]string{
						"For Google Drive, set sharing to Anyone with the link.",
						"For YouTube, set the video to Unlisted (not Private).",
						"Test the link in a private browser window before submitting.",
						"Submissions are blocked while you already have a Submitted or Approved intro video on file.",
					},
					false,
				)
				@GuideSection(
					"track-status",
					"Track submission status",
					utils.URL("/intro-videos"),
					"Follow review progress on My Intro Video or from your profile.",
					[]string{
						"Open My Intro Video from the navigation to see your submission history.",
						"Statuses are Submitted (pending review), Approved, or Rejected.",
						"Your profile also shows the current submission status and a link to open the video.",
						"If uploads are disabled, the profile section explains that submissions are not available.",
					},
					false,
				)
				@GuideSection(
					"resubmit-after-rejection",
					"Resubmit after rejection",
					utils.URL("/profile"),
					"You can submit a new video or link after an administrator rejects your submission.",
					[]string{
						"Open My Profile and check the Introduction video section for the reject reason.",
						"Fix the file or link, then submit again.",
						"You cannot submit again while a Submitted or Approved video is still on file.",
						"After rejection, the form becomes available for a new submission.",
					},
					false,
				)
				@GuideSection(
					"admin-review-intro-videos",
					"Review intro video submissions",
					utils.URL("/intro-videos"),
					"Administrators review teacher intro videos on the Intro Videos page.",
					[]string{
						"Open Intro Videos from the dashboard Pending Review card or navigation.",
						"Filter by status, teacher, or search term. Sort by upload date as needed.",
						"Source shows Upload, YouTube, or Google Drive. Legacy rows may show Uploaded file.",
						"Use View to open the teacher's video in a new tab.",
						"Click Approve for acceptable submissions, or Reject and enter a required reason so the teacher can resubmit.",
						"Delete removes the submission so the teacher can upload a new one.",
					},
					true,
				)
				@GuideSection(
					"admin-feature-flag",
					"Enable uploads by teacher role",
					utils.URL("/feature-flags"),
					"Superusers control which teacher roles can see and use intro video uploads.",
					[]string{
						"Open Feature Flags from the navigation (superuser only).",
						"Find the intro video uploads flag and enable it.",
						"Select which teacher roles can submit intro videos.",
						"Save changes. Teachers with matching roles will see the Introduction video section on My Profile.",
					},
					true,
				)
			</div>

			<div class="guides-footer-nav">
				<a href={ utils.URL("/guides") } class="guides-back-link">
					@GuideBackIcon()
					All guides
				</a>
			</div>
		</div>
		@GuideAnchorScript()
	</body>
	</html>
}

templ GuidePayments() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Payments - Guides - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@GuideStyles()
	</head>
	<body>
		<div class="container guides-page">
			@HeaderSimple()

			<nav class="guides-breadcrumb" aria-label="Breadcrumb">
				<a href={ utils.URL("/guides") } class="guides-breadcrumb-link">Guides</a>
				<span class="guides-breadcrumb-sep" aria-hidden="true">/</span>
				<span class="guides-breadcrumb-current" aria-current="page">Payments</span>
			</nav>

			@HubHeader("Payments", "", "", false)

			<div class="guides-hero">
				<p class="guides-subtitle">
					Administrators record payroll payments sent from Reports. Teachers confirm receipt and browse history on Payment History. See the Reports &amp; Generation guide for cutoff periods and XLSX exports.
				</p>
			</div>

			<div class="guide-content">
				@GuideSection(
					"payment-overview",
					"How payments work",
					utils.URL("/payments"),
					"Payments track payroll sent for each teacher and cutoff period.",
					[]string{
						"Each payment is tied to a report cutoff date range and a single teacher.",
						"Only one payment can be recorded per teacher per cutoff period.",
						"Status starts as Pending when an administrator sends payment, then becomes Received when the teacher confirms.",
						"Payment method is GCash. A reference number is required when sending payment.",
						"For payroll totals and class details, see the Reports & Generation guide.",
					},
					false,
				)
				@GuideSection(
					"confirm-receipt",
					"Confirm payment received",
					utils.URL("/payments"),
					"Teachers confirm when payroll has arrived.",
					[]string{
						"When a payment is sent, you may see a prompt on the dashboard asking you to confirm receipt.",
						"Click Received when the payment has arrived, or Not Yet Received to dismiss the prompt for this login session.",
						"You can also open My Payment History, find a Pending row, and click Mark as received.",
						"In the modal, review the period and amount, then click Received to update the status.",
					},
					false,
				)
				@GuideSection(
					"payment-history-teacher",
					"My Payment History",
					utils.URL("/payments"),
					"Browse your sent payments and filter by date or status.",
					[]string{
						"Open My Payment History from the navigation.",
						"Use the month picker or date preset to narrow the list.",
						"Filter by status: All, Pending, or Received.",
						"Click View on a row to open payment details in a modal.",
					},
					false,
				)
				@GuideSection(
					"admin-send-payment",
					"Send payment from Reports",
					utils.URL("/reports"),
					"Administrators record a sent payment from the Reports page for a cutoff period.",
					[]string{
						"Open Reports and select the cutoff date range for the payroll period.",
						"On a teacher row, click Send payment (available when no payment exists for that period).",
						"In the modal, confirm the teacher, total earnings, period, payment method, reference number, and amount.",
						"Click Send payment. The teacher is notified and the row shows payment status.",
						"If payment was already sent for this cutoff, Send payment is disabled until the next cutoff period.",
					},
					true,
				)
				@GuideSection(
					"admin-payment-history",
					"Payment History for all teachers",
					utils.URL("/payments"),
					"Administrators can audit all sent payments across teachers.",
					[]string{
						"Open Payment History from the dashboard or navigation.",
						"Filter by month, date preset, and status.",
						"Search by teacher name to find a specific teacher's payments.",
						"Click View to open read-only payment details for any row.",
					},
					true,
				)
			</div>

			<div class="guides-footer-nav">
				<a href={ utils.URL("/guides") } class="guides-back-link">
					@GuideBackIcon()
					All guides
				</a>
			</div>
		</div>
		@GuideAnchorScript()
	</body>
	</html>
}

templ GuideConnectZoom() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Connect Zoom - Guides - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@GuideStyles()
	</head>
	<body>
		<div class="container guides-page">
			@HeaderSimple()

			<nav class="guides-breadcrumb" aria-label="Breadcrumb">
				<a href={ utils.URL("/guides") } class="guides-breadcrumb-link">Guides</a>
				<span class="guides-breadcrumb-sep" aria-hidden="true">/</span>
				<span class="guides-breadcrumb-current" aria-current="page">Connect Zoom</span>
			</nav>

			@HubHeader("Connect Zoom", "", "", false)

			<div class="guides-hero">
				<p class="guides-subtitle">
					Link your Zoom account once so the admin tool can create meeting rooms for scheduled classes up to 40 minutes.
				</p>
			</div>

			<div class="guide-content">
				@GuideConnectZoomSections()
			</div>

			<div class="guides-footer-nav">
				<a href={ utils.URL("/guides") } class="guides-back-link">
					@GuideBackIcon()
					All guides
				</a>
			</div>
		</div>
		@GuideAnchorScript()
	</body>
	</html>
}

templ DocsConnectZoom() {
	@LegalDocPage(
		"Connect Zoom",
		"Link your Zoom account once so the admin tool can create meeting rooms for scheduled classes up to 40 minutes.",
	) {
		@GuideConnectZoomSections()
	}
}

templ GuideConnectZoomSections() {
	@GuideSection(
		"why-connect-zoom",
		"Why connect Zoom?",
		utils.URL("/profile"),
		"One-time setup that enables automatic meeting links for short scheduled classes.",
		[]string{
			"Connect your own Zoom Basic account from My Profile.",
			"After connecting, classes up to 40 minutes receive a Zoom meeting link automatically when you schedule them.",
			"Scheduling classes up to 40 minutes requires a connected Zoom account.",
		},
		false,
	)
	@GuideSection(
		"before-you-start",
		"Before you start",
		utils.URL("/profile"),
		"You need a Zoom account you can sign into.",
		[]string{
			"Use your own Zoom account (Basic is fine).",
			"Sign in with the same email you use for Zoom.",
		},
		false,
	)
	@GuideSection(
		"connect-your-account",
		"Connect your account",
		utils.URL("/profile"),
		"Authorize the admin tool from your profile page.",
		[]string{
			"Open My Profile from the dashboard or navigation.",
			"Scroll to Integrations and click Connect Zoom.",
			"Sign in to Zoom if prompted and approve access.",
			"Return to the profile page and confirm the Zoom badge shows Connected.",
		},
		false,
	)
	@GuideSection(
		"schedule-with-zoom",
		"Schedule a class with Zoom",
		utils.URL("/schedule"),
		"Automatic meeting links appear on class cards for classes up to 40 minutes.",
		[]string{
			"Open Class Schedule and add a class as usual.",
			"For classes up to 40 minutes, a Zoom button appears on the class card after scheduling.",
			"Click the Zoom button to open meeting details, then use Open to launch Zoom or Copy to share the link and passcode with your student.",
		},
		false,
	)
	@GuideSection(
		"forty-minute-limit",
		"40-minute limit",
		utils.URL("/schedule"),
		"Zoom Basic accounts limit hosted meetings to 40 minutes.",
		[]string{
			"If your class is longer than 40 minutes, the schedule form shows a warning.",
			"No automatic Zoom room is created for those classes.",
			"Create your Zoom meeting manually in Zoom and share the link with your student.",
		},
		false,
	)
	@GuideSection(
		"disconnect-reconnect",
		"Disconnect or reconnect",
		utils.URL("/profile"),
		"Manage your Zoom connection from My Profile.",
		[]string{
			"Click Disconnect Zoom in Integrations if you need to remove access.",
			"Scheduling classes up to 40 minutes is blocked until you reconnect.",
			"Reconnect if you switch Zoom accounts.",
		},
		false,
	)
	@GuideSection(
		"troubleshooting",
		"Troubleshooting",
		utils.URL("/profile"),
		"Common issues when connecting or scheduling with Zoom.",
		[]string{
			"If Connect Zoom is missing, ask your administrator to configure Zoom for the system.",
			"If scheduling fails, confirm Zoom shows Connected on your profile.",
			"If connection fails for your Zoom account but works for the administrator, the Zoom app may still be in development-only mode. Your administrator must use Production credentials and request Beta Test sharing or publish the app.",
			"If Zoom is down, try again later or schedule a class longer than 40 minutes without an automatic room.",
		},
		false,
	)
	@GuideSection(
		"admin-zoom-setup",
		"Administrator: Zoom Marketplace setup",
		utils.URL("/profile"),
		"Required so teachers on their own Zoom accounts can connect (not only the developer account).",
		[]string{
			"In Zoom Marketplace, open the app under the Production tab (not Development).",
			"Set OAuth redirect URL and allow list to your callback URL, e.g. https://your-domain/zion-english-admin/profile/zoom/callback.",
			"Set Support URL to your public support page, e.g. https://your-domain/zion-english-admin/support.",
			"Set Documentation URL to this page, e.g. https://your-domain/zion-english-admin/docs/connect-zoom.",
			"Enable only these scopes: user:read:user, meeting:write:meeting, meeting:update:meeting, meeting:delete:meeting.",
			"Copy Production Client ID and Secret into server ZOOM_CLIENT_ID and ZOOM_CLIENT_SECRET; set ZOOM_REDIRECT_URI to the same callback URL.",
			"Copy the authorization URL from Marketplace (Local Test or Beta Test) into server ZOOM_AUTHORIZE_URL. Connect Zoom uses this URL.",
			"Under Beta Test, complete requirements and submit Request to Share so external Zoom accounts can authorize (or publish the app for full production).",
		},
		true,
	)
}

