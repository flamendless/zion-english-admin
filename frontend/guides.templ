package frontend

import "zion-english/internal/utils"

type GuideEntry struct {
	Slug        string
	Title       string
	Description string
	Access      string
}

type GuidesData struct {
	Guides []GuideEntry
}

templ Guides(data GuidesData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Guides - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@GuideStyles()
	</head>
	<body>
		<div class="container guides-page">
			@HeaderSimple()
			@HubHeader("Guides", "", "", false)

			<div class="guides-hero">
				<p class="guides-subtitle">
					Step-by-step help for everyday tasks in the admin tool. Pick a guide below to get started.
				</p>
			</div>

			if len(data.Guides) == 0 {
				<p class="guides-empty">No guides are available yet.</p>
			} else {
				<div class="guides-grid" role="list">
					for _, guide := range data.Guides {
						@GuideCard(guide)
					}
				</div>
			}
		</div>
	</body>
	</html>
}

templ GuideCard(guide GuideEntry) {
	<a
		href={ utils.URL("/guides/" + guide.Slug) }
		class={ "guide-card guide-card--" + guide.Access }
		role="listitem"
	>
		<span class={ "guide-card-ribbon guide-card-ribbon--" + guide.Access } aria-hidden="true">
			if guide.Access == "superuser" {
				SUPERUSER
			} else {
				TEACHER
			}
		</span>
		<span class="guide-card-icon" aria-hidden="true">
			@GuideBookIcon()
		</span>
		<span class="guide-card-body">
			<span class="guide-card-title">{ guide.Title }</span>
			<span class="guide-card-desc">{ guide.Description }</span>
		</span>
		<span class="guide-card-arrow" aria-hidden="true">
			@GuideArrowIcon()
		</span>
	</a>
}

templ GuideGettingStarted() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Getting Started - Guides - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@GuideStyles()
	</head>
	<body>
		<div class="container guides-page">
			@HeaderSimple()

			<nav class="guides-breadcrumb" aria-label="Breadcrumb">
				<a href={ utils.URL("/guides") } class="guides-breadcrumb-link">Guides</a>
				<span class="guides-breadcrumb-sep" aria-hidden="true">/</span>
				<span class="guides-breadcrumb-current" aria-current="page">Getting Started</span>
			</nav>

			@HubHeader("Getting Started", "", "", false)

			<div class="guides-hero">
				<p class="guides-subtitle">
					A quick walkthrough for teachers on profile settings, student registration, recording classes, planning your schedule, and editing past records.
				</p>
			</div>

			<div class="guide-content">
				@GuideBetaCallout()
				@GuideSection(
					"my-profile",
					"My Profile",
					utils.URL("/profile"),
					"Update your name, mobile number, or password.",
					[]string{
						"Open My Profile from the dashboard or navigation.",
						"Scroll to the Name section.",
						"Enter your first, middle (optional), and last name correctly — each field can only be set once.",
						"Click Update name.",
						"Scroll to the Mobile number section, enter your new number, and click Update mobile number. Changes are limited to once every 7 days.",
						"Scroll to the Password section, enter your current password and a new strong password, then click Update password. Password changes are also limited to once every 7 days.",
					},
				)
				@GuideSection(
					"student-registration",
					"Student Registration",
					utils.URL("/students/register"),
					"Register your assigned students with names that match your Google Sheets exactly.",
					[]string{
						"Open My Students from the dashboard, then click Register Student in the page header (or go directly to Register Student).",
						"Enter the student name using the exact casing as in your Google Sheet (e.g. Kim Min-Ji, not kim min-ji). This is critical for matching records during processing.",
						"Select currency and status (active or inactive).",
						"Enter the rate per class and click Register Student.",
						"You are automatically assigned as the student's teacher — no teacher picker is shown.",
						"Confirm the new student appears in My Students before scheduling or recording classes.",
					},
				)
				@GuideSection(
					"class-schedule",
					"Class Schedule",
					utils.URL("/schedule"),
					"Plan classes ahead and conduct or cancel scheduled sessions.",
					[]string{
						"Open Class Schedule to see today's classes and the monthly calendar.",
						"Click a day on the calendar to open the schedule modal for that date.",
						"To add a class, choose the student, set start and end times, confirm the rate, and click Schedule Class.",
						"Today's Classes lists everything scheduled for today. Use Conduct to record a class as completed, Edit to change the student or date/time, Cancel to mark it cancelled, or Delete to remove a scheduled class (reason required).",
						"Conduct opens a short modal where you can add optional notes. Cancel asks for a reason and optional notes.",
					},
				)
				@GuideSection(
					"my-classes",
					"My Classes",
					utils.URL("/classes"),
					"View your class history and record new classes.",
					[]string{
						"Open My Classes to see your recorded classes. Use the date range, status, and student filters to find specific entries.",
						"Click Record Class in the page header to log a new class.",
						"Select the student, date, start and end times, rate, and status (conducted, cancelled, or rescheduled).",
						"If the status is cancelled or rescheduled, a reason is required before you can submit.",
						"Click Record Class to save. A success message confirms the entry was added.",
						"Use Delete on a class row to remove it from your lists. A reason is required; the record is kept for audit.",
						"During the beta phase, continue recording classes in your Google Sheet as well for auditing.",
					},
				)
				@GuideSection(
					"editing-classes",
					"Editing classes",
					utils.URL("/classes"),
					"Update details for a class you already recorded.",
					[]string{
						"Open My Classes and find the class you want to change. Use filters if needed.",
						"For scheduled classes, click Edit to change the student, date, or time in a modal.",
						"For recorded classes, click Edit on the row to update date, times, status, reason, notes, or other fields.",
						"Click Save changes. A success message confirms the update.",
					},
				)
			</div>

			<div class="guides-footer-nav">
				<a href={ utils.URL("/guides") } class="guides-back-link">
					@GuideBackIcon()
					All guides
				</a>
			</div>
		</div>
		@GuideAnchorScript()
	</body>
	</html>
}

templ GuideReportsGeneration() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Reports &amp; Generation - Guides - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@GuideStyles()
	</head>
	<body>
		<div class="container guides-page">
			@HeaderSimple()

			<nav class="guides-breadcrumb" aria-label="Breadcrumb">
				<a href={ utils.URL("/guides") } class="guides-breadcrumb-link">Guides</a>
				<span class="guides-breadcrumb-sep" aria-hidden="true">/</span>
				<span class="guides-breadcrumb-current" aria-current="page">Reports &amp; Generation</span>
			</nav>

			@HubHeader("Reports &amp; Generation", "", "", false)

			<div class="guides-hero">
				<p class="guides-subtitle">
					How superusers review teacher payroll summaries, preview class records for a cutoff period, and generate downloadable XLSX reports.
				</p>
			</div>

			<div class="guide-content">
				@GuideSection(
					"reports-overview",
					"Reports overview",
					utils.URL("/reports"),
					"Open the Reports page to see every teacher's class totals and earnings for a date range.",
					[]string{
						"Open Reports from the dashboard or navigation.",
						"The table lists each teacher with conducted/total classes and earnings broken down by currency.",
						"Use the actions on each row to view details, generate an XLSX file, or download a report that is already ready.",
					},
				)
				@GuideSection(
					"date-range-and-search",
					"Date range and search",
					utils.URL("/reports"),
					"Filter the report list to the payroll cutoff you need.",
					[]string{
						"Choose a date preset from the dropdown (for example, this month or last month).",
						"Optionally type in the search box to narrow results by teacher or student name.",
						"Click Filter to refresh the table with the selected range and search term.",
					},
				)
				@GuideSection(
					"view-report",
					"View a teacher report",
					utils.URL("/reports"),
					"Preview a teacher's classes and earnings before exporting.",
					[]string{
						"Click View on the teacher's row.",
						"The modal shows the teacher name, cutoff period, total earnings, and a status summary (conducted, rescheduled, cancelled).",
						"Scroll through the class list to verify dates, students, rates, times, and statuses.",
						"Close the modal with the X button, Escape, or by clicking outside the dialog.",
					},
				)
				@GuideSection(
					"generate-and-download",
					"Generate and download XLSX",
					utils.URL("/reports"),
					"Build a spreadsheet from recorded classes and download it for payroll.",
					[]string{
						"Click Generate report on the teacher's row for the selected date range.",
						"When generation finishes, Download XLSX becomes available for that row.",
						"If class records have not changed since the last export, the system skips regeneration and keeps the existing file.",
						"Click Regenerate after teachers update class records if you need a fresh XLSX.",
						"The downloaded file uses the same format as the Process pipeline output.",
					},
				)
			</div>

			<div class="guides-footer-nav">
				<a href={ utils.URL("/guides") } class="guides-back-link">
					@GuideBackIcon()
					All guides
				</a>
			</div>
		</div>
		@GuideAnchorScript()
	</body>
	</html>
}

templ GuideConnectZoom() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Connect Zoom - Guides - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@GuideStyles()
	</head>
	<body>
		<div class="container guides-page">
			@HeaderSimple()

			<nav class="guides-breadcrumb" aria-label="Breadcrumb">
				<a href={ utils.URL("/guides") } class="guides-breadcrumb-link">Guides</a>
				<span class="guides-breadcrumb-sep" aria-hidden="true">/</span>
				<span class="guides-breadcrumb-current" aria-current="page">Connect Zoom</span>
			</nav>

			@HubHeader("Connect Zoom", "", "", false)

			<div class="guides-hero">
				<p class="guides-subtitle">
					Link your Zoom account once so the admin tool can create meeting rooms for scheduled classes up to 40 minutes.
				</p>
			</div>

			<div class="guide-content">
				@GuideConnectZoomSections()
			</div>

			<div class="guides-footer-nav">
				<a href={ utils.URL("/guides") } class="guides-back-link">
					@GuideBackIcon()
					All guides
				</a>
			</div>
		</div>
		@GuideAnchorScript()
	</body>
	</html>
}

templ DocsConnectZoom() {
	@LegalDocPage(
		"Connect Zoom",
		"Link your Zoom account once so the admin tool can create meeting rooms for scheduled classes up to 40 minutes.",
	) {
		@GuideConnectZoomSections()
	}
}

templ GuideConnectZoomSections() {
	@GuideSection(
		"why-connect-zoom",
		"Why connect Zoom?",
		utils.URL("/profile"),
		"One-time setup that enables automatic meeting links for short scheduled classes.",
		[]string{
			"Connect your own Zoom Basic account from My Profile.",
			"After connecting, classes up to 40 minutes receive a Zoom meeting link automatically when you schedule them.",
			"Scheduling classes up to 40 minutes requires a connected Zoom account.",
		},
	)
	@GuideSection(
		"before-you-start",
		"Before you start",
		utils.URL("/profile"),
		"You need a Zoom account you can sign into.",
		[]string{
			"Use your own Zoom account (Basic is fine).",
			"Sign in with the same email you use for Zoom.",
		},
	)
	@GuideSection(
		"connect-your-account",
		"Connect your account",
		utils.URL("/profile"),
		"Authorize the admin tool from your profile page.",
		[]string{
			"Open My Profile from the dashboard or navigation.",
			"Scroll to Integrations and click Connect Zoom.",
			"Sign in to Zoom if prompted and approve access.",
			"Return to the profile page and confirm the Zoom badge shows Connected.",
		},
	)
	@GuideSection(
		"schedule-with-zoom",
		"Schedule a class with Zoom",
		utils.URL("/schedule"),
		"Automatic meeting links appear on class cards for classes up to 40 minutes.",
		[]string{
			"Open Class Schedule and add a class as usual.",
			"For classes up to 40 minutes, a Zoom button appears on the class card after scheduling.",
			"Click the Zoom button to open meeting details, then use Open to launch Zoom or Copy to share the link and passcode with your student.",
		},
	)
	@GuideSection(
		"forty-minute-limit",
		"40-minute limit",
		utils.URL("/schedule"),
		"Zoom Basic accounts limit hosted meetings to 40 minutes.",
		[]string{
			"If your class is longer than 40 minutes, the schedule form shows a warning.",
			"No automatic Zoom room is created for those classes.",
			"Create your Zoom meeting manually in Zoom and share the link with your student.",
		},
	)
	@GuideSection(
		"disconnect-reconnect",
		"Disconnect or reconnect",
		utils.URL("/profile"),
		"Manage your Zoom connection from My Profile.",
		[]string{
			"Click Disconnect Zoom in Integrations if you need to remove access.",
			"Scheduling classes up to 40 minutes is blocked until you reconnect.",
			"Reconnect if you switch Zoom accounts.",
		},
	)
	@GuideSection(
		"troubleshooting",
		"Troubleshooting",
		utils.URL("/profile"),
		"Common issues when connecting or scheduling with Zoom.",
		[]string{
			"If Connect Zoom is missing, ask your administrator to configure Zoom for the system.",
			"If scheduling fails, confirm Zoom shows Connected on your profile.",
			"If connection fails for your Zoom account but works for the administrator, the Zoom app may still be in development-only mode — your administrator must use Production credentials and request Beta Test sharing or publish the app.",
			"If Zoom is down, try again later or schedule a class longer than 40 minutes without an automatic room.",
		},
	)
	@GuideSection(
		"admin-zoom-setup",
		"Administrator: Zoom Marketplace setup",
		utils.URL("/profile"),
		"Required so teachers on their own Zoom accounts can connect (not only the developer account).",
		[]string{
			"In Zoom Marketplace, open the app under the Production tab (not Development).",
			"Set OAuth redirect URL and allow list to your callback URL, e.g. https://your-domain/zion-english-admin/profile/zoom/callback.",
			"Set Support URL to your public support page, e.g. https://your-domain/zion-english-admin/support.",
			"Set Documentation URL to this page, e.g. https://your-domain/zion-english-admin/docs/connect-zoom.",
			"Enable only these scopes: user:read:user, meeting:write:meeting, meeting:update:meeting, meeting:delete:meeting.",
			"Copy Production Client ID and Secret into server ZOOM_CLIENT_ID and ZOOM_CLIENT_SECRET; set ZOOM_REDIRECT_URI to the same callback URL.",
			"Copy the authorization URL from Marketplace (Local Test or Beta Test) into server ZOOM_AUTHORIZE_URL — Connect Zoom uses this URL.",
			"Under Beta Test, complete requirements and submit Request to Share so external Zoom accounts can authorize (or publish the app for full production).",
		},
	)
}

templ GuideBetaCallout() {
	<div class="guide-beta-card" role="note" aria-label="Beta testing instructions">
		<span class="guide-beta-ribbon" aria-hidden="true">BETA</span>
		<h2 class="guide-beta-title">Early testing phase</h2>
		<p class="guide-beta-intro">
			Teachers, since this system is still in testing and early phase, please do the following:
		</p>
		<ul class="guide-beta-list">
			<li>Update your first, middle, and last names correctly</li>
			<li>Register your students (use the exact casing from your Google Sheets)</li>
			<li>Plot some class schedules for the upcoming week</li>
			<li>Conduct/record all classes in the admin tool WHILE ALSO CONTINUING to record them in your Google Sheets for auditing</li>
		</ul>
	</div>
}

templ GuideSection(anchor string, title string, href string, summary string, steps []string) {
	<section class="guide-section" id={ anchor }>
		<h2 class="guide-section-title">
			<a
				href={ "#" + anchor }
				class="guide-section-anchor"
				aria-label={ "Link to " + title }
			>#</a>
			<a
				href={ href }
				class="guide-section-link"
				target="_blank"
				rel="noopener noreferrer"
			>
				{ title }
				<span class="guide-external-icon" aria-hidden="true">
					@GuideExternalIcon()
				</span>
			</a>
		</h2>
		<p class="guide-section-summary">{ summary }</p>
		<ol class="guide-steps">
			for _, step := range steps {
				<li>{ step }</li>
			}
		</ol>
	</section>
}

templ GuideAnchorScript() {
	<script>
		(function () {
			function syncAnchoredSection() {
				document.querySelectorAll('.guide-section.is-anchored').forEach(function (section) {
					section.classList.remove('is-anchored');
				});

				var hash = window.location.hash;
				if (!hash || hash.length < 2) {
					return;
				}

				var section = document.querySelector(hash);
				if (section && section.classList.contains('guide-section')) {
					section.classList.add('is-anchored');
				}
			}

			window.addEventListener('hashchange', syncAnchoredSection);
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', syncAnchoredSection);
			} else {
				syncAnchoredSection();
			}
		})();
	</script>
}

templ GuideThemeVars() {
	<style>
		:root {
			--color-primary: #90C020;
			--color-primary-hover: #7A9F18;
			--color-muted-foreground: #6B6560;
			--color-border-subtle: #F0EDE6;
			--color-surface: #FFFFFF;
			--color-foreground: #2D2D2D;
			--color-ring: #90C020;
			--radius-lg: 12px;
			--shadow-sm: 0 1px 2px rgba(45, 45, 45, 0.06);
			--shadow-md: 0 4px 12px rgba(45, 45, 45, 0.08);
			--transition-fast: 150ms ease;
			--space-2: 8px;
			--space-3: 12px;
			--space-4: 16px;
			--space-5: 20px;
			--space-6: 24px;
			--space-8: 32px;
			--space-10: 40px;
		}
	</style>
}

templ GuideStyles() {
	<style>
		.guides-page {
			padding-bottom: var(--space-10);
		}

		.guides-hero {
			margin-bottom: var(--space-6);
			max-width: 42rem;
		}

		.guides-subtitle {
			margin-top: var(--space-2);
			color: var(--color-muted-foreground);
			font-size: 1rem;
			line-height: 1.625;
		}

		.guides-empty {
			color: var(--color-muted-foreground);
			font-size: 1rem;
			line-height: 1.625;
		}

		.guides-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
			gap: var(--space-4);
			max-width: 52rem;
		}

		.guide-card {
			display: flex;
			align-items: flex-start;
			gap: var(--space-4);
			padding: var(--space-5);
			border: 1px solid var(--color-border-subtle);
			border-radius: var(--radius-lg);
			background: var(--color-surface);
			box-shadow: var(--shadow-sm);
			text-decoration: none;
			color: inherit;
			cursor: pointer;
			position: relative;
			overflow: hidden;
			transition:
				border-color var(--transition-fast),
				box-shadow var(--transition-fast),
				transform var(--transition-fast);
		}

		.guide-card:hover {
			border-color: var(--color-primary);
			box-shadow: var(--shadow-md);
			transform: translateY(-2px);
		}

		.guide-card:focus-visible {
			outline: 2px solid var(--color-ring);
			outline-offset: 2px;
		}

		.guide-card-icon {
			flex-shrink: 0;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 44px;
			height: 44px;
			border-radius: var(--radius-md);
			background: var(--color-primary-light);
			color: var(--color-primary-hover);
		}

		.guide-card-body {
			display: flex;
			flex-direction: column;
			gap: var(--space-1);
			flex: 1;
			min-width: 0;
		}

		.guide-card-ribbon {
			position: absolute;
			top: 14px;
			right: -34px;
			width: 120px;
			padding: var(--space-1) 0;
			font-size: 0.6875rem;
			font-weight: 700;
			text-align: center;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			transform: rotate(45deg);
			box-shadow: var(--shadow-sm);
		}

		.guide-card-ribbon--teacher {
			background: var(--color-primary-light);
			color: var(--color-primary-hover);
		}

		.guide-card-ribbon--superuser {
			background: var(--color-warning-bg);
			color: #7A4E00;
		}

		.guide-card-title {
			font-size: 1.0625rem;
			font-weight: 600;
			color: var(--color-foreground);
			line-height: 1.35;
		}

		.guide-card-desc {
			font-size: 0.9375rem;
			color: var(--color-muted-foreground);
			line-height: 1.5;
		}

		.guide-card-arrow {
			flex-shrink: 0;
			display: inline-flex;
			align-items: center;
			align-self: center;
			color: var(--color-muted-foreground);
			transition: color var(--transition-fast), transform var(--transition-fast);
		}

		.guide-card:hover .guide-card-arrow {
			color: var(--color-primary-hover);
			transform: translateX(2px);
		}

		.guides-breadcrumb {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--space-2);
			margin-bottom: var(--space-4);
			font-size: 0.875rem;
			line-height: 1.5;
		}

		.guides-breadcrumb-link {
			color: var(--color-primary-hover);
			text-decoration: none;
			transition: color var(--transition-fast);
		}

		.guides-breadcrumb-link:hover {
			color: var(--color-primary);
			text-decoration: underline;
		}

		.guides-breadcrumb-sep {
			color: var(--color-muted-foreground);
		}

		.guides-breadcrumb-current {
			color: var(--color-muted-foreground);
		}

		.guide-content {
			display: flex;
			flex-direction: column;
			gap: var(--space-6);
			max-width: 48rem;
		}

		.guide-beta-card {
			position: relative;
			overflow: hidden;
			padding: var(--space-5);
			border: 1px solid var(--color-accent);
			border-radius: var(--radius-lg);
			background: var(--color-surface);
			box-shadow: var(--shadow-sm);
		}

		.guide-beta-ribbon {
			position: absolute;
			top: 14px;
			right: -34px;
			width: 120px;
			padding: var(--space-1) 0;
			background: var(--color-warning-bg);
			color: #7A4E00;
			font-size: 0.6875rem;
			font-weight: 700;
			text-align: center;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			transform: rotate(45deg);
			box-shadow: var(--shadow-sm);
		}

		.guide-beta-title {
			margin: 0;
			font-size: 1.25rem;
			line-height: 1.35;
			color: var(--color-foreground);
		}

		.guide-beta-intro {
			margin-top: var(--space-2);
			color: var(--color-muted-foreground);
			font-size: 0.9375rem;
			line-height: 1.625;
		}

		.guide-beta-list {
			margin-top: var(--space-4);
			padding-left: 1.25rem;
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
		}

		.guide-beta-list li {
			color: var(--color-foreground);
			font-size: 0.9375rem;
			line-height: 1.625;
		}

		.guide-section {
			padding: var(--space-5);
			border: 1px solid var(--color-border-subtle);
			border-radius: var(--radius-lg);
			background: var(--color-surface);
			box-shadow: var(--shadow-sm);
			scroll-margin-top: var(--space-8);
			transition:
				border-color var(--transition-base),
				box-shadow var(--transition-base);
		}

		.guide-section:target,
		.guide-section.is-anchored {
			border-color: var(--color-primary-hover);
			box-shadow:
				var(--shadow-md),
				0 0 0 3px var(--color-primary-light);
		}

		.guide-section-title {
			margin: 0;
			font-size: 1.25rem;
			line-height: 1.35;
			display: flex;
			align-items: center;
			gap: var(--space-2);
			flex-wrap: wrap;
		}

		.guide-section-anchor {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-width: 1.25rem;
			color: var(--color-muted-foreground);
			text-decoration: none;
			font-weight: 600;
			opacity: 0.55;
			transition: color var(--transition-fast), opacity var(--transition-fast);
		}

		.guide-section:hover .guide-section-anchor,
		.guide-section-anchor:focus-visible {
			color: var(--color-primary-hover);
			opacity: 1;
		}

		.guide-section-anchor:focus-visible {
			outline: 2px solid var(--color-ring);
			outline-offset: 2px;
			border-radius: var(--radius-sm);
		}

		.guide-section-link {
			display: inline-flex;
			align-items: center;
			gap: var(--space-2);
			color: var(--color-primary-hover);
			text-decoration: none;
			transition: color var(--transition-fast);
		}

		.guide-section-link:hover {
			color: var(--color-primary);
			text-decoration: underline;
		}

		.guide-section-link:focus-visible {
			outline: 2px solid var(--color-ring);
			outline-offset: 2px;
			border-radius: var(--radius-sm);
		}

		.guide-external-icon {
			display: inline-flex;
			opacity: 0.75;
		}

		.guide-section-summary {
			margin-top: var(--space-2);
			color: var(--color-muted-foreground);
			font-size: 0.9375rem;
			line-height: 1.625;
		}

		.guide-steps {
			margin-top: var(--space-4);
			padding-left: 1.25rem;
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
		}

		.guide-steps li {
			color: var(--color-foreground);
			font-size: 0.9375rem;
			line-height: 1.625;
		}

		.guides-footer-nav {
			margin-top: var(--space-8);
			max-width: 48rem;
		}

		.guides-back-link {
			display: inline-flex;
			align-items: center;
			gap: var(--space-2);
			font-size: 0.9375rem;
			font-weight: 500;
			color: var(--color-primary-hover);
			text-decoration: none;
			cursor: pointer;
			transition: color var(--transition-fast);
		}

		.guides-back-link:hover {
			color: var(--color-primary);
			text-decoration: underline;
		}

		.guides-back-link:focus-visible {
			outline: 2px solid var(--color-ring);
			outline-offset: 2px;
			border-radius: var(--radius-sm);
		}
	</style>
}

templ GuideBookIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
		<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
	</svg>
}

templ GuideArrowIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M5 12h14"></path>
		<path d="m12 5 7 7-7 7"></path>
	</svg>
}

templ GuideBackIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="m15 18-6-6 6-6"></path>
	</svg>
}

templ GuideExternalIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
		<polyline points="15 3 21 3 21 9"></polyline>
		<line x1="10" y1="14" x2="21" y2="3"></line>
	</svg>
}
