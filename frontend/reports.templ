package frontend

import "zion-english/internal/utils"

templ Reports() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Reports - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@AvatarStyles()
		<style>
			.reports-filters {
				display: contents;
			}

			.reports-teacher-cell {
				display: flex;
				align-items: center;
				gap: var(--space-2);
				min-width: 0;
			}

			.report-role-excluded {
				color: var(--color-muted-foreground);
				cursor: not-allowed;
			}
		</style>
		<script>
			window.closeReportViewModal = function () {
				const host = document.getElementById('reportViewModalHost');
				if (host) host.innerHTML = '';
				document.body.classList.remove('modal-open');
			};

			window.closeReportPaymentModal = function () {
				const host = document.getElementById('reportPaymentModalHost');
				if (host) host.innerHTML = '';
				document.body.classList.remove('modal-open');
			};

			document.body.addEventListener('htmx:afterSwap', function (evt) {
				if (evt.detail.target.id === 'reportViewModalHost') {
					document.body.classList.add('modal-open');
					const overlay = evt.detail.target.querySelector('.modal-overlay');
					const closeBtn = overlay && overlay.querySelector('.report-view-close');
					if (closeBtn) closeBtn.focus();
					return;
				}
				if (evt.detail.target.id === 'reportPaymentModalHost') {
					document.body.classList.add('modal-open');
					const overlay = evt.detail.target.querySelector('.modal-overlay');
					const closeBtn = overlay && overlay.querySelector('.report-payment-close');
					if (closeBtn) closeBtn.focus();
				}
			});

			document.body.addEventListener('click', function (e) {
				if (e.target.closest('.report-view-close')) {
					window.closeReportViewModal();
					return;
				}
				if (e.target.closest('.report-payment-close')) {
					window.closeReportPaymentModal();
					return;
				}
				const viewOverlay = e.target.closest('#reportViewModal');
				if (viewOverlay && e.target === viewOverlay) window.closeReportViewModal();
				const paymentOverlay = e.target.closest('#reportPaymentModal');
				if (paymentOverlay && e.target === paymentOverlay) window.closeReportPaymentModal();
			});

			document.addEventListener('keydown', function (e) {
				if (e.key === 'Escape' && document.getElementById('reportViewModalHost')?.innerHTML) {
					window.closeReportViewModal();
				}
				if (e.key === 'Escape' && document.getElementById('reportPaymentModalHost')?.innerHTML) {
					window.closeReportPaymentModal();
				}
			});
		</script>
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@SuccessBanner()
			@HubHeader("Reports", "", "", false)

			<div id="reportsSummaryCards" class="dashboard-stats reports-summary">
				<div class="stat-card">
					<span class="stat-label">Total Earnings</span>
					<span class="stat-sub">Loading...</span>
				</div>
			</div>

			<div class="toolbar" id="reportsToolbar">
				<div id="reportsFilters" class="reports-filters">
					<div class="form-group">
						<label for="reportSearch">Search</label>
						<input type="text" id="reportSearch" name="q" placeholder="Search teacher or student name..."/>
					</div>
					@MonthPicker("reportMonth", utils.URL("/reports/partials/date-preset"))
					@DatePreset(true)
					@ReportRolesFilterDropdown(true, false)
					@SortControls("earnings", "desc", ListSortKindReport)
					<button
						type="button"
						id="filterBtn"
						hx-get={ utils.URL("/reports/partials/rows") }
						hx-include="#reportsFilters"
						hx-target="#reportsTableBody"
						hx-swap={ HxSwapInnerHTML }
					>Filter</button>
				</div>
				<form
					method="GET"
					action={ utils.URL("/reports/summary") }
					id="reportSummaryForm"
					class="report-summary-form"
					onsubmit="syncReportSummaryForm(event)"
				>
					<input type="hidden" name="q" id="summaryQ" value=""/>
					<input type="hidden" name="datePreset" id="summaryDatePreset" value=""/>
					<input type="hidden" name="roleTeacher" id="summaryRoleTeacher" value=""/>
					<input type="hidden" name="roleAdmin" id="summaryRoleAdmin" value=""/>
					<button type="submit" class="btn">Generate Summary</button>
				</form>
			</div>

			<div class="table-wrapper">
				<table id="reportsTable" class="table-stack-mobile">
					<thead>
						<tr>
							<th>Teacher</th>
							<th>Payment status</th>
							<th>Total Classes</th>
							<th>Total Rate/Earnings</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody
						id="reportsTableBody"
						hx-get={ utils.URL("/reports/partials/rows") }
						hx-include="#reportsFilters"
						hx-trigger={ HxTriggerLoad }
						hx-swap={ HxSwapInnerHTML }
					>
						<tr>
							<td colspan="5" class="empty-state">Loading reports...</td>
						</tr>
					</tbody>
				</table>
			</div>

			<div id="reportViewModalHost"></div>
			<div id="reportPaymentModalHost"></div>
		</div>

		<script>
			const reportSearch = document.getElementById('reportSearch');

			function setDateRangeFromPreset(select) {
				if (!select) return;
				if (!select.value) {
					delete select.dataset.startDate;
					delete select.dataset.endDate;
					return;
				}
				const parts = select.value.split('|');
				if (parts.length !== 2) return;
				select.dataset.startDate = parts[0];
				select.dataset.endDate = parts[1];
			}

			function bindDatePresetSelect() {
				const datePresetSelect = document.getElementById('datePreset');
				if (!datePresetSelect) return;
				setDateRangeFromPreset(datePresetSelect);
				datePresetSelect.addEventListener('change', () => {
					setDateRangeFromPreset(datePresetSelect);
				});
			}

			bindDatePresetSelect();

			document.body.addEventListener('htmx:afterSwap', function (evt) {
				if (evt.detail.target.id !== 'datePresetGroup') return;
				bindDatePresetSelect();
				if (typeof htmx !== 'undefined') {
					htmx.trigger('#reportsTableBody', 'load');
				}
			});

			reportSearch.addEventListener('keydown', function (e) {
				if (e.key === 'Enter') {
					e.preventDefault();
					if (typeof htmx !== 'undefined') {
						htmx.trigger('#reportsTableBody', 'load');
					}
				}
			});

			window.syncReportSummaryForm = function (e) {
				const search = document.getElementById('reportSearch');
				const preset = document.getElementById('datePreset');
				const qField = document.getElementById('summaryQ');
				const presetField = document.getElementById('summaryDatePreset');
				const roleTeacher = document.querySelector('#reportsFilters input[name="roleTeacher"]');
				const roleAdmin = document.querySelector('#reportsFilters input[name="roleAdmin"]');
				const summaryRoleTeacher = document.getElementById('summaryRoleTeacher');
				const summaryRoleAdmin = document.getElementById('summaryRoleAdmin');
				if (search && qField) {
					qField.value = search.value || '';
				}
				if (preset && presetField) {
					presetField.value = preset.value || '';
				}
				if (summaryRoleTeacher) {
					summaryRoleTeacher.value = roleTeacher && roleTeacher.checked ? '1' : '';
				}
				if (summaryRoleAdmin) {
					summaryRoleAdmin.value = roleAdmin && roleAdmin.checked ? '1' : '';
				}
				if (!presetField || !presetField.value) {
					e.preventDefault();
					alert('Select a date range first.');
				}
			};
		</script>
	</body>
	</html>
}

