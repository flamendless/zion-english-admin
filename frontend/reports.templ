package frontend

import "zion-english/internal/utils"

templ Reports() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		@AdminPageHead("Reports - Zion English Admin Tool")
		@AvatarStyles()
		<style>
			.reports-filters {
				display: contents;
			}

			.reports-header-actions {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-2);
				align-items: center;
				justify-content: flex-end;
				flex-shrink: 0;
			}

			.reports-header-actions .btn,
			.reports-header-actions .add-btn {
				margin-top: 0;
				width: auto;
			}

			.hub-header > .btn,
			.hub-header > a.btn {
				margin-top: 0;
				width: auto;
				flex-shrink: 0;
			}

			.report-role-excluded {
				color: var(--color-muted-foreground);
				cursor: not-allowed;
			}
		</style>
		<script>
			window.closeReportViewModal = function () {
				const host = document.getElementById('reportViewModalHost');
				if (host) host.innerHTML = '';
				document.body.classList.remove('modal-open');
			};

			window.closeReportPaymentModal = function () {
				const host = document.getElementById('reportPaymentModalHost');
				if (host) host.innerHTML = '';
				document.body.classList.remove('modal-open');
			};

			window.closeReportSummaryModal = function () {
				const modal = document.getElementById('reportSummaryModal');
				if (modal) modal.hidden = true;
				document.body.classList.remove('modal-open');
			};

			function initReportsModalUI() {
				if (!document.body) return;
				document.body.addEventListener('htmx:afterSwap', function (evt) {
					if (evt.detail.target.id === 'reportViewModalHost') {
						document.body.classList.add('modal-open');
						const overlay = evt.detail.target.querySelector('.modal-overlay');
						const closeBtn = overlay && overlay.querySelector('.report-view-close');
						if (closeBtn) closeBtn.focus();
						return;
					}
					if (evt.detail.target.id === 'reportPaymentModalHost') {
						document.body.classList.add('modal-open');
						const overlay = evt.detail.target.querySelector('.modal-overlay');
						const closeBtn = overlay && overlay.querySelector('.report-payment-close');
						if (closeBtn) closeBtn.focus();
					}
				});

				document.body.addEventListener('click', function (e) {
					if (e.target.closest('.report-view-close')) {
						window.closeReportViewModal();
						return;
					}
					if (e.target.closest('.report-payment-close')) {
						window.closeReportPaymentModal();
						return;
					}
					if (e.target.closest('[data-open-report-summary-modal]')) {
						if (typeof window.openReportSummaryModal === 'function') {
							window.openReportSummaryModal();
						}
						return;
					}
					if (e.target.closest('.report-summary-close')) {
						window.closeReportSummaryModal();
						return;
					}
					const viewOverlay = e.target.closest('#reportViewModal');
					if (viewOverlay && e.target === viewOverlay) window.closeReportViewModal();
					const paymentOverlay = e.target.closest('#reportPaymentModal');
					if (paymentOverlay && e.target === paymentOverlay) window.closeReportPaymentModal();
					const summaryOverlay = e.target.closest('#reportSummaryModal');
					if (summaryOverlay && e.target === summaryOverlay) window.closeReportSummaryModal();
				});
			}

			if (document.body) {
				initReportsModalUI();
			} else {
				document.addEventListener('DOMContentLoaded', initReportsModalUI);
			}

			document.addEventListener('keydown', function (e) {
				if (e.key === 'Escape' && document.getElementById('reportViewModalHost')?.innerHTML) {
					window.closeReportViewModal();
				}
				if (e.key === 'Escape' && document.getElementById('reportPaymentModalHost')?.innerHTML) {
					window.closeReportPaymentModal();
				}
				const summaryModal = document.getElementById('reportSummaryModal');
				if (e.key === 'Escape' && summaryModal && !summaryModal.hidden) {
					window.closeReportSummaryModal();
				}
			});
		</script>
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@SuccessBanner()
			<div class="hub-header">
				<h2 class="hub-title">Reports</h2>
				<div class="reports-header-actions">
					<a href={ utils.URL("/reports/history") } class="btn btn-secondary">View History</a>
					<a href={ utils.URL("/payments") } class="btn btn-secondary">View Payment History</a>
					<button type="button" class="add-btn" data-open-report-summary-modal>Generate Summary</button>
				</div>
			</div>

			<div id="reportsSummaryCards" class="dashboard-stats reports-summary">
				<div class="stat-card">
					<span class="stat-label">Total Earnings</span>
					<span class="stat-sub">Loading...</span>
				</div>
			</div>

			<div class="toolbar" id="reportsToolbar">
				<div id="reportsFilters" class="reports-filters">
					<div class="form-group">
						<label for="reportSearch">Search</label>
						<input type="text" id="reportSearch" name="q" placeholder="Search teacher or student name..."/>
					</div>
					@MonthPicker("reportMonth", utils.URL("/reports/partials/date-preset"))
					@DatePreset(true)
					@ReportRolesFilterDropdown(true, false)
					@SortControls("earnings", "desc", ListSortKindReport)
					<input type="hidden" id="reportsPage" name="page" value="1"/>
					@DataListViewToggle()
					<button
						type="button"
						id="filterBtn"
						hx-get={ utils.URL("/reports/partials/rows") }
						hx-include="#reportsFilters"
						hx-target="#reportsTableBody"
						hx-swap={ HxSwapInnerHTML }
					>Filter</button>
					@CutoffLegend()
				</div>
			</div>

			<div class="table-wrapper data-list-view-root">
				<table id="reportsTable" class="table-stack-mobile">
					<thead>
						<tr>
							<th>Teacher</th>
							<th>Payment status</th>
							<th>Total Classes</th>
							<th>Total Rate/Earnings</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody
						id="reportsTableBody"
						data-loading-label="Loading reports..."
						hx-get={ utils.URL("/reports/partials/rows") }
						hx-include="#reportsFilters"
						hx-trigger={ HxTriggerLoad }
						hx-swap={ HxSwapInnerHTML }
					>
						@TableBodyLoadingRow(5, "Loading reports...")
					</tbody>
				</table>
			</div>

			<div id="paginationBottom" class="pagination-bar"></div>

			<div id="reportViewModalHost"></div>
			<div id="reportPaymentModalHost"></div>
			@ReportSummaryModal()
		</div>

		<script>
			function setDateRangeFromPreset(select) {
				if (!select) return;
				if (!select.value) {
					delete select.dataset.startDate;
					delete select.dataset.endDate;
					return;
				}
				const parts = select.value.split('|');
				if (parts.length !== 2) return;
				select.dataset.startDate = parts[0];
				select.dataset.endDate = parts[1];
			}

			let toolbarDatePresetBound = false;
			function bindDatePresetSelect() {
				const datePresetSelect = document.getElementById('datePreset');
				if (!datePresetSelect || toolbarDatePresetBound) return;
				toolbarDatePresetBound = true;
				setDateRangeFromPreset(datePresetSelect);
				datePresetSelect.addEventListener('change', () => {
					setDateRangeFromPreset(datePresetSelect);
				});
			}

			let summaryDatePresetBound = false;
			function bindSummaryDatePresetSelect() {
				const datePresetSelect = document.getElementById('summaryDatePreset');
				if (!datePresetSelect) return;
				setDateRangeFromPreset(datePresetSelect);
				if (summaryDatePresetBound) return;
				summaryDatePresetBound = true;
				datePresetSelect.addEventListener('change', () => {
					setDateRangeFromPreset(datePresetSelect);
				});
			}

			window.validateReportSummaryForm = function (e) {
				const presetField = document.getElementById('summaryDatePreset');
				if (!presetField || !presetField.value) {
					e.preventDefault();
					alert('Select a date range first.');
					return false;
				}
				return true;
			};

			window.openReportSummaryModal = function () {
				const modal = document.getElementById('reportSummaryModal');
				if (!modal) return;
				const toolbarMonth = document.getElementById('reportMonth');
				const summaryMonth = document.getElementById('summaryReportMonth');
				const toolbarPreset = document.getElementById('datePreset');
				let monthChanged = false;
				if (toolbarMonth && summaryMonth) {
					monthChanged = toolbarMonth.value !== summaryMonth.value;
					summaryMonth.value = toolbarMonth.value;
				}
				const applyPresetAndRoles = function () {
					const summaryPreset = document.getElementById('summaryDatePreset');
					if (toolbarPreset && summaryPreset && toolbarPreset.value) {
						summaryPreset.value = toolbarPreset.value;
						setDateRangeFromPreset(summaryPreset);
					}
					const srcTeacher = document.querySelector('#reportsFilters input[name="roleTeacher"]');
					const srcAdmin = document.querySelector('#reportsFilters input[name="roleAdmin"]');
					const dstTeacher = document.querySelector('#reportSummaryForm input[name="roleTeacher"]');
					const dstAdmin = document.querySelector('#reportSummaryForm input[name="roleAdmin"]');
					if (srcTeacher && dstTeacher) dstTeacher.checked = srcTeacher.checked;
					if (srcAdmin && dstAdmin) dstAdmin.checked = srcAdmin.checked;
				};
				if (monthChanged && summaryMonth) {
					window._reportSummaryPrefillAfterSwap = applyPresetAndRoles;
					summaryMonth.dispatchEvent(new Event('change', { bubbles: true }));
				} else {
					applyPresetAndRoles();
					bindSummaryDatePresetSelect();
				}
				modal.hidden = false;
				document.body.classList.add('modal-open');
				const closeBtn = modal.querySelector('.report-summary-close');
				if (closeBtn) closeBtn.focus();
			};

			bindDatePresetSelect();
			bindSummaryDatePresetSelect();

			document.body.addEventListener('htmx:afterSwap', function (evt) {
				if (evt.detail.target.id === 'datePresetGroup') {
					toolbarDatePresetBound = false;
					bindDatePresetSelect();
					const reportsPage = document.getElementById('reportsPage');
					if (reportsPage) reportsPage.value = '1';
					if (typeof htmx !== 'undefined') {
						htmx.trigger('#reportsTableBody', 'load');
					}
					return;
				}
				if (evt.detail.target.id === 'summaryDatePresetGroup') {
					summaryDatePresetBound = false;
					bindSummaryDatePresetSelect();
					if (typeof window._reportSummaryPrefillAfterSwap === 'function') {
						window._reportSummaryPrefillAfterSwap();
						window._reportSummaryPrefillAfterSwap = null;
					}
				}
			});

			const filterBtn = document.getElementById('filterBtn');
			const reportsPage = document.getElementById('reportsPage');
			if (filterBtn) {
				filterBtn.addEventListener('click', function () {
					if (reportsPage) reportsPage.value = '1';
				});
			}

			const reportSearch = document.getElementById('reportSearch');
			if (reportSearch) {
				reportSearch.addEventListener('keydown', function (e) {
					if (e.key === 'Enter') {
						e.preventDefault();
						if (reportsPage) reportsPage.value = '1';
						if (typeof htmx !== 'undefined') {
							htmx.trigger('#reportsTableBody', 'load');
						}
					}
				});
			}

			document.body.addEventListener('click', function (e) {
				const pageBtn = e.target.closest('#paginationBottom .pagination-btn[hx-get]');
				if (!pageBtn || !reportsPage) return;
				const vals = pageBtn.getAttribute('hx-vals');
				if (!vals) return;
				try {
					const parsed = JSON.parse(vals.replace(/'/g, '"'));
					if (parsed.page) reportsPage.value = String(parsed.page);
				} catch (err) { /* ignore */ }
			});

		</script>
	@LayoutEnd()
	</body>
	</html>
}

