package frontend

import "zion-english/internal/utils"

templ Landing() {
	<!DOCTYPE html>
	<html lang="en" class="landing-html">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Zion English — Admin Portal</title>
		<meta name="description" content="The admin portal for Zion English teachers and administrators. Manage students, classes, schedules, and payroll in one place."/>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet"/>
		@LandingStyles()
	</head>
	<body class="landing-page">
		<div class="landing-bg" aria-hidden="true">
			<div class="landing-orb landing-orb--green"></div>
			<div class="landing-orb landing-orb--blue"></div>
			<div class="landing-orb landing-orb--coral"></div>
			<div class="landing-orb landing-orb--amber"></div>
		</div>

		<header class="landing-nav reveal" data-reveal="fade-down">
			<a href={ utils.URL("/") } class="landing-nav__brand">
				<img src={ utils.URL("/static/logo.png") } alt="Zion English" class="landing-nav__logo"/>
				<span>Zion English</span>
			</a>
			<nav class="landing-nav__links" aria-label="Primary">
				<a href="#features" class="landing-nav__link">Features</a>
				<a href={ utils.URL("/auth/login") } class="landing-btn landing-btn--primary landing-btn--sm">Sign in</a>
			</nav>
		</header>

		<main>
			<section class="landing-hero">
				<div class="landing-hero__content">
					<p class="landing-eyebrow reveal" data-reveal="fade-up" data-delay="0">Admin portal</p>
					<h1 class="landing-hero__title reveal" data-reveal="fade-up" data-delay="80">
						Run your English classes with clarity and confidence
					</h1>
					<p class="landing-hero__subtitle reveal" data-reveal="fade-up" data-delay="160">
						Schedule lessons, track students, process class sheets, and keep your teaching operations organized — all in one dedicated workspace for Zion English.
					</p>
					<div class="landing-hero__actions reveal" data-reveal="fade-up" data-delay="240">
						<a href={ utils.URL("/auth/login") } class="landing-btn landing-btn--primary">Sign in to dashboard</a>
					</div>
				</div>
				<div class="landing-hero__panel reveal" data-reveal="fade-left" data-delay="320">
					<div class="landing-glass landing-glass--hero">
						<div class="landing-stat">
							<span class="landing-stat__value">Students</span>
							<span class="landing-stat__label">Manage profiles, rates, and status</span>
						</div>
						<div class="landing-stat">
							<span class="landing-stat__value">Classes</span>
							<span class="landing-stat__label">Record conducted, cancelled, and rescheduled</span>
						</div>
						<div class="landing-stat">
							<span class="landing-stat__value">Sheets</span>
							<span class="landing-stat__label">Process Google Drive exports to payroll</span>
						</div>
						<div class="landing-stat landing-stat--accent">
							<span class="landing-stat__value">Schedule</span>
							<span class="landing-stat__label">See what's on today at a glance</span>
						</div>
					</div>
				</div>
			</section>

			<section id="features" class="landing-features">
				<div class="landing-section-header reveal" data-reveal="fade-up">
					<p class="landing-eyebrow">Built for teachers &amp; admins</p>
					<h2>Everything you need to stay on top of teaching ops</h2>
					<p class="landing-section-header__desc">
						A focused toolkit for day-to-day work — no clutter, no guesswork.
					</p>
				</div>
				<div class="landing-features__grid">
					@LandingFeatureCard(
						"students",
						"Student management",
						"Register students, assign teachers, track active and inactive status, and keep contact details in one place.",
						0,
					)
					@LandingFeatureCard(
						"calendar",
						"Scheduling & classes",
						"View your schedule, record class outcomes, and monitor weekly conducted, cancelled, and rescheduled totals.",
						80,
					)
					@LandingFeatureCard(
						"sheet",
						"Sheet processing",
						"Import class data from Google Drive spreadsheets and generate payroll-ready exports automatically.",
						160,
					)
					@LandingFeatureCard(
						"shield",
						"Role-based access",
						"Teachers see their students and classes. Superusers manage the full organization with audit logs.",
						240,
					)
				</div>
			</section>

			<section class="landing-cta reveal" data-reveal="scale-up">
				<div class="landing-glass landing-glass--cta">
					<h2>Ready to get started?</h2>
					<p>Sign in to your dashboard to manage students, classes, and schedules.</p>
					<div class="landing-cta__actions">
						<a href={ utils.URL("/auth/login") } class="landing-btn landing-btn--primary">Sign in</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="landing-footer reveal" data-reveal="fade-up">
			<div class="landing-footer__inner">
				<a href={ utils.URL("/") } class="landing-footer__brand">
					<img src={ utils.URL("/static/logo.png") } alt="Zion English" class="landing-footer__logo"/>
				</a>
				<div class="landing-footer__partner">
					<div class="landing-footer__meta">
						<p class="landing-footer__credit">
							made by
							<a href="https://innova-tech.services" target="_blank" rel="noopener noreferrer">InnovaTech</a>
						</p>
						<div class="landing-footer__links">
							<a href="https://innova-tech.services" target="_blank" rel="noopener noreferrer" class="landing-footer__link">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.47.732-3.565"/>
								</svg>
								Website
							</a>
							<a href="https://www.facebook.com/profile.php?id=61584134420643" target="_blank" rel="noopener noreferrer" class="landing-footer__link">
								<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
								</svg>
								Facebook
							</a>
						</div>
					</div>
					<a href="https://innova-tech.services" target="_blank" rel="noopener noreferrer" class="landing-footer__partner-logo">
						<img src={ utils.URL("/static/innovatech-logo.png") } alt="InnovaTech" class="landing-footer__partner-logo-img"/>
					</a>
				</div>
			</div>
		</footer>

		@LandingRevealScript()
	</body>
	</html>
}

templ LandingFeatureCard(icon string, title string, desc string, delay int) {
	<article class="landing-feature reveal" data-reveal="fade-up" data-delay={ delay }>
		<div class="landing-feature__icon" aria-hidden="true">
			switch icon {
				case "students":
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/>
					</svg>
				case "calendar":
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/>
					</svg>
				case "sheet":
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
					</svg>
				default:
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/>
					</svg>
			}
		</div>
		<h3>{ title }</h3>
		<p>{ desc }</p>
	</article>
}

templ LandingStyles() {
	<style>
		.landing-html {
			scroll-behavior: smooth;
		}

		.landing-page {
			--lp-primary: #90C020;
			--lp-primary-dark: #7A9F18;
			--lp-secondary: #20A0E0;
			--lp-tertiary: #F06060;
			--lp-amber: #F0B030;
			--lp-bg: #FAFAF7;
			--lp-fg: #2D2D2D;
			--lp-muted: #6B6560;
			--lp-glass: rgba(255, 255, 255, 0.55);
			--lp-glass-border: rgba(255, 255, 255, 0.65);
			--lp-shadow: 0 8px 32px rgba(45, 45, 45, 0.08);

			min-height: 100vh;
			font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			color: var(--lp-fg);
			background: var(--lp-bg);
			overflow-x: hidden;
			position: relative;
		}

		/* Landing page always plays reveal animations, regardless of OS motion settings. */
		@media (prefers-reduced-motion: reduce) {
			.landing-page *,
			.landing-page *::before,
			.landing-page *::after {
				animation-duration: revert !important;
				animation-iteration-count: revert !important;
				transition-duration: revert !important;
			}
		}

		.landing-page h1,
		.landing-page h2,
		.landing-page h3 {
			font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			font-weight: 600;
			line-height: 1.2;
		}

		.landing-bg {
			position: fixed;
			inset: 0;
			z-index: 0;
			pointer-events: none;
			overflow: hidden;
		}

		.landing-orb {
			position: absolute;
			border-radius: 50%;
			filter: blur(80px);
			opacity: 0.45;
			animation: landing-float 18s ease-in-out infinite;
		}

		.landing-orb--green {
			width: 420px;
			height: 420px;
			background: var(--lp-primary);
			top: -120px;
			right: -80px;
		}

		.landing-orb--blue {
			width: 360px;
			height: 360px;
			background: var(--lp-secondary);
			bottom: 10%;
			left: -100px;
			animation-delay: -6s;
		}

		.landing-orb--coral {
			width: 280px;
			height: 280px;
			background: var(--lp-tertiary);
			top: 40%;
			right: 15%;
			animation-delay: -12s;
		}

		.landing-orb--amber {
			width: 200px;
			height: 200px;
			background: var(--lp-amber);
			bottom: -60px;
			right: 30%;
			animation-delay: -3s;
		}

		@keyframes landing-float {
			0%, 100% { transform: translate(0, 0) scale(1); }
			33% { transform: translate(24px, -18px) scale(1.04); }
			66% { transform: translate(-16px, 12px) scale(0.96); }
		}

		.landing-nav {
			position: relative;
			z-index: 10;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 24px;
			max-width: 1120px;
			margin: 0 auto;
			padding: 24px 24px 0;
		}

		.landing-nav__brand {
			display: flex;
			align-items: center;
			gap: 12px;
			text-decoration: none;
			color: var(--lp-fg);
			font-family: 'Poppins', sans-serif;
			font-weight: 600;
			font-size: 1.05rem;
		}

		.landing-nav__logo {
			height: 40px;
			width: auto;
		}

		.landing-nav__links {
			display: flex;
			align-items: center;
			gap: 20px;
		}

		.landing-nav__link {
			color: var(--lp-muted);
			text-decoration: none;
			font-size: 0.95rem;
			font-weight: 500;
			transition: color 200ms ease;
		}

		.landing-nav__link:hover {
			color: var(--lp-fg);
		}

		.landing-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 14px 28px;
			border-radius: 10px;
			font-family: 'Poppins', sans-serif;
			font-weight: 600;
			font-size: 0.95rem;
			text-decoration: none;
			cursor: pointer;
			border: 1px solid transparent;
			transition: transform 200ms ease, box-shadow 200ms ease, background 200ms ease, color 200ms ease, border-color 200ms ease;
		}

		.landing-btn:hover {
			transform: translateY(-2px);
		}

		.landing-btn--sm {
			padding: 10px 20px;
			font-size: 0.875rem;
		}

		.landing-btn--primary {
			background: var(--lp-primary);
			color: #fff;
			box-shadow: 0 4px 14px rgba(144, 192, 32, 0.35);
		}

		.landing-btn--primary:hover {
			background: var(--lp-primary-dark);
			box-shadow: 0 6px 20px rgba(144, 192, 32, 0.4);
		}

		.landing-btn--ghost {
			background: var(--lp-glass);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			border-color: var(--lp-glass-border);
			color: var(--lp-fg);
		}

		.landing-btn--ghost:hover {
			background: rgba(255, 255, 255, 0.75);
		}

		.landing-btn--outline {
			background: transparent;
			border-color: rgba(45, 45, 45, 0.2);
			color: var(--lp-fg);
		}

		.landing-btn--outline:hover {
			border-color: var(--lp-primary);
			color: var(--lp-primary-dark);
		}

		.landing-hero {
			position: relative;
			z-index: 1;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 48px;
			align-items: center;
			max-width: 1120px;
			margin: 0 auto;
			padding: 72px 24px 96px;
		}

		.landing-eyebrow {
			display: inline-block;
			font-size: 0.8rem;
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--lp-primary-dark);
			margin-bottom: 16px;
		}

		.landing-hero__title {
			font-size: clamp(2.25rem, 5vw, 3.25rem);
			margin-bottom: 20px;
			letter-spacing: -0.02em;
		}

		.landing-hero__subtitle {
			font-size: 1.125rem;
			line-height: 1.7;
			color: var(--lp-muted);
			max-width: 520px;
			margin-bottom: 32px;
		}

		.landing-hero__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 14px;
		}

		.landing-glass {
			background: var(--lp-glass);
			backdrop-filter: blur(16px);
			-webkit-backdrop-filter: blur(16px);
			border: 1px solid var(--lp-glass-border);
			border-radius: 20px;
			box-shadow: var(--lp-shadow);
		}

		.landing-glass--hero {
			padding: 28px;
			display: grid;
			gap: 16px;
		}

		.landing-stat {
			padding: 18px 20px;
			border-radius: 12px;
			background: rgba(255, 255, 255, 0.5);
			border: 1px solid rgba(255, 255, 255, 0.6);
		}

		.landing-stat--accent {
			background: rgba(144, 192, 32, 0.12);
			border-color: rgba(144, 192, 32, 0.25);
		}

		.landing-stat__value {
			display: block;
			font-family: 'Poppins', sans-serif;
			font-weight: 600;
			font-size: 1.05rem;
			margin-bottom: 4px;
		}

		.landing-stat__label {
			font-size: 0.875rem;
			color: var(--lp-muted);
			line-height: 1.5;
		}

		.landing-features {
			position: relative;
			z-index: 1;
			max-width: 1120px;
			margin: 0 auto;
			padding: 0 24px 96px;
		}

		.landing-section-header {
			text-align: center;
			max-width: 640px;
			margin: 0 auto 56px;
		}

		.landing-section-header h2 {
			font-size: clamp(1.75rem, 4vw, 2.5rem);
			margin-bottom: 16px;
			letter-spacing: -0.02em;
		}

		.landing-section-header__desc {
			color: var(--lp-muted);
			font-size: 1.05rem;
			line-height: 1.6;
		}

		.landing-features__grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 24px;
		}

		.landing-feature {
			padding: 32px;
			border-radius: 16px;
			background: var(--lp-glass);
			backdrop-filter: blur(14px);
			-webkit-backdrop-filter: blur(14px);
			border: 1px solid var(--lp-glass-border);
			box-shadow: var(--lp-shadow);
			transition: transform 250ms ease, box-shadow 250ms ease;
		}

		.landing-feature:hover {
			transform: translateY(-4px);
			box-shadow: 0 12px 40px rgba(45, 45, 45, 0.1);
		}

		.landing-feature__icon {
			width: 48px;
			height: 48px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 12px;
			background: rgba(144, 192, 32, 0.15);
			color: var(--lp-primary-dark);
			margin-bottom: 20px;
		}

		.landing-feature__icon svg {
			width: 24px;
			height: 24px;
		}

		.landing-feature h3 {
			font-size: 1.15rem;
			margin-bottom: 10px;
		}

		.landing-feature p {
			color: var(--lp-muted);
			line-height: 1.65;
			font-size: 0.95rem;
		}

		.landing-cta {
			position: relative;
			z-index: 1;
			max-width: 800px;
			margin: 0 auto;
			padding: 0 24px 96px;
		}

		.landing-glass--cta {
			padding: 56px 48px;
			text-align: center;
		}

		.landing-glass--cta h2 {
			font-size: clamp(1.5rem, 3vw, 2rem);
			margin-bottom: 12px;
		}

		.landing-glass--cta p {
			color: var(--lp-muted);
			line-height: 1.65;
			max-width: 520px;
			margin: 0 auto 28px;
		}

		.landing-cta__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 14px;
			justify-content: center;
		}

		.landing-footer {
			position: relative;
			z-index: 1;
			padding: 32px 24px 40px;
			border-top: 1px solid rgba(45, 45, 45, 0.08);
		}

		.landing-footer__inner {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 24px;
			max-width: 1120px;
			margin: 0 auto;
		}

		.landing-footer__brand {
			display: flex;
			align-items: center;
			flex-shrink: 0;
		}

		.landing-footer__logo {
			height: 36px;
			width: auto;
		}

		.landing-footer__partner {
			display: flex;
			align-items: center;
			gap: 20px;
		}

		.landing-footer__meta {
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			gap: 10px;
		}

		.landing-footer__credit {
			color: var(--lp-muted);
			font-size: 0.875rem;
			margin: 0;
		}

		.landing-footer__credit a {
			color: var(--lp-fg);
			font-weight: 600;
			text-decoration: none;
			transition: color 200ms ease;
		}

		.landing-footer__credit a:hover {
			color: var(--lp-primary-dark);
		}

		.landing-footer__links {
			display: flex;
			align-items: center;
			gap: 16px;
		}

		.landing-footer__link {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			color: var(--lp-muted);
			font-size: 0.8125rem;
			font-weight: 500;
			text-decoration: none;
			transition: color 200ms ease;
		}

		.landing-footer__link svg {
			width: 16px;
			height: 16px;
			flex-shrink: 0;
		}

		.landing-footer__link:hover {
			color: var(--lp-primary-dark);
		}

		.landing-footer__partner-logo {
			display: flex;
			align-items: center;
			flex-shrink: 0;
			opacity: 0.92;
			transition: opacity 200ms ease;
		}

		.landing-footer__partner-logo:hover {
			opacity: 1;
		}

		.landing-footer__partner-logo-img {
			height: 40px;
			width: auto;
			display: block;
		}

		/* Reveal animations */
		.reveal {
			opacity: 0;
			transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
			            transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
			will-change: opacity, transform;
		}

		.reveal[data-reveal="fade-up"] {
			transform: translateY(32px);
		}

		.reveal[data-reveal="fade-down"] {
			transform: translateY(-24px);
		}

		.reveal[data-reveal="fade-left"] {
			transform: translateX(40px);
		}

		.reveal[data-reveal="scale-up"] {
			transform: scale(0.94);
		}

		.reveal.is-visible {
			opacity: 1;
			transform: none;
		}

		@media (max-width: 900px) {
			.landing-hero {
				grid-template-columns: 1fr;
				padding-top: 48px;
			}

			.landing-hero__panel {
				order: -1;
			}

			.landing-features__grid {
				grid-template-columns: 1fr;
			}

			.landing-nav__links .landing-nav__link:first-child {
				display: none;
			}
		}

		@media (max-width: 480px) {
			.landing-nav {
				padding-top: 16px;
			}

			.landing-nav__brand span {
				display: none;
			}

			.landing-hero__actions,
			.landing-cta__actions {
				flex-direction: column;
				width: 100%;
			}

			.landing-btn {
				width: 100%;
			}

			.landing-glass--cta {
				padding: 40px 24px;
			}

			.landing-footer__inner {
				flex-direction: column;
				align-items: flex-start;
			}

			.landing-footer__partner {
				flex-direction: column;
				align-items: flex-start;
				width: 100%;
			}

			.landing-footer__meta {
				align-items: flex-start;
			}
		}
	</style>
}

templ LandingRevealScript() {
	<script>
		(function () {
			var reveals = document.querySelectorAll('.reveal');
			if (!reveals.length) return;

			var observer = new IntersectionObserver(function (entries) {
				entries.forEach(function (entry) {
					if (!entry.isIntersecting) return;
					var el = entry.target;
					var delay = parseInt(el.getAttribute('data-delay') || '0', 10);
					setTimeout(function () {
						el.classList.add('is-visible');
					}, delay);
					observer.unobserve(el);
				});
			}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

			reveals.forEach(function (el) { observer.observe(el); });
		})();
	</script>
}
