package frontend

import "zion-english/internal/utils"

templ TeacherDropdownWithValue(selectedID string) {
	<div class="form-group">
		<label for="teacher">Teacher *</label>
		<select id="teacher" name="teacher" required
			hx-get={ utils.URL("/api/teachers?selected=" + selectedID) }
			hx-trigger="load"
			hx-swap="innerHTML"
			hx-target="this"
		>
			<option value="">-- Select Teacher --</option>
		</select>
	</div>
}

