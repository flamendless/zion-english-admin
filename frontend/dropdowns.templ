templ TeacherAssignRow(selectedID string, selectedName string, rowKey string, removable bool) {
	<div class="teacher-assign-row">
		@TeacherSearch(TeacherSearchParams{
			InputID:      "teacherSearch_" + rowKey,
			HiddenID:     "teacher_" + rowKey,
			HiddenName:   "teachers",
			ResultsID:    "teacherSearchResults_" + rowKey,
			Placeholder:  "Search teacher...",
			Required:     true,
			SelectedID:   selectedID,
			SelectedName: selectedName,
		})
		if removable {
			<button type="button" class="teacher-assign-remove" data-tooltip="Remove assigned teacher" aria-label="Remove assigned teacher"
				_="on click
					if #teacherRows.children.length > 1
						remove closest .teacher-assign-row
					end
				"
			>−</button>
		}
	</div>
}

templ TeacherAssignRows(selectedIDs []string, selectedNames []string) {
	<div class="form-group teacher-assign">
		@AdminOnlyFieldLabel("Assigned Teachers *")
		<div id="teacherRows" class="teacher-assign-rows">
			if len(selectedIDs) == 0 {
				@TeacherAssignRow("", "", "0", false)
			} else {
				for i, id := range selectedIDs {
					@TeacherAssignRow(id, selectedNames[i], fmt.Sprintf("%d", i), i > 0 || len(selectedIDs) > 1)
				}
			}
		</div>
		<div class="teacher-assign-add-row">
			<button type="button" class="teacher-assign-add" data-tooltip="Assign to another teacher" aria-label="Assign to another teacher"
				hx-get={ utils.URL("/api/teacher-row") }
				hx-target="#teacherRows"
				hx-swap="beforeend"
			>+</button>
			<span class="teacher-assign-add-label">Assign to another teacher</span>
		</div>
	</div>
}

var letters = []string{"A", "B", "C", "D", "E", "F", "G", "H"}
templ Letters(id string, text string, initial string) {
	<div class="form-group">
		<label for={ id }>{ text }</label>
		<select id={ id } name={ id } required>
			for _, letter := range letters {
				<option value={ letter } selected?={ letter == initial }>{  letter }</option>
			}
		</select>
		{ children... }
	</div>
}
