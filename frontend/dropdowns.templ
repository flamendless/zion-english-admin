templ StudentSearchbox() {
	<div class="form-group entity-search student-search">
		<label for="relatedStudentSearch">Student name related with</label>
		<input
			type="text"
			id="relatedStudentSearch"
			name="studentQ"
			autocomplete="off"
			placeholder="Search by name or legal name..."
			hx-get={ utils.URL("/api/students/search") }
			hx-trigger={ HxTriggerInputDelay }
			hx-target="#relatedStudentResults"
			hx-include="this"
		/>
		<input type="hidden" id="relatedStudentId" name="relatedStudentId"/>
		<div id="relatedStudentResults"></div>
	</div>
}

templ ParentCurrencyDropdownWithValue(selected string) {
	<div class="form-group">
		@AdminOnlyFormLabel("parentCurrency", "Parent Currency")
		<select id="parentCurrency" name="parentCurrency">
			<option value="" selected?={ selected == "" }>-- None --</option>
			<option value="KRW" selected?={ selected == "KRW" }>KRW (Korean Won)</option>
			<option value="CAD" selected?={ selected == "CAD" }>CAD (Canadian Dollar)</option>
			<option value="YEN" selected?={ selected == "YEN" }>YEN (Japanese Yen)</option>
			<option value="PHP" selected?={ selected == "PHP" }>PHP (Philippine Peso)</option>
		</select>
	</div>
}

templ NationalityDropdownWithValue(options []NationalityOption, selected string) {
	<div class="form-group nationality-field">
		<label for="nationalityId">Nationality</label>
		<div class="nationality-select-row">
			@NationalityFlagPreview(selected)
			<select
				id="nationalityId"
				name="nationalityId"
				class="nationality-select"
				hx-get={ utils.URL("/partials/nationality-flag") }
				hx-trigger="change"
				hx-target="#nationalityFlagPreview"
				hx-swap={ HxSwapOuterHTML }
				hx-include="#nationalityId"
			>
				<option value="" selected?={ selected == "" }>Not set</option>
				for _, opt := range options {
					<option value={ opt.ID } selected?={ selected == opt.ID }>{ opt.CountryName }</option>
				}
			</select>
		</div>
		<p class="field-hint">Optional. Shown on the student avatar and name across the app.</p>
	</div>
	<style>
		.nationality-select-row {
			display: flex;
			align-items: center;
			gap: var(--space-2);
		}
		.nationality-flag-preview-host {
			flex-shrink: 0;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			line-height: 0;
		}
		.nationality-flag-preview-host .nationality-flag-preview,
		.nationality-flag-preview-host svg {
			width: 28px;
			height: 20px;
			border-radius: 2px;
			border: var(--pill-border);
			display: block;
			background: var(--color-muted);
		}
		.nationality-flag-preview--empty {
			display: inline-block;
			width: 28px;
			height: 20px;
			background: var(--color-muted);
			border-radius: 2px;
			border: var(--pill-border);
		}
		.nationality-select {
			flex: 1;
			min-width: 0;
		}
		.nationality-display {
			display: inline-flex;
			align-items: center;
			gap: var(--space-2);
		}
		.nationality-display svg {
			width: 24px;
			height: 16px;
			border-radius: 2px;
			border: var(--pill-border);
			flex-shrink: 0;
			display: block;
			background: var(--color-muted);
		}
	</style>
}

templ NationalityDisplay(opt NationalityOption) {
	<span class="nationality-display">
		@NationalityFlag(opt.ID, "nationality-flag-inline")
		<span>{ opt.CountryName }</span>
	</span>
}

