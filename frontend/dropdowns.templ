templ ScheduleEditStudentDropdown(teacherID string, studentID string) {
	<div class="form-group">
		<label for="schedule_student">Student *</label>
		<select id="schedule_student" name="schedule_student" required
			hx-get={ utils.URL("/api/students?teacher=" + teacherID + "&selected=" + studentID) }
			hx-trigger="load"
			hx-swap="innerHTML"
			hx-target="this"
		>
			<option value="">-- Select Student --</option>
		</select>
	</div>
}

templ StudentSearchbox() {
	<div class="form-group student-search">
		<label for="relatedStudentSearch">Existing Student</label>
		<input
			type="text"
			id="relatedStudentSearch"
			name="q"
			autocomplete="off"
			placeholder="Search registered student..."
			hx-get={ utils.URL("/api/students/search") }
			hx-trigger="input changed delay:300ms"
			hx-target="#relatedStudentResults"
			hx-include="this"
		/>
		<input type="hidden" id="relatedStudentId" name="relatedStudentId"/>
		<div id="relatedStudentResults"></div>
	</div>
}

templ CurrencyDropdownWithValue(selected string) {
	<div class="form-group">
		<label for="currency">Currency *</label>
		<select id="currency" name="currency" required>
			<option value="KRW" selected?={ selected == "KRW" }>KRW (Korean Won)</option>
			<option value="CAD" selected?={ selected == "CAD" }>CAD (Canadian Dollar)</option>
			<option value="YEN" selected?={ selected == "YEN" }>YEN (Japanese Yen)</option>
			<option value="PHP" selected?={ selected == "PHP" }>PHP (Philippine Peso)</option>
		</select>
	</div>
}

templ ClassesStatusFilterDropdown() {
	<div class="form-group">
		<label for="statusFilter">Status</label>
		<select id="statusFilter" name="status">
			<option value="">All</option>
			for _, opt := range ClassListFilterOptions {
				<option value={ opt.Value }>{ opt.Label }</option>
			}
		</select>
	</div>
}

templ ClassStatusDropdownWithValue(selected string) {
	<div class="form-group">
		<label for="status">Status *</label>
		<select id="status" name="status" required>
			for _, opt := range ClassRecordStatusOptions {
				<option value={ opt.Value } selected?={ selected == opt.Value }>{ opt.Label }</option>
			}
		</select>
	</div>
}

templ StudentStatusDropdownWithValue(selected string) {
	<div class="form-group">
		<label for="status">Status *</label>
		<select id="status" name="status" required>
			<option value="active" selected?={ selected == "active" }>Active</option>
			<option value="inactive" selected?={ selected == "inactive" }>Inactive</option>
		</select>
	</div>
}

