package frontend

import "fmt"
import "zion-english/internal/utils"
import "zion-english/internal/constants"

type TeacherSearchParams struct {
	InputID      string
	HiddenID     string
	HiddenName   string
	ResultsID    string
	Label        string
	Placeholder  string
	Required     bool
	FilterMode   bool
	SelectedID   string
	SelectedName string
}

templ TeacherSearch(params TeacherSearchParams) {
	<div class="form-group entity-search teacher-search">
		if params.Label != "" {
			<label for={ params.InputID }>{ params.Label }</label>
		}
		<input type="hidden" name="hiddenId" value={ params.HiddenID }/>
		<input type="hidden" name="inputId" value={ params.InputID }/>
		<input type="hidden" name="resultsId" value={ params.ResultsID }/>
		<input
			type="text"
			id={ params.InputID }
			name="q"
			autocomplete="off"
			placeholder={ params.Placeholder }
			value={ params.SelectedName }
			if params.FilterMode {
				_={ teacherSearchClearScript(params.HiddenID, params.ResultsID) }
			}
			hx-get={ utils.URL("/api/teachers/search") }
			hx-trigger="input changed delay:300ms"
			hx-target={ "#" + params.ResultsID }
			hx-include="closest .teacher-search"
		/>
		if params.Required {
			<input
				type="hidden"
				id={ params.HiddenID }
				name={ params.HiddenName }
				value={ params.SelectedID }
				required
			/>
		} else {
			<input
				type="hidden"
				id={ params.HiddenID }
				name={ params.HiddenName }
				value={ params.SelectedID }
			/>
		}
		<div id={ params.ResultsID }></div>
	</div>
}

templ TeacherDropdownWithValue(selectedID string, selectedName string) {
	@TeacherSearch(TeacherSearchParams{
		InputID:      "teacherSearch",
		HiddenID:     "teacher",
		HiddenName:   "teacher",
		ResultsID:    "teacherSearchResults",
		Label:        "Teacher *",
		Placeholder:  "Search teacher...",
		Required:     true,
		SelectedID:   selectedID,
		SelectedName: selectedName,
	})
}

templ TeacherDropdown() {
	@TeacherDropdownWithValue("", "")
}

templ TeacherDropdownEx(label string) {
	@TeacherSearch(TeacherSearchParams{
		InputID:      "teacherSearch",
		HiddenID:     "teacher",
		HiddenName:   "teacher",
		ResultsID:    "teacherSearchResults",
		Label:        label,
		Placeholder:  "Search teacher...",
		Required:     true,
	})
}

