package frontend

import (
	"fmt"
	"zion-english/internal/constants"
	"zion-english/internal/utils"
)

type DocumentItem struct {
	ID               string
	Filename         string
	Extension        string
	Type             string
	FileSize         string
	Status           constants.TeacherDocumentStatus
	UploadedAt       string
	UploadedBy       string
	UploadedByAvatar AvatarProps
	ViewURL          string
	CanReview        bool
}

func documentRowClass(status constants.TeacherDocumentStatus) string {
	switch status {
	case constants.TeacherDocumentStatusSubmitted:
		return "document-row-submitted"
	case constants.TeacherDocumentStatusRejected:
		return "document-row-rejected"
	default:
		return ""
	}
}

func documentTypeLabel(docType string) string {
	switch docType {
	case "avatar":
		return "Avatar"
	case "document":
		return "Document"
	default:
		return docType
	}
}

func documentsTableColspan(showUploader bool, showActions bool) int {
	colspan := 6
	if showUploader {
		colspan++
	}
	if showActions {
		colspan++
	}
	return colspan
}

templ DocumentTypeFilterDropdown() {
	<div class="form-group">
		<label for="documentType">Type</label>
		<select id="documentType" name="type">
			<option value="">All</option>
			<option value="avatar">Avatar</option>
			<option value="document">Document</option>
		</select>
	</div>
}

templ DocumentStatusFilterDropdown() {
	<div class="form-group">
		<label for="documentStatus">Status</label>
		<select id="documentStatus" name="status">
			<option value="">All</option>
			for _, opt := range TeacherDocumentStatusOptions {
				<option value={ opt.Value }>{ opt.Label }</option>
			}
		</select>
	</div>
}

templ DocumentsToolbar(showTeacherFilter bool) {
	<div class="toolbar" id="documentsToolbar">
		<div class="form-group">
			<label for="documentSearch">Search</label>
			if showTeacherFilter {
				<input type="text" id="documentSearch" name="q" placeholder="Filename or teacher name..."/>
			} else {
				<input type="text" id="documentSearch" name="q" placeholder="Filename..."/>
			}
		</div>
		@DocumentTypeFilterDropdown()
		@DocumentStatusFilterDropdown()
		if showTeacherFilter {
			@TeacherFilterDropdown("")
		}
		<button
			type="button"
			id="documentsFilterBtn"
			hx-get={ utils.URL("/documents/partials/rows") }
			hx-include="#documentsToolbar"
			hx-target="#documentsTableBody"
			hx-swap="innerHTML"
		>Filter</button>
	</div>
}

templ DocumentTableRow(item DocumentItem, showUploader bool, showActions bool) {
	<tr class={ documentRowClass(item.Status) }>
		<td data-label="Filename">
			<a href={ item.ViewURL } class="documents-filename documents-filename-link" title={ item.Filename } target="_blank" rel="noopener noreferrer">{ item.Filename }</a>
		</td>
		<td data-label="Extension">
			<code class="documents-ext">.{ item.Extension }</code>
		</td>
		<td data-label="Type">
			@Pill(documentTypeLabel(item.Type), PillToneInfo)
		</td>
		<td data-label="File size">{ item.FileSize }</td>
		<td data-label="Status">
			@StatusPill(item.Status.Label(), DocumentStatusPillTone(item.Status), true)
		</td>
		if showUploader {
			<td data-label="Uploaded by">
				<div class="documents-uploader-cell">
					@Avatar(item.UploadedByAvatar)
					<span>{ item.UploadedBy }</span>
				</div>
			</td>
		}
		<td data-label="Uploaded at">{ item.UploadedAt }</td>
		if showActions {
			<td data-label="Actions">
				<div class="table-actions">
					@IconActionLinkExternal(item.ViewURL, "View", IconKindExternal)
					if item.CanReview {
						<form method="POST" action={ utils.URL("/documents/" + item.ID + "/approve") } class="table-action-form">
							@IconActionSubmit("Approve", IconKindApprove)
						</form>
						<form method="POST" action={ utils.URL("/documents/" + item.ID + "/reject") } class="table-action-form" onsubmit="return confirm('Reject this document? The teacher will be able to upload a new one.');">
							@IconActionSubmit("Reject", IconKindReject)
						</form>
					}
					<form method="POST" action={ utils.URL("/documents/" + item.ID + "/delete") } class="table-action-form" onsubmit="return confirm('Permanently delete this document? The file will be removed and cannot be recovered.');">
						@IconActionSubmit("Delete", IconKindWarning)
					</form>
				</div>
			</td>
		}
	</tr>
}

templ DocumentsTableBody(items []DocumentItem, showUploader bool, showActions bool, emptyMessage string) {
	if len(items) == 0 {
		<tr>
			<td colspan={ fmt.Sprintf("%d", documentsTableColspan(showUploader, showActions)) } class="empty-state">{ emptyMessage }</td>
		</tr>
	} else {
		for _, item := range items {
			@DocumentTableRow(item, showUploader, showActions)
		}
	}
}

templ DocumentsTable(showUploader bool, showActions bool) {
	<div class="table-wrapper documents-table-wrapper">
		<table class="documents-table table-stack-mobile">
			<thead>
				<tr>
					<th>Filename</th>
					<th>Extension</th>
					<th>Type</th>
					<th>File size</th>
					<th>Status</th>
					if showUploader {
						<th>Uploaded by</th>
					}
					<th>Uploaded at</th>
					if showActions {
						<th>Actions</th>
					}
				</tr>
			</thead>
			<tbody
				id="documentsTableBody"
				hx-get={ utils.URL("/documents/partials/rows") }
				hx-include="#documentsToolbar"
				hx-trigger="load"
				hx-swap="innerHTML"
			>
				<tr>
					<td colspan={ fmt.Sprintf("%d", documentsTableColspan(showUploader, showActions)) } class="empty-state">Loading documents...</td>
				</tr>
			</tbody>
		</table>
	</div>
}

templ DocumentsCard(title string, description string, showUploader bool, showActions bool, showTeacherFilter bool) {
	<section class="documents-card">
		<div class="documents-card-header">
			<div>
				<h2>{ title }</h2>
				if description != "" {
					<p class="documents-card-desc">{ description }</p>
				}
			</div>
		</div>
		@DocumentsToolbar(showTeacherFilter)
		@DocumentsTable(showUploader, showActions)
	</section>
}

templ DocumentsStyles() {
	<style>
		.documents-page-desc {
			margin-bottom: var(--space-6);
			color: var(--color-muted-foreground);
			font-size: 0.9375rem;
		}

		.documents-card {
			background: var(--color-muted);
			border: 1px solid var(--color-border-subtle);
			border-radius: var(--radius-lg);
			padding: var(--space-6);
			margin-top: var(--space-6);
		}

		.documents-card-header {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: var(--space-4);
			margin-bottom: var(--space-4);
		}

		.documents-card h2 {
			margin: 0;
			font-size: 1.125rem;
		}

		.documents-card-desc {
			margin-top: var(--space-2);
			color: var(--color-muted-foreground);
			font-size: 0.875rem;
		}

		.documents-table-wrapper {
			margin-top: var(--space-2);
		}

		.documents-uploader-cell {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			min-width: 0;
		}

		.documents-table .documents-filename {
			display: inline;
			word-break: break-all;
			overflow-wrap: anywhere;
		}

		.documents-filename-link {
			color: var(--color-accent);
			text-decoration: none;
		}

		.documents-filename-link:hover {
			color: var(--color-accent-hover);
			text-decoration: underline;
		}

		.documents-ext {
			font-family: 'Fira Code', monospace;
			font-size: 0.8125rem;
			background: var(--color-surface);
			padding: 2px 8px;
			border-radius: var(--radius-sm);
			border: 1px solid var(--color-border-subtle);
		}

		.document-row-submitted {
			background-color: var(--color-warning-bg) !important;
		}

		.document-row-rejected {
			background-color: var(--color-error-bg) !important;
		}

		.documents-empty {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: var(--space-3);
			padding: var(--space-8) var(--space-4);
			text-align: center;
			color: var(--color-muted-foreground);
		}

		.documents-empty svg {
			color: var(--color-border);
		}

		.documents-empty-hint {
			font-size: 0.875rem;
		}

		.upload-zone {
			border: 2px dashed var(--color-border);
			border-radius: var(--radius-md);
			padding: var(--space-4);
			background: var(--color-surface);
			transition: border-color var(--transition-fast), background-color var(--transition-fast);
		}

		.upload-zone:focus-within {
			border-color: var(--color-primary);
			background: var(--color-primary-light);
		}

		.upload-zone-label {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			cursor: pointer;
			font-weight: 500;
			font-size: 0.875rem;
		}

		.upload-zone-icon {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 40px;
			height: 40px;
			border-radius: var(--radius-md);
			background: var(--color-info-bg);
			color: var(--color-accent);
			flex-shrink: 0;
		}

		.upload-zone input[type="file"] {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			border: 0;
		}

		.upload-zone-meta {
			display: flex;
			flex-direction: column;
			gap: 2px;
			min-width: 0;
		}

		.upload-zone-hint {
			font-size: 0.75rem;
			color: var(--color-muted-foreground);
			font-weight: 400;
		}

		.upload-filename {
			margin-top: var(--space-2);
			font-size: 0.8125rem;
			color: var(--color-foreground);
			word-break: break-all;
		}

		.upload-locked-notice {
			display: flex;
			align-items: flex-start;
			gap: var(--space-2);
			padding: var(--space-3) var(--space-4);
			margin-bottom: var(--space-4);
			border-radius: var(--radius-md);
			background: var(--color-info-bg);
			border: 1px solid color-mix(in srgb, var(--color-info) 25%, transparent);
			font-size: 0.875rem;
		}

		.upload-locked-notice svg {
			flex-shrink: 0;
			margin-top: 2px;
			color: var(--color-info);
		}
	</style>
}

type DocumentsPageData struct {
	Title             string
	Description       string
	ShowUploader      bool
	ShowActions       bool
	ShowTeacherFilter bool
}

templ DocumentsPage(data DocumentsPageData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ data.Title } - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@AvatarStyles()
		@DocumentsStyles()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@SuccessBanner()
			@ErrorBanner()
			@HubHeader(data.Title, "", "", false)
			if data.Description != "" {
				<p class="documents-page-desc">{ data.Description }</p>
			}
			@DocumentsToolbar(data.ShowTeacherFilter)
			@DocumentsTable(data.ShowUploader, data.ShowActions)
		</div>
		@SuccessBannerHandlers()
		@ErrorBannerHandlers()
		<script>
			const documentSearch = document.getElementById('documentSearch');
			if (documentSearch) {
				documentSearch.addEventListener('keydown', function (e) {
					if (e.key === 'Enter') {
						e.preventDefault();
						if (typeof htmx !== 'undefined') {
							htmx.trigger('#documentsTableBody', 'load');
						}
					}
				});
			}
		</script>
	</body>
	</html>
}

templ ProfilePictureUpload(data ProfileData) {
	if !data.IsSuperuser {
		<form
			class="profile-upload-form"
			method="POST"
			action={ utils.URL("/profile/avatar") }
			enctype="multipart/form-data"
		>
			<label class="upload-zone-label" for="avatar">Profile picture</label>
			<div class="upload-zone">
				<label class="upload-zone-label" for="avatar">
					<span class="upload-zone-icon" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
							<circle cx="12" cy="7" r="4"></circle>
						</svg>
					</span>
					<span class="upload-zone-meta">
						<span>Choose a photo</span>
						<span class="upload-zone-hint">JPEG or PNG, up to 2 MB</span>
					</span>
					<input type="file" id="avatar" name="avatar" accept="image/jpeg,image/png" onchange="this.form.querySelector('.upload-filename').textContent = this.files[0] ? this.files[0].name : ''"/>
				</label>
				<p class="upload-filename" aria-live="polite"></p>
			</div>
			<div class="profile-form-actions">
				<button type="submit">Upload photo</button>
			</div>
		</form>
	}
}

templ ProfileDocumentUpload(data ProfileData) {
	if !data.IsSuperuser {
		<div class="profile-card profile-section">
			<h2>Valid ID document</h2>
			<p class="profile-section-desc">Submit a government-issued ID for verification. Accepted formats: PNG, JPEG, JPG, or PDF (max 5 MB).</p>
			if !data.CanUploadDocument {
				<div class="upload-locked-notice" role="status">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="12" y1="8" x2="12" y2="12"></line>
						<line x1="12" y1="16" x2="12.01" y2="16"></line>
					</svg>
					<span>You already have a submitted or approved ID on file. You cannot upload again unless it is rejected by an administrator.</span>
				</div>
			}
			<form
				method="POST"
				action={ utils.URL("/profile/document") }
				enctype="multipart/form-data"
				onsubmit="return confirm('Once submitted, you will not be able to upload a new ID unless your current submission is rejected. Continue?');"
			>
				<div class="upload-zone">
					<label class="upload-zone-label" for="document">
						<span class="upload-zone-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
								<polyline points="14 2 14 8 20 8"></polyline>
							</svg>
						</span>
						<span class="upload-zone-meta">
							<span>Choose ID document</span>
							<span class="upload-zone-hint">PNG, JPEG, JPG, or PDF (max 5 MB)</span>
						</span>
						<input
							type="file"
							id="document"
							name="document"
							accept=".png,.jpg,.jpeg,.pdf,image/png,image/jpeg,application/pdf"
							required
							disabled?={ !data.CanUploadDocument }
							onchange="this.form.querySelector('.upload-filename').textContent = this.files[0] ? this.files[0].name : ''"
						/>
					</label>
					<p class="upload-filename" aria-live="polite"></p>
				</div>
				<div class="profile-form-actions">
					<button type="submit" disabled?={ !data.CanUploadDocument }>Submit document</button>
				</div>
			</form>
		</div>
	}
}
