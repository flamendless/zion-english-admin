package frontend

import "zion-english/internal/utils"

templ ReportsHistory() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		@AdminPageHead("Reports History - Zion English Admin Tool")
		@AvatarStyles()
		<style>
			.reports-history-filters {
				display: contents;
			}

			.reports-history-header-actions {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-2);
				align-items: center;
				justify-content: flex-end;
				flex-shrink: 0;
			}

			.reports-history-header-actions .btn {
				margin-top: 0;
				width: auto;
			}

			.hub-header > .btn,
			.hub-header > a.btn {
				margin-top: 0;
				width: auto;
				flex-shrink: 0;
			}
		</style>
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@SuccessBanner()
			<div class="hub-header">
				<h2 class="hub-title">Reports History</h2>
				<div class="reports-history-header-actions">
					<a href={ utils.URL("/reports") } class="btn btn-secondary">Back to Reports</a>
				</div>
			</div>

			<div class="toolbar" id="reportsHistoryToolbar">
				<div id="reportsHistoryFilters" class="reports-history-filters">
					<div class="form-group">
						<label for="reportHistorySearch">Search</label>
						<input type="text" id="reportHistorySearch" name="q" placeholder="Search teacher or summary..."/>
					</div>
					@MonthPicker("reportHistoryMonth", utils.URL("/reports/history/partials/date-preset"))
					@DatePreset(true)
					<input type="hidden" id="reportsHistoryPage" name="page" value="1"/>
					@DataListViewToggle()
					<button
						type="button"
						id="reportHistoryFilterBtn"
						hx-get={ utils.URL("/reports/history/partials/rows") }
						hx-include="#reportsHistoryFilters"
						hx-target="#reportsHistoryTableBody"
						hx-swap={ HxSwapInnerHTML }
					>Filter</button>
				</div>
			</div>

			<div class="table-wrapper data-list-view-root">
				<table id="reportsHistoryTable" class="table-stack-mobile">
					<thead>
						<tr>
							<th>Teacher</th>
							<th>Period</th>
							<th>Records</th>
							<th>Generated at</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody
						id="reportsHistoryTableBody"
						data-loading-label="Loading report history..."
						hx-get={ utils.URL("/reports/history/partials/rows") }
						hx-include="#reportsHistoryFilters"
						hx-trigger={ HxTriggerLoad }
						hx-swap={ HxSwapInnerHTML }
					>
						@TableBodyLoadingRow(5, "Loading report history...")
					</tbody>
				</table>
			</div>

			<div id="paginationBottom" class="pagination-bar"></div>
		</div>

		<script>
			const reportHistorySearch = document.getElementById('reportHistorySearch');

			function setReportHistoryDateRangeFromPreset(select) {
				if (!select) return;
				if (!select.value) {
					delete select.dataset.startDate;
					delete select.dataset.endDate;
					return;
				}
				const parts = select.value.split('|');
				if (parts.length !== 2) return;
				select.dataset.startDate = parts[0];
				select.dataset.endDate = parts[1];
			}

			function bindReportHistoryDatePresetSelect() {
				const datePresetSelect = document.getElementById('datePreset');
				if (!datePresetSelect) return;
				setReportHistoryDateRangeFromPreset(datePresetSelect);
				datePresetSelect.addEventListener('change', () => {
					setReportHistoryDateRangeFromPreset(datePresetSelect);
				});
			}

			bindReportHistoryDatePresetSelect();

			document.body.addEventListener('htmx:afterSwap', function (evt) {
				if (evt.detail.target.id !== 'datePresetGroup') return;
				bindReportHistoryDatePresetSelect();
				const reportsHistoryPage = document.getElementById('reportsHistoryPage');
				if (reportsHistoryPage) reportsHistoryPage.value = '1';
				if (typeof htmx !== 'undefined') {
					htmx.trigger('#reportsHistoryTableBody', 'load');
				}
			});

			const reportHistoryFilterBtn = document.getElementById('reportHistoryFilterBtn');
			const reportsHistoryPage = document.getElementById('reportsHistoryPage');
			if (reportHistoryFilterBtn) {
				reportHistoryFilterBtn.addEventListener('click', function () {
					if (reportsHistoryPage) reportsHistoryPage.value = '1';
				});
			}

			if (reportHistorySearch) {
				reportHistorySearch.addEventListener('keydown', function (e) {
					if (e.key === 'Enter') {
						e.preventDefault();
						if (reportsHistoryPage) reportsHistoryPage.value = '1';
						if (typeof htmx !== 'undefined') {
							htmx.trigger('#reportsHistoryTableBody', 'load');
						}
					}
				});
			}

			document.body.addEventListener('click', function (e) {
				const pageBtn = e.target.closest('#paginationBottom .pagination-btn[hx-get]');
				if (!pageBtn || !reportsHistoryPage) return;
				const vals = pageBtn.getAttribute('hx-vals');
				if (!vals) return;
				try {
					const parsed = JSON.parse(vals.replace(/'/g, '"'));
					if (parsed.page) reportsHistoryPage.value = String(parsed.page);
				} catch (err) { /* ignore */ }
			});
		</script>
	@LayoutEnd()
	</body>
	</html>
}
