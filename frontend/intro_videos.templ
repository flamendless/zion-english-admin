package frontend

import (
	"fmt"
	"zion-english/internal/constants"
	"zion-english/internal/utils"
)

type IntroVideoItem struct {
	ID               string
	Filename         string
	MimeType         string
	FileSize         string
	Status           constants.TeacherIntroVideoStatus
	UploadedAt       string
	UploadedBy       string
	UploadedByAvatar AvatarProps
	RejectReason     string
	ViewURL          string
	CanReview        bool
}

func introVideoRowClass(status constants.TeacherIntroVideoStatus) string {
	switch status {
	case constants.TeacherIntroVideoStatusSubmitted:
		return "document-row-submitted"
	case constants.TeacherIntroVideoStatusRejected:
		return "document-row-rejected"
	default:
		return ""
	}
}

func introVideosTableColspan(showUploader bool, showActions bool) int {
	colspan := 5
	if showUploader {
		colspan++
	}
	if showActions {
		colspan++
	}
	return colspan
}

templ IntroVideoStatusFilterDropdown() {
	<div class="form-group">
		<label for="introVideoStatus">Status</label>
		<select id="introVideoStatus" name="status">
			<option value="">All</option>
			for _, opt := range TeacherIntroVideoStatusOptions {
				<option value={ opt.Value }>{ opt.Label }</option>
			}
		</select>
	</div>
}

templ IntroVideosToolbar(showTeacherFilter bool) {
	<div class="toolbar" id="introVideosToolbar">
		<div class="form-group">
			<label for="introVideoSearch">Search</label>
			if showTeacherFilter {
				<input type="text" id="introVideoSearch" name="introVideoQ" placeholder="Filename or teacher name..."/>
			} else {
				<input type="text" id="introVideoSearch" name="introVideoQ" placeholder="Filename..."/>
			}
		</div>
		@IntroVideoStatusFilterDropdown()
		if showTeacherFilter {
			@TeacherFilterDropdown("", "")
		}
		@SortControls("", "desc", ListSortKindIntroVideo)
		<button
			type="button"
			id="introVideosFilterBtn"
			hx-get={ utils.URL("/intro-videos/partials/rows") }
			hx-include="#introVideosToolbar"
			hx-target="#introVideosTableBody"
			hx-swap="innerHTML"
		>Filter</button>
	</div>
}

templ IntroVideoTableRow(item IntroVideoItem, showUploader bool, showActions bool) {
	<tr class={ introVideoRowClass(item.Status) }>
		<td data-label="Filename">
			<a href={ item.ViewURL } class="documents-filename documents-filename-link" title={ item.Filename } target="_blank" rel="noopener noreferrer">{ item.Filename }</a>
			if item.RejectReason != "" {
				<div class="intro-video-reject-reason">Reject reason: { item.RejectReason }</div>
			}
		</td>
		<td data-label="Type">
			@Pill(item.MimeType, PillToneInfo)
		</td>
		<td data-label="File size">{ item.FileSize }</td>
		<td data-label="Status">
			@StatusPill(item.Status.Label(), IntroVideoStatusPillTone(item.Status), true)
		</td>
		if showUploader {
			<td data-label="Uploaded by">
				<div class="documents-uploader-cell">
					@Avatar(item.UploadedByAvatar)
					<span>{ item.UploadedBy }</span>
				</div>
			</td>
		}
		<td data-label="Uploaded at">{ item.UploadedAt }</td>
		if showActions {
			<td data-label="Actions">
				<div class="table-actions">
					@IconActionLinkExternal(item.ViewURL, "View", IconKindExternal)
					if item.CanReview {
						<form method="POST" action={ utils.URL("/intro-videos/" + item.ID + "/approve") } class="table-action-form">
							@IconActionSubmit("Approve", IconKindApprove)
						</form>
						@IconActionButton("Reject", IconKindReject, templ.Attributes{
							"type": "button",
							"data-intro-video-reject-url": utils.URL("/intro-videos/" + item.ID + "/reject"),
							"data-intro-video-reject-filename": item.Filename,
						})
					}
					<form method="POST" action={ utils.URL("/intro-videos/" + item.ID + "/delete") } class="table-action-form" onsubmit="return confirm('Delete this intro video? The file will be removed and the teacher can upload a new one.');">
						@IconActionSubmit("Delete", IconKindWarning)
					</form>
				</div>
			</td>
		}
	</tr>
}

templ IntroVideosTableBody(items []IntroVideoItem, showUploader bool, showActions bool, emptyMessage string) {
	if len(items) == 0 {
		<tr>
			<td colspan={ fmt.Sprintf("%d", introVideosTableColspan(showUploader, showActions)) } class="empty-state">{ emptyMessage }</td>
		</tr>
	} else {
		for _, item := range items {
			@IntroVideoTableRow(item, showUploader, showActions)
		}
	}
}

templ IntroVideosTable(showUploader bool, showActions bool) {
	<div class="table-wrapper documents-table-wrapper">
		<table class="documents-table table-stack-mobile">
			<thead>
				<tr>
					<th>Filename</th>
					<th>Type</th>
					<th>File size</th>
					<th>Status</th>
					if showUploader {
						@AdminOnlyTableHeader("Uploaded by")
					}
					<th>Uploaded at</th>
					if showActions {
						@AdminOnlyTableHeader("Actions")
					}
				</tr>
			</thead>
			<tbody
				id="introVideosTableBody"
				hx-get={ utils.URL("/intro-videos/partials/rows") }
				hx-include="#introVideosToolbar"
				hx-trigger="load"
				hx-swap="innerHTML"
			>
				<tr>
					<td colspan={ fmt.Sprintf("%d", introVideosTableColspan(showUploader, showActions)) } class="empty-state">Loading intro videos...</td>
				</tr>
			</tbody>
		</table>
	</div>
}

type IntroVideosPageData struct {
	Title             string
	Description       string
	ShowUploader      bool
	ShowActions       bool
	ShowTeacherFilter bool
}

templ IntroVideosPage(data IntroVideosPageData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ data.Title } - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@AvatarStyles()
		@DocumentsStyles()
		<style>
			.intro-video-reject-reason {
				font-size: 0.8125rem;
				color: var(--color-muted-foreground);
			}
		</style>
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@SuccessBanner()
			@ErrorBanner()
			@HubHeader(data.Title, "", "", false)
			if data.Description != "" {
				<p class="documents-page-desc">{ data.Description }</p>
			}
			@IntroVideosToolbar(data.ShowTeacherFilter)
			@IntroVideosTable(data.ShowUploader, data.ShowActions)
			if data.ShowActions {
				@IntroVideoRejectModal()
			}
		</div>
		@SuccessBannerHandlers()
		@ErrorBannerHandlers()
		<script>
			const introVideoSearch = document.getElementById('introVideoSearch');
			if (introVideoSearch) {
				introVideoSearch.addEventListener('keydown', function (e) {
					if (e.key === 'Enter') {
						e.preventDefault();
						if (typeof htmx !== 'undefined') {
							htmx.trigger('#introVideosTableBody', 'load');
						}
					}
				});
			}
		</script>
	</body>
	</html>
}

templ IntroVideoRejectModal() {
	<div class="modal-overlay" id="introVideoRejectModal" hidden role="presentation">
		<div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="introVideoRejectModalTitle">
			<div class="modal-header">
				<h3 id="introVideoRejectModalTitle">Reject intro video</h3>
				<button type="button" class="modal-close intro-video-reject-modal-close" data-tooltip="Close" aria-label="Close">&times;</button>
			</div>
			<form
				id="introVideoRejectForm"
				method="POST"
				class="modal-body scheduled-class-action-modal"
			>
				<p class="scheduled-class-modal-lead">The teacher will be able to upload a new intro video after rejection.</p>
				<div class="form-group">
					<label>Video</label>
					<p id="introVideoRejectFilename" class="intro-video-reject-modal-filename">-</p>
				</div>
				<div class="scheduled-class-modal-fields">
					<div class="form-group">
						<label for="introVideoRejectReason">Reject reason *</label>
						<textarea
							id="introVideoRejectReason"
							name="reject_reason"
							required
							rows="3"
							placeholder="Explain what the teacher should fix before resubmitting"
						></textarea>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary intro-video-reject-modal-close">Cancel</button>
					<button type="submit" class="btn btn-danger">Reject video</button>
				</div>
			</form>
		</div>
	</div>
	<style>
		.intro-video-reject-modal-filename {
			margin: 0;
			font-weight: 600;
			color: var(--color-foreground);
			word-break: break-word;
		}
	</style>
	<script>
		(function () {
			const modal = document.getElementById('introVideoRejectModal');
			const form = document.getElementById('introVideoRejectForm');
			const reasonInput = document.getElementById('introVideoRejectReason');
			const filenameEl = document.getElementById('introVideoRejectFilename');
			if (!modal || !form || !reasonInput || !filenameEl) return;

			window.openIntroVideoRejectModal = function (rejectURL, filename) {
				form.action = rejectURL;
				reasonInput.value = '';
				filenameEl.textContent = filename || '-';
				modal.hidden = false;
				document.body.classList.add('modal-open');
				reasonInput.focus();
			};

			window.closeIntroVideoRejectModal = function () {
				modal.hidden = true;
				document.body.classList.remove('modal-open');
				reasonInput.value = '';
				filenameEl.textContent = '-';
			};

			document.body.addEventListener('click', function (e) {
				const rejectBtn = e.target.closest('[data-intro-video-reject-url]');
				if (rejectBtn) {
					const rejectURL = rejectBtn.getAttribute('data-intro-video-reject-url');
					const filename = rejectBtn.getAttribute('data-intro-video-reject-filename') || '';
					if (!rejectURL) return;
					window.openIntroVideoRejectModal(rejectURL, filename);
					return;
				}
				if (e.target.closest('.intro-video-reject-modal-close')) {
					window.closeIntroVideoRejectModal();
					return;
				}
				if (e.target === modal) {
					window.closeIntroVideoRejectModal();
				}
			});

			document.addEventListener('keydown', function (e) {
				if (e.key === 'Escape' && modal && !modal.hidden) {
					window.closeIntroVideoRejectModal();
				}
			});

			form.addEventListener('submit', function (e) {
				if (!reasonInput.value.trim()) {
					e.preventDefault();
					reasonInput.focus();
				}
			});
		})();
	</script>
}

templ ProfileIntroVideoUpload(data ProfileData) {
	if !data.IsSuperuser && data.IntroVideoUploadVisible {
		<div class="profile-card profile-section">
			<h2>Introduction video</h2>
			<p class="profile-section-desc">Upload a short introduction video for students and administrators. Accepted formats: MP4, WebM, MOV, AVI, MKV, OGV, M4V, or 3GP (max 1 minute, 20 MB).</p>
			if data.HasIntroVideo {
				<div class="profile-detail" style="margin-bottom: var(--space-4);">
					<span class="profile-detail-label">Current video</span>
					<div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-2);">
						@StatusPill(data.IntroVideoStatus.Label(), IntroVideoStatusPillTone(data.IntroVideoStatus), true)
						if data.IntroVideoViewURL != "" {
							<a href={ data.IntroVideoViewURL } class="documents-filename-link" target="_blank" rel="noopener noreferrer">View uploaded video</a>
						}
					</div>
					if data.IntroVideoRejectReason != "" {
						<p class="profile-section-desc" style="margin-top: var(--space-2); margin-bottom: 0;">Reject reason: { data.IntroVideoRejectReason }</p>
					}
				</div>
			}
			if !data.IntroVideoUploadsAllowed {
				<div class="upload-locked-notice" role="status">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="12" y1="8" x2="12" y2="12"></line>
						<line x1="12" y1="16" x2="12.01" y2="16"></line>
					</svg>
					<span>Intro video uploads are currently disabled.</span>
				</div>
			} else if !data.CanUploadIntroVideo {
				<div class="upload-locked-notice" role="status">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="12" y1="8" x2="12" y2="12"></line>
						<line x1="12" y1="16" x2="12.01" y2="16"></line>
					</svg>
					<span>You already have a submitted or approved intro video on file. You cannot upload again unless it is rejected or deleted by an administrator.</span>
				</div>
			}
			if data.IntroVideoUploadsAllowed {
				<form
					method="POST"
					action={ utils.URL("/profile/intro-video") }
					enctype="multipart/form-data"
					onsubmit="return confirm('Once submitted, you will not be able to upload a new intro video unless your current submission is rejected or deleted. Continue?');"
				>
					<div class="upload-zone">
						<label class="upload-zone-label" for="intro_video">
							<span class="upload-zone-icon" aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<polygon points="23 7 16 12 23 17 23 7"></polygon>
									<rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
								</svg>
							</span>
							<span class="upload-zone-meta">
								<span>Choose intro video</span>
								<span class="upload-zone-hint">MP4, WebM, MOV, AVI, MKV, OGV, M4V, or 3GP (max 1 min, 20 MB)</span>
							</span>
							<input
								type="file"
								id="intro_video"
								name="intro_video"
								accept="video/mp4,video/webm,video/quicktime,video/x-msvideo,video/x-matroska,video/ogg,video/3gpp,.mp4,.webm,.mov,.avi,.mkv,.ogv,.m4v,.3gp"
								required
								disabled?={ !data.CanUploadIntroVideo }
								onchange="this.form.querySelector('.upload-filename').textContent = this.files[0] ? this.files[0].name : ''"
							/>
						</label>
						<p class="upload-filename" aria-live="polite"></p>
					</div>
					<div class="profile-form-actions">
						<button type="submit" disabled?={ !data.CanUploadIntroVideo }>Submit intro video</button>
					</div>
				</form>
			}
		</div>
	}
}
