package frontend

import (
	"fmt"
	"zion-english/internal/utils"
)

func classesTableColspan(data ClassesData) int {
	if data.ShowAllTeachers {
		return 8
	}
	return 7
}

type ClassesData struct {
	LockTeacher     bool
	ShowAllTeachers bool
	TeacherID       string
	TeacherName     string
}

templ Classes(data ClassesData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		if data.LockTeacher {
			<title>My Classes - Zion English Admin</title>
		} else {
			<title>View Classes - Zion English Admin</title>
		}
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@ScrTimeRangeJS()
		@AvatarStyles()
		<style>
			.time-range-cell {
				white-space: nowrap;
				font-variant-numeric: tabular-nums;
			}

			.note-reason-cell {
				max-width: 200px;
			}

			.note-reason-text {
				display: block;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
		</style>
		@ClassViewModalScripts()
		@LearningMaterialViewModalStyles()
	</head>
	<body>
		<div class="container" data-show-all-teachers={ fmt.Sprintf("%t", data.ShowAllTeachers) }>
			@HeaderSimple()
			@SuccessBanner()
			@ErrorBanner()
			if data.LockTeacher {
				@HubHeaderModalAction("My Classes", "New Class")
			} else {
				@HubHeaderModalAction("Classes", "New Class")
			}

			<div class="toolbar" id="classesToolbar">
				if data.ShowAllTeachers {
					@ClassesTeacherFilterSearch()
				} else if data.LockTeacher {
					<input type="hidden" id="teacher" name="teacherId" value={ data.TeacherID }/>
					<div class="form-group">
						<label>Teacher</label>
						<input type="text" value={ data.TeacherName } disabled/>
					</div>
				} else {
					@TeacherDropdown()
				}
				<div class="form-group">
					<label for="studentSearch">Student</label>
					<input type="text" id="studentSearch" name="q" placeholder="Search student name..."/>
				</div>
				<div class="form-group report-month-group">
					<label for="classesMonth">Month</label>
					<input
						type="month"
						id="classesMonth"
						name="month"
						value={ utils.CurrentMonthPHT() }
						hx-get={ utils.URL("/classes/partials/date-preset") }
						hx-target="#datePresetGroup"
						hx-swap="outerHTML"
						hx-include="this"
						hx-trigger="change"
					/>
				</div>
				@DatePreset(true)
				@ClassesStatusFilterDropdown()
				@SortControls("", "desc", ListSortKindClass)
				<input type="hidden" id="classesPage" name="page" value="1"/>
				<button
					type="button"
					id="filterBtn"
					hx-get={ utils.URL("/classes/partials/rows") }
					hx-include="#classesToolbar"
					hx-target="#classesTableBody"
					hx-swap="innerHTML"
				>Filter</button>
			</div>

			<div class="table-wrapper">
			<table id="classesTable" class="table-stack-mobile">
				<thead>
					<tr>
						<th>Date</th>
						<th>Time</th>
						if data.ShowAllTeachers {
							<th>Teacher</th>
						}
						<th>Student</th>
						<th>Rate</th>
						<th>Status</th>
						<th>Note / Reason</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody
					id="classesTableBody"
					hx-get={ utils.URL("/classes/partials/rows") }
					hx-include="#classesToolbar"
					hx-trigger="load"
					hx-swap="innerHTML"
				>
					<tr>
						if data.LockTeacher || data.ShowAllTeachers {
							<td colspan={ fmt.Sprintf("%d", classesTableColspan(data)) } class="empty-state">Loading classes...</td>
						} else {
							<td colspan="7" class="empty-state">Select a teacher to view classes</td>
						}
					</tr>
				</tbody>
			</table>
			</div>
			<div id="paginationBottom" class="pagination-bar"></div>
			@DeleteClassModal()
			@ScheduledClassModals()
			<div id="classViewModalHost"></div>
			<div id="lmViewModalHost"></div>
			@RecordClassesChoiceModal()
		</div>

		@LearningMaterialViewModalScripts()

		<script>
			const datePresetSelect = document.getElementById('datePreset');
			const filterBtn = document.getElementById('filterBtn');
			const classesPage = document.getElementById('classesPage');
			const teacherSelect = document.getElementById('teacher');

			function setDateRangeFromPreset(select) {
				if (!select) return;
				if (!select.value) {
					delete select.dataset.startDate;
					delete select.dataset.endDate;
					return;
				}
				const parts = select.value.split('|');
				if (parts.length !== 2) return;
				select.dataset.startDate = parts[0];
				select.dataset.endDate = parts[1];
			}

			function bindDatePresetSelect() {
				const presetSelect = document.getElementById('datePreset');
				if (!presetSelect) return;
				setDateRangeFromPreset(presetSelect);
				presetSelect.addEventListener('change', () => {
					setDateRangeFromPreset(presetSelect);
				});
			}

			bindDatePresetSelect();

			document.body.addEventListener('htmx:afterSwap', function (evt) {
				if (evt.detail.target.id !== 'datePresetGroup') return;
				bindDatePresetSelect();
				if (classesPage) classesPage.value = '1';
				if (typeof htmx !== 'undefined') {
					htmx.trigger('#classesTableBody', 'load');
				}
			});

			filterBtn.addEventListener('click', () => {
				if (classesPage) classesPage.value = '1';
			});

			if (teacherSelect) {
				teacherSelect.addEventListener('change', () => {
					if (classesPage) classesPage.value = '1';
					const presetSelect = document.getElementById('datePreset');
					if (presetSelect && presetSelect.value) {
						setDateRangeFromPreset(presetSelect);
						if (typeof htmx !== 'undefined') {
							htmx.trigger('#classesTableBody', 'load');
						}
					}
				});
			}

			document.body.addEventListener('click', function (e) {
				const pageBtn = e.target.closest('#paginationBottom .pagination-btn[hx-get]');
				if (!pageBtn || !classesPage) return;
				const vals = pageBtn.getAttribute('hx-vals');
				if (!vals) return;
				try {
					const parsed = JSON.parse(vals.replace(/'/g, '"'));
					if (parsed.page) classesPage.value = String(parsed.page);
				} catch (err) { /* ignore */ }
			});
		</script>
	</body>
	</html>
}
