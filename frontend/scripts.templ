package frontend

import "zion-english/internal/utils"

templ ScrHTMX() {
	<script type="text/javascript" src={ templ.URL(utils.URL("/static/js/htmx.min.js")) }></script>
}

templ ScrChartJS() {
	<script type="text/javascript" src={ templ.URL(utils.URL("/static/js/chart.umd.min.js")) }></script>
}

templ ScrForceGraph() {
	<script type="text/javascript" src={ templ.URL(utils.URL("/static/js/force-graph.min.js")) }></script>
}

templ ScrHyperscript() {
	<script async type="text/javascript" src={ templ.URL(utils.URL("/static/js/hyperscript.min.js")) }></script>
}

templ ScrClock() {
	<script type="text/javascript" src={ templ.URL(utils.URL("/static/js/clock.js")) }></script>
}

templ ScrClipboardHelpers() {
	<script>
		window.copyCellText = function (button) {
			var value = button.getAttribute('data-copy');
			if (!value || !navigator.clipboard) return;
			navigator.clipboard.writeText(value).then(function () {
				button.classList.add('copied');
				setTimeout(function () { button.classList.remove('copied'); }, 1500);
			});
		};
	</script>
}

templ ScrTableTruncationTooltips() {
	<script>
		(function () {
			if (window._tableTruncationTooltipsBound) return;
			window._tableTruncationTooltipsBound = true;

			function updateTableTruncationTooltips(root) {
				var scope = root || document;
				scope.querySelectorAll('[data-full-text]').forEach(function (el) {
					var full = el.getAttribute('data-full-text');
					if (!full) {
						el.removeAttribute('title');
						return;
					}
					if (el.scrollWidth > el.clientWidth) {
						el.setAttribute('title', full);
					} else {
						el.removeAttribute('title');
					}
				});
			}

			window.updateTableTruncationTooltips = updateTableTruncationTooltips;

			function runUpdate(root) {
				requestAnimationFrame(function () {
					updateTableTruncationTooltips(root);
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', function () {
					runUpdate(document);
				});
			} else {
				runUpdate(document);
			}

			window.addEventListener('resize', function () {
				runUpdate(document);
			});

			function bindBodyHTMXListeners() {
				if (!document.body) return;
				document.body.addEventListener('htmx:afterSwap', function (evt) {
					runUpdate(evt.detail.target);
				});
				document.body.addEventListener('htmx:afterSettle', function (evt) {
					runUpdate(evt.detail.target);
				});
			}

			if (document.body) {
				bindBodyHTMXListeners();
			} else {
				document.addEventListener('DOMContentLoaded', bindBodyHTMXListeners);
			}
		})();
	</script>
}

templ ScrTableBodyLoading() {
	<script>
		(function () {
			if (window.zionFetchBodyLoading) return;

			var defaultMessage = 'Loading...';

			function escapeHTML(text) {
				var div = document.createElement('div');
				div.textContent = text;
				return div.innerHTML;
			}

			function tableColspan(target) {
				var table = target.closest('table');
				if (!table) return 1;
				var headers = table.querySelectorAll('thead th');
				return headers.length > 0 ? headers.length : 1;
			}

			function isModalHost(el) {
				return el && el.id && el.id.indexOf('ModalHost') !== -1;
			}

			function isFetchBodyTarget(target) {
				if (!target || isModalHost(target)) return false;
				if (target.tagName === 'TBODY' && target.closest('.table-wrapper')) return true;
				if (target.hasAttribute('data-zion-fetch-body')) return true;
				return false;
			}

			function blockLoadingHTML(message) {
				return '<p class="day-classes-empty table-body-loading" aria-busy="true">' +
					'<span class="loading-spinner" aria-hidden="true"></span>' +
					'<span>' + escapeHTML(message) + '</span></p>';
			}

			function tableRowLoadingHTML(colspan, message) {
				return '<tr class="table-body-loading-row" aria-busy="true">' +
					'<td colspan="' + colspan + '" class="empty-state table-body-loading">' +
					'<span class="loading-spinner" aria-hidden="true"></span>' +
					'<span>' + escapeHTML(message) + '</span></td></tr>';
			}

			function showFetchBodyLoading(target, message) {
				if (!target) return;
				var msg = message || target.dataset.loadingLabel || defaultMessage;
				if (!target.dataset.zionFetchBodyPrev) {
					target.dataset.zionFetchBodyPrev = target.innerHTML;
				}
				if (target.tagName === 'TBODY') {
					target.innerHTML = tableRowLoadingHTML(tableColspan(target), msg);
				} else {
					target.innerHTML = blockLoadingHTML(msg);
				}
			}

			function clearFetchBodyPrev(target) {
				if (target && target.dataset) {
					delete target.dataset.zionFetchBodyPrev;
				}
			}

			window.zionFetchBodyLoading = {
				show: showFetchBodyLoading,
				tableRow: tableRowLoadingHTML,
				block: blockLoadingHTML,
				isTarget: isFetchBodyTarget
			};

			function bindBodyHTMXListeners() {
				if (!document.body) return;
				document.body.addEventListener('htmx:beforeRequest', function (evt) {
					var target = evt.detail.target;
					if (!isFetchBodyTarget(target)) return;
					showFetchBodyLoading(target);
				});
				document.body.addEventListener('htmx:afterSwap', function (evt) {
					var target = evt.detail.target;
					if (!isFetchBodyTarget(target)) return;
					clearFetchBodyPrev(target);
				});
				document.body.addEventListener('htmx:responseError', function (evt) {
					var target = evt.detail.target;
					if (!target || !target.querySelector('.table-body-loading')) return;
					if (!isFetchBodyTarget(target)) return;
					var prev = target.dataset.zionFetchBodyPrev;
					if (prev) {
						target.innerHTML = prev;
					} else if (target.tagName === 'TBODY') {
						target.innerHTML = tableRowLoadingHTML(tableColspan(target), 'Could not load data. Try again.');
					} else {
						target.innerHTML = blockLoadingHTML('Could not load data. Try again.');
					}
					clearFetchBodyPrev(target);
				});
			}

			if (document.body) {
				bindBodyHTMXListeners();
			} else {
				document.addEventListener('DOMContentLoaded', bindBodyHTMXListeners);
			}
		})();
	</script>
}

templ ScrFloatingTooltips() {
	<script>
		(function () {
			if (window._floatingTooltipsBound) return;
			window._floatingTooltipsBound = true;

			let tipEl = null;
			let activeTarget = null;

			function getTip() {
				if (!tipEl) {
					tipEl = document.createElement('div');
					tipEl.id = 'floatingTooltip';
					tipEl.className = 'floating-tooltip';
					tipEl.setAttribute('role', 'tooltip');
					tipEl.hidden = true;
					document.body.appendChild(tipEl);
				}
				return tipEl;
			}

			function positionTip(target) {
				const tip = getTip();
				const text = target.getAttribute('data-tooltip');
				if (!text) return;
				tip.textContent = text;
				tip.hidden = false;

				tip.style.left = '0';
				tip.style.top = '0';
				const tipRect = tip.getBoundingClientRect();
				const rect = target.getBoundingClientRect();
				const gap = 8;
				const margin = 8;

				let top = rect.top - tipRect.height - gap;
				let left = rect.left + rect.width / 2 - tipRect.width / 2;

				if (top < margin) {
					top = rect.bottom + gap;
				}

				const maxLeft = window.innerWidth - tipRect.width - margin;
				left = Math.max(margin, Math.min(left, maxLeft));

				if (top + tipRect.height > window.innerHeight - margin) {
					top = Math.max(margin, rect.top - tipRect.height - gap);
				}

				tip.style.left = left + 'px';
				tip.style.top = top + 'px';
			}

			function hideTip() {
				if (tipEl) tipEl.hidden = true;
				activeTarget = null;
			}

			function showTip(target) {
				activeTarget = target;
				positionTip(target);
			}

			function tooltipTarget(node) {
				return node && node.closest(
					'.table-wrapper [data-tooltip], .day-class-integrations [data-tooltip], .notification-panel [data-tooltip], .modal-body [data-tooltip], .ad-zone [data-tooltip], .affiliate-product-card-shop-row [data-tooltip]'
				);
			}

			document.addEventListener('mouseover', function (e) {
				const el = tooltipTarget(e.target);
				if (el) showTip(el);
			});

			document.addEventListener('mouseout', function (e) {
				const el = tooltipTarget(e.target);
				if (!el) return;
				const related = e.relatedTarget;
				if (related && el.contains(related)) return;
				hideTip();
			});

			document.addEventListener('focusin', function (e) {
				const el = tooltipTarget(e.target);
				if (el) showTip(el);
			});

			document.addEventListener('focusout', function (e) {
				const el = tooltipTarget(e.target);
				if (el) hideTip();
			});

			window.addEventListener('scroll', function () {
				if (activeTarget) positionTip(activeTarget);
			}, true);

			window.addEventListener('resize', function () {
				if (activeTarget) positionTip(activeTarget);
			});
		})();
	</script>
}
