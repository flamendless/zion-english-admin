package frontend

import (
	"strings"
	"zion-english/internal/learningmaterials"
	"zion-english/internal/utils"
)

type LearningMaterialTag struct {
	ID    string
	Label string
	Color string
}

type LearningMaterialListItem struct {
	ID                string
	Title             string
	Description       string
	URL               string
	ThumbnailURL      string
	Access            string
	Status            string
	OwnerName         string
	OwnerAvatar       AvatarProps
	CreatedAt         string
	UpdatedAt         string
	Tags              []LearningMaterialTag
	PublicationStatus string
	PublicationTone   PillTone
	AccessLabel       string
	AccessTone        PillTone
	IsDeleted         bool
	CanEdit           bool
}

type LearningMaterialsData struct {
	Materials      []LearningMaterialListItem
	ExistingTags   []LearningMaterialTag
	CanCreate      bool
	PageNumber     int
	PageTotalPages int
	PageTotal      int64
	PrevURL        string
	NextURL        string
	HasPrev        bool
	HasNext        bool
}

type LearningMaterialFormData struct {
	ID           string
	Title        string
	Description  string
	URL          string
	ThumbnailURL string
	Access       string
	Status       string
	SelectedTags []LearningMaterialTag
	ExistingTags []LearningMaterialTag
	IsEdit       bool
	IsDeleted    bool
	CanDelete    bool
}

type LearningMaterialViewData struct {
	ID           string
	Title        string
	Description  string
	URL          string
	ThumbnailURL string
	Access       string
	Status      string
	OwnerName   string
	OwnerAvatar AvatarProps
	CreatedAt   string
	UpdatedAt   string
	DeletedAt   string
	Tags        []LearningMaterialTag
}

func learningMaterialFormAction(data LearningMaterialFormData) string {
	if data.IsEdit {
		return utils.URL("/learning-materials/" + data.ID + "/edit")
	}
	return utils.URL("/learning-materials/create")
}

func learningMaterialFormTitle(data LearningMaterialFormData) string {
	if data.IsEdit {
		return "Edit Learning Material"
	}
	return "Add Learning Material"
}

func learningMaterialSubmitLabel(data LearningMaterialFormData) string {
	if data.IsEdit {
		return "Save changes"
	}
	return "Create material"
}

func learningMaterialDescriptionPreview(desc string) string {
	desc = strings.TrimSpace(desc)
	if len(desc) <= 120 {
		return desc
	}
	return desc[:117] + "..."
}

func learningMaterialCardClass(status string) string {
	switch status {
	case learningmaterials.StatusPublished:
		return "lm-card lm-card--published"
	case learningmaterials.StatusDeleted:
		return "lm-card lm-card--deleted"
	default:
		return "lm-card lm-card--draft"
	}
}

templ LearningMaterials(data LearningMaterialsData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Learning Library - Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@AvatarStyles()
		@LearningMaterialsStyles()
	</head>
	<body>
		<div class="container lm-page">
			@HeaderSimple()
			<div class="hub-header">
				<div class="lm-page-heading">
					<h2 class="hub-title">Learning Library</h2>
					<p class="lm-page-subtitle">Teaching and learning resources shared across the team.</p>
				</div>
				if data.CanCreate {
					<button type="button" class="add-btn lm-add-btn" id="openCreateMaterialBtn">
						@LearningMaterialPlusIcon()
						Add material
					</button>
				}
			</div>
			@SuccessBanner()
			@ErrorBanner()

			if len(data.Materials) > 0 {
				<div class="lm-grid" role="list">
					for _, item := range data.Materials {
						@LearningMaterialCard(item)
					}
				</div>
				@PaginationBar(data.HasPrev, data.PrevURL, data.HasNext, data.NextURL, data.PageNumber, data.PageTotalPages, data.PageTotal)
			} else {
				<div class="lm-empty">
					<div class="lm-empty-icon" aria-hidden="true">
						@LearningMaterialBookIcon()
					</div>
					<p>No learning materials yet.</p>
					if data.CanCreate {
						<button type="button" class="add-btn lm-add-btn" onclick="document.getElementById('openCreateMaterialBtn')?.click()">
							Add your first material
						</button>
					}
				</div>
			}
		</div>

		<div id="lmViewModalHost"></div>
		<div id="lmEditModalHost"></div>

		@LearningMaterialFormModal(LearningMaterialFormData{
			Access:       learningmaterials.AccessPublic,
			Status:       learningmaterials.StatusDraft,
			ExistingTags: data.ExistingTags,
		})

		@LearningMaterialsScripts()
		@LearningMaterialViewModalScripts()
	</body>
	</html>
}

templ LearningMaterialCard(item LearningMaterialListItem) {
	<article class={ learningMaterialCardClass(item.Status) } role="listitem">
		@LearningMaterialThumbnail(item.ThumbnailURL, item.Title, LearningMaterialThumbSizeDefault)
		<h3 class="lm-card-title">{ item.Title }</h3>
		<p class="lm-card-description">{ learningMaterialDescriptionPreview(item.Description) }</p>
		<div class="lm-card-url">
			<a href={ item.URL } class="lm-card-url-text" target="_blank" rel="noopener noreferrer">
				{ item.URL }
			</a>
		</div>
		<div class="lm-card-badges">
			@StatusPill(item.PublicationStatus, item.PublicationTone, false)
			@StatusPill(item.AccessLabel, item.AccessTone, false)
		</div>
		if len(item.Tags) > 0 {
			<div class="lm-tag-list" aria-label="Tags">
				for _, tag := range item.Tags {
					@LearningMaterialTagPill(tag)
				}
			</div>
		}
		<div class="lm-card-footer">
			<div class="lm-card-owner">
				@TeacherNameCell(item.OwnerName, item.OwnerAvatar)
			</div>
			<div class="lm-card-actions">
				@IconActionLinkExternal(item.URL, "Open link", IconKindExternal)
				@IconActionButton("View", IconKindView, templ.Attributes{
					"hx-get":    utils.URL("/learning-materials/" + item.ID + "/view"),
					"hx-target": "#lmViewModalHost",
					"hx-swap":   "innerHTML",
				})
				if item.CanEdit {
					@IconActionButton("Edit", IconKindEdit, templ.Attributes{
						"hx-get":    utils.URL("/learning-materials/" + item.ID + "/edit"),
						"hx-target": "#lmEditModalHost",
						"hx-swap":   "innerHTML",
					})
				}
			</div>
		</div>
	</article>
}

templ LearningMaterialTagPill(tag LearningMaterialTag) {
	<span class="lm-tag-pill" style={ "background-color: " + tag.Color + "33; color: #2D2D2D;" }>
		{ tag.Label }
	</span>
}

templ LearningMaterialViewModal(data LearningMaterialViewData) {
	<div class="modal-overlay" id="lmViewModal" role="presentation">
		<div class="modal-dialog modal-dialog-entity lm-modal" role="dialog" aria-modal="true" aria-labelledby="lmViewTitle">
			<div class="modal-header">
				<h3 id="lmViewTitle">{ data.Title }</h3>
				<button type="button" class="modal-close lm-view-close" aria-label="Close">&times;</button>
			</div>
			<div class="modal-body lm-view-body">
				@LearningMaterialThumbnail(data.ThumbnailURL, data.Title, LearningMaterialThumbSizeCompact)
				<div class="lm-view-section">
					<h4 class="lm-view-label">Description</h4>
					<p class="lm-view-text">{ data.Description }</p>
				</div>
				<div class="lm-view-section">
					<h4 class="lm-view-label">URL</h4>
					<a href={ data.URL } class="lm-view-link" target="_blank" rel="noopener noreferrer">{ data.URL }</a>
				</div>
				<div class="lm-view-section">
					<h4 class="lm-view-label">Status</h4>
					<div class="lm-view-badges">
						@StatusPill(learningMaterialViewStatusLabel(data.Status), learningMaterialViewStatusTone(data.Status), false)
						@StatusPill(learningMaterialViewAccessLabel(data.Access), learningMaterialViewAccessTone(data.Access), false)
					</div>
				</div>
				if len(data.Tags) > 0 {
					<div class="lm-view-section">
						<h4 class="lm-view-label">Tags</h4>
						<div class="lm-tag-list">
							for _, tag := range data.Tags {
								@LearningMaterialTagPill(tag)
							}
						</div>
					</div>
				}
				<div class="lm-view-meta">
					@LearningMaterialMetaOwner(data.OwnerName, data.OwnerAvatar)
					@LearningMaterialMetaItem("Created", data.CreatedAt)
					@LearningMaterialMetaItem("Updated", data.UpdatedAt)
					if data.DeletedAt != "" {
						@LearningMaterialMetaItem("Deleted", data.DeletedAt)
					}
				</div>
			</div>
			<div class="modal-footer lm-view-footer">
				<div class="lm-view-footer-actions">
					@IconActionLinkExternal(data.URL, "Open link", IconKindExternal)
				</div>
			</div>
		</div>
	</div>
}

templ LearningMaterialMetaItem(label string, value string) {
	<div class="lm-meta-item">
		<span class="lm-meta-label">{ label }</span>
		<span class="lm-meta-value">{ value }</span>
	</div>
}

templ LearningMaterialMetaOwner(name string, avatar AvatarProps) {
	<div class="lm-meta-item lm-meta-item--owner">
		<span class="lm-meta-label">Owner</span>
		@TeacherNameCell(name, avatar)
	</div>
}

templ LearningMaterialFormModal(data LearningMaterialFormData) {
	<div class="modal-overlay" id={ learningMaterialModalID(data) } hidden?={ !data.IsEdit } role="presentation">
		<div class="modal-dialog lm-modal" role="dialog" aria-modal="true" aria-labelledby="lmFormTitle">
			<div class="modal-header">
				<h3 id="lmFormTitle">{ learningMaterialFormTitle(data) }</h3>
				<button type="button" class="modal-close lm-form-close" aria-label="Close">&times;</button>
			</div>
			<form
				id="lmMaterialForm"
				method="POST"
				action={ learningMaterialFormAction(data) }
				class="modal-body lm-form-body"
			>
				<div class="form-group">
					<label for="lmTitle">Title *</label>
					<input
						type="text"
						id="lmTitle"
						name="title"
						required
						maxlength="64"
						value={ data.Title }
						placeholder="Short name for this resource"
					/>
				</div>
				<div class="form-group">
					<label for="lmDescription">Description *</label>
					<textarea
						id="lmDescription"
						name="description"
						required
						rows="4"
						maxlength="1000"
						placeholder="What is this resource about?"
					>{ data.Description }</textarea>
				</div>
				<div class="form-group">
					<label for="lmURL">URL *</label>
					<input
						type="url"
						id="lmURL"
						class="lm-form-url"
						name="url"
						required
						value={ data.URL }
						placeholder="https://..."
					/>
					<div
						id="lmUrlPreview"
						class="lm-thumb lm-thumb--compact lm-url-preview"
						hidden?={ data.ThumbnailURL == "" }
					>
						<img
							id="lmUrlPreviewImg"
							class="lm-thumb-img"
							alt="Link preview"
							referrerpolicy="no-referrer"
							hidden?={ data.ThumbnailURL == "" }
							if data.ThumbnailURL != "" {
								src={ data.ThumbnailURL }
							}
						/>
						<div
							id="lmUrlPreviewPlaceholder"
							class="lm-thumb-placeholder"
							hidden?={ data.ThumbnailURL != "" }
							aria-hidden="true"
						>
							@LearningMaterialBookIcon()
						</div>
						<span class="lm-url-preview-loading">Fetching preview…</span>
					</div>
					<input type="hidden" id="lmThumbnailURL" class="lm-form-thumbnail-url" name="thumbnail_url" value={ data.ThumbnailURL }/>
				</div>

				<div class="form-group">
					<label>Access *</label>
					<div class="lm-option-cards" role="radiogroup" aria-label="Access level">
						<label class="lm-option-card">
							<input type="radio" name="access" value={ learningmaterials.AccessPublic } checked?={ data.Access != learningmaterials.AccessPrivate }/>
							<span class="lm-option-card__body">
								<span class="lm-option-card__title">Public</span>
								<span class="lm-option-card__desc">Visible to all teachers when published</span>
							</span>
						</label>
						<label class="lm-option-card">
							<input type="radio" name="access" value={ learningmaterials.AccessPrivate } checked?={ data.Access == learningmaterials.AccessPrivate }/>
							<span class="lm-option-card__body">
								<span class="lm-option-card__title">Private</span>
								<span class="lm-option-card__desc">Only you and superuser can view</span>
							</span>
						</label>
					</div>
				</div>

				<div class="form-group">
					<label for="lmStatus">Status *</label>
					if data.IsDeleted {
						<p class="field-hint">This material is deleted. Choose Draft or Published to restore it.</p>
					}
					<select id="lmStatus" name="status" required>
						<option value={ learningmaterials.StatusDraft } selected?={ data.Status != learningmaterials.StatusPublished && data.Status != learningmaterials.StatusDeleted }>Draft</option>
						<option value={ learningmaterials.StatusPublished } selected?={ data.Status == learningmaterials.StatusPublished }>Published</option>
						if data.IsEdit && data.CanDelete {
							<option value={ learningmaterials.StatusDeleted } selected?={ data.Status == learningmaterials.StatusDeleted }>Deleted</option>
						}
					</select>
				</div>

				<div class="form-group">
					<label for="lmTagInput">Tags * <span class="lm-tag-hint">(1–7 tags)</span></label>
					<div class="lm-tag-input-wrap" id="lmTagInputWrap">
						<div class="lm-tag-chips" id="lmTagChips" aria-live="polite"></div>
						<input
							type="text"
							id="lmTagInput"
							class="lm-tag-text-input"
							placeholder="Type a tag and press Enter"
							autocomplete="off"
							list="lmTagSuggestions"
						/>
						<datalist id="lmTagSuggestions">
							for _, tag := range data.ExistingTags {
								<option value={ tag.Label }></option>
							}
						</datalist>
					</div>
					<p class="field-hint lm-tag-limit-warning" hidden>Maximum of 7 tags reached. Remove a tag to add another.</p>
					<p class="field-hint">Tags are stored in lowercase. Type a tag and press Enter.</p>
					for _, tag := range data.SelectedTags {
						<input type="hidden" name="tags" value={ tag.Label }/>
					}
				</div>

				<div class="modal-footer lm-form-footer">
					<div class="lm-form-footer-actions">
						<button type="button" class="btn btn-secondary lm-form-close">Cancel</button>
						<button type="submit" class="add-btn lm-submit-btn">{ learningMaterialSubmitLabel(data) }</button>
					</div>
				</div>
			</form>
		</div>
	</div>
}

func learningMaterialViewStatusLabel(status string) string {
	switch status {
	case learningmaterials.StatusPublished:
		return "Published"
	case learningmaterials.StatusDeleted:
		return "Deleted"
	default:
		return "Draft"
	}
}

func learningMaterialViewStatusTone(status string) PillTone {
	switch status {
	case learningmaterials.StatusPublished:
		return PillToneSuccess
	case learningmaterials.StatusDeleted:
		return PillToneError
	default:
		return PillToneNeutral
	}
}

func learningMaterialViewAccessLabel(access string) string {
	if access == learningmaterials.AccessPrivate {
		return "Private"
	}
	return "Public"
}

func learningMaterialViewAccessTone(access string) PillTone {
	if access == learningmaterials.AccessPrivate {
		return PillToneWarning
	}
	return PillToneInfo
}

type LearningMaterialThumbSize string

const (
	LearningMaterialThumbSizeDefault LearningMaterialThumbSize = "default"
	LearningMaterialThumbSizeCompact LearningMaterialThumbSize = "compact"
)

func learningMaterialThumbClass(size LearningMaterialThumbSize) string {
	if size == LearningMaterialThumbSizeCompact {
		return "lm-thumb lm-thumb--compact"
	}
	return "lm-thumb"
}

templ LearningMaterialThumbnail(thumbnailURL string, title string, size LearningMaterialThumbSize) {
	<div class={ learningMaterialThumbClass(size) }>
		if thumbnailURL != "" {
			<img
				src={ thumbnailURL }
				class="lm-thumb-img"
				alt={ "Preview for " + title }
				loading="lazy"
				referrerpolicy="no-referrer"
				onerror="this.hidden=true; const p=this.parentElement.querySelector('.lm-thumb-placeholder'); if(p) p.hidden=false;"
			/>
			<div class="lm-thumb-placeholder" hidden aria-hidden="true">
				@LearningMaterialBookIcon()
			</div>
		} else {
			<div class="lm-thumb-placeholder" aria-hidden="true">
				@LearningMaterialBookIcon()
			</div>
		}
	</div>
}

templ LearningMaterialBookIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
		<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
		<path d="M8 7h8"></path>
		<path d="M8 11h6"></path>
	</svg>
}

templ LearningMaterialPlusIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 5v14"></path>
		<path d="M5 12h14"></path>
	</svg>
}

templ LearningMaterialsStyles() {
	<style>
		.lm-page {
			padding-bottom: var(--space-10);
		}

		.lm-page-heading {
			display: flex;
			flex-direction: column;
			gap: var(--space-1);
		}

		.lm-page-subtitle {
			color: var(--color-muted-foreground);
			font-size: 0.9375rem;
			line-height: 1.5;
			max-width: 36rem;
		}

		.lm-add-btn {
			display: inline-flex;
			align-items: center;
			gap: var(--space-2);
		}

		.lm-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
			gap: var(--space-4);
			margin-bottom: var(--space-6);
		}

		.lm-card {
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
			padding: var(--space-5);
			border: 2px solid var(--color-border-subtle);
			border-radius: var(--radius-lg);
			background: transparent;
			box-shadow: var(--shadow-sm);
			transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
		}

		.lm-thumb {
			width: 100%;
			aspect-ratio: 16 / 9;
			border-radius: var(--radius-md);
			overflow: hidden;
			background: linear-gradient(180deg, #F0FDFA 0%, #E6FFFA 100%);
			border: 1px solid var(--color-border-subtle);
		}

		.lm-thumb--compact {
			width: 100%;
			max-width: 168px;
			aspect-ratio: 16 / 9;
		}

		.lm-thumb-img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.lm-thumb-placeholder {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: 100%;
			color: #0D9488;
		}

		.lm-url-preview {
			position: relative;
			margin-top: var(--space-2);
			overflow: hidden;
		}

		.lm-url-preview .lm-thumb-placeholder {
			position: absolute;
			inset: 0;
		}

		.lm-url-preview .lm-thumb-img:not([src]) {
			opacity: 0;
			position: absolute;
			inset: 0;
		}

		.lm-url-preview .lm-thumb-img[src] {
			position: relative;
			z-index: 1;
		}

		.lm-url-preview-loading {
			position: absolute;
			inset: 0;
			display: none;
			align-items: center;
			justify-content: center;
			font-size: 0.8125rem;
			color: var(--color-muted-foreground);
			background: rgba(255, 255, 255, 0.85);
		}

		.lm-url-preview--loading .lm-url-preview-loading {
			display: flex;
		}

		.lm-url-preview--loading .lm-url-preview-img {
			opacity: 0.35;
		}

		.lm-thumb-img[hidden] {
			display: none;
		}

		.lm-card--published {
			border-color: #22C55E;
		}

		.lm-card--draft {
			border-color: #FACC15;
		}

		.lm-card--deleted {
			border-color: #EF4444;
		}

		.lm-card:hover {
			box-shadow: var(--shadow-md);
			transform: translateY(-2px);
		}

		.lm-card--published:hover {
			border-color: #16A34A;
		}

		.lm-card--draft:hover {
			border-color: #EAB308;
		}

		.lm-card--deleted:hover {
			border-color: #DC2626;
		}

		.lm-card-badges {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
		}

		.lm-card-footer {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-3);
			margin-top: auto;
			padding-top: var(--space-3);
			border-top: 1px solid var(--color-border-subtle);
		}

		.lm-card-owner {
			flex: 1;
			min-width: 0;
		}

		.lm-card-owner .teacher-name-cell-text {
			font-size: 0.8125rem;
			font-weight: 500;
			color: var(--color-muted-foreground);
		}

		.lm-card-actions {
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: var(--space-1);
			flex-shrink: 0;
		}

		.lm-card-title {
			margin: 0;
			font-size: 1rem;
			font-weight: 600;
			line-height: 1.4;
			color: var(--color-foreground);
		}

		.lm-card-url {
			display: flex;
			align-items: flex-start;
			gap: var(--space-2);
			min-width: 0;
		}

		.lm-card-url-text {
			flex: 1;
			min-width: 0;
			font-size: 0.8125rem;
			font-family: 'Fira Code', monospace;
			color: #0D9488;
			text-decoration: none;
			line-height: 1.5;
			overflow-wrap: anywhere;
			word-break: break-word;
		}

		.lm-card-url-text:hover {
			text-decoration: underline;
		}

		.lm-card-description {
			font-size: 0.9375rem;
			line-height: 1.55;
			color: var(--color-foreground);
		}

		.lm-tag-list {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
		}

		.lm-tag-pill {
			display: inline-flex;
			align-items: center;
			padding: 4px 10px;
			border-radius: var(--radius-full);
			border: var(--pill-border);
			font-size: 0.75rem;
			font-weight: 600;
			line-height: 1.2;
			text-transform: lowercase;
			box-sizing: border-box;
		}

		.lm-empty {
			text-align: center;
			padding: var(--space-10) var(--space-4);
			color: var(--color-muted-foreground);
			border: 1px dashed var(--color-border);
			border-radius: var(--radius-lg);
			background: linear-gradient(180deg, #F0FDFA 0%, var(--color-surface) 100%);
		}

		.lm-empty-icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 56px;
			height: 56px;
			margin-bottom: var(--space-4);
			border-radius: var(--radius-full);
			background: #E6FFFA;
			color: #0D9488;
		}

		.lm-empty p {
			margin-bottom: var(--space-4);
		}

		.lm-modal {
			max-width: 560px;
		}

		.lm-view-body,
		.lm-form-body {
			display: flex;
			flex-direction: column;
			gap: var(--space-4);
		}

		.lm-view-badges {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
		}

		.lm-view-section {
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		.lm-view-label {
			font-size: 0.8125rem;
			font-weight: 600;
			color: var(--color-muted-foreground);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.lm-view-text {
			font-size: 0.9375rem;
			line-height: 1.6;
			white-space: pre-wrap;
		}

		.lm-view-link {
			word-break: break-all;
			font-size: 0.875rem;
		}

		.lm-view-meta {
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
			padding: var(--space-4);
			border-radius: var(--radius-md);
			background: var(--color-muted);
		}

		.lm-meta-item {
			display: flex;
			flex-direction: column;
			gap: 2px;
		}

		.lm-meta-label {
			font-size: 0.75rem;
			color: var(--color-muted-foreground);
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.lm-meta-value {
			font-size: 0.875rem;
		}

		.lm-meta-item--owner .teacher-name-cell-text {
			font-size: 0.875rem;
			font-weight: 500;
			color: var(--color-foreground);
		}

		.lm-view-footer,
		.lm-form-footer {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--space-3);
		}

		.lm-form-footer {
			justify-content: flex-end;
		}

		.lm-form-footer-actions {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--space-3);
		}

		.lm-view-footer {
			padding: var(--space-2) var(--space-4) var(--space-4);
			border-top: 1px solid var(--color-border-subtle);
		}

		.lm-view-footer-actions {
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: var(--space-1);
			width: 100%;
		}

		.lm-view-footer button,
		.lm-view-footer .btn,
		.lm-view-footer .add-btn,
		.lm-form-footer button,
		.lm-form-footer .btn,
		.lm-form-footer .add-btn {
			margin-top: 0;
		}

		.lm-option-cards {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-3);
		}

		.lm-option-card {
			display: flex;
			align-items: flex-start;
			gap: var(--space-3);
			padding: var(--space-3);
			border: 2px solid var(--color-border);
			border-radius: var(--radius-md);
			cursor: pointer;
			transition: border-color var(--transition-fast), background var(--transition-fast);
		}

		.lm-option-card:hover {
			background: var(--color-muted);
		}

		.lm-option-card:has(input:checked) {
			border-color: #0D9488;
			background: #F0FDFA;
		}

		.lm-option-card input {
			margin-top: 4px;
			accent-color: #0D9488;
		}

		.lm-option-card__title {
			display: block;
			font-weight: 600;
			font-size: 0.875rem;
		}

		.lm-option-card__desc {
			display: block;
			font-size: 0.75rem;
			color: var(--color-muted-foreground);
			margin-top: 2px;
			line-height: 1.4;
		}

		.lm-tag-hint {
			font-weight: 400;
			color: var(--color-muted-foreground);
			font-size: 0.8125rem;
		}

		.lm-tag-input-wrap {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: var(--space-2);
			padding: var(--space-2) var(--space-3);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			background: var(--color-surface);
			transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
		}

		.lm-tag-input-wrap:focus-within {
			border-color: #0D9488;
			box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15);
		}

		.lm-tag-chips {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
			width: 100%;
		}

		.lm-tag-chip {
			display: inline-flex;
			align-items: center;
			gap: var(--space-1);
			padding: 4px 8px 4px 10px;
			border-radius: var(--radius-full);
			background: #E6FFFA;
			border: var(--pill-border);
			font-size: 0.8125rem;
			font-weight: 500;
			text-transform: lowercase;
			box-sizing: border-box;
		}

		.lm-tag-chip-remove {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 1.125rem;
			height: 1.125rem;
			padding: 0;
			margin: 0;
			border: none;
			border-radius: var(--radius-full);
			background: transparent;
			background-color: transparent;
			color: var(--color-muted-foreground);
			cursor: pointer;
			font-size: 0.875rem;
			font-weight: 400;
			line-height: 1;
			flex-shrink: 0;
		}

		.lm-tag-chip-remove:hover {
			background: rgba(0, 0, 0, 0.06);
			background-color: rgba(0, 0, 0, 0.06);
			color: var(--color-foreground);
		}

		.lm-tag-text-input {
			width: 100%;
			border: none;
			outline: none;
			font-size: 0.9375rem;
			background: transparent;
			padding: var(--space-1) 0;
		}

		.lm-tag-text-input:disabled {
			cursor: not-allowed;
			color: var(--color-muted-foreground);
		}

		.lm-tag-limit-warning {
			color: #B45309;
			font-weight: 500;
		}

		.lm-submit-btn {
			min-width: 140px;
		}

		@media (max-width: 768px) {
			.lm-grid {
				grid-template-columns: 1fr;
			}

			.lm-option-cards {
				grid-template-columns: 1fr;
			}

			.lm-view-meta-grid {
				grid-template-columns: 1fr;
			}

			.hub-header {
				flex-direction: column;
				align-items: stretch;
			}
		}
	</style>
}

func learningMaterialModalID(data LearningMaterialFormData) string {
	if data.IsEdit {
		return "lmEditModal"
	}
	return "lmFormModal"
}

templ LearningMaterialViewModalStyles() {
	<style>
		#lmViewModalHost .modal-overlay {
			z-index: 1100;
		}

		.lm-thumb {
			width: 100%;
			aspect-ratio: 16 / 9;
			border-radius: var(--radius-md);
			overflow: hidden;
			background: linear-gradient(180deg, #F0FDFA 0%, #E6FFFA 100%);
			border: 1px solid var(--color-border-subtle);
		}

		.lm-thumb--compact {
			width: 100%;
			max-width: 168px;
			aspect-ratio: 16 / 9;
		}

		.lm-thumb-img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.lm-thumb-placeholder {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: 100%;
			color: #0D9488;
		}

		.lm-thumb-img[hidden] {
			display: none;
		}

		.lm-tag-list {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
		}

		.lm-tag-pill {
			display: inline-flex;
			align-items: center;
			padding: 4px 10px;
			border-radius: var(--radius-full);
			border: var(--pill-border);
			font-size: 0.75rem;
			font-weight: 600;
			line-height: 1.2;
			text-transform: lowercase;
			box-sizing: border-box;
		}

		.lm-modal {
			max-width: 560px;
		}

		.lm-view-body {
			display: flex;
			flex-direction: column;
			gap: var(--space-4);
		}

		.lm-view-badges {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
		}

		.lm-view-section {
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		.lm-view-label {
			font-size: 0.8125rem;
			font-weight: 600;
			color: var(--color-muted-foreground);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.lm-view-text {
			font-size: 0.9375rem;
			line-height: 1.6;
			white-space: pre-wrap;
		}

		.lm-view-link {
			word-break: break-all;
			font-size: 0.875rem;
		}

		.lm-view-meta {
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
			padding: var(--space-4);
			border-radius: var(--radius-md);
			background: var(--color-muted);
		}

		.lm-meta-item {
			display: flex;
			flex-direction: column;
			gap: 2px;
		}

		.lm-meta-label {
			font-size: 0.75rem;
			color: var(--color-muted-foreground);
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.lm-meta-value {
			font-size: 0.875rem;
		}

		.lm-meta-item--owner .teacher-name-cell-text {
			font-size: 0.875rem;
			font-weight: 500;
			color: var(--color-foreground);
		}

		.lm-view-footer {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--space-3);
			padding: var(--space-2) var(--space-4) var(--space-4);
			border-top: 1px solid var(--color-border-subtle);
		}

		.lm-view-footer-actions {
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: var(--space-1);
			width: 100%;
		}

		.lm-view-footer button,
		.lm-view-footer .btn,
		.lm-view-footer .add-btn {
			margin-top: 0;
		}
	</style>
}

templ LearningMaterialViewModalScripts() {
	<script>
		(function () {
			if (window._lmViewModalBound) return;
			window._lmViewModalBound = true;

			function hasOpenModalLayer() {
				return !!(
					document.getElementById('classViewModal') ||
					document.getElementById('lmEditModal') ||
					document.getElementById('lmFormModal') ||
					document.getElementById('lmViewModal')
				);
			}

			window.closeLearningMaterialViewModal = function () {
				const host = document.getElementById('lmViewModalHost');
				if (host) host.innerHTML = '';
				if (!hasOpenModalLayer()) {
					document.body.classList.remove('modal-open');
				}
			};

			document.body.addEventListener('click', function (e) {
				if (e.target.closest('.lm-view-close')) {
					window.closeLearningMaterialViewModal();
					return;
				}
				const viewOverlay = e.target.closest('#lmViewModal');
				if (viewOverlay && e.target === viewOverlay) {
					window.closeLearningMaterialViewModal();
				}
			});

			document.addEventListener('keydown', function (e) {
				if (e.key !== 'Escape' || !document.getElementById('lmViewModal')) return;
				window.closeLearningMaterialViewModal();
			});

			document.body.addEventListener('htmx:afterSwap', function (evt) {
				if (evt.detail.target.id !== 'lmViewModalHost') return;
				document.body.classList.add('modal-open');
				const closeBtn = evt.detail.target.querySelector('.lm-view-close');
				if (closeBtn) closeBtn.focus();
			});
		})();
	</script>
}

templ LearningMaterialViewModalSupport() {
	<div id="lmViewModalHost"></div>
	@LearningMaterialViewModalStyles()
	@LearningMaterialViewModalScripts()
}

templ LearningMaterialsScripts() {
	@templ.JSONScript("lmPreviewURL", utils.URL("/learning-materials/preview"))
	<script>
		(function () {
			const MAX_TAGS = 7;
			const MIN_TAGS = 1;
			const previewURLScript = document.getElementById('lmPreviewURL');
			const PREVIEW_URL = previewURLScript ? JSON.parse(previewURLScript.textContent) : '/learning-materials/preview';
			let activeModal = null;

			function normalizeTag(value) {
				return (value || '').trim().toLowerCase();
			}

			function getFormSelectedTags(form) {
				if (!form) return null;
				if (!form._lmSelectedTags) {
					form._lmSelectedTags = new Set();
				}
				return form._lmSelectedTags;
			}

			function updateTagLimitUI(form) {
				const selectedTags = getFormSelectedTags(form);
				if (!selectedTags) return;
				const tagInput = form.querySelector('.lm-tag-text-input');
				const warning = form.querySelector('.lm-tag-limit-warning');
				const atMax = selectedTags.size >= MAX_TAGS;
				if (tagInput) {
					tagInput.disabled = atMax;
					if (atMax) {
						tagInput.value = '';
					}
				}
				if (warning) {
					warning.hidden = !atMax;
				}
			}

			function renderTagChips(form) {
				const selectedTags = getFormSelectedTags(form);
				const tagChips = form.querySelector('.lm-tag-chips');
				if (!tagChips || !selectedTags) return;
				tagChips.innerHTML = '';
				selectedTags.forEach(function (tag) {
					const chip = document.createElement('span');
					chip.className = 'lm-tag-chip';
					chip.innerHTML = tag + '<button type="button" class="lm-tag-chip-remove" aria-label="Remove ' + tag + '">&times;</button>';
					const removeBtn = chip.querySelector('.lm-tag-chip-remove');
					removeBtn.addEventListener('click', function () {
						selectedTags.delete(tag);
						syncHiddenTagInputs(form);
						renderTagChips(form);
					});
					tagChips.appendChild(chip);
				});
				updateTagLimitUI(form);
			}

			function syncHiddenTagInputs(form) {
				const selectedTags = getFormSelectedTags(form);
				if (!selectedTags) return;
				form.querySelectorAll('input[name="tags"]').forEach(function (el) { el.remove(); });
				selectedTags.forEach(function (tag) {
					const input = document.createElement('input');
					input.type = 'hidden';
					input.name = 'tags';
					input.value = tag;
					form.appendChild(input);
				});
			}

			function bindTagInput(form) {
				const tagInput = form.querySelector('.lm-tag-text-input');
				if (!tagInput || tagInput.dataset.lmBound === '1') return;
				tagInput.dataset.lmBound = '1';

				tagInput.addEventListener('keydown', function (e) {
					const selectedTags = getFormSelectedTags(form);
					if (!selectedTags || selectedTags.size >= MAX_TAGS) {
						if (e.key === 'Enter' || e.key === ',') {
							e.preventDefault();
						}
						return;
					}
					if (e.key === 'Enter' || e.key === ',') {
						e.preventDefault();
						if (addTag(tagInput.value, form)) {
							tagInput.value = '';
						}
					} else if (e.key === 'Backspace' && tagInput.value === '' && selectedTags.size > 0) {
						const tags = Array.from(selectedTags);
						selectedTags.delete(tags[tags.length - 1]);
						syncHiddenTagInputs(form);
						renderTagChips(form);
					}
				});

				tagInput.addEventListener('blur', function () {
					const selectedTags = getFormSelectedTags(form);
					if (!selectedTags || selectedTags.size >= MAX_TAGS || !tagInput.value.trim()) {
						return;
					}
					if (addTag(tagInput.value, form)) {
						tagInput.value = '';
					}
				});
			}

			function addTag(raw, form) {
				const selectedTags = getFormSelectedTags(form);
				if (!selectedTags) return false;
				const tag = normalizeTag(raw);
				if (!tag) return false;
				if (selectedTags.has(tag)) return false;
				if (selectedTags.size >= MAX_TAGS) {
					return false;
				}
				selectedTags.add(tag);
				syncHiddenTagInputs(form);
				renderTagChips(form);
				return true;
			}

			function bindUrlPreview(form) {
				const urlInput = form.querySelector('.lm-form-url');
				const preview = form.querySelector('.lm-url-preview');
				const previewImg = preview ? preview.querySelector('.lm-thumb-img') : null;
				const thumbHidden = form.querySelector('.lm-form-thumbnail-url');
				if (!urlInput || !preview || !previewImg || !thumbHidden || urlInput.dataset.lmUrlBound === '1') {
					return;
				}
				urlInput.dataset.lmUrlBound = '1';

				let debounceTimer = null;
				let fetchRequestID = 0;
				let lastFetchedUrl = '';

				function setPreviewLoading(loading) {
					preview.classList.toggle('lm-url-preview--loading', loading);
				}

				function getPreviewPlaceholder() {
					return preview.querySelector('.lm-thumb-placeholder');
				}

				function clearPreview() {
					preview.hidden = true;
					previewImg.removeAttribute('src');
					previewImg.hidden = true;
					const placeholder = getPreviewPlaceholder();
					if (placeholder) placeholder.hidden = false;
					thumbHidden.value = '';
					lastFetchedUrl = '';
					setPreviewLoading(false);
				}

				function showFallbackPreview() {
					preview.hidden = false;
					previewImg.removeAttribute('src');
					previewImg.hidden = true;
					const placeholder = getPreviewPlaceholder();
					if (placeholder) placeholder.hidden = false;
					thumbHidden.value = '';
					setPreviewLoading(false);
				}

				function showPreview(thumbnailURL) {
					if (!thumbnailURL) {
						showFallbackPreview();
						return;
					}
					preview.hidden = false;
					previewImg.hidden = false;
					previewImg.referrerPolicy = 'no-referrer';
					previewImg.onerror = function () {
						showFallbackPreview();
					};
					const placeholder = getPreviewPlaceholder();
					if (placeholder) placeholder.hidden = true;
					previewImg.src = thumbnailURL;
				}

				async function fetchPreview(rawURL) {
					const normalized = (rawURL || '').trim();
					if (!normalized || !/^https?:\/\//i.test(normalized)) {
						clearPreview();
						return;
					}
					if (normalized === lastFetchedUrl) {
						if (thumbHidden.value) {
							showPreview(thumbHidden.value);
						} else {
							showFallbackPreview();
						}
						return;
					}

					const requestID = ++fetchRequestID;
					preview.hidden = false;
					setPreviewLoading(true);
					previewImg.hidden = true;
					const placeholder = getPreviewPlaceholder();
					if (placeholder) placeholder.hidden = false;
					try {
						const resp = await fetch(PREVIEW_URL + '?url=' + encodeURIComponent(normalized), {
							credentials: 'same-origin',
						});
						if (requestID !== fetchRequestID) {
							return;
						}
						if (!resp.ok) {
							lastFetchedUrl = normalized;
							showFallbackPreview();
							return;
						}
						const data = await resp.json();
						if (requestID !== fetchRequestID) {
							return;
						}
						lastFetchedUrl = normalized;
						if (data.thumbnail_url) {
							thumbHidden.value = data.thumbnail_url;
							showPreview(data.thumbnail_url);
						} else {
							showFallbackPreview();
						}
					} catch (err) {
						if (requestID !== fetchRequestID) {
							return;
						}
						lastFetchedUrl = normalized;
						showFallbackPreview();
					} finally {
						if (requestID === fetchRequestID) {
							setPreviewLoading(false);
						}
					}
				}

				function schedulePreview() {
					clearTimeout(debounceTimer);
					debounceTimer = setTimeout(function () {
						fetchPreview(urlInput.value);
					}, 400);
				}

				urlInput.addEventListener('input', schedulePreview);
				urlInput.addEventListener('paste', function () {
					setTimeout(function () {
						fetchPreview(urlInput.value);
					}, 0);
				});

				if (thumbHidden.value && urlInput.value.trim()) {
					lastFetchedUrl = urlInput.value.trim();
					showPreview(thumbHidden.value);
				}
			}

			function initModalForm(modal, initialTags) {
				activeModal = modal;
				const form = modal.querySelector('form');
				if (!form) return;

				const selectedTags = new Set(initialTags || []);
				form._lmSelectedTags = selectedTags;
				syncHiddenTagInputs(form);
				renderTagChips(form);
				bindTagInput(form);
				bindUrlPreview(form);

				if (form.dataset.lmSubmitBound !== '1') {
					form.dataset.lmSubmitBound = '1';
					form.addEventListener('submit', function (e) {
						const tags = getFormSelectedTags(form);
						const tagInput = form.querySelector('.lm-tag-text-input');
						if (tagInput && tagInput.value.trim() && tags.size < MAX_TAGS) {
							addTag(tagInput.value, form);
							tagInput.value = '';
						}
						syncHiddenTagInputs(form);
						if (tags.size < MIN_TAGS || tags.size > MAX_TAGS) {
							e.preventDefault();
							alert('Please add between ' + MIN_TAGS + ' and ' + MAX_TAGS + ' tags.');
						}
					});
				}
			}

			window.openLearningMaterialFormModal = function () {
				const formModal = document.getElementById('lmFormModal');
				if (!formModal) return;
				formModal.hidden = false;
				document.body.classList.add('modal-open');
				initModalForm(formModal, []);
				const desc = formModal.querySelector('#lmDescription');
				if (desc) desc.focus();
			};

			window.closeLearningMaterialFormModal = function () {
				const formModal = document.getElementById('lmFormModal');
				if (formModal) formModal.hidden = true;
				document.body.classList.remove('modal-open');
				activeModal = null;
			};

			window.closeLearningMaterialEditModal = function () {
				const host = document.getElementById('lmEditModalHost');
				if (host) host.innerHTML = '';
				document.body.classList.remove('modal-open');
				activeModal = null;
			};

			const openCreateBtn = document.getElementById('openCreateMaterialBtn');
			if (openCreateBtn) {
				openCreateBtn.addEventListener('click', window.openLearningMaterialFormModal);
			}

			document.body.addEventListener('click', function (e) {
				if (e.target.closest('.lm-form-close')) {
					window.closeLearningMaterialFormModal();
					window.closeLearningMaterialEditModal();
					return;
				}
				const formOverlay = e.target.closest('#lmFormModal');
				if (formOverlay && e.target === formOverlay) {
					window.closeLearningMaterialFormModal();
					return;
				}
				const editOverlay = e.target.closest('#lmEditModal');
				if (editOverlay && e.target === editOverlay) {
					window.closeLearningMaterialEditModal();
				}
			});

			document.addEventListener('keydown', function (e) {
				if (e.key !== 'Escape') return;
				window.closeLearningMaterialEditModal();
				window.closeLearningMaterialFormModal();
			});

			document.body.addEventListener('htmx:afterSwap', function (evt) {
				if (evt.detail.target.id === 'lmEditModalHost') {
					document.body.classList.add('modal-open');
					const editModal = evt.detail.target.querySelector('#lmEditModal');
					const initial = [];
					if (editModal) {
						editModal.querySelectorAll('input[name="tags"]').forEach(function (input) {
							initial.push(input.value);
						});
						initModalForm(editModal, initial);
						const closeBtn = editModal.querySelector('.lm-form-close');
						if (closeBtn) closeBtn.focus();
					}
				}
			});

			const createModal = document.getElementById('lmFormModal');
			if (createModal) {
				initModalForm(createModal, []);
			}
		})();
	</script>
}
