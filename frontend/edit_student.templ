package frontend

import "zion-english/internal/utils"

type StudentRelationshipItem struct {
	RelatedStudentID   string
	RelatedStudentName string
	Relationship       string
}

type EditStudentData struct {
	ID             string
	Readonly       bool
	Name           string
	Currency       string
	Contact        string
	RatePerClass   float64
	ParentName     string
	AssignedColor  string
	Status         string
	InactiveReason string
	TeacherIDs     []string
	TeacherNames   []string
	Relationships  []StudentRelationshipItem
}

templ EditStudent(data EditStudentData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		if data.Readonly {
			<title>View Student - Zion English Admin</title>
		} else {
			<title>Edit Student - Zion English Admin</title>
		}
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		<style>
			.relationship-list {
				display: flex;
				flex-direction: column;
				gap: var(--space-2);
				margin-bottom: var(--space-3);
			}
			.relationship-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: var(--space-3);
				padding: var(--space-2) var(--space-3);
				background: var(--color-muted);
				border-radius: var(--radius-md);
			}
			.inactive-reason-group {
				display: none;
			}
			.inactive-reason-group.is-visible {
				display: block;
			}
		</style>
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@SuccessBanner()
			@ErrorBanner()

			if data.Readonly {
				<div class="form-readonly">
					<div class="form-group">
						<label for="name">Student Name</label>
						<input type="text" id="name" value={ data.Name } disabled/>
					</div>
					<div class="form-row">
						<div class="form-group">
							<label for="currency">Currency</label>
							<input type="text" id="currency" value={ data.Currency } disabled/>
						</div>
						<div class="form-group">
							<label for="status">Status</label>
							<input type="text" id="status" value={ data.Status } disabled/>
						</div>
					</div>
					if data.Status == "inactive" && data.InactiveReason != "" {
						<div class="form-group">
							<label for="inactiveReason">Inactive Reason</label>
							<input type="text" id="inactiveReason" value={ data.InactiveReason } disabled/>
						</div>
					}
					<div class="form-group">
						<label for="contact">Contact</label>
						<input type="text" id="contact" value={ data.Contact } disabled/>
					</div>
					<div class="form-group">
						<label for="ratePerClass">Rate Per Class</label>
						<input type="text" id="ratePerClass" value={ formatFloat(data.RatePerClass) } disabled/>
					</div>
					<div class="form-group">
						<label for="parentName">Parent's Name</label>
						<input type="text" id="parentName" value={ data.ParentName } disabled/>
					</div>
					if len(data.Relationships) > 0 {
						<div class="form-group">
							<label>Related To</label>
							for _, rel := range data.Relationships {
								<input type="text" value={ formatStudentRelationshipLabel(rel) } disabled/>
							}
						</div>
					}
					<div class="form-group">
						<label>Assigned Teachers</label>
						for _, name := range data.TeacherNames {
							<input type="text" value={ name } disabled/>
						}
					</div>
					<div class="form-group">
						<label for="assignedColor">Assigned Color</label>
						<input type="color" id="assignedColor" value={ data.AssignedColor } disabled/>
					</div>
				</div>
				<p><a href={ utils.URL("/students") } class="btn">Back to Students</a></p>
			} else {
				<form
					id="editStudentForm"
					hx-post={ utils.URL("/students/" + data.ID + "/edit") }
					hx-swap="innerHTML"
					hx-target="#logOutput"
				>
					<div class="form-group">
						<label for="name">Student Name *</label>
						<input type="text" id="name" name="name" required value={ data.Name }/>
					</div>
					<div class="form-row">
						@CurrencyDropdownWithValue(data.Currency)
						@StudentStatusDropdownWithValue(data.Status)
					</div>
					<div id="inactiveReasonGroup" class={ inactiveReasonGroupClass(data.Status) }>
						<label for="inactiveReason">Inactive Reason *</label>
						<input type="text" id="inactiveReason" name="inactiveReason" value={ data.InactiveReason } placeholder="Why is this student inactive?"/>
					</div>
					<div class="form-group">
						<label for="contact">Contact</label>
						<input type="text" id="contact" name="contact" value={ data.Contact }/>
					</div>
					<div class="form-group">
						<label for="ratePerClass">Rate Per Class *</label>
						<input type="number" id="ratePerClass" name="ratePerClass" required step="0.01" min="0" value={ formatFloat(data.RatePerClass) }/>
					</div>
					<div class="form-group">
						<label for="parentName">Parent's Name</label>
						<input type="text" id="parentName" name="parentName" value={ data.ParentName }/>
					</div>
					@TeacherAssignRows(data.TeacherIDs)
					<div class="form-group">
						<label for="assignedColor">Assigned Color *</label>
						<input type="color" id="assignedColor" name="assignedColor" required value={ data.AssignedColor }/>
					</div>
					<div class="form-group">
						<label>Related Students</label>
						if len(data.Relationships) > 0 {
							<div class="relationship-list">
								for _, rel := range data.Relationships {
									<label class="relationship-row">
										<span>{ formatStudentRelationshipLabel(rel) }</span>
										<span>
											<input type="checkbox" name="removeRelationship" value={ rel.RelatedStudentID }/>
											Remove
										</span>
									</label>
								}
							</div>
						} else {
							<p class="field-hint">No related students yet.</p>
						}
						<div class="form-row">
							<div class="form-group">
								<label for="relationship">Relationship</label>
								<input type="text" id="relationship" name="relationship" placeholder="siblings"/>
							</div>
							@StudentSearchbox()
						</div>
					</div>
					<button type="submit">Save Changes</button>
				</form>
				<div id="logOutput"></div>
				<script>
					(function () {
						const statusEl = document.getElementById('status');
						const reasonGroup = document.getElementById('inactiveReasonGroup');
						const reasonEl = document.getElementById('inactiveReason');
						if (!statusEl || !reasonGroup) return;
						function syncInactiveReason() {
							const inactive = statusEl.value === 'inactive';
							reasonGroup.classList.toggle('is-visible', inactive);
							if (reasonEl) reasonEl.required = inactive;
						}
						statusEl.addEventListener('change', syncInactiveReason);
						syncInactiveReason();
					})();
				</script>
			}
		</div>
	</body>
	</html>
}

func formatStudentRelationshipLabel(rel StudentRelationshipItem) string {
	if rel.Relationship != "" {
		return rel.Relationship + " → " + rel.RelatedStudentName
	}
	return rel.RelatedStudentName
}

func inactiveReasonGroupClass(status string) string {
	if status == "inactive" {
		return "form-group inactive-reason-group is-visible"
	}
	return "form-group inactive-reason-group"
}
