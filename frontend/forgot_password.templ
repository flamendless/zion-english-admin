package frontend

import "zion-english/internal/utils"

templ ForgotPassword(successMessage string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Forgot Password - Zion English Admin</title>
			<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
			@GlobalIncludes()
			@SuccessBanner()
			@ErrorBanner()
			<style>
				body.login-page {
					min-height: 100vh;
					display: flex;
					justify-content: center;
					align-items: center;
					padding: 20px;
					background: #f7f7f7;
				}

				.login-card {
					background: white;
					border-radius: 8px;
					box-shadow: 0 2px 8px rgba(0,0,0,0.1);
					padding: 40px;
					width: 100%;
					max-width: 400px;
				}

				.login-logo {
					display: block;
					max-width: 200px;
					height: auto;
					margin: 0 auto 30px;
				}

				.login-title {
					text-align: center;
					margin-bottom: 30px;
					color: #333;
				}

				.forgot-message {
					background: #efe;
					border: 1px solid #cfc;
					color: #3c3;
					padding: 10px;
					border-radius: 4px;
					margin-bottom: 20px;
					display: none;
				}

				.forgot-message.show,
				.forgot-message:not(:empty) {
					display: block;
				}

				.forgot-error {
					background: #fee;
					border: 1px solid #fcc;
					color: #c33;
					padding: 10px;
					border-radius: 4px;
					margin-bottom: 20px;
					display: none;
				}

				.forgot-error.show,
				.forgot-error:not(:empty) {
					display: block;
				}

				.login-links {
					text-align: center;
					margin-top: 20px;
				}

				@media (max-width: 480px) {
					body.login-page {
						align-items: flex-start;
						padding-top: 40px;
					}

					.login-card {
						padding: 25px;
					}
				}
			</style>
		</head>
		<body class="login-page">
			<div class="login-card">
				<img src={ utils.URL("/static/logo.png") } alt="Zion English" class="login-logo"/>
				<h1 class="login-title">Forgot Password</h1>
				if successMessage != "" {
					<div class="forgot-message show">{ successMessage }</div>
				}
				<div id="forgotResult"></div>
				<form>
					<div class="form-group">
						<label for="email">Email</label>
						<input
							type="email"
							name="email"
							id="email"
							required
							placeholder="Enter your email"
						/>
					</div>
					<div class="form-group" style="text-align: center;">
						<button
							hx-post={ utils.URL("/auth/forgot-password") }
							hx-target="#forgotResult"
							hx-swap="innerHTML"
						>
							Send reset password
						</button>
					</div>
				</form>
				<p class="login-links">
					<a href={ utils.URL("/auth/login") }>Back to login</a>
				</p>
			</div>
			<script>
				document.body.addEventListener('htmx:afterSwap', function(evt) {
					if (evt.detail.target.id === 'forgotResult') {
						var text = evt.detail.target.textContent.trim();
						if (text && evt.detail.target.querySelector('.forgot-error')) {
							showErrorBanner(text);
						}
					}
				});
			</script>
		</body>
	</html>
}

templ ForgotPasswordSuccess() {
	<div class="forgot-message show">Password reset sent</div>
}

templ ForgotPasswordError(message string) {
	<div class="forgot-error show">{ message }</div>
}

templ ResetPassword(email string, token string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Reset Password - Zion English Admin</title>
			<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
			@GlobalIncludes()
			@SuccessBanner()
			@ErrorBanner()
			<style>
				body.login-page {
					min-height: 100vh;
					display: flex;
					justify-content: center;
					align-items: center;
					padding: 20px;
					background: #f7f7f7;
				}

				.login-card {
					background: white;
					border-radius: 8px;
					box-shadow: 0 2px 8px rgba(0,0,0,0.1);
					padding: 40px;
					width: 100%;
					max-width: 400px;
				}

				.login-logo {
					display: block;
					max-width: 200px;
					height: auto;
					margin: 0 auto 30px;
				}

				.login-title {
					text-align: center;
					margin-bottom: 20px;
					color: #333;
				}

				.reset-banner {
					background: #efe;
					border: 1px solid #cfc;
					color: #3c3;
					padding: 10px;
					border-radius: 4px;
					margin-bottom: 20px;
					text-align: center;
				}

				.reset-error {
					background: #fee;
					border: 1px solid #fcc;
					color: #c33;
					padding: 10px;
					border-radius: 4px;
					margin-bottom: 20px;
					display: none;
				}

				.reset-error.show,
				.reset-error:not(:empty) {
					display: block;
				}

				.error-message {
					display: none;
					color: #c33;
					font-size: 13px;
					margin-top: 4px;
				}

				.error-message.show {
					display: block;
				}

				.login-links {
					text-align: center;
					margin-top: 20px;
				}

				@media (max-width: 480px) {
					body.login-page {
						align-items: flex-start;
						padding-top: 40px;
					}

					.login-card {
						padding: 25px;
					}

					.password-wrapper input {
						padding-right: 65px;
					}
				}
			</style>
		</head>
		<body class="login-page">
			<div class="login-card">
				<img src={ utils.URL("/static/logo.png") } alt="Zion English" class="login-logo"/>
				<h1 class="login-title">Reset Password</h1>
				<div class="reset-banner">Password reset sent</div>
				<div id="resetError" class="reset-error"></div>
				<form id="resetForm">
					<input type="hidden" name="token" value={ token }/>
					<div class="form-group">
						<label for="email">Email</label>
						<input
							type="email"
							name="email"
							id="email"
							value={ email }
							readonly
						/>
					</div>
					<div class="form-group">
						<label for="password">New Password</label>
						<div class="password-wrapper">
							<input
								type="password"
								id="password"
								name="password"
								required
								minlength="8"
								maxlength="32"
								placeholder="8-32 characters with uppercase, lowercase, number, and symbol (!@#%^&*?)"
							/>
							@ShowPassword("password")
						</div>
						<div class="error-message" id="passwordError">Password must be 8-32 characters with uppercase, lowercase, number, and symbol (!@#$%^&*?)</div>
					</div>
					<div class="form-group">
						<label for="confirmPassword">Confirm Password</label>
						<div class="password-wrapper">
							<input
								type="password"
								id="confirmPassword"
								name="confirmPassword"
								required
								minlength="8"
								maxlength="32"
								placeholder="Re-enter password"
							/>
							@ShowPassword("confirmPassword")
						</div>
						<div class="error-message" id="confirmPasswordError">Passwords do not match</div>
					</div>
					<div class="form-group" style="text-align: center;">
						<button
							type="submit"
							id="resetBtn"
							hx-post={ utils.URL("/auth/forgot-password/reset") }
							hx-target="#resetError"
							hx-swap="innerHTML"
						>
							Reset password
						</button>
					</div>
				</form>
				<p class="login-links">
					<a href={ utils.URL("/auth/login") }>Back to login</a>
				</p>
			</div>
			<script>
				(function() {
					var reLength = /^[A-Za-z\d!@#$%^&*?]{8,32}$/;
					var reLower = /[a-z]/;
					var reUpper = /[A-Z]/;
					var reDigit = /\d/;
					var reSpecial = /[!@#$%^&*?]/;

					function validatePassword(p) {
						return reLength.test(p) && reLower.test(p) && reUpper.test(p) &&
							reDigit.test(p) && reSpecial.test(p);
					}

					function showError(id, show) {
						var el = document.getElementById(id);
						if (el) {
							el.classList.toggle('show', show);
						}
					}

					function validateForm() {
						var password = document.getElementById('password').value;
						var confirm = document.getElementById('confirmPassword').value;
						var passwordValid = validatePassword(password);
						var confirmValid = password === confirm && confirm !== '';
						showError('passwordError', !passwordValid);
						showError('confirmPasswordError', !confirmValid);
						return passwordValid && confirmValid;
					}

					document.getElementById('password').addEventListener('blur', validateForm);
					document.getElementById('confirmPassword').addEventListener('blur', validateForm);

					document.body.addEventListener('htmx:beforeRequest', function(evt) {
						if (evt.detail.elt.id === 'resetBtn' && !validateForm()) {
							evt.preventDefault();
						}
					});

					document.body.addEventListener('htmx:afterSwap', function(evt) {
						if (evt.detail.target.id === 'resetError' && evt.detail.target.textContent.trim()) {
							showErrorBanner(evt.detail.target.textContent.trim());
						}
					});
				})();
			</script>
		</body>
	</html>
}
