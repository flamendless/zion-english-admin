package frontend

import "fmt"
import "time"
import "zion-english/internal/models"
import "zion-english/internal/utils"

var onceScrPassword = templ.NewOnceHandle()

templ Flam() {
	<p class="made-by">
		made by
		<a href="https://flamendless.xyz" target="_blank">{ "@" }flamendless</a>
	</p>
}

templ ActionCard(url string, h2 string, desc string) {
	<a href={ utils.URL(url) } class="card">
		<h2>{ h2 }</h2>
		<p>{ desc }</p>
	</a>
}

templ TeacherOptions(teachers []models.TeacherAPIResponse) {
	<option value="">-- Select Teacher --</option>
	for _, t := range teachers {
		<option
			value={ fmt.Sprintf("%d", t.ID) }
			data-rate={ fmt.Sprintf("%.2f", t.RatePerClass) }
			data-id={ t.ID }
			data-name={ t.Name }
			data-driveurl={ t.DriveUrl }
			data-template={ t.Template }
		>
			{ t.Name }
		</option>
	}
}

templ StudentOptions(students []models.StudentAPIResponse) {
	<option value="">-- Select Student --</option>
	for _, s := range students {
		<option value={ fmt.Sprintf("%d", s.ID) } data-rate={ fmt.Sprintf("%.2f", s.RatePerClass) } data-currency={ s.Currency }>{ s.Name }</option>
	}
}

templ DatePreset() {
	{{
		now := time.Now()
		year, month, _ := now.Date()
		firstOfMonth := time.Date(year, month, 1, 0, 0, 0, 0, time.Local)
		lastOfMonth := firstOfMonth.AddDate(0, 1, -1).Day() // Day() gives day number

		a := time.Date(year, month, 1, 0, 0, 0, 0, time.Local).Format("2006-01-02")
		b := time.Date(year, month, 15, 0, 0, 0, 0, time.Local).Format("2006-01-02")
		c := time.Date(year, month, 16, 0, 0, 0, 0, time.Local).Format("2006-01-02")
		d := time.Date(year, month, lastOfMonth, 0, 0, 0, 0, time.Local).Format("2006-01-02")
	}}
	<div class="form-group">
		<label for="datePreset">Date Range</label>
		<select id="datePreset" name="datePreset">
			<option value="">-- Select Range --</option>
			<option value={ fmt.Sprintf("%s|%s", a, b) }>first cut-off</option>
			<option value={ fmt.Sprintf("%s|%s", c, d) }>second cut-off</option>
		</select>
	</div>
}

templ NavLink(url string, id string, text string) {
	<a href={ utils.URL(url) } id={ id } class="nav-link">{ text }</a>
}

templ DriveURLInput() {
	<div class="form-group">
		<label for="driveUrl">Spreadsheet URL *</label>
		<input
			type="text"
			id="driveUrl"
			name="driveUrl"
			required
			placeholder="https://docs.google.com/spreadsheets/..."
		/>
		<div class="error-message" id="driveUrlError"></div>
	</div>
}

templ DateInput(id string, text string) {
	<div class="form-group">
		<label for={ id }>{ text }</label>
		<input type="date" id={ id } name={ id } required/>
		{ children... }
	</div>
}

templ LoginButton() {
	<a href={ utils.URL("/auth/login") } class="btn">Login</a>
}

templ Logout() {
	<button
		hx-post={ utils.URL("/auth/logout") }
		hx-trigger="click"
	>
		Logout
	</button>
}

templ displayURL(value string) {
	if value != "" {
		<a href={ templ.SafeURL(value) } target="_blank">
			open in new tab
		</a>
	} else {
		<p>-</p>
	}
}

templ ShowPassword(inputID string) {
	<button type="button" class="password-toggle" data-target={ inputID } onclick="togglePasswordField(this)">Show</button>

	@onceScrPassword.Once() {
		<style>
			.password-wrapper {
				position: relative;
				width: 100%;
			}

			.password-wrapper input {
				width: 100%;
				padding-right: 60px; /* space for toggle */
			}

			.password-wrapper .password-toggle {
				position: absolute !important;
				right: 12px;
				top: 50%;
				transform: translateY(-50%);
				background: none;
				border: none;
				cursor: pointer;
				font-size: 14px;
				color: #666;
				padding: 0;
				margin: 0;
				width: auto;
			}
		</style>
		<script>
			function togglePasswordField(btn) {
				const passwordInput = document.getElementById(btn.dataset.target);
				if (!passwordInput) return;
				if (passwordInput.type === 'password') {
					passwordInput.type = 'text';
					btn.textContent = 'Hide';
				} else {
					passwordInput.type = 'password';
					btn.textContent = 'Show';
				}
			}
		</script>
	}
}
