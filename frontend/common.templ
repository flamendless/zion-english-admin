package frontend

import "fmt"
import "time"
import "zion-english/internal/models"
import "zion-english/internal/utils"

var onceScrPassword = templ.NewOnceHandle()

templ Flam() {
	<p class="made-by">
		made by
		<a href="https://flamendless.xyz" target="_blank">{ "@" }flamendless</a>
	</p>
}

templ ActionCard(url string, h2 string, desc string) {
	<a href={ utils.URL(url) } class="card">
		<h2>{ h2 }</h2>
		<p>{ desc }</p>
	</a>
}

templ TeacherOptions(teachers []models.TeacherAPIResponse) {
	<option value="">-- Select Teacher --</option>
	for _, t := range teachers {
		<option
			value={ fmt.Sprintf("%d", t.ID) }
			data-rate={ fmt.Sprintf("%.2f", t.RatePerClass) }
			data-id={ t.ID }
			data-name={ t.Name }
			data-driveurl={ t.DriveUrl }
			data-template={ t.Template }
		>
			{ t.Name }
		</option>
	}
}

templ StudentOptions(students []models.StudentAPIResponse) {
	<option value="">-- Select Student --</option>
	for _, s := range students {
		<option value={ fmt.Sprintf("%d", s.ID) } data-rate={ fmt.Sprintf("%.2f", s.RatePerClass) } data-currency={ s.Currency }>{ s.Name }</option>
	}
}

templ StudentSearchResults(students []models.StudentAPIResponse) {
	<div class="student-search-results">
		for _, s := range students {
			<button
				type="button"
				class="student-search-item"
				data-id={ fmt.Sprintf("%d", s.ID) }
				data-name={ s.Name }
				_="
					on click
						set #relatedStudentId.value to my @data-id
						set #relatedStudentSearch.value to my @data-name
						set #relatedStudentResults.innerHTML to ''
					end
				"
			>
				{ s.Name }
			</button>
		}
	</div>
}

templ DatePreset() {
	{{
		now := time.Now()
		year, month, _ := now.Date()
		firstOfMonth := time.Date(year, month, 1, 0, 0, 0, 0, time.Local)
		lastOfMonth := firstOfMonth.AddDate(0, 1, -1).Day() // Day() gives day number

		a := time.Date(year, month, 1, 0, 0, 0, 0, time.Local).Format("2006-01-02")
		b := time.Date(year, month, 15, 0, 0, 0, 0, time.Local).Format("2006-01-02")
		c := time.Date(year, month, 16, 0, 0, 0, 0, time.Local).Format("2006-01-02")
		d := time.Date(year, month, lastOfMonth, 0, 0, 0, 0, time.Local).Format("2006-01-02")
	}}
	<div class="form-group">
		<label for="datePreset">Date Range</label>
		<select id="datePreset" name="datePreset">
			<option value="">-- Select Range --</option>
			<option value={ fmt.Sprintf("%s|%s", a, b) }>first cut-off</option>
			<option value={ fmt.Sprintf("%s|%s", c, d) }>second cut-off</option>
		</select>
	</div>
}

templ NavLink(url string, id string, text string) {
	<a href={ utils.URL(url) } id={ id } class="nav-link">{ text }</a>
}

templ DriveURLInput() {
	<div class="form-group">
		<label for="driveUrl">Google Sheet URL *</label>
		<p class="field-hint">Link to your Google Sheet that you use for tracking classes</p>
		<input
			type="text"
			id="driveUrl"
			name="driveUrl"
			required
			placeholder="https://docs.google.com/spreadsheets/..."
		/>
		<div class="error-message" id="driveUrlError">Google Sheet URL is required</div>
	</div>
}

templ DateInput(id string, text string) {
	<div class="form-group">
		<label for={ id }>{ text }</label>
		<input type="date" id={ id } name={ id } required/>
		{ children... }
	</div>
}

templ LoginButton() {
	<a href={ utils.URL("/auth/login") } class="btn">Login</a>
}

templ Logout() {
	<button
		hx-post={ utils.URL("/auth/logout") }
		hx-trigger="click"
	>
		Logout
	</button>
}

templ displayURL(value string) {
	if value != "" {
		<a href={ templ.SafeURL(value) } target="_blank">
			open in new tab
		</a>
	} else {
		<p>-</p>
	}
}

templ ShowPassword(inputID string) {
	<button
		type="button"
		class="password-toggle"
		data-target={ inputID }
		aria-label="Show password"
		onclick="togglePasswordField(this)"
	>
		<svg class="password-toggle-icon password-toggle-show" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>
			<circle cx="12" cy="12" r="3"></circle>
		</svg>
		<svg class="password-toggle-icon password-toggle-hide" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-6.5 0-10-7-10-7a20.77 20.77 0 0 1 5.06-5.94"></path>
			<path d="M9.9 4.24A10.94 10.94 0 0 1 12 5c6.5 0 10 7 10 7a20.77 20.77 0 0 1-3.17 4.19"></path>
			<path d="M1 1l22 22"></path>
			<path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
		</svg>
	</button>

	@onceScrPassword.Once() {
		<style>
			.password-wrapper {
				position: relative;
				width: 100%;
			}

			.password-wrapper input {
				width: 100%;
				padding-right: 44px;
			}

			.password-wrapper .password-toggle {
				position: absolute !important;
				right: 6px;
				top: 50%;
				transform: translateY(-50%);
				background: none;
				border: none;
				cursor: pointer;
				color: var(--color-muted-foreground);
				padding: 0;
				margin: 0;
				width: 36px;
				height: 36px;
				border-radius: var(--radius-sm);
				display: inline-flex;
				align-items: center;
				justify-content: center;
				transition: background-color var(--transition-fast), color var(--transition-fast);
			}

			.password-wrapper .password-toggle:hover {
				background-color: var(--color-info-bg);
				color: var(--color-accent);
			}

			.password-wrapper .password-toggle:active {
				transform: translateY(-50%);
			}

			.password-toggle-icon {
				display: block;
			}

			.password-toggle-hide {
				display: none;
			}

			.password-toggle.is-visible .password-toggle-show {
				display: none;
			}

			.password-toggle.is-visible .password-toggle-hide {
				display: block;
			}
		</style>
		<script>
			function togglePasswordField(btn) {
				const passwordInput = document.getElementById(btn.dataset.target);
				if (!passwordInput) return;
				const isPassword = passwordInput.type === 'password';
				passwordInput.type = isPassword ? 'text' : 'password';
				btn.classList.toggle('is-visible', isPassword);
				btn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
			}
		</script>
	}
}
