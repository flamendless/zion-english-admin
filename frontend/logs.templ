package frontend

import "zion-english/internal/utils"

type ProcessingLogData struct {
	Logs []ProcessingLogItem
}

type ProcessingLogItem struct {
	ID             string
	GoogleDriveURL string
	Name           string
	Template       string
	StartDate      string
	EndDate        string
	ExcludedRows   string
	UserAgent      string
	OutputPath     string
	Errors         string
	CreatedAt      string
}

func getErrorClass(errors string) string {
	if errors != "" {
		return "error-cell"
	}
	return "success-cell"
}

func getErrorTitle(errors string) string {
	if errors != "" {
		return errors
	}
	return "No errors"
}

func getErrorDisplay(errors string) string {
	if errors != "" {
		return errors
	}
	return "Success"
}

func getDisplayValue(value string) string {
	if value != "" {
		return value
	}
	return "-"
}

templ ProcessingLogs(data ProcessingLogData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Processing Logs - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()

			<div class="button-group">
				<button
					class="refresh-btn"
					id="refreshBtn"
				>
					Refresh
				</button>
			</div>

			if len(data.Logs) > 0 {
				<div class="table-wrapper">
				<table id="logsTable">
					<thead>
						<tr>
							<th>ID</th>
							<th>Name</th>
							<th>Output</th>
							<th>Template</th>
							<th>Date Range</th>
							<th>Excluded Rows</th>
							<th>Created At</th>
							<th>Errors</th>
						</tr>
					</thead>
					<tbody>
						for _, log := range data.Logs {
							<tr>
								<td>{ log.ID }</td>
								<td>{ log.Name }</td>
								<td>{ log.OutputPath }</td>
								<td>{ getDisplayValue(log.Template) }</td>
								<td class="date-cell">{ log.StartDate } - { log.EndDate }</td>
								<td>{ getDisplayValue(log.ExcludedRows) }</td>
								<td class="date-cell">{ log.CreatedAt }</td>
								<td class={ getErrorClass(log.Errors) } title={ getErrorTitle(log.Errors) }>
									{ getErrorDisplay(log.Errors) }
								</td>
							</tr>
						}
					</tbody>
				</table>
				</div>
			} else {
				<div class="empty-state">No processing logs found.</div>
			}
		</div>

		<script>
			document.getElementById('refreshBtn').addEventListener('click', () => {
				window.location.reload();
			});
		</script>
	</body>
	</html>
}
