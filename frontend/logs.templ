package frontend

type LogData struct {
	Logs []LogItem
}

type LogItem struct {
	ID             string
	GoogleDriveURL string
	Name           string
	Template       string
	StartDate      string
	EndDate        string
	ExcludedRows   string
	UserAgent      string
	OutputPath     string
	Errors         string
	CreatedAt      string
}

func getErrorClass(errors string) string {
	if errors != "" {
		return "error-cell"
	}
	return "success-cell"
}

func getErrorTitle(errors string) string {
	if errors != "" {
		return errors
	}
	return "No errors"
}

func getErrorDisplay(errors string) string {
	if errors != "" {
		return errors
	}
	return "Success"
}

func getDisplayValue(value string) string {
	if value != "" {
		return value
	}
	return "-"
}

templ Logs(logs LogData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Logs - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" id="favicon">
		<style>
			.export-btn {
				background-color: #2196F3;
			}

			.export-btn:hover {
				background-color: #0b7dda;
			}

			.refresh-btn {
				background-color: #FF9800;
			}

			.refresh-btn:hover {
				background-color: #e68900;
			}

			table {
				width: 100%;
				border-collapse: collapse;
				margin-bottom: 20px;
				font-size: 14px;
			}

			.error-cell {
				color: #dc3545;
				max-width: 200px;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.error-cell:hover {
				white-space: normal;
				word-break: break-word;
			}

			.success-cell {
				color: #28a745;
			}

			.empty-state {
				text-align: center;
				padding: 40px;
				color: #666;
			}

			.date-cell {
				white-space: nowrap;
			}

			.loading {
				text-align: center;
				padding: 40px;
				color: #666;
			}
		</style>
	</head>
	<body>
		<div class="container">
			@HeaderSimple("Processing Logs")

			<div class="button-group">
				<button class="refresh-btn" id="refreshBtn">Refresh</button>
			</div>

			if len(logs.Logs) > 0 {
				<table id="logsTable">
					<thead>
						<tr>
							<th>ID</th>
							<th>Name</th>
							<th>Output</th>
							<th>Template</th>
							<th>Date Range</th>
							<th>Excluded Rows</th>
							<th>Created At</th>
							<th>Errors</th>
						</tr>
					</thead>
					<tbody>
						for _, log := range logs.Logs {
							<tr>
								<td>{ log.ID }</td>
								<td>{ log.Name }</td>
								<td>{ log.OutputPath }</td>
								<td>{ getDisplayValue(log.Template) }</td>
								<td class="date-cell">{ log.StartDate } - { log.EndDate }</td>
								<td>{ getDisplayValue(log.ExcludedRows) }</td>
								<td class="date-cell">{ log.CreatedAt }</td>
								<td class={ getErrorClass(log.Errors) } title={ getErrorTitle(log.Errors) }>
									{ getErrorDisplay(log.Errors) }
								</td>
							</tr>
						}
					</tbody>
				</table>
			} else {
				<div class="empty-state">No processing logs found.</div>
			}
		</div>

		<script>
			function getBaseURL() {
				const pathname = window.location.pathname;
				const cleanPath = pathname.replace(/\/$/, '');
				const parts = cleanPath.split('/').filter(p => p !== '');

				if (parts.length === 0 || cleanPath.endsWith('.html')) {
					if (cleanPath.includes('/zion-english-admin')) {
						return '/zion-english-admin';
					}
					return '';
				}

				if (parts.length === 1) {
					return '/' + parts[0];
				}

				return '/' + parts.slice(0, -1).join('/');
			}

			const baseURL = getBaseURL();

			function buildURL(path) {
				return baseURL + path;
			}

			const refreshBtn = document.getElementById('refreshBtn');

			refreshBtn.addEventListener('click', () => {
				window.location.reload();
			});

			const favicon = document.getElementById('favicon');
			if (favicon) {
				favicon.href = buildURL('/static/favicon.ico');
			}
		</script>
	</body>
	</html>
}
