package frontend

import "zion-english/internal/utils"

type ProcessingLogData struct {
	Logs           []ProcessingLogItem
	Query          string
	StartDate      string
	EndDate        string
	SortBy         string
	SortOrder      string
	PageNumber     int
	PageTotalPages int
	PageTotal      int64
	PrevURL        string
	NextURL        string
	HasPrev        bool
	HasNext        bool
	FilterPath     string
}

type ProcessingLogItem struct {
	ID             string
	GoogleDriveURL string
	Name           string
	Template       string
	StartDate      string
	EndDate        string
	ExcludedRows   string
	UserAgent      string
	OutputPath     string
	Errors         string
	CreatedAt      string
}

func getErrorClass(errors string) string {
	if errors != "" {
		return "error-cell"
	}
	return "success-cell"
}

func getErrorTitle(errors string) string {
	if errors != "" {
		return errors
	}
	return "No errors"
}

func getErrorDisplay(errors string) string {
	if errors != "" {
		return errors
	}
	return "Success"
}

templ ProcessingLogs(data ProcessingLogData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Processing Logs - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@HubHeader("Processing Logs", "", "", false)

			<div class="button-group">
				<a href={ utils.URL("/process") } class="add-btn">Back to Process</a>
			</div>

			@ListFilterForm(data.FilterPath, data.Query, "", "", "", "", "", data.StartDate, data.EndDate, false, false, false, true, false, data.SortBy, data.SortOrder, ListSortKindProcessingLog)

			if len(data.Logs) > 0 {
				<div class="table-wrapper">
				<table id="logsTable" class="table-stack-mobile">
					<thead>
						<tr>
							<th>ID</th>
							<th>Name</th>
							<th>Output</th>
							<th>Template</th>
							<th>Date Range</th>
							<th>Excluded Rows</th>
							<th>Created At</th>
							<th>Errors</th>
						</tr>
					</thead>
					<tbody>
						for _, log := range data.Logs {
							<tr>
								<td data-label="ID">{ log.ID }</td>
								<td data-label="Name">{ log.Name }</td>
								<td data-label="Output">{ log.OutputPath }</td>
								<td data-label="Template">{ getDisplayValue(log.Template) }</td>
								<td class="date-cell" data-label="Date Range">{ log.StartDate } - { log.EndDate }</td>
								<td data-label="Excluded">{ getDisplayValue(log.ExcludedRows) }</td>
								<td class="date-cell" data-label="Created">{ log.CreatedAt }</td>
								<td class={ getErrorClass(log.Errors) } data-label="Errors" title={ getErrorTitle(log.Errors) }>
									{ getErrorDisplay(log.Errors) }
								</td>
							</tr>
						}
					</tbody>
				</table>
				</div>
				@PaginationBar(data.HasPrev, data.PrevURL, data.HasNext, data.NextURL, data.PageNumber, data.PageTotalPages, data.PageTotal)
			} else {
				<div class="empty-state">No processing logs found.</div>
			}
		</div>
	</body>
	</html>
}
