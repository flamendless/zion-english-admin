package frontend

import "zion-english/internal/utils"

templ Login(successMessage string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Login - Zion English Admin</title>
			<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
			@GlobalIncludes()
			@SuccessBanner()
			@ErrorBanner()
		</head>

		<body class="auth-page">
			<div class="auth-card">
				<img src={ utils.URL("/static/logo.png") } alt="Zion English" class="auth-logo"/>
				<h1 class="auth-title">Login</h1>
				<div id="loginError" class="login-error" role="alert"></div>
				<div id="loginSuccess" class="login-success"></div>
				<form>
					<div class="form-group">
						<label for="email">Email</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							placeholder="Enter your email"
							autocomplete="email"
						/>
					</div>
					<div class="form-group">
						<label for="password">Password</label>
						<div class="password-wrapper">
							<input
								type="password"
								id="password"
								name="password"
								required
								placeholder="Enter your password"
								autocomplete="current-password"
							/>
							@ShowPassword("password")
						</div>
					</div>
					<div class="form-group">
						<button
							hx-post={ utils.URL("/auth/login") }
							hx-target="#loginError"
							hx-swap="innerHTML"
						>
							Login
						</button>
					</div>
				</form>
				<p class="auth-links">
					<a href={ utils.URL("/teachers/register") }>Register as a teacher</a>
					<br/>
					<a href={ utils.URL("/auth/forgot-password") }>Forgot password?</a>
				</p>
				<div class="auth-footer">
					@Flam()
				</div>
			</div>
			if successMessage != "" {
				@SuccessBannerScript(successMessage)
			}
			<script>
				document.body.addEventListener('htmx:afterSwap', function(evt) {
					if (evt.detail.target.id === 'loginError' && evt.detail.target.textContent.trim()) {
						showErrorBanner(evt.detail.target.textContent.trim());
					}
				});
			</script>
		</body>
	</html>
}
