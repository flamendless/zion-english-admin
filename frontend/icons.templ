		<path d="M8 16H3v5"></path>
	</svg>
}

templ iconSVGMarkRead() {
	<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h8"></path>
		<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
		<polyline points="16 19 18 21 22 17"></polyline>
	</svg>
}

templ iconSVGSortAsc() {
	<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M4 6h11"></path>
		<path d="M4 12h7"></path>
		<path d="M4 18h4"></path>
		<path d="m15 8 3-3 3 3"></path>
		<path d="M18 5v14"></path>
	</svg>
}

templ iconSVGSortDesc() {
	<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M4 6h4"></path>
		<path d="M4 12h7"></path>
		<path d="M4 18h11"></path>
		<path d="m15 16 3 3 3-3"></path>
		<path d="M18 5v14"></path>
	</svg>
}

templ IconSVG(kind IconKind) {
	switch kind {
		case IconKindView:
			@iconSVGView()
		case IconKindEdit:
			@iconSVGEdit()
		case IconKindConduct, IconKindApprove:
			@iconSVGCheck()
		case IconKindCancel:
			@iconSVGCancel()
		case IconKindDelete, IconKindWarning:
			@iconSVGTrash()
		case IconKindReject:
			@iconSVGReject()
		case IconKindUnapprove:
			@iconSVGUnapprove()
		case IconKindExternal:
			@iconSVGExternal()
		case IconKindDownload:
			@iconSVGDownload()
		case IconKindGenerate:
			@iconSVGGenerate()
		case IconKindRegenerate:
			@iconSVGRegenerate()
		case IconKindMarkRead:
			@iconSVGMarkRead()
		case IconKindSortAsc:
			@iconSVGSortAsc()
		case IconKindSortDesc:
			@iconSVGSortDesc()
	}
}

templ IconActionLink(href string, label string, kind IconKind) {
	<a href={ href } class={ iconActionClass(kind) } data-tooltip={ label } aria-label={ label }>
		@IconSVG(kind)
	</a>
}

templ IconActionLinkExternal(href string, label string, kind IconKind) {
	<a href={ href } class={ iconActionClass(kind) } data-tooltip={ label } aria-label={ label } target="_blank" rel="noopener noreferrer">
		@IconSVG(kind)
	</a>
}

templ IconActionButton(label string, kind IconKind, attrs templ.Attributes) {
	<button
		type="button"
		class={ iconActionClass(kind) }
		data-tooltip={ label }
		aria-label={ label }
		{ attrs... }
	>
		@IconSVG(kind)
	</button>
}

templ IconActionTrigger(label string, kind IconKind, attrs templ.Attributes) {
	<a
		href="#"
		class={ iconActionClass(kind) }
		role="button"
		data-tooltip={ label }
		aria-label={ label }
		{ attrs... }
	>
		@IconSVG(kind)
	</a>
}

templ IconActionSubmit(label string, kind IconKind) {
	<button type="submit" class={ iconActionClass(kind) } data-tooltip={ label } aria-label={ label }>
		@IconSVG(kind)
	</button>
}
