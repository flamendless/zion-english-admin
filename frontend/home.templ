package frontend

import "zion-english/internal/auth"
import "zion-english/internal/utils"
import "fmt"

type CurrencyTotal struct {
	Currency string
	Total    float64
}

type DashboardCurrencySection struct {
	Title  string
	Totals []CurrencyTotal
}

type DashboardData struct {
	Role                   auth.Role
	Avatar                 AvatarProps
	Onboarding             OnboardingChecklistData
	ShowOnboarding         bool
	ActiveStudents         int64
	InactiveStudents       int64
	PendingTeachers        int64
	PendingDocuments       int64
	PendingIntroVideos     int64
	MyStudentCount         int64
	ClassesConductedWeek   int64
	ClassesCancelledWeek   int64
	ClassesRescheduledWeek int64
	ScheduledToday         int64
	MonthlyTotals          []CurrencyTotal
	ParentMonthlyTotals           []CurrencyTotal
	FirstCutoffTotals             []CurrencyTotal
	SecondCutoffTotals            []CurrencyTotal
	StudentsWithoutParent         int64
	StudentsWithoutParentRate     int64
}

templ Home(data DashboardData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		<style>
			.stat-link-rows {
				display: flex;
				flex-direction: column;
				gap: var(--space-2);
			}

			.stat-link-row {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: var(--space-3);
				text-decoration: none;
				color: inherit;
				padding: var(--space-1) 0;
			}

			.stat-link-row:hover .stat-link-row-value {
				color: var(--color-primary);
			}

			.stat-link-row-label {
				font-size: 0.8rem;
				color: var(--color-muted-foreground);
			}

			.stat-link-row-value {
				font-size: 1.1rem;
				font-weight: 600;
				font-variant-numeric: tabular-nums;
				line-height: 1.2;
			}

			.stat-section {
				display: flex;
				flex-direction: column;
				gap: var(--space-1);
			}

			.stat-section + .stat-section {
				margin-top: var(--space-2);
				padding-top: var(--space-2);
				border-top: 1px solid var(--color-border-subtle);
			}

			.stat-section-title {
				font-size: 0.75rem;
				font-weight: 600;
				color: var(--color-muted-foreground);
				text-transform: uppercase;
				letter-spacing: 0.03em;
			}

			.dashboard-setup-section {
				margin-bottom: var(--space-6);
			}
		</style>
	</head>
	<body>
		<div class="home-container">
			<div class="home-title">
				<img src={utils.URL("/static/logo.png")} alt="Zion English" class="home-logo">
			</div>
			<div class="home-top-bar">
				<div class="home-top-bar-left">
					@HeaderAvatar(data.Avatar)
					@NotificationBell()
				</div>
				@Logout()
			</div>

			<div class="home-welcome">
				@WelcomeRole()
				@DigitalClock("hero")
				@AnnouncementBanners()
			</div>

			@DashboardStats(data)

			if data.ShowOnboarding {
				<section class="dashboard-setup-section">
					<h2 class="dashboard-section-title">Complete your setup</h2>
					@OnboardingChecklist(data.Onboarding)
				</section>
			}

			<h2 class="dashboard-section-title">Quick actions</h2>
			<div class="cards-grid">
				for _, entry := range DashboardQuickActionEntries(data.Role) {
					switch entry.Kind {
					case NavBarEntryLink:
						if entry.Item.FeatureCard {
							@ActionCardFeature(entry.Item)
						} else {
							@ActionCard(entry.Item)
						}
					case NavBarEntryGroup:
						@NavGroupActionCard(entry.Group)
					}
				}
				for _, item := range DashboardExtraItems(data.Role) {
					@ActionCard(item)
				}
			</div>

			@NavGroupChoiceModals(NavGroups(data.Role))
			@RecordClassFlowModals(ClassWizardPageDataForContext(ctx))
		</div>
	</body>
	</html>
}

templ DashboardSectionedCurrencyStatCard(label string, sections []DashboardCurrencySection) {
	<div class="stat-card">
		<span class="stat-label">{ label }</span>
		for _, section := range sections {
			<div class="stat-section">
				if section.Title != "" {
					<span class="stat-section-title">{ section.Title }</span>
				}
				<div class="stat-currency-rows">
					for _, total := range section.Totals {
						<span class="stat-currency-row">{ utils.FormatCurrency(total.Total, total.Currency) }</span>
					}
				</div>
			</div>
		}
	</div>
}

templ DashboardParentGapStatCard(withoutParent int64, withoutParentRate int64) {
	<div class="stat-card">
		<span class="stat-label">Students Missing Parent Info</span>
		<div class="stat-link-rows">
			<a href={ utils.URL("/students?status=active&parentFilter=missing_name") } class="stat-link-row">
				<span class="stat-link-row-label">Without parent name</span>
				<span class="stat-link-row-value">{ fmt.Sprintf("%d", withoutParent) }</span>
			</a>
			<a href={ utils.URL("/students?status=active&parentFilter=missing_rate") } class="stat-link-row">
				<span class="stat-link-row-label">Without parent rate</span>
				<span class="stat-link-row-value">{ fmt.Sprintf("%d", withoutParentRate) }</span>
			</a>
		</div>
	</div>
}

templ DashboardStats(data DashboardData) {
	<h2 class="dashboard-section-title">Overview</h2>
	<div class="dashboard-stats">
		if auth.HasAdminAccess(data.Role) {
			<div class="stat-card">
				<span class="stat-label">Students</span>
				<span class="stat-value">{ fmt.Sprintf("%d", data.ActiveStudents + data.InactiveStudents) }</span>
				<span class="stat-sub">{ fmt.Sprintf("%d active, %d inactive", data.ActiveStudents, data.InactiveStudents) }</span>
			</div>
			<div class="stat-card">
				<span class="stat-label">Pending Teachers</span>
				<span class="stat-value">{ fmt.Sprintf("%d", data.PendingTeachers) }</span>
			</div>
			<div class="stat-card">
				<span class="stat-label">Pending Documents</span>
				<span class="stat-value">{ fmt.Sprintf("%d", data.PendingDocuments) }</span>
			</div>
			<div class="stat-card">
				<span class="stat-label">Pending Intro Videos</span>
				<span class="stat-value">{ fmt.Sprintf("%d", data.PendingIntroVideos) }</span>
			</div>
			@DashboardParentGapStatCard(data.StudentsWithoutParent, data.StudentsWithoutParentRate)
		}
		if data.Role == auth.RoleTeacher {
			<a href={ utils.URL("/my-students") } class="stat-card stat-card-link">
				<span class="stat-label">My Students</span>
				<span class="stat-value">{ fmt.Sprintf("%d", data.MyStudentCount) }</span>
			</a>
		}
		if data.Role == auth.RoleTeacher || data.Role == auth.RoleTester {
			<div class="stat-card stat-card-accent">
				<span class="stat-label">Scheduled Today</span>
				<span class="stat-value">{ fmt.Sprintf("%d", data.ScheduledToday) }</span>
			</div>
		}
		<div class="stat-card">
			<span class="stat-label">Classes This Week</span>
			<span class="stat-value">{ fmt.Sprintf("%d total", data.ClassesConductedWeek + data.ClassesCancelledWeek + data.ClassesRescheduledWeek) }</span>
			<span class="stat-sub">{ fmt.Sprintf("%d conducted, %d cancelled, %d rescheduled", data.ClassesConductedWeek, data.ClassesCancelledWeek, data.ClassesRescheduledWeek) }</span>
		</div>
		@DashboardSectionedCurrencyStatCard("Cutoffs", []DashboardCurrencySection{
			{Title: "First cutoff", Totals: data.FirstCutoffTotals},
			{Title: "Second cutoff", Totals: data.SecondCutoffTotals},
		})
		if auth.HasAdminAccess(data.Role) {
			@DashboardSectionedCurrencyStatCard("Month", []DashboardCurrencySection{
				{Title: "Teacher rates", Totals: data.MonthlyTotals},
				{Title: "Parent rates", Totals: data.ParentMonthlyTotals},
			})
		} else {
			@DashboardSectionedCurrencyStatCard("Month", []DashboardCurrencySection{
				{Totals: data.MonthlyTotals},
			})
		}
	</div>
}
