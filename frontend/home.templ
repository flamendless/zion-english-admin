package frontend

import "zion-english/internal/utils"

templ Home() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		<style>
			.home-container {
				max-width: 900px;
				margin: 0 auto;
				padding: 40px 20px;
			}

			.home-title {
				text-align: center;
				margin-bottom: 10px;
			}

			.home-logo {
				max-width: 300px;
				height: auto;
			}

			.home-subtitle {
				text-align: center;
				margin-bottom: 40px;
				color: #666;
				font-size: 18px;
			}

			.home-subtitle a {
				color: var(--color-primary);
				text-decoration: none;
				font-weight: 500;
			}

			.home-subtitle a:hover {
				text-decoration: underline;
			}

			.cards-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 30px;
			}

			.card {
				background: white;
				border-radius: 8px;
				padding: 25px;
				box-shadow: 0 2px 8px rgba(0,0,0,0.1);
				transition: transform 0.2s, box-shadow 0.2s;
				text-decoration: none;
				display: block;
			}

			.card:hover {
				transform: translateY(-4px);
				box-shadow: 0 4px 16px rgba(0,0,0,0.15);
			}

			.card h2 {
				margin: 0 0 15px 0;
				font-size: 24px;
				color: #333;
			}

			.card p {
				margin: 0;
				color: #666;
				font-size: 14px;
			}

			.card-icon {
				font-size: 32px;
				margin-bottom: 10px;
			}
		</style>
		@ScrHTMX()
		@ScrHyperscript()
	</head>

	<body>
		<div class="home-container">
			<div class="home-title">
				<img src={utils.URL("/static/logo.png")} alt="Zion English" class="home-logo">
			</div>

			<span style={ "display: flex; flex-direction: row;" }>
				<p class="home-subtext">Admin Tools</p>
				@Flam()
			</span>

			<div class="cards-grid">
				@ActionCard("/classes", "Classes", "View recorded classes")
				@ActionCard("/classes/record", "Record a Class", "Record a new class")

				@ActionCard("/students", "Students", "View and manage students")
				@ActionCard("/students/register", "Register a student", "Add a new student")

				@ActionCard("/teachers", "Teachers", "View and manage teachers")
				@ActionCard("/teachers/register", "Register a teacher", "Add a new teacher")

				@ActionCard("/logs", "Process logs", "View and manage processing logs")
				@ActionCard("/process", "Process", "Process CSV/XLSX files")
			</div>
		</div>
	</body>
	</html>
}
