package frontend

import "zion-english/internal/auth"
import "zion-english/internal/utils"
import "fmt"

type CurrencyTotal struct {
	Currency string
	Total    float64
}

type DashboardCurrencySection struct {
	Title     string
	Totals    []CurrencyTotal
	AdminOnly bool
}

type DashboardData struct {
	Role                   auth.Role
	Avatar                 AvatarProps
	Onboarding             OnboardingChecklistData
	ShowOnboarding         bool
	ActiveStudents         int64
	InactiveStudents       int64
	PendingTeachers        int64
	PendingDocuments       int64
	PendingIntroVideos     int64
	MyStudentCount         int64
	ClassesConductedWeek   int64
	ClassesCancelledWeek   int64
	ClassesRescheduledWeek int64
	ClassesOverdueWeek     int64
	ClassesWeekStart       string
	ClassesWeekEnd         string
	ScheduledToday         int64
	FirstCutoffTotals                 []CurrencyTotal
	SecondCutoffTotals                []CurrencyTotal
	FirstCutoffParentTotals           []CurrencyTotal
	SecondCutoffParentTotals          []CurrencyTotal
	AllTeachersFirstCutoffTotals      []CurrencyTotal
	AllTeachersSecondCutoffTotals     []CurrencyTotal
	AllTeachersFirstCutoffParentTotals  []CurrencyTotal
	AllTeachersSecondCutoffParentTotals []CurrencyTotal
	StudentsWithoutParent             int64
	StudentsWithoutParentRate         int64
	TotalTeachers                     int64
	TeachersWithoutZoom               int64
	TeachersWithoutGoogleCal int64
	TeachersWithoutCV             int64
	TeachersWithoutProfileAvatar  int64
	ShowPaymentReceipt                bool
	PaymentReceipt                    PaymentReceiptData
}

templ Home(data DashboardData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		<style>
			.stat-link-rows {
				display: flex;
				flex-direction: column;
				gap: var(--space-2);
			}

			.stat-link-row {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: var(--space-3);
				text-decoration: none;
				color: inherit;
				padding: var(--space-1) 0;
			}

			.stat-link-row:hover .stat-link-row-value {
				color: var(--color-primary);
			}

			.stat-link-row-label {
				font-size: 0.8rem;
				color: var(--color-muted-foreground);
			}

			.stat-link-row-value {
				font-size: 1.1rem;
				font-weight: 600;
				font-variant-numeric: tabular-nums;
				line-height: 1.2;
			}

			.stat-value-signifier {
				align-self: stretch;
				border-bottom: 1px dotted var(--color-primary);
			}

			.stat-link-row-value-wrap {
				display: inline-flex;
				flex-direction: column;
				align-items: flex-end;
				width: fit-content;
				gap: var(--space-1);
			}

			.stat-section {
				display: flex;
				flex-direction: column;
				gap: var(--space-1);
			}

			.stat-section + .stat-section {
				margin-top: var(--space-2);
				padding-top: var(--space-2);
				border-top: 1px solid var(--color-border-subtle);
			}

			.stat-section-title {
				font-size: 0.75rem;
				font-weight: 600;
				color: var(--color-muted-foreground);
				text-transform: uppercase;
				letter-spacing: 0.03em;
			}

			.dashboard-setup-section {
				margin-bottom: var(--space-6);
			}
		</style>
	</head>
	<body>
		<div class="home-container">
			<div class="home-title">
				<img src={utils.URL("/static/logo.png")} alt="Zion English" class="home-logo">
			</div>
			<div class="home-top-bar">
				<div class="home-top-bar-left">
					@HeaderAvatar(data.Avatar)
					@NotificationBell()
				</div>
				@Logout()
			</div>

			<div class="home-welcome">
				@WelcomeRole()
				@DigitalClock("hero")
				@AnnouncementBanners()
			</div>

			@DashboardStats(data)

			if data.ShowOnboarding {
				<section class="dashboard-setup-section">
					<h2 class="dashboard-section-title">Complete your setup</h2>
					@OnboardingChecklist(data.Onboarding)
				</section>
			}

			<h2 class="dashboard-section-title">Quick actions</h2>
			<div class="cards-grid">
				for _, entry := range DashboardQuickActionEntries(data.Role) {
					switch entry.Kind {
					case NavBarEntryLink:
						if entry.Item.FeatureCard {
							@ActionCardFeature(entry.Item)
						} else {
							@ActionCard(entry.Item)
						}
					case NavBarEntryGroup:
						@NavGroupActionCard(entry.Group)
					}
				}
				for _, item := range DashboardExtraItems(data.Role) {
					@ActionCard(item)
				}
			</div>

			@NavGroupChoiceModals(NavGroups(data.Role))
			@RecordClassFlowModals(ClassWizardPageDataForContext(ctx))
			if data.ShowPaymentReceipt {
				@PaymentReceiptModal(data.PaymentReceipt)
			}
			if data.Role == auth.RoleTeacher {
				@PersistentPanelSlot(PersistentPanelSlotParams{
					HostID:     "persistentOnboardingHost",
					PartialURL: utils.URL("/onboarding/persistent"),
				})
			}
		</div>
	</body>
	</html>
}

templ DashboardStatLinkRow(label string, href string, count int64, tooltip string) {
	if count > 0 {
		<a href={ href } class="stat-link-row" data-tooltip={ tooltip }>
			<span class="stat-link-row-label">{ label }</span>
			<span class="stat-link-row-value-wrap">
				<span class="stat-link-row-value">{ fmt.Sprintf("%d", count) }</span>
				<span class="stat-value-signifier" aria-hidden="true"></span>
			</span>
		</a>
	} else {
		<div class="stat-link-row">
			<span class="stat-link-row-label">{ label }</span>
			<span class="stat-link-row-value">{ fmt.Sprintf("%d", count) }</span>
		</div>
	}
}

templ DashboardSectionedCurrencyStatCard(label string, adminOnly bool, sections []DashboardCurrencySection) {
	<div class="stat-card">
		if adminOnly {
			@AdminOnlyStatLabel(label)
		} else {
			<span class="stat-label">{ label }</span>
		}
		for _, section := range sections {
			<div class="stat-section">
				if section.Title != "" {
					if section.AdminOnly {
						@AdminOnlyStatSectionTitle(section.Title)
					} else {
						<span class="stat-section-title">{ section.Title }</span>
					}
				}
				<div class="stat-currency-rows">
					for _, total := range section.Totals {
						<span class="stat-currency-row">{ utils.FormatCurrency(total.Total, total.Currency) }</span>
					}
				</div>
			</div>
		}
	</div>
}

templ DashboardPendingStatCard(pendingTeachers int64, pendingDocuments int64, pendingIntroVideos int64) {
	<div class="stat-card">
		@AdminOnlyStatLabel("Pending Review")
		<div class="stat-link-rows">
			@DashboardStatLinkRow(
				"Teachers",
				utils.URL("/teachers?status=pending"),
				pendingTeachers,
				"View unapproved teachers",
			)
			@DashboardStatLinkRow(
				"Documents",
				utils.URL("/documents?status=submitted"),
				pendingDocuments,
				"View submitted documents",
			)
			@DashboardStatLinkRow(
				"Intro videos",
				utils.URL("/intro-videos?status=submitted"),
				pendingIntroVideos,
				"View submitted intro videos",
			)
		</div>
	</div>
}

templ DashboardTeachersStatCard(total int64, withoutZoom int64, withoutGoogleCal int64, withoutCV int64, withoutProfileAvatar int64) {
	<div class="stat-card">
		@AdminOnlyStatLabel("Teachers")
		<div class="stat-link-rows">
			@DashboardStatLinkRow(
				"Total teachers",
				utils.URL("/teachers"),
				total,
				"View all teachers",
			)
			@DashboardStatLinkRow(
				"Without Zoom",
				utils.URL("/teachers?connectionFilter=missing_zoom"),
				withoutZoom,
				"View teachers without Zoom",
			)
			@DashboardStatLinkRow(
				"Without Google Calendar",
				utils.URL("/teachers?connectionFilter=missing_google"),
				withoutGoogleCal,
				"View teachers without Google Calendar",
			)
			@DashboardStatLinkRow(
				"Without uploaded CV",
				utils.URL("/teachers?resumeStatus=none"),
				withoutCV,
				"View teachers without an uploaded CV",
			)
			@DashboardStatLinkRow(
				"Without profile avatar",
				utils.URL("/teachers?profilePictureFilter=missing"),
				withoutProfileAvatar,
				"View teachers without an uploaded profile avatar",
			)
		</div>
	</div>
}

templ DashboardParentGapStatCard(withoutParent int64, withoutParentRate int64) {
	<div class="stat-card">
		@AdminOnlyStatLabel("Students Missing Parent Info")
		<div class="stat-link-rows">
			@DashboardStatLinkRow(
				"Without parent name",
				utils.URL("/students?status=active&parentFilter=missing_name"),
				withoutParent,
				"View students missing parent name",
			)
			@DashboardStatLinkRow(
				"Without parent rate",
				utils.URL("/students?status=active&parentFilter=missing_rate"),
				withoutParentRate,
				"View students missing parent rate",
			)
		</div>
	</div>
}

templ DashboardStats(data DashboardData) {
	<h2 class="dashboard-section-title">Overview</h2>
	<div class="dashboard-stats">
		if auth.HasAdminAccess(data.Role) {
			<div class="stat-card">
				@AdminOnlyStatLabel("Students")
				<span class="stat-value">{ fmt.Sprintf("%d", data.ActiveStudents + data.InactiveStudents) }</span>
				<span class="stat-sub">{ fmt.Sprintf("%d active, %d inactive", data.ActiveStudents, data.InactiveStudents) }</span>
			</div>
			@DashboardPendingStatCard(data.PendingTeachers, data.PendingDocuments, data.PendingIntroVideos)
			@DashboardTeachersStatCard(data.TotalTeachers, data.TeachersWithoutZoom, data.TeachersWithoutGoogleCal, data.TeachersWithoutCV, data.TeachersWithoutProfileAvatar)
			@DashboardParentGapStatCard(data.StudentsWithoutParent, data.StudentsWithoutParentRate)
		}
		if data.Role == auth.RoleTeacher {
			<a href={ utils.URL("/my-students") } class="stat-card stat-card-link">
				<span class="stat-label">My Students</span>
				<span class="stat-value">{ fmt.Sprintf("%d", data.MyStudentCount) }</span>
			</a>
		}
		if data.Role == auth.RoleTeacher || data.Role == auth.RoleTester {
			<div class="stat-card stat-card-accent">
				<span class="stat-label">Scheduled Today</span>
				<span class="stat-value">{ fmt.Sprintf("%d", data.ScheduledToday) }</span>
			</div>
		}
		<div class="stat-card">
			if auth.HasAdminAccess(data.Role) {
				@AdminOnlyStatLabel("Classes This Week")
			} else {
				<span class="stat-label">Classes This Week</span>
			}
			<span class="stat-value">{ fmt.Sprintf("%d total", data.ClassesConductedWeek + data.ClassesCancelledWeek + data.ClassesRescheduledWeek) }</span>
			<span class="stat-sub">{ fmt.Sprintf("%d conducted, %d cancelled, %d rescheduled", data.ClassesConductedWeek, data.ClassesCancelledWeek, data.ClassesRescheduledWeek) }</span>
			<div class="stat-link-rows">
				@DashboardStatLinkRow(
					"Overdue",
					utils.URL(fmt.Sprintf("/classes?status=overdue&startDate=%s&endDate=%s", data.ClassesWeekStart, data.ClassesWeekEnd)),
					data.ClassesOverdueWeek,
					"View overdue scheduled classes this week",
				)
			</div>
		</div>
		if data.Role == auth.RoleAdmin {
			@DashboardSectionedCurrencyStatCard("My Cutoffs", false, []DashboardCurrencySection{
				{Title: "First cutoff · Teacher rates", Totals: data.FirstCutoffTotals},
				{Title: "First cutoff · Parent rates", Totals: data.FirstCutoffParentTotals, AdminOnly: true},
				{Title: "Second cutoff · Teacher rates", Totals: data.SecondCutoffTotals},
				{Title: "Second cutoff · Parent rates", Totals: data.SecondCutoffParentTotals, AdminOnly: true},
			})
			@DashboardSectionedCurrencyStatCard("All Teachers Cutoffs", true, []DashboardCurrencySection{
				{Title: "First cutoff · Teacher rates", Totals: data.AllTeachersFirstCutoffTotals},
				{Title: "First cutoff · Parent rates", Totals: data.AllTeachersFirstCutoffParentTotals},
				{Title: "Second cutoff · Teacher rates", Totals: data.AllTeachersSecondCutoffTotals},
				{Title: "Second cutoff · Parent rates", Totals: data.AllTeachersSecondCutoffParentTotals},
			})
		} else if auth.HasAdminAccess(data.Role) {
			@DashboardSectionedCurrencyStatCard("Cutoffs", true, []DashboardCurrencySection{
				{Title: "First cutoff · Teacher rates", Totals: data.FirstCutoffTotals},
				{Title: "First cutoff · Parent rates", Totals: data.FirstCutoffParentTotals},
				{Title: "Second cutoff · Teacher rates", Totals: data.SecondCutoffTotals},
				{Title: "Second cutoff · Parent rates", Totals: data.SecondCutoffParentTotals},
			})
		} else {
			@DashboardSectionedCurrencyStatCard("Cutoffs", false, []DashboardCurrencySection{
				{Title: "First cutoff · Teacher rates", Totals: data.FirstCutoffTotals},
				{Title: "Second cutoff · Teacher rates", Totals: data.SecondCutoffTotals},
			})
		}
	</div>
}
