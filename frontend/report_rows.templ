package frontend

import (
	"fmt"
	"zion-english/internal/utils"
)

templ ReportTableRow(row ReportRowData, startDate string, endDate string, swapOOB bool) {
	<tr data-teacher-id={ row.TeacherID } if swapOOB { hx-swap-oob="outerHTML" }>
		<td data-label="Teacher">
			<div class="reports-teacher-cell">
				@Avatar(row.TeacherAvatar)
				<span>{ row.TeacherName }</span>
			</div>
		</td>
		<td data-label="Payment status">
			if row.HasPaymentStatus() {
				@StatusPill(row.PaymentStatus.Label(), PaymentStatusPillTone(row.PaymentStatus), false)
			} else {
				-
			}
		</td>
		<td data-label="Total Classes">{ row.ClassesLabel() }</td>
		<td data-label="Total Rate/Earnings">
			@templ.Raw(row.EarningsHTML())
		</td>
		<td data-label="Actions">
			<div class="table-actions">
				@IconActionButton(row.GenerateLabel(), row.GenerateKind(), templ.Attributes{
					"hx-post":   utils.URL("/reports/" + row.TeacherID + "/generate"),
					"hx-vals":   fmt.Sprintf(`{"startDate":"%s","endDate":"%s"}`, startDate, endDate),
					"hx-target": "closest tr",
					"hx-swap":   "outerHTML",
				})
				<span
					class="download-report-wrap"
					if !row.DownloadReady {
						data-tooltip={ downloadDisabledTooltip }
					}
				>
					if row.DownloadReady {
						@IconActionLink(row.DownloadURL(), "Download XLSX", IconKindDownload)
					} else {
						<a
							class="icon-action-btn icon-action-btn--download download-report-btn is-disabled"
							href="#"
							aria-label="Download XLSX"
							aria-disabled="true"
						>
							@IconSVG(IconKindDownload)
						</a>
					}
				</span>
				@IconActionButton("View", IconKindView, templ.Attributes{
					"hx-get":    utils.URL("/reports/" + row.TeacherID + "/view?startDate=" + startDate + "&endDate=" + endDate),
					"hx-target": "#reportViewModalHost",
					"hx-swap":   "innerHTML",
				})
				<span
					class="send-payment-wrap"
					if !row.CanSendPayment() {
						data-tooltip={ row.SendPaymentDisabledTooltip }
					}
				>
					if row.CanSendPayment() {
						@IconActionButton("Send payment", IconKindPayment, templ.Attributes{
							"hx-get":    utils.URL("/reports/" + row.TeacherID + "/payment?startDate=" + startDate + "&endDate=" + endDate),
							"hx-target": "#reportPaymentModalHost",
							"hx-swap":   "innerHTML",
						})
					} else {
						<button
							type="button"
							class="icon-action-btn icon-action-btn--payment is-disabled"
							aria-label="Send payment"
							aria-disabled="true"
						>
							@IconSVG(IconKindPayment)
						</button>
					}
				</span>
			</div>
		</td>
	</tr>
}

templ ReportsTableBody(rows []ReportRowData, startDate string, endDate string, emptyMessage string) {
	if len(rows) == 0 {
		<tr>
			<td colspan="5" class="empty-state">{ emptyMessage }</td>
		</tr>
	} else {
		for _, row := range rows {
			@ReportTableRow(row, startDate, endDate, false)
		}
	}
}

templ ReportsSummaryCards(data ReportsSummaryData) {
	if !data.HasDateRange {
		<div class="stat-card">
			<span class="stat-label">Total Earnings</span>
			<span class="stat-sub">Select a date range</span>
		</div>
	} else if len(data.Earnings) == 0 {
		<div class="stat-card">
			<span class="stat-label">Total Earnings</span>
			if data.CutoffLabel != "" {
				<span class="stat-sub">{ data.CutoffLabel }</span>
			}
			<span class="stat-currency-row">-</span>
		</div>
	} else {
		@DashboardSectionedCurrencyStatCard("Total Earnings", true, []DashboardCurrencySection{
			{Title: data.CutoffLabel, Totals: data.Earnings},
		})
	}
}

templ ReportsPartial(rows []ReportRowData, startDate string, endDate string, emptyMessage string, summary ReportsSummaryData) {
	@ReportsTableBody(rows, startDate, endDate, emptyMessage)
	<div id="reportsSummaryCards" class="dashboard-stats reports-summary" hx-swap-oob="outerHTML">
		@ReportsSummaryCards(summary)
	</div>
}
