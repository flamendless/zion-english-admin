		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-cta-logo,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-cta-logo {
			width: 0.75rem;
			height: 0.75rem;
		}
		.ad-chrome--bottom {
			pointer-events: none;
			width: 100%;
			margin-top: var(--space-6);
			padding: var(--space-3) 0 var(--space-4);
			border-top: 1px solid var(--color-border-subtle);
		}
		.ad-chrome--bottom .ad-zone--bottom {
			display: flex;
			flex-wrap: nowrap;
			overflow: hidden;
			justify-content: center;
			align-items: center;
			gap: var(--space-3);
			max-width: 56rem;
			margin: 0 auto;
			padding: 0 var(--space-3);
		}
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome.affiliate-product-card--impact-banner {
			flex: 1 1 0;
			min-width: 0;
