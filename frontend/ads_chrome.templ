package frontend

import (
	"fmt"
	"zion-english/internal/ads"
)

templ AdPlacementChrome() {
	{{
		slots := ads.GetResolvedSlots(ctx)
		fastRefreshSeconds := ads.CatalogFastTimerRefreshSeconds(ads.GetCatalog(ctx))
		bodyClass := ""
		if slots.HasSideRails {
			bodyClass = "has-ad-rails"
		}
	}}
	if fastRefreshSeconds > 0 {
		@ScrAdFastRotation(fastRefreshSeconds)
	}
	if bodyClass != "" {
		<script>
			document.documentElement.classList.add('has-ad-rails');
			(function () {
				function syncAdSideRailOffset() {
					var headerTop = document.querySelector('.header-top');
					var header = document.querySelector('.header-section');
					var anchor = headerTop || header;
					if (!anchor) return;
					var inset = Math.max(0, anchor.getBoundingClientRect().bottom);
					document.documentElement.style.setProperty('--ad-side-rail-inset', inset + 'px');
				}
				syncAdSideRailOffset();
				window.addEventListener('resize', syncAdSideRailOffset);
				window.addEventListener('scroll', syncAdSideRailOffset, { passive: true });
				var header = document.querySelector('.header-section');
				if (header && typeof ResizeObserver !== 'undefined') {
					new ResizeObserver(syncAdSideRailOffset).observe(header);
				}
			})();
		</script>
	}
	@AffiliateProductCardStyles()
	@AdPlacementChromeStyles()
	if len(slots.Top) > 0 || len(slots.Left) > 0 || len(slots.Right) > 0 {
		@AdPlacementChromeInner(slots)
	}
}

templ AdChromeRefreshFragment() {
	{{
		slots := ads.GetResolvedSlots(ctx)
	}}
	if len(slots.Top) > 0 || len(slots.Left) > 0 || len(slots.Right) > 0 {
		@AdPlacementChromeInner(slots)
	}
	if len(slots.Bottom) > 0 {
		@AdPlacementBottomInner(slots)
	}
}

templ AdPlacementChromeInner(slots ads.ResolvedSlots) {
	<div class="ad-chrome ad-chrome--fixed" aria-hidden="false">
		if len(slots.Top) > 0 {
			<div class="ad-zone ad-zone--top">
				for _, item := range slots.Top {
					@AffiliateProductCard(AffiliateProductCardFromResolved(item))
				}
			</div>
		}
		if len(slots.Left) > 0 {
			<div class="ad-zone ad-zone--left">
				for _, item := range slots.Left {
					@AffiliateProductCard(AffiliateProductCardFromResolved(item))
				}
			</div>
		}
		if len(slots.Right) > 0 {
			<div class="ad-zone ad-zone--right">
				for _, item := range slots.Right {
					@AffiliateProductCard(AffiliateProductCardFromResolved(item))
				}
			</div>
		}
	</div>
}

templ AdPlacementBottomInner(slots ads.ResolvedSlots) {
	<div class="ad-chrome ad-chrome--bottom" aria-label="Sponsored recommendations">
		<div class="ad-zone ad-zone--bottom">
			for _, item := range slots.Bottom {
				@AffiliateProductCard(AffiliateProductCardFromResolved(item))
			}
		</div>
	</div>
}

templ ScrAdFastRotation(intervalSeconds int) {
	<span id="adFastRotationConfig" data-interval-ms={ fmt.Sprintf("%d", intervalSeconds*1000) } hidden aria-hidden="true"></span>
	<script>
		(function () {
			if (window._adFastRotationBound) return;
			window._adFastRotationBound = true;
			const cfg = document.getElementById('adFastRotationConfig');
			const intervalMs = cfg ? parseInt(cfg.getAttribute('data-interval-ms') || '5000', 10) : 5000;
			function buildURL(path) {
				const banner = document.getElementById('errorBanner');
				if (banner && banner.dataset.basePath) {
					return banner.dataset.basePath.replace(/\/$/, '') + path;
				}
				const pathname = window.location.pathname.replace(/\/$/, '');
				if (pathname.includes('/zion-english-admin')) {
					return '/zion-english-admin' + path;
				}
				return path;
			}
			function syncAdSideRailOffset() {
				var headerTop = document.querySelector('.header-top');
				var header = document.querySelector('.header-section');
				var anchor = headerTop || header;
				if (!anchor || !document.documentElement.classList.contains('has-ad-rails')) return;
				var inset = Math.max(0, anchor.getBoundingClientRect().bottom);
				document.documentElement.style.setProperty('--ad-side-rail-inset', inset + 'px');
			}
			function replaceAdChrome(html) {
				const tpl = document.createElement('template');
				tpl.innerHTML = html.trim();
				const nextFixed = tpl.content.querySelector('.ad-chrome--fixed');
				const nextBottom = tpl.content.querySelector('.ad-chrome--bottom');
				const fixed = document.querySelector('.ad-chrome--fixed');
				const bottom = document.querySelector('.ad-chrome--bottom');
				if (nextFixed && fixed) {
					fixed.replaceWith(nextFixed);
				} else if (nextFixed && !fixed) {
					document.body.insertBefore(nextFixed, document.body.firstChild);
				} else if (!nextFixed && fixed) {
					fixed.remove();
				}
				if (nextBottom && bottom) {
					bottom.replaceWith(nextBottom);
				} else if (nextBottom && !bottom) {
					document.body.appendChild(nextBottom);
				} else if (!nextBottom && bottom) {
					bottom.remove();
				}
				syncAdSideRailOffset();
			}
			function refreshAds() {
				fetch(buildURL('/ads/partials/chrome'), { credentials: 'same-origin' })
					.then(function (res) {
						if (!res.ok) return '';
						return res.text();
					})
					.then(function (html) {
						if (html) replaceAdChrome(html);
					})
					.catch(function () {});
			}
			window.addEventListener('scroll', syncAdSideRailOffset, { passive: true });
			window.setInterval(refreshAds, intervalMs);
		})();
	</script>
}

templ AdPlacementBottom() {
	{{
		slots := ads.GetResolvedSlots(ctx)
	}}
	if len(slots.Bottom) > 0 {
		@AdPlacementBottomInner(slots)
	}
}

templ AdPlacementChromeStyles() {
	<style>
		.ad-chrome {
			--ad-placement-card-max-width: 11rem;
			--ad-placement-image-size: 6.5rem;
			--ad-chrome-row-height: 6rem;
			--ad-chrome-side-image-size: 5.25rem;
			pointer-events: none;
		}
		.ad-chrome .affiliate-product-card--ad-chrome.affiliate-product-card--impact-banner .affiliate-product-card-image--banner {
			border-radius: var(--radius-sm);
		}
		.ad-chrome a,
		.ad-chrome button {
			pointer-events: auto;
		}
		.ad-chrome .affiliate-product-card {
			box-sizing: border-box;
			max-width: var(--ad-placement-card-max-width);
			width: min(100%, var(--ad-placement-card-max-width));
			flex: 0 0 auto;
			align-self: center;
		}
		.ad-chrome .affiliate-product-card-image-link {
			width: 100%;
			max-width: var(--ad-placement-image-size);
			max-height: var(--ad-placement-image-size);
			margin: 0 auto;
			aspect-ratio: 1 / 1;
		}
		.ad-chrome .affiliate-product-card--impact-banner {
			--ad-placement-card-max-width: 100%;
			width: 100%;
			max-width: 100%;
			align-self: stretch;
		}
		.ad-chrome .affiliate-product-card--impact-banner .affiliate-product-card-image-link--banner {
			max-width: 100%;
			width: 100%;
			max-height: none;
			margin: 0;
			aspect-ratio: auto;
		}
		.ad-zone--left .affiliate-product-card--impact-banner,
		.ad-zone--right .affiliate-product-card--impact-banner {
			width: 100%;
		}
		.ad-zone--top .affiliate-product-card--impact-banner:not(.affiliate-product-card--thumbnail-portrait),
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--impact-banner:not(.affiliate-product-card--thumbnail-portrait) {
			flex: 1 1 0;
			min-width: 0;
			width: auto;
			max-width: none;
		}
		.ad-zone--top .affiliate-product-card--impact-banner:not(.affiliate-product-card--thumbnail-portrait) .affiliate-product-card-image--banner,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--impact-banner:not(.affiliate-product-card--thumbnail-portrait) .affiliate-product-card-image--banner {
			max-height: var(--ad-chrome-row-height);
			width: 100%;
			object-fit: contain;
		}
		.ad-zone--top .affiliate-product-card--impact-banner.affiliate-product-card--thumbnail-portrait,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--impact-banner.affiliate-product-card--thumbnail-portrait {
			width: 100%;
			max-width: min(14rem, 100%);
		}
		.ad-zone--top {
			width: 100%;
			display: flex;
			flex-wrap: nowrap;
			overflow: hidden;
			justify-content: center;
			align-items: center;
			gap: var(--space-2);
			padding: var(--space-2) 0;
			margin-bottom: var(--space-2);
		}
		.ad-zone--top .affiliate-product-card--ad-chrome.affiliate-product-card--impact-banner {
			flex: 1 1 0;
			min-width: 0;
			max-width: none;
			width: auto;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) {
			flex: 0 0 auto;
			width: auto;
			max-width: 16rem;
		}
		.ad-zone--top .affiliate-product-card-shop {
			display: -webkit-box;
			-webkit-line-clamp: 1;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.ad-zone--top .affiliate-product-card-body {
			flex: 1;
		}
		.ad-zone--top .affiliate-product-card-cta {
			margin-top: auto;
		}
		.ad-zone--top .affiliate-product-card-body {
			padding: var(--space-2);
			gap: var(--space-1);
		}
		.ad-zone--top .affiliate-product-card-title {
			font-size: 0.8125rem;
		}
		.ad-zone--top .affiliate-product-card-price {
			font-size: 0.875rem;
		}
		.ad-zone--top .affiliate-product-card-cta {
			padding: 0.4375rem var(--space-2);
			font-size: 0.6875rem;
			gap: 0.25rem;
		}
		.ad-zone--top .affiliate-product-card-cta-logo {
			width: 0.875rem;
			height: 0.875rem;
		}
		.ad-zone--top .affiliate-product-card-sales {
			display: none;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner),
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) {
			display: grid;
			grid-template-columns: var(--ad-chrome-row-height) minmax(0, 10.5rem);
			grid-template-rows: 1fr;
			align-items: stretch;
			height: var(--ad-chrome-row-height);
			max-height: var(--ad-chrome-row-height);
			align-self: center;
			overflow: hidden;
			box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-image-wrap,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-image-wrap {
			grid-column: 1;
			grid-row: 1;
			height: 100%;
			min-height: 0;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-image-link,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-image-link {
			width: 100%;
			height: 100%;
			max-width: none;
			max-height: none;
			margin: 0;
			aspect-ratio: auto;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-image,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-image {
			object-fit: cover;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-body,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-body {
			grid-column: 2;
			grid-row: 1;
			flex: none;
			min-width: 0;
			padding: var(--space-1) var(--space-2);
			gap: 0.125rem;
			border-top: none;
			border-left: 1px solid rgba(238, 77, 45, 0.12);
			justify-content: center;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-shop-row,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-shop-row {
			min-height: 0;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-shop,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-shop {
			font-size: 0.625rem;
			-webkit-line-clamp: 1;
			display: -webkit-box;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-help,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-help {
			display: none;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-title,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-title {
			font-size: 0.6875rem;
			line-height: 1.25;
			-webkit-line-clamp: 2;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-meta,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-meta {
			margin: 0;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-price,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-price {
			font-size: 0.8125rem;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-sales,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-sales {
			display: none;
		}
		.ad-zone--top .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-cta,
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-cta {
			margin-top: 0.125rem;
