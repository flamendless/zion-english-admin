		}
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card-shop {
			display: -webkit-box;
			-webkit-line-clamp: 1;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card-body {
			flex: 1;
		}
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card-cta {
			margin-top: auto;
		}
		.ad-zone--left,
		.ad-zone--right {
			position: fixed;
			top: 0;
			width: 11rem;
			height: 100vh;
			max-height: 100vh;
			z-index: 800;
			display: flex;
			flex-direction: column;
			align-items: stretch;
			justify-content: flex-start;
			gap: var(--space-1);
			overflow: hidden;
			padding: max(var(--space-1), var(--ad-side-rail-inset, 3.25rem)) var(--space-1) var(--space-2);
			box-sizing: border-box;
		}
		.ad-zone--left > .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner),
		.ad-zone--right > .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) {
			flex: 0 0 auto;
			height: auto;
			width: 100%;
			max-width: 100%;
			overflow: hidden;
			display: flex;
			flex-direction: column;
		}
		.ad-zone--left > .affiliate-product-card--ad-chrome.affiliate-product-card--impact-banner,
		.ad-zone--right > .affiliate-product-card--ad-chrome.affiliate-product-card--impact-banner {
			flex: 1 1 0;
			min-height: 0;
			width: 100%;
			max-width: 100%;
			overflow: hidden;
			display: flex;
			flex-direction: column;
		}
		.ad-zone--left .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-image-wrap,
		.ad-zone--right .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-image-wrap {
			flex: 0 0 auto;
			max-height: none;
		}
		.ad-zone--left .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-image-link,
		.ad-zone--right .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-image-link {
			width: 100%;
			max-width: var(--ad-chrome-side-image-size);
			max-height: 100%;
			margin: 0 auto;
			aspect-ratio: 1 / 1;
			height: auto;
		}
		.ad-zone--left .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-body,
		.ad-zone--right .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-body {
			flex: 0 0 auto;
			overflow: hidden;
			padding: var(--space-1) var(--space-2);
			gap: 0.125rem;
		}
		.ad-zone--left .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-help,
		.ad-zone--right .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-help {
			display: none;
		}
		.ad-zone--left .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-title,
		.ad-zone--right .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-title {
			font-size: 0.6875rem;
			line-height: 1.25;
			-webkit-line-clamp: 2;
		}
		.ad-zone--left .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-shop,
		.ad-zone--right .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-shop {
			font-size: 0.625rem;
		}
		.ad-zone--left .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-price,
		.ad-zone--right .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-price {
			font-size: 0.8125rem;
		}
		.ad-zone--left .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-cta,
		.ad-zone--right .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-cta {
			margin-top: 0.125rem;
			padding: 0.25rem var(--space-2);
			font-size: 0.625rem;
		}
		.ad-zone--left .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-cta-logo,
		.ad-zone--right .affiliate-product-card--ad-chrome:not(.affiliate-product-card--impact-banner) .affiliate-product-card-cta-logo {
			width: 0.75rem;
