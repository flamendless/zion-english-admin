package frontend

import (
	"fmt"
	"zion-english/internal/ads"
)

templ AdPlacementChrome() {
	{{
		slots := ads.GetResolvedSlots(ctx)
		fastRefreshSeconds := ads.CatalogFastTimerRefreshSeconds(ads.GetCatalog(ctx))
		bodyClass := ""
		if slots.HasSideRails {
			bodyClass = "has-ad-rails"
		}
	}}
	if fastRefreshSeconds > 0 {
		@ScrAdFastRotation(fastRefreshSeconds)
	}
	if bodyClass != "" {
		<script>
			document.documentElement.classList.add('has-ad-rails');
		</script>
	}
	@AffiliateProductCardStyles()
	@AdPlacementChromeStyles()
	if len(slots.Top) > 0 || len(slots.Left) > 0 || len(slots.Right) > 0 {
		@AdPlacementChromeInner(slots)
	}
}

templ AdChromeRefreshFragment() {
	{{
		slots := ads.GetResolvedSlots(ctx)
		hasMobileSides := len(slots.Left) > 0 || len(slots.Right) > 0
	}}
	if len(slots.Top) > 0 || len(slots.Left) > 0 || len(slots.Right) > 0 {
		@AdPlacementChromeInner(slots)
	}
	if len(slots.Bottom) > 0 || hasMobileSides {
		@AdPlacementBottomInner(slots, hasMobileSides)
	}
}

templ AdPlacementChromeInner(slots ads.ResolvedSlots) {
	<div class="ad-chrome ad-chrome--fixed" aria-hidden="false">
		if len(slots.Top) > 0 {
			<div class="ad-zone ad-zone--top">
				for _, item := range slots.Top {
					@AffiliateProductCard(AffiliateProductCardFromResolved(item))
				}
			</div>
		}
		if len(slots.Left) > 0 {
			<div class="ad-zone ad-zone--left">
				for _, item := range slots.Left {
					@AffiliateProductCard(AffiliateProductCardFromResolved(item))
				}
			</div>
		}
		if len(slots.Right) > 0 {
			<div class="ad-zone ad-zone--right">
				for _, item := range slots.Right {
					@AffiliateProductCard(AffiliateProductCardFromResolved(item))
				}
			</div>
		}
	</div>
}

templ AdPlacementBottomInner(slots ads.ResolvedSlots, hasMobileSides bool) {
	<div class="ad-chrome ad-chrome--bottom" aria-label="Sponsored recommendations">
		if len(slots.Bottom) > 0 {
			<div class="ad-zone ad-zone--bottom">
				for _, item := range slots.Bottom {
					@AffiliateProductCard(AffiliateProductCardFromResolved(item))
				}
			</div>
		}
		if hasMobileSides {
			<div class="ad-zone ad-zone--mobile-sides" aria-label="Sponsored recommendations">
				for _, item := range slots.Left {
					@AffiliateProductCard(AffiliateProductCardFromResolved(item))
				}
				for _, item := range slots.Right {
					@AffiliateProductCard(AffiliateProductCardFromResolved(item))
				}
			</div>
		}
	</div>
}

templ ScrAdFastRotation(intervalSeconds int) {
	<span id="adFastRotationConfig" data-interval-ms={ fmt.Sprintf("%d", intervalSeconds*1000) } hidden aria-hidden="true"></span>
	<script>
		(function () {
			if (window._adFastRotationBound) return;
			window._adFastRotationBound = true;
			const cfg = document.getElementById('adFastRotationConfig');
			const intervalMs = cfg ? parseInt(cfg.getAttribute('data-interval-ms') || '5000', 10) : 5000;
			function buildURL(path) {
				const banner = document.getElementById('errorBanner');
				if (banner && banner.dataset.basePath) {
					return banner.dataset.basePath.replace(/\/$/, '') + path;
				}
				const pathname = window.location.pathname.replace(/\/$/, '');
				if (pathname.includes('/zion-english-admin')) {
					return '/zion-english-admin' + path;
				}
				return path;
			}
			function replaceAdChrome(html) {
				const tpl = document.createElement('template');
				tpl.innerHTML = html.trim();
				const nextFixed = tpl.content.querySelector('.ad-chrome--fixed');
				const nextBottom = tpl.content.querySelector('.ad-chrome--bottom');
				const fixed = document.querySelector('.ad-chrome--fixed');
				const bottom = document.querySelector('.ad-chrome--bottom');
				if (nextFixed && fixed) {
					fixed.replaceWith(nextFixed);
				} else if (nextFixed && !fixed) {
					document.body.insertBefore(nextFixed, document.body.firstChild);
				} else if (!nextFixed && fixed) {
					fixed.remove();
				}
				if (nextBottom && bottom) {
					bottom.replaceWith(nextBottom);
				} else if (nextBottom && !bottom) {
					document.body.appendChild(nextBottom);
				} else if (!nextBottom && bottom) {
					bottom.remove();
				}
			}
			function refreshAds() {
				fetch(buildURL('/ads/partials/chrome'), { credentials: 'same-origin' })
					.then(function (res) {
						if (!res.ok) return '';
						return res.text();
					})
					.then(function (html) {
						if (html) replaceAdChrome(html);
					})
					.catch(function () {});
			}
			window.setInterval(refreshAds, intervalMs);
		})();
	</script>
}

templ AdPlacementBottom() {
	{{
		slots := ads.GetResolvedSlots(ctx)
		hasMobileSides := len(slots.Left) > 0 || len(slots.Right) > 0
	}}
	if len(slots.Bottom) > 0 || hasMobileSides {
		@AdPlacementBottomInner(slots, hasMobileSides)
	}
}

templ AdPlacementChromeStyles() {
	<style>
		.ad-chrome {
			--ad-placement-card-max-width: 11rem;
			--ad-placement-image-size: 6.5rem;
			pointer-events: none;
		}
		.ad-chrome a,
		.ad-chrome button {
			pointer-events: auto;
		}
		.ad-chrome .affiliate-product-card {
			box-sizing: border-box;
			max-width: var(--ad-placement-card-max-width);
			width: min(100%, var(--ad-placement-card-max-width));
			flex: 0 0 auto;
			align-self: center;
		}
		.ad-chrome .affiliate-product-card-image-link {
			width: 100%;
			max-width: var(--ad-placement-image-size);
			max-height: var(--ad-placement-image-size);
			margin: 0 auto;
			aspect-ratio: 1 / 1;
		}
		.ad-zone--top {
			width: 100%;
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			align-items: stretch;
			gap: var(--space-2);
			padding: var(--space-2) 0;
			margin-bottom: var(--space-2);
		}
		.ad-zone--top .affiliate-product-card {
			--ad-placement-card-max-width: 10.5rem;
		}
		.ad-zone--top .affiliate-product-card-shop {
			display: -webkit-box;
			-webkit-line-clamp: 1;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.ad-zone--top .affiliate-product-card-body {
			flex: 1;
		}
		.ad-zone--top .affiliate-product-card-cta {
			margin-top: auto;
		}
		.ad-zone--top .affiliate-product-card-body {
			padding: var(--space-2);
			gap: var(--space-1);
		}
		.ad-zone--top .affiliate-product-card-title {
			font-size: 0.8125rem;
		}
		.ad-zone--top .affiliate-product-card-price {
			font-size: 0.875rem;
		}
		.ad-zone--top .affiliate-product-card-cta {
			padding: 0.4375rem var(--space-2);
			font-size: 0.6875rem;
			gap: 0.25rem;
		}
		.ad-zone--top .affiliate-product-card-cta-logo {
			width: 0.875rem;
			height: 0.875rem;
		}
		.ad-zone--top .affiliate-product-card-sales {
			display: none;
		}
		.ad-chrome--bottom {
			pointer-events: none;
			width: 100%;
			margin-top: var(--space-6);
			padding: var(--space-3) 0 var(--space-4);
			border-top: 1px solid var(--color-border-subtle);
		}
		.ad-chrome--bottom .ad-zone--bottom {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			align-items: stretch;
			gap: var(--space-3);
			max-width: 56rem;
			margin: 0 auto;
			padding: 0 var(--space-3);
		}
		.ad-chrome--bottom .affiliate-product-card {
			--ad-placement-card-max-width: 11rem;
		}
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card-shop {
			display: -webkit-box;
			-webkit-line-clamp: 1;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card-body {
			flex: 1;
		}
		.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card-cta {
			margin-top: auto;
		}
		.ad-zone--mobile-sides {
			display: none;
		}
		.ad-zone--left,
		.ad-zone--right {
			position: fixed;
			top: 4.75rem;
			width: 11rem;
			max-height: calc(100vh - 4.75rem - var(--space-2));
			z-index: 850;
			display: flex;
			flex-direction: column;
			align-items: stretch;
			justify-content: flex-start;
			gap: var(--space-2);
			overflow-x: hidden;
			overflow-y: auto;
			padding: var(--space-2) var(--space-1);
			box-sizing: border-box;
			scrollbar-width: thin;
		}
		.ad-zone--left { left: 0; }
		.ad-zone--right { right: 0; }
		.ad-zone--left .affiliate-product-card,
		.ad-zone--right .affiliate-product-card {
			width: min(100%, var(--ad-placement-card-max-width));
		}
		.ad-zone--left .affiliate-product-card-body,
		.ad-zone--right .affiliate-product-card-body {
			padding: var(--space-2);
			gap: var(--space-1);
		}
		.ad-zone--left .affiliate-product-card-title,
		.ad-zone--right .affiliate-product-card-title {
			font-size: 0.8125rem;
		}
		.ad-zone--left .affiliate-product-card-price,
		.ad-zone--right .affiliate-product-card-price {
			font-size: 0.9375rem;
		}
		.ad-zone--left .affiliate-product-card-cta,
		.ad-zone--right .affiliate-product-card-cta {
			padding: 0.4375rem var(--space-2);
			font-size: 0.6875rem;
			gap: 0.25rem;
		}
		.ad-zone--left .affiliate-product-card-cta-logo,
		.ad-zone--right .affiliate-product-card-cta-logo {
			width: 0.875rem;
			height: 0.875rem;
		}
		.ad-zone--left .affiliate-product-card-sales,
		.ad-zone--right .affiliate-product-card-sales {
			display: none;
		}
		.ad-zone [data-tooltip]::after {
			content: none;
		}
		html.has-ad-rails body {
			padding-left: 11.5rem;
			padding-right: 11.5rem;
		}
		@media (max-width: 960px) {
			.ad-zone--left,
			.ad-zone--right {
				display: none;
			}
			.ad-chrome--bottom .ad-zone--bottom,
			.ad-zone--mobile-sides {
				display: flex;
				flex-direction: row;
				flex-wrap: wrap;
				justify-content: center;
				align-items: stretch;
				gap: var(--space-2);
				max-width: none;
				margin: 0;
				padding: var(--space-3);
			}
			.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card,
			.ad-zone--mobile-sides .affiliate-product-card {
				--ad-placement-card-max-width: min(calc(50% - var(--space-1)), 11rem);
				width: min(100%, var(--ad-placement-card-max-width));
			}
			.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card-shop,
			.ad-zone--mobile-sides .affiliate-product-card-shop {
				display: -webkit-box;
				-webkit-line-clamp: 1;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card-body,
			.ad-zone--mobile-sides .affiliate-product-card-body {
				flex: 1;
			}
			.ad-chrome--bottom .ad-zone--bottom .affiliate-product-card-cta,
			.ad-zone--mobile-sides .affiliate-product-card-cta {
				margin-top: auto;
			}
			.ad-chrome--bottom .ad-zone--bottom + .ad-zone--mobile-sides {
				padding-top: var(--space-3);
				border-top: 1px solid var(--color-border-subtle);
				margin-top: 0;
			}
			html.has-ad-rails body {
				padding-left: 0;
				padding-right: 0;
			}
		}
	</style>
}
