package frontend

import "zion-english/internal/utils"

type RegisterStudentData struct {
	IsSuperuser bool
}

templ RegisterStudent(data RegisterStudentData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Register Student - Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@SuccessBanner()
			@ErrorBanner()

			<form id="registerForm" hx-post={ utils.URL("/students/register") } hx-swap="innerHTML" hx-target="#logOutput">
				<div class="form-group">
					<label for="name">Student Name *</label>
					<input type="text" id="name" name="name" required
					       placeholder="Enter student name">
					<div class="error-message" id="nameError">Name is required</div>
				</div>

				<div class="form-row">
					@CurrencyDropdown()
					@StudentStatusDropdown()
				</div>

				if data.IsSuperuser {
					<div id="registerInactiveReasonGroup" class="form-group inactive-reason-group">
						<label for="inactiveReason">Inactive Reason</label>
						<input type="text" id="inactiveReason" name="inactiveReason" placeholder="Why is this student inactive?"/>
					</div>
				}

				if data.IsSuperuser {
					<div class="form-group">
						<label for="contact">Contact</label>
						<input type="text" id="contact" name="contact"
						       placeholder="Enter contact information">
					</div>
				}

				<div class="form-group">
					<label for="ratePerClass">Rate Per Class *</label>
					<input type="number" id="ratePerClass" name="ratePerClass" required
					       step="0.01" min="0" placeholder="0.00">
				</div>

				<div class="form-group">
					<label for="parentName">Parent's Name</label>
					<input type="text" id="parentName" name="parentName"
					       placeholder="Enter parent's name">
				</div>

				if data.IsSuperuser {
					<div class="form-group">
						<label>Related To</label>
						<div class="form-row">
							<div class="form-group">
								<label for="relationship">Relationship</label>
								<input type="text" id="relationship" name="relationship"
								       placeholder="siblings">
							</div>
							@StudentSearchbox()
						</div>
					</div>

					@TeacherAssignRows(nil)

					<div class="form-group">
						<label for="assignedColor">Assigned Color *</label>
						<div class="color-group">
							<input type="color" id="assignedColor" name="assignedColor" required
							       value="#90C020"
								_="
									on input
										set #colorPreview.style.backgroundColor to me.value
									end
								">
							<div class="color-preview" id="colorPreview" style="background-color: #90C020;"></div>
						</div>
					</div>
				}

				<button type="submit" id="submitBtn" hx-indicator="Registering student...">Register Student</button>
			</form>

			if data.IsSuperuser {
				<script>
					(function () {
						const statusEl = document.getElementById('status');
						const reasonGroup = document.getElementById('registerInactiveReasonGroup');
						const reasonEl = document.getElementById('inactiveReason');
						if (!statusEl || !reasonGroup) return;
						function syncInactiveReason() {
							const inactive = statusEl.value === 'inactive';
							reasonGroup.classList.toggle('is-visible', inactive);
							if (reasonEl) reasonEl.required = inactive;
						}
						statusEl.addEventListener('change', syncInactiveReason);
						syncInactiveReason();
					})();
				</script>
				<style>
					.inactive-reason-group { display: none; }
					.inactive-reason-group.is-visible { display: block; }
				</style>
			}

			<div class="logs-section">
				<h3>Logs and Errors</h3>
				<div id="logOutput">Waiting for submission...</div>
			</div>
		</div>

	</body>
	</html>
}
