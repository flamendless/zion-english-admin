package frontend

import "fmt"
import "zion-english/internal/utils"

type EditClassData struct {
	RecordID        string
	IsSuperuser     bool
	StudentID       string
	TeacherID       string
	StudentName     string
	TeacherName     string
	Date            string
	DurationMinutes int64
	Rate            float64
	Currency        string
	Status          string
	Reason          string
	Notes           string
}

templ EditClass(data EditClassData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Edit Class - Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@SuccessBanner()
			@ErrorBanner()

			if data.IsSuperuser {
				<form
					hx-post={ utils.URL("/classes/" + data.RecordID + "/edit") }
					hx-swap="innerHTML"
					hx-target="#logOutput"
				>
					<div class="form-row">
						@TeacherDropdown()
						@StudentDropdown()
					</div>
					@EditClassFields(data)
				</form>
			} else {
				<form
					hx-post={ utils.URL("/classes/" + data.RecordID + "/edit") }
					hx-swap="innerHTML"
					hx-target="#logOutput"
				>
					<input type="hidden" name="teacher" value={ data.TeacherID }/>
					<div class="form-row">
						@TeacherStudentsDropdown()
					</div>
					@EditClassFields(data)
				</form>
			}

			<div id="logOutput"></div>
		</div>
	</body>
	</html>
}

templ EditClassFields(data EditClassData) {
	<div class="form-row">
		<div class="form-group">
			<label for="date">Date *</label>
			<input type="date" id="date" name="date" required value={ data.Date }/>
		</div>
		<div class="form-group">
			<label for="duration">Duration (minutes) *</label>
			<input type="number" id="duration" name="duration" required min="1" value={ formatInt64(data.DurationMinutes) }/>
		</div>
	</div>
	<div class="form-row">
		@CurrencyDropdownWithValue(data.Currency)
		<div class="form-group">
			<label for="rate">Rate *</label>
			<input type="number" id="rate" name="rate" required min="0" step="0.01" value={ formatFloat(data.Rate) }/>
		</div>
	</div>
	<div class="form-row">
		@ClassStatusDropdownWithValue(data.Status)
		<div class="form-group">
			<label for="reason">Reason</label>
			<input type="text" id="reason" name="reason" value={ data.Reason }/>
		</div>
	</div>
	<div class="form-group">
		<label for="notes">Notes</label>
		<textarea id="notes" name="notes" rows="4" placeholder="Lesson notes...">{ data.Notes }</textarea>
	</div>
	<button type="submit">Save Changes</button>
}

func formatFloat(v float64) string {
	return fmt.Sprintf("%g", v)
}

func formatInt64(v int64) string {
	return fmt.Sprintf("%d", v)
}
