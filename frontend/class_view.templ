package frontend

import "zion-english/internal/constants"

templ ClassViewModal(data EditClassData) {
	<div class="modal-overlay" id="classViewModal" role="presentation">
		<div class="modal-dialog modal-dialog-profile modal-dialog-entity" role="dialog" aria-modal="true" aria-labelledby="classViewTitle">
			<div class="modal-header">
				<h3 id="classViewTitle">Class Details</h3>
				<button type="button" class="modal-close class-view-close" aria-label="Close" onclick="window.closeClassViewModal()">&times;</button>
			</div>
			<div class="modal-body entity-view-body class-view-body">
				@EntityViewModalStyles()
				@AvatarStyles()
				@ClassViewModalStyles()
				<div class={ "entity-view-hero " + classStatusAccentClass(data.Status) }>
					<div class="entity-view-hero-main">
						<p class="entity-view-eyebrow">Student Name</p>
						<h2>{ data.StudentName }</h2>
						if data.IsSuperuser {
							<div class="entity-view-hero-teacher">
								@TeacherNameCell(data.TeacherName, data.TeacherAvatar)
							</div>
						}
						<div class="class-view-meta-row">
							@ClassViewMetaPill("Date", data.Date, PillToneInfo)
							@ClassViewMetaPill("Time", data.TimeRangeLabel(), PillTonePrimary)
							@ClassViewMetaPill("Duration", formatDurationMinutes(data.DurationMinutes), PillToneWarning)
							@ClassViewRateMetaPill(data.Rate, data.Currency)
						</div>
					</div>
					@StatusPill(capitalizeStatus(data.Status), ClassStatusPillTone(data.Status), true)
				</div>
				if len(data.LearningMaterials) > 0 {
					<div class="entity-view-card">
						@ClassLearningMaterialReadonlyList(data.LearningMaterials)
					</div>
				}
				if (data.Status != constants.ClassListFilterConducted && data.Reason != "") || data.Notes != "" {
					<div class="entity-view-card">
						<div class="entity-view-section-body">
							if data.Status != constants.ClassListFilterConducted && data.Reason != "" {
								@EntityViewNotePanel("Reason", data.Reason, PillToneWarning)
							}
							if data.Notes != "" {
								<div class="class-view-note">
									<span class="entity-view-note-title">Notes</span>
									<p class="entity-view-note-content">{ data.Notes }</p>
								</div>
							}
						</div>
					</div>
				}
			</div>
			if data.Status == constants.ClassListFilterScheduled {
				<div class="modal-footer class-view-footer">
					<div class="class-view-footer-actions scheduled-class-actions">
						@ScheduledClassManageActions(ScheduledClassItemFromEditClassData(data))
					</div>
				</div>
			} else if data.Status != constants.ClassListFilterDeleted {
				<div class="modal-footer class-view-footer">
					<div class="class-view-footer-actions">
						@ClassRecordViewActions(data)
					</div>
				</div>
			}
		</div>
	</div>
}

templ ClassRecordViewActions(data EditClassData) {
	@IconActionLink(data.ClassEditURL(), "Edit", IconKindEdit)
	@IconActionTrigger("Delete", IconKindDelete, templ.Attributes{
		"data-delete-url":  data.ClassDeleteURL(),
		"data-delete-from": string(data.ActionFrom),
	})
}

func (data EditClassData) TimeRangeLabel() string {
	return FormatScheduledClassTimeRange(data.StartTime, data.EndTime, data.DurationMinutes)
}

templ ClassViewMetaPill(kind, value string, tone PillTone) {
	<span class="class-view-meta-pill" aria-label={ kind + ": " + value } title={ kind }>
		@Pill(value, tone)
	</span>
}

templ ClassViewRateMetaPill(rate float64, currency string) {
	<span class="class-view-meta-pill class-view-meta-pill--rate" aria-label={ "Rate: " + formatRate(rate, currency) } title="Rate">
		@RatePill(rate, currency)
	</span>
}

templ ClassViewModalStyles() {
	<style>
		.class-view-body .entity-view-hero-main {
			min-width: 0;
			flex: 1;
		}

		.class-view-meta-row {
			display: flex;
			flex-wrap: nowrap;
			gap: var(--space-1);
			width: 100%;
			max-width: 100%;
		}

		.class-view-meta-pill {
			flex: 1 1 0;
			min-width: 0;
			display: flex;
		}

		.class-view-meta-pill .pill {
			width: 100%;
			justify-content: center;
			padding: 6px 8px;
			font-size: 0.75rem;
			line-height: 1.3;
			font-variant-numeric: tabular-nums;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.class-view-meta-pill--rate .rate-pill {
			width: 100%;
			justify-content: center;
			padding: 6px 8px;
			font-size: 0.75rem;
		}

		.class-view-note {
			padding: 0;
			border: none;
			background: none;
		}

		#classViewModalHost .modal-overlay {
			z-index: 1100;
		}

		.class-view-footer {
			justify-content: flex-end;
			padding: var(--space-4);
			border-top: 1px solid var(--color-border-subtle);
		}

		.class-view-footer-actions {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: flex-end;
			gap: var(--space-2);
		}

		.class-view-footer-actions .scheduled-class-actions,
		.class-view-footer-actions .icon-action-btn {
			margin-top: 0;
		}
	</style>
}

templ ClassViewModalScripts() {
	<script>
		window.closeClassViewModal = function () {
			const host = document.getElementById('classViewModalHost');
			if (host) host.innerHTML = '';
			const scheduleOpen = typeof window.isScheduleModalOpen === 'function' && window.isScheduleModalOpen();
			if (!scheduleOpen) {
				document.body.classList.remove('modal-open');
			}
		};

		document.body.addEventListener('htmx:afterSwap', function (evt) {
			if (evt.detail.target.id !== 'classViewModalHost') return;
			document.body.classList.add('modal-open');
			const overlay = evt.detail.target.querySelector('#classViewModal');
			const closeBtn = overlay && overlay.querySelector('.class-view-close');
			if (closeBtn) closeBtn.focus();
		});

		document.body.addEventListener('click', function (e) {
			if (e.target.closest('.class-view-close')) {
				window.closeClassViewModal();
				return;
			}
			const overlay = e.target.closest('#classViewModal');
			if (overlay && e.target === overlay) window.closeClassViewModal();
		});

		document.addEventListener('keydown', function (e) {
			if (e.key !== 'Escape' || !document.getElementById('classViewModal')) return;
			if (document.getElementById('lmViewModal')) return;
			if (typeof window.hasOpenScheduledClassActionModal === 'function' && window.hasOpenScheduledClassActionModal()) return;
			const deleteModal = document.getElementById('deleteClassModal');
			if (deleteModal && !deleteModal.hidden) return;
			e.preventDefault();
			window.closeClassViewModal();
			e.stopImmediatePropagation();
		});

		window.hasOpenClassViewLayer = function () {
			return !!document.getElementById('classViewModal');
		};

		window.hasOpenScheduledClassActionModal = function () {
			const ids = ['editScheduledClassModal', 'conductClassModal', 'cancelClassModal'];
			return ids.some(function (id) {
				const el = document.getElementById(id);
				return el && !el.hidden;
			});
		};
	</script>
}
