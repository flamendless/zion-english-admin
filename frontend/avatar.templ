package frontend

import "zion-english/internal/utils"

type AvatarProps struct {
	Size          string `json:"size"`
	Initials      string `json:"initials"`
	AssignedColor string `json:"assignedColor"`
	PictureURL    string `json:"pictureURL"`
	HasPicture    bool   `json:"hasPicture"`
	Alt           string `json:"alt"`
	RoleBadge     string `json:"roleBadge,omitempty"`
}

type TeacherListItem struct {
	Name   string
	Avatar AvatarProps
}

templ TeacherNameCell(name string, avatar AvatarProps) {
	<div class="teacher-name-cell">
		@Avatar(avatar)
		<span class="teacher-name-cell-text">{ name }</span>
	</div>
}

templ avatarCircle(props AvatarProps) {
	<div
		class={ "avatar avatar-" + props.Size }
		style={ templ.SafeCSS("background-color: " + props.AssignedColor + ";") }
		aria-label={ props.Alt }
	>
		if props.HasPicture {
			<img src={ props.PictureURL } alt={ props.Alt } class="avatar-image"/>
		} else {
			<span class="avatar-initials" aria-hidden="true">{ props.Initials }</span>
		}
	</div>
}

templ Avatar(props AvatarProps) {
	if props.RoleBadge != "" {
		<div class="avatar-with-role">
			@avatarCircle(props)
			<span class={ "avatar-role-badge " + pillClass(AvatarRoleBadgeTone(props.RoleBadge)) }>{ props.RoleBadge }</span>
		</div>
	} else {
		@avatarCircle(props)
	}
}

templ AvatarStyles() {
	<style>
		.avatar {
			position: relative;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			border-radius: var(--radius-full);
			overflow: hidden;
			flex-shrink: 0;
			border: 2px solid var(--color-surface);
			box-shadow: var(--shadow-sm);
			color: var(--color-on-primary);
			font-weight: 600;
			text-transform: uppercase;
			user-select: none;
		}

		.avatar-sm {
			width: 32px;
			height: 32px;
			font-size: 0.6875rem;
		}

		.avatar-md {
			width: 48px;
			height: 48px;
			font-size: 0.875rem;
		}

		.avatar-nav {
			width: 72px;
			height: 72px;
			font-size: 1.125rem;
		}

		.avatar-lg {
			width: 96px;
			height: 96px;
			font-size: 1.75rem;
		}

		.avatar-xl {
			width: 128px;
			height: 128px;
			font-size: 2.25rem;
		}

		.avatar-image {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

		.avatar-initials {
			line-height: 1;
			letter-spacing: 0.02em;
		}

		.header-avatar-link {
			display: inline-flex;
			text-decoration: none;
			line-height: 0;
		}

		.header-avatar-link:hover .avatar {
			box-shadow: var(--shadow-md);
		}

		.teacher-name-cell {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			min-width: 0;
		}

		.teacher-name-cell .avatar-with-role,
		.analytics-teacher-cell .avatar-with-role,
		.reports-teacher-cell .avatar-with-role,
		.documents-uploader-cell .avatar-with-role {
			margin-bottom: 0;
			flex-shrink: 0;
			margin-inline-end: var(--space-3);
		}

		.day-class-header .avatar-with-role {
			margin-bottom: var(--space-4);
			flex-shrink: 0;
			margin-inline-end: var(--space-3);
		}

		.teacher-name-cell-text {
			min-width: 0;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.avatar-with-role {
			position: relative;
			display: inline-block;
			margin-bottom: var(--space-3);
		}

		.avatar-role-badge {
			position: absolute;
			bottom: 0;
			left: 50%;
			transform: translate(-50%, 50%);
			z-index: 1;
			font-size: 0.625rem;
			padding: 2px 8px;
			white-space: nowrap;
			box-shadow: var(--shadow-sm);
			text-transform: lowercase;
		}

		.avatar-with-role:has(.avatar-sm) .avatar-role-badge,
		.avatar-with-role:has(.avatar-nav) .avatar-role-badge {
			font-size: 0.5625rem;
			padding: 1px 6px;
		}

		.avatar-with-role .avatar-role-badge.pill--neutral {
			background: var(--color-surface);
			color: var(--color-foreground);
		}
	</style>
}

templ ProfileAvatar(props AvatarProps) {
	@AvatarStyles()
	@Avatar(props)
}

templ HeaderAvatar(props AvatarProps) {
	@AvatarStyles()
	<a href={ utils.URL("/dashboard") } class="header-avatar-link" title="Dashboard">
		@Avatar(props)
	</a>
}

templ HeaderAvatarPlaceholder() {
	<div
		class="header-avatar-slot"
		hx-get={ utils.URL("/header-avatar") }
		hx-trigger="load once"
		hx-swap="outerHTML"
	></div>
}
