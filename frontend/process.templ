package frontend

import "zion-english/internal/utils"

templ Process() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Zion English Admin Tool</title>
			<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
			<style>
			.column-mapping {
				background-color: #f9f9f9;
				padding: 20px;
				border-radius: 4px;
				margin-top: 10px;
			}

			.column-mapping h3 {
				margin-bottom: 15px;
				color: #333;
			}

			.column-row {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 15px;
				margin-bottom: 15px;
			}

			.results-section {
				margin-top: 30px;
			}

			.results-section h3 {
				margin-bottom: 15px;
				color: #333;
			}

			.download-btn {
				background-color: #2196F3;
				margin-top: 0;
			}

			.download-btn:hover {
				background-color: #0b7dda;
			}

			.clear-btn {
				background-color: #f44336;
				margin-left: 10px;
			}

			.clear-btn:hover {
				background-color: #da190b;
			}

			.column-error {
				color: #dc3545;
				font-size: 12px;
				margin-top: 5px;
				display: none;
			}

			.total-row {
				font-weight: bold;
				background-color: #f0f0f0;
			}

			.info-display {
				display: flex;
				gap: 15px;
				margin-bottom: 20px;
			}

			.info-display > div {
				flex: 1;
				background-color: var(--color-primary);
				color: white;
				padding: 15px;
				border-radius: 4px;
				font-size: 18px;
				font-weight: bold;
				text-align: center;
			}

			.log-error {
				color: #dc3545;
				background-color: #f8d7da;
				padding: 10px;
				border-radius: 4px;
				margin-bottom: 10px;
			}

			.log-success {
				color: #155724;
				background-color: #d4edda;
				padding: 10px;
				border-radius: 4px;
				margin-bottom: 10px;
			}

			.btn:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}
		</style>
			@GlobalIncludes()
		</head>
		<body>
			<div class="container">
				@HeaderSimple()
				@SuccessBanner()
				@ErrorBanner()
				<form
					hx-post={ utils.URL("/process") }
					hx-target="#results"
					hx-swap="innerHTML"
					hx-indicator="#submitBtn"
				>
					<div
						_="
							on change from #teacher
								set nameAttr to event.target.selectedOptions[0].dataset.name
								set #name.value to nameAttr

								set driveURLAttr to event.target.selectedOptions[0].dataset.driveurl
								set #driveUrl.value to driveURLAttr
							end
						"
					>
						@TeacherDropdown()
					</div>
					@DriveURLInput()
					<div class="form-group">
						<label for="name">Name *</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							pattern="[a-zA-Z\-\s]+"
							placeholder="teacher-name"
						/>
						<div class="error-message" id="nameError">Name must contain only letters, spaces, and dashes</div>
					</div>
					<div class="form-group">
						<label for="templateSelect">Template</label>
						<select
							id="templateSelect"
							name="templateSelect"
							_="on change
							if me.value == ''
								halt
							end
							set cols to me.value.split(',')
							set #nameCol.value to cols[0]
							set #durationCol.value to cols[1]
							set #rateCol.value to cols[2]
							set #statusCol.value to cols[3]
						"
						>
							<option value="">-- Select Template --</option>
							<option value="A,B,C,G">A,B,C,G</option>
							<option value="A,C,D,H">A,C,D,H</option>
						</select>
					</div>
					<div class="column-mapping">
						<h3>Date Range</h3>
						<div
							_="
								on change from #datePreset
									set parts to #datePreset.value.split('|')
									set #startDate.value to parts[0]
									set #endDate.value to parts[1]
								end
							"
						>
							@DatePreset()
						</div>
						<div class="column-row">
							@DateInput("startDate", "Start Date *")
							@DateInput("endDate", "End Date *") {
								<div class="error-message" id="endDateError">End date must be after start date</div>
							}
						</div>
						<h3>Options</h3>
						<div class="form-group">
							<label for="excludedRows">Exclude Rows (comma-separated)</label>
							<input
								type="text"
								id="excludedRows"
								name="excludedRows"
								placeholder="e.g., 5, 10, 15"
							/>
							<div class="error-message" id="excludedRowsError">Enter valid row numbers separated by commas (for excluding row with total)</div>
						</div>
						<h3>Column Mapping</h3>
						<div class="column-row">
							@Letters("nameCol", "Name Column *", "A") {
								<div class="column-error" id="nameColError"></div>
							}
							@Letters("durationCol", "Duration Column *", "B") {
								<div class="column-error" id="durationColError"></div>
							}
						</div>
						<div class="column-row">
							@Letters("rateCol", "Rate Column *", "C") {
								<div class="column-error" id="rateColError"></div>
							}
							@Letters("statusCol", "Status Column *", "G") {
								<div class="column-error" id="rateColError"></div>
							}
						</div>
					</div>
					<button type="submit" id="submitBtn">Process CSV</button>
				</form>
				<div id="results">
					//ProcessResponse
				</div>
			</div>
		</body>
	</html>
}
