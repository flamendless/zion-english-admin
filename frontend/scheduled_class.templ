package frontend

import (
	"strconv"
)
templ ScheduledClassActions(item ScheduledClassItemData) {
	<div class="scheduled-class-actions">
		@ScheduledClassViewAction(item)
		@ScheduledClassManageActions(item)
	</div>
}

templ ScheduledClassViewAction(item ScheduledClassItemData) {
	@IconActionButton("View", IconKindView, templ.Attributes{
		"hx-get":    ScheduledClassViewURL(item.ID),
		"hx-target": "#classViewModalHost",
		"hx-swap":   "innerHTML",
	})
}

templ ScheduledClassManageActions(item ScheduledClassItemData) {
	@IconActionTrigger("Conduct", IconKindConduct, mergeTemplAttrs(scheduledClassDetailAttrs(item), templ.Attributes{
		"data-conduct-url": ScheduledClassConductURL(item.ID),
		"data-action-from": string(item.DeleteFrom),
	}))
	@IconActionTrigger("Edit", IconKindEdit, templ.Attributes{
		"data-edit-url":    ScheduledClassEditModalURL(item.ID),
		"data-action-from": string(item.DeleteFrom),
	})
	@IconActionTrigger("Cancel", IconKindCancel, mergeTemplAttrs(scheduledClassDetailAttrs(item), templ.Attributes{
		"data-cancel-url":  ScheduledClassCancelURL(item.ID),
		"data-action-from": string(item.DeleteFrom),
	}))
	@IconActionTrigger("Delete", IconKindDelete, mergeTemplAttrs(scheduledClassDetailAttrs(item), templ.Attributes{
		"data-delete-url":  ScheduledClassDeleteURL(item.ID),
		"data-delete-from": string(item.DeleteFrom),
	}))
}

templ ScheduledClassMeeting(item ScheduledClassItemData, zoomLogoURL string) {
	if item.RoomURL != "" {
		<div class="day-class-meeting">
			<button
				type="button"
				class="zoom-meeting-btn"
				data-room-url={ item.RoomURL }
				data-passcode={ item.RoomPasscode }
				title="View Zoom meeting details"
				aria-label="View Zoom meeting details"
			>
				<img src={ zoomLogoURL } alt="" width="24" height="24" aria-hidden="true"/>
			</button>
		</div>
	} else if item.ShowZoomWarning {
		<div class="day-class-meeting">
			<div class="day-class-meeting-warning">{ ZoomManualWarning }</div>
		</div>
	}
}

templ ScheduledClassCalendarEvent(item ScheduledClassItemData, calendarLogoURL string) {
	if item.CalendarEventURL != "" {
		<div class="day-class-meeting">
			<a
				href={ item.CalendarEventURL }
				class="calendar-event-btn"
				target="_blank"
				rel="noopener noreferrer"
				title="Open in Google Calendar"
				aria-label="Open in Google Calendar"
			>
				<img src={ calendarLogoURL } alt="" width="24" height="24" aria-hidden="true"/>
			</a>
		</div>
	}
}

templ ScheduledClassListItem(item ScheduledClassItemData, zoomLogoURL string, calendarLogoURL string) {
	<li class={ scheduledClassItemClass(item.Overdue) }>
		<div class="day-class-info">
			<div class="day-class-header">
				@Avatar(item.TeacherAvatar)
				<strong>{ item.TeacherName } - { item.StudentName }</strong>
			</div>
			<div class="day-class-pills">
				@TimeRangePill(item.TimeRange)
				@RatePill(item.Rate, item.Currency)
				if item.Overdue {
					@StatusPill("OVERDUE", PillToneError, false)
				}
			</div>
			<div class="day-class-integrations">
				@ScheduledClassMeeting(item, zoomLogoURL)
				@ScheduledClassCalendarEvent(item, calendarLogoURL)
			</div>
		</div>
		<div class="day-class-actions">
			@ScheduledClassActions(item)
		</div>
	</li>
}

templ ScheduledClassList(items []ScheduledClassItemData, emptyMessage string, zoomLogoURL string, calendarLogoURL string) {
	if len(items) == 0 {
		<p class="day-classes-empty">{ emptyMessage }</p>
	} else {
		<ul class="day-classes-items">
			for _, item := range items {
				@ScheduledClassListItem(item, zoomLogoURL, calendarLogoURL)
			}
		</ul>
	}
}

func scheduledClassItemClass(overdue bool) string {
	if overdue {
		return "day-class-item is-overdue"
	}
	return "day-class-item"
}

func mergeTemplAttrs(base, extra templ.Attributes) templ.Attributes {
	merged := templ.Attributes{}
	for key, value := range base {
		merged[key] = value
	}
	for key, value := range extra {
		merged[key] = value
	}
	return merged
}

func strconvFormatInt64(v int64) string {
	return strconv.FormatInt(v, 10)
}
