package frontend

import (
	"fmt"
)

templ HubHeader(title string, actionLabel string, actionHref string, showAction bool) {
	<div class="hub-header">
		<h2 class="hub-title">{ title }</h2>
		if showAction && actionLabel != "" && actionHref != "" {
			<a href={ actionHref } class="add-btn">{ actionLabel }</a>
		}
	</div>
}

templ HubHeaderModalAction(title string, actionLabel string) {
	<div class="hub-header">
		<h2 class="hub-title">{ title }</h2>
		<button type="button" class="add-btn" data-open-record-classes-modal>{ actionLabel }</button>
	</div>
}

templ PaginationBar(hasPrev bool, prevURL string, hasNext bool, nextURL string, pageNum int, totalPages int, total int64) {
	<div class="pagination-bar">
		if hasPrev {
			<a href={ prevURL } class="pagination-btn">Previous</a>
		} else {
			<span class="pagination-btn disabled">Previous</span>
		}
		<span class="pagination-info">Page { pageNum } of { totalPages } ({ total } total)</span>
		if hasNext {
			<a href={ nextURL } class="pagination-btn">Next</a>
		} else {
			<span class="pagination-btn disabled">Next</span>
		}
	</div>
}

templ PaginationBarHTMX(loadURL string, includeSelector string, page PaginationData) {
	<div class="pagination-bar">
		if page.HasPrev {
			<button
				type="button"
				class="pagination-btn"
				hx-get={ loadURL }
				hx-include={ includeSelector }
				hx-vals={ fmt.Sprintf(`{"page": %d}`, page.PrevPage) }
				hx-target="#classesTableBody"
				hx-swap="innerHTML"
			>Previous</button>
		} else {
			<span class="pagination-btn disabled">Previous</span>
		}
		<span class="pagination-info">Page { page.Number } of { page.TotalPages } ({ page.Total } total)</span>
		if page.HasNext {
			<button
				type="button"
				class="pagination-btn"
				hx-get={ loadURL }
				hx-include={ includeSelector }
				hx-vals={ fmt.Sprintf(`{"page": %d}`, page.NextPage) }
				hx-target="#classesTableBody"
				hx-swap="innerHTML"
			>Next</button>
		} else {
			<span class="pagination-btn disabled">Next</span>
		}
	</div>
}

func listSearchPlaceholder(statusType ListFilterKind) string {
	if statusType == ListFilterKindTeacher {
		return "Name or email..."
	}
	return "Name..."
}

templ ListFilterForm(actionPath string, query string, status string, statusType ListFilterKind, teacherID string, teacherName string, email string, module string, startDate string, endDate string, showTeacher bool, showEmail bool, showModule bool, showDateRange bool, showStatus bool, sortBy string, sortOrder string, sortKind ListSortKind) {
	<form class="list-toolbar" method="GET" action={ actionPath }>
		<div class="form-group">
			<label for="q">Search</label>
			<input type="text" id="q" name="q" value={ query } placeholder={ listSearchPlaceholder(statusType) }/>
		</div>
		if showStatus {
			<div class="form-group">
				<label for="status">Status</label>
				<select id="status" name="status">
					<option value="">All</option>
					if statusType == ListFilterKindTeacher {
						for _, opt := range TeacherFilterStatusOptions {
							<option value={ opt.Value } selected?={ status == opt.Value }>{ opt.Label }</option>
						}
					} else if statusType == ListFilterKindClass {
						for _, opt := range ClassRecordFilterStatusOptions {
							<option value={ opt.Value } selected?={ status == opt.Value }>{ opt.Label }</option>
						}
					} else {
						for _, opt := range StudentStatusOptions {
							<option value={ opt.Value } selected?={ status == opt.Value }>{ opt.Label }</option>
						}
					}
				</select>
			</div>
		}
		if showTeacher {
			@TeacherFilterDropdown(teacherID, teacherName)
		}
		if showEmail {
			<div class="form-group">
				<label for="email">Email</label>
				<input type="text" id="email" name="email" value={ email } placeholder="Email..."/>
			</div>
		}
		if showModule {
			<div class="form-group">
				<label for="module">Module</label>
				<input type="text" id="module" name="module" value={ module } placeholder="e.g. classes"/>
			</div>
		}
		if showDateRange {
			<div class="form-group">
				<label for="startDate">From</label>
				<input type="date" id="startDate" name="startDate" value={ startDate }/>
			</div>
			<div class="form-group">
				<label for="endDate">To</label>
				<input type="date" id="endDate" name="endDate" value={ endDate }/>
			</div>
		}
		@SortControls(sortBy, sortOrder, sortKind)
		<div class="form-group list-toolbar-action">
			<label for="listFilterSubmit">&nbsp;</label>
			<button type="submit" id="listFilterSubmit">Filter</button>
		</div>
	</form>
}

templ TeacherFilterDropdown(selectedID string, selectedName string) {
	@TeacherSearch(TeacherSearchParams{
		InputID:      "teacherIdSearch",
		HiddenID:     "teacherId",
		HiddenName:   "teacherId",
		ResultsID:    "teacherIdSearchResults",
		Label:        "Teacher",
		Placeholder:  "All teachers",
		FilterMode:   true,
		SelectedID:   selectedID,
		SelectedName: selectedName,
	})
}
