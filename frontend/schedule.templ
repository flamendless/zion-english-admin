package frontend

import (
	"fmt"
	"zion-english/internal/constants"
	"zion-english/internal/utils"
)

type ScheduleData struct {
	LockTeacher     bool
	ShowAllTeachers bool
	TeacherID       string
	TeacherName     string
}

templ Schedule(data ScheduleData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Class Schedule - Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@ScrTimeRangeJS()
		@AvatarStyles()
		<style>
			.day-class-item.is-overdue {
				border-color: var(--color-destructive);
				background: var(--color-error-bg);
			}
			.day-class-item.is-overdue .status-pill--error {
				background: var(--color-destructive);
				color: var(--color-on-primary);
				letter-spacing: 0.03em;
			}
			.schedule-page .zoom-meeting-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 44px;
				height: 44px;
				padding: var(--space-2);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-md);
				background: var(--color-surface);
				cursor: pointer;
				transition: background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
			}
			.schedule-page .zoom-meeting-btn:hover {
				background: var(--color-info-bg);
				border-color: color-mix(in srgb, #0B5CFF 35%, var(--color-border));
				box-shadow: var(--shadow-sm);
			}
			.schedule-page .zoom-meeting-btn:focus-visible {
				outline: 2px solid var(--color-ring);
				outline-offset: 2px;
			}
			.schedule-page .zoom-meeting-btn img {
				display: block;
				width: 24px;
				height: 24px;
			}
			.schedule-page .calendar-event-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 44px;
				height: 44px;
				padding: var(--space-2);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-md);
				background: var(--color-surface);
				text-decoration: none;
				transition: background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
			}
			.schedule-page .calendar-event-btn:hover {
				background: var(--color-primary-light);
				border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
				box-shadow: var(--shadow-sm);
			}
			.schedule-page .calendar-event-btn:focus-visible {
				outline: 2px solid var(--color-ring);
				outline-offset: 2px;
			}
			.schedule-page .calendar-event-btn img {
				display: block;
				width: 24px;
				height: 24px;
			}
			.modal-overlay-zoom {
				z-index: 1100;
			}
			.modal-dialog-zoom {
				width: min(100%, 28rem);
			}
			.modal-header-zoom {
				justify-content: flex-end;
				border-bottom: none;
				padding-bottom: 0;
			}
			.zoom-meeting-sr-title {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}
			.zoom-meeting-body {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: var(--space-5);
				padding: 0 var(--space-5) var(--space-5);
			}
			.zoom-meeting-logo {
				width: 48px;
				height: 48px;
			}
			.zoom-meeting-field {
				width: 100%;
			}
			.zoom-meeting-label {
				display: block;
				font-size: 0.8125rem;
				font-weight: 600;
				color: var(--color-muted-foreground);
				margin-bottom: var(--space-2);
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}
			.zoom-meeting-row {
				display: flex;
				align-items: center;
				gap: var(--space-2);
				padding: var(--space-3);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-md);
				background: var(--color-muted);
			}
			.zoom-meeting-url {
				flex: 1;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				color: var(--color-accent);
				text-decoration: none;
				font-size: 0.875rem;
			}
			.zoom-meeting-url:hover {
				text-decoration: underline;
			}
			.zoom-meeting-passcode {
				flex: 1;
				min-width: 0;
				font-size: 0.9375rem;
				font-weight: 500;
				letter-spacing: 0.06em;
				font-family: 'Fira Code', monospace;
			}
			@media (max-width: 640px) {
				.schedule-page .schedule-layout {
					gap: var(--space-4);
				}
				.schedule-page .day-class-item {
					flex-direction: column;
					align-items: stretch;
				}
				.schedule-page .day-class-actions {
					flex-direction: row;
					justify-content: flex-end;
					width: 100%;
				}
				.schedule-page .day-class-actions .btn {
					width: 100%;
					justify-content: center;
					text-align: center;
				}
				.schedule-page .day-class-actions .icon-action-btn {
					width: 40px;
					height: 40px;
				}
				.schedule-page .schedule-modal-form .form-row {
					flex-direction: column;
				}
				.schedule-page .calendar-header {
					flex-wrap: wrap;
				}
			}
		</style>
		@ScrTimeRangeJS()
	</head>
	<body>
		<div
			class="container schedule-page"
			data-show-all-teachers={ fmt.Sprintf("%t", data.ShowAllTeachers) }
			data-lock-teacher={ fmt.Sprintf("%t", data.LockTeacher) }
			data-teacher-id={ data.TeacherID }
			data-teacher-name={ data.TeacherName }
			data-zoom-logo-url={ utils.URL("/static/zoom-logo.svg") }
		>
			@HeaderSimple()
			@SuccessBanner()
			@ErrorBanner()
			@HubHeader("Class Schedule", "", "", false)

			<div class="schedule-toolbar">
				if data.ShowAllTeachers {
					<input type="hidden" id="listTeacher" name="teacherId" value="0"/>
					<div class="form-group">
						<label>Teacher</label>
						<input type="text" value="All teachers" disabled/>
					</div>
				} else if data.LockTeacher {
					<input type="hidden" id="listTeacher" name="teacherId" value={ data.TeacherID }/>
					<div class="form-group">
						<label>Teacher</label>
						<input type="text" value={ data.TeacherName } disabled/>
					</div>
				} else {
					<div class="form-group">
						<label for="listTeacher">Teacher</label>
						<select id="listTeacher" name="teacherId"
							hx-get={ utils.URL("/api/teachers") }
							hx-trigger="load"
							hx-swap="innerHTML"
							hx-target="this"
						>
							<option value="">-- Select Teacher --</option>
						</select>
					</div>
				}
			</div>

			<input type="hidden" id="todayListStart" name="startDate" value=""/>
			<input type="hidden" id="todayListEnd" name="endDate" value=""/>
			<input type="hidden" id="todayListStatus" name="status" value={ string(constants.ScheduledClassStatusScheduled) }/>
			<input type="hidden" id="dayListStart" name="startDate" value=""/>
			<input type="hidden" id="dayListEnd" name="endDate" value=""/>
			<input type="hidden" id="dayListStatus" name="status" value={ string(constants.ScheduledClassStatusScheduled) }/>

			<div class="schedule-layout">
				<aside class="schedule-section schedule-today-section" aria-labelledby="todayHeading">
					<h3 id="todayHeading">Today's Classes</h3>
					<p class="schedule-today-date" id="todayDateLabel"></p>
					<div
						id="todayScheduleList"
						class="day-classes-list"
						hx-get={ utils.URL("/schedule/partials/list") }
						hx-include="#listTeacher, #todayListStart, #todayListEnd, #todayListStatus"
						hx-trigger="scheduleRefresh from:body"
						hx-swap="innerHTML"
					>
						<p class="day-classes-empty">Loading today's schedule...</p>
					</div>
				</aside>

				<div class="schedule-section schedule-calendar-section" aria-labelledby="calendarHeading">
					<div class="schedule-section-head">
						<h3 id="calendarHeading">Calendar</h3>
						<div class="calendar-legend" aria-hidden="true">
							<span class="legend-item"><span class="legend-swatch legend-vacant"></span> Vacant</span>
							<span class="legend-item"><span class="legend-swatch legend-scheduled"></span> Has class</span>
							<span class="legend-item"><span class="legend-swatch legend-today"></span> Today</span>
						</div>
					</div>

					<div class="schedule-calendar schedule-calendar-full" role="application" aria-label="Class schedule calendar">
					<div class="calendar-header">
						<button type="button" class="calendar-nav-btn" id="calPrev" aria-label="Previous month">&lsaquo;</button>
						<span class="calendar-month-label" id="calMonthLabel"></span>
						<button type="button" class="calendar-nav-btn" id="calNext" aria-label="Next month">&rsaquo;</button>
						<button type="button" class="calendar-today-btn" id="calToday" aria-label="Jump to today">Today</button>
					</div>
					<div class="calendar-weekdays" aria-hidden="true">
						<span class="calendar-weekday">Sun</span>
						<span class="calendar-weekday">Mon</span>
						<span class="calendar-weekday">Tue</span>
						<span class="calendar-weekday">Wed</span>
						<span class="calendar-weekday">Thu</span>
						<span class="calendar-weekday">Fri</span>
						<span class="calendar-weekday">Sat</span>
					</div>
					<div class="calendar-grid-wrap">
						<div class="calendar-loading" id="calendarLoading" hidden aria-live="polite">
							<span class="loading-spinner" aria-hidden="true"></span>
							<span>Loading schedule…</span>
						</div>
						<div class="calendar-grid calendar-grid-full" id="calendarGrid"></div>
					</div>
				</div>
				</div>
			</div>

			<div class="modal-overlay" id="scheduleModal" hidden>
				<div class="modal-dialog modal-dialog-schedule" role="dialog" aria-modal="true" aria-labelledby="modalDateTitle">
					<div class="modal-header">
						<h3 id="modalDateTitle">Schedule</h3>
						<button type="button" class="modal-close" id="modalCloseBtn" aria-label="Close">&times;</button>
					</div>
					<div class="modal-body">
						<section class="modal-section" aria-labelledby="dayClassesHeading">
							<h4 class="modal-section-title" id="dayClassesHeading">Scheduled classes</h4>
							<div
								id="dayClassesList"
								class="day-classes-list"
								hx-get={ utils.URL("/schedule/partials/list") }
								hx-include="#listTeacher, #dayListStart, #dayListEnd, #dayListStatus"
								hx-trigger="scheduleDayOpen from:body"
								hx-swap="innerHTML"
							></div>
						</section>
						<div id="modalFormOutput" class="form-message" role="alert" aria-live="assertive"></div>
						if data.LockTeacher {
							<form id="scheduleModalForm" class="schedule-modal-form">
								<input type="hidden" id="modal_teacher" name="teacher" value={ data.TeacherID }/>
								<input type="hidden" id="scheduled_date" name="scheduled_date"/>
								<h4 class="modal-section-title" id="addClassHeading">Add class</h4>
								<div class="form-row">
									@TeacherStudentsDropdown()
								</div>
								@ScheduleModalFields()
								<div class="modal-footer">
									<button type="submit" id="modalSubmitBtn" class="btn">Schedule Class</button>
								</div>
							</form>
						} else {
							<form id="scheduleModalForm" class="schedule-modal-form">
								<input type="hidden" id="scheduled_date" name="scheduled_date"/>
								<h4 class="modal-section-title" id="addClassHeading">Add class</h4>
								<div class="form-row">
									@ScheduleModalTeacherDropdown()
									@ScheduleModalStudentDropdown()
								</div>
								@ScheduleModalFields()
								<div class="modal-footer">
									<button type="submit" id="modalSubmitBtn" class="btn">Schedule Class</button>
								</div>
							</form>
						}
					</div>
				</div>
			</div>

			<div class="modal-overlay modal-overlay-zoom" id="zoomMeetingModal" hidden>
				<div class="modal-dialog modal-dialog-zoom" role="dialog" aria-modal="true" aria-labelledby="zoomMeetingTitle">
					<div class="modal-header modal-header-zoom">
						<h3 id="zoomMeetingTitle" class="zoom-meeting-sr-title">Zoom Meeting</h3>
						<button type="button" class="modal-close" id="zoomMeetingCloseBtn" aria-label="Close">&times;</button>
					</div>
					<div class="modal-body zoom-meeting-body">
						<img
							src={ utils.URL("/static/zoom-logo.svg") }
							class="zoom-meeting-logo"
							width="48"
							height="48"
							alt="Zoom"
						/>
						<div class="zoom-meeting-field">
							<span class="zoom-meeting-label">Meeting link</span>
							<div class="zoom-meeting-row" id="zoomMeetingUrlRow"></div>
						</div>
						<div class="zoom-meeting-field" id="zoomPasscodeField" hidden>
							<span class="zoom-meeting-label">Passcode</span>
							<div class="zoom-meeting-row" id="zoomMeetingPasscodeRow"></div>
						</div>
					</div>
				</div>
			</div>
			@DeleteClassModal()
			@ScheduledClassModals()
			<div id="classViewModalHost"></div>
		</div>

		@ClassViewModalScripts()

		<script>
			const pageRoot = document.querySelector('.schedule-page');
			const showAllTeachers = pageRoot.dataset.showAllTeachers === 'true';
			const lockTeacher = pageRoot.dataset.lockTeacher === 'true';
			const listTeacher = document.getElementById('listTeacher');
			const calendarGrid = document.getElementById('calendarGrid');
			const calMonthLabel = document.getElementById('calMonthLabel');
			const calPrev = document.getElementById('calPrev');
			const calNext = document.getElementById('calNext');
			const calToday = document.getElementById('calToday');
			const calendarLoading = document.getElementById('calendarLoading');
			const scheduleModal = document.getElementById('scheduleModal');
			const modalCloseBtn = document.getElementById('modalCloseBtn');
			const modalDateTitle = document.getElementById('modalDateTitle');
			const dayClassesList = document.getElementById('dayClassesList');
			const todayScheduleList = document.getElementById('todayScheduleList');
			const todayDateLabel = document.getElementById('todayDateLabel');
			const scheduleModalForm = document.getElementById('scheduleModalForm');
			const scheduledDateInput = document.getElementById('scheduled_date');
			const modalFormOutput = document.getElementById('modalFormOutput');
			const modalSubmitBtn = document.getElementById('modalSubmitBtn');
			const startTimeInput = document.getElementById('start_time');
			const endTimeInput = document.getElementById('end_time');
			const zoomMeetingModal = document.getElementById('zoomMeetingModal');
			const zoomMeetingCloseBtn = document.getElementById('zoomMeetingCloseBtn');
			const zoomMeetingUrlRow = document.getElementById('zoomMeetingUrlRow');
			const zoomPasscodeField = document.getElementById('zoomPasscodeField');
			const zoomMeetingPasscodeRow = document.getElementById('zoomMeetingPasscodeRow');
			const ZOOM_LOGO_URL = pageRoot ? pageRoot.dataset.zoomLogoUrl : '';
			const ZOOM_MAX_AUTO_MINUTES = 40;
			const ZOOM_MANUAL_WARNING = 'Classes longer than 40 minutes cannot receive an automatic Zoom meeting room on a Basic account. Please create your Zoom meeting manually and share the link with your student.';
			let zoomMeetingTriggerEl = null;

			function durationFromForm() {
				const start = parseTimeToMinutes(startTimeInput ? startTimeInput.value : '');
				const end = parseTimeToMinutes(endTimeInput ? endTimeInput.value : '');
				if (start === null || end === null || end <= start) return null;
				return end - start;
			}

			function updateScheduleZoomWarning() {
				const el = document.getElementById('zoomDurationWarning');
				if (!el) return;
				const duration = durationFromForm();
				if (duration !== null && duration > ZOOM_MAX_AUTO_MINUTES) {
					el.textContent = ZOOM_MANUAL_WARNING;
					el.hidden = false;
				} else {
					el.hidden = true;
					el.textContent = '';
				}
			}

			function createCopyButton(value, label) {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'copy-btn';
				button.dataset.copy = value;
				button.title = label;
				button.setAttribute('aria-label', label);
				button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
				button.addEventListener('click', function () { window.copyCellText(button); });
				return button;
			}

			function createOpenLink(url) {
				const link = document.createElement('a');
				link.href = url;
				link.target = '_blank';
				link.rel = 'noopener noreferrer';
				link.className = 'open-btn';
				link.title = 'Open meeting in new tab';
				link.setAttribute('aria-label', 'Open meeting in new tab');
				link.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>';
				return link;
			}

			function populateZoomMeetingUrlRow(url) {
				if (!zoomMeetingUrlRow) return;
				zoomMeetingUrlRow.innerHTML = '';
				const link = document.createElement('a');
				link.href = url;
				link.target = '_blank';
				link.rel = 'noopener noreferrer';
				link.className = 'zoom-meeting-url copyable-text';
				link.title = url;
				link.textContent = url;
				zoomMeetingUrlRow.appendChild(link);
				zoomMeetingUrlRow.appendChild(createOpenLink(url));
				zoomMeetingUrlRow.appendChild(createCopyButton(url, 'Copy meeting link'));
			}

			function populateZoomMeetingPasscodeRow(passcode) {
				if (!zoomMeetingPasscodeRow || !zoomPasscodeField) return;
				if (!passcode) {
					zoomPasscodeField.hidden = true;
					zoomMeetingPasscodeRow.innerHTML = '';
					return;
				}
				zoomPasscodeField.hidden = false;
				zoomMeetingPasscodeRow.innerHTML = '';
				const passcodeText = document.createElement('span');
				passcodeText.className = 'copyable-text zoom-meeting-passcode';
				passcodeText.textContent = passcode;
				zoomMeetingPasscodeRow.appendChild(passcodeText);
				zoomMeetingPasscodeRow.appendChild(createCopyButton(passcode, 'Copy passcode'));
			}

			function getZoomModalFocusables() {
				if (!zoomMeetingModal) return [];
				return Array.from(zoomMeetingModal.querySelectorAll(
					'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
				)).filter(el => !el.hidden && el.offsetParent !== null);
			}

			function trapZoomModalFocus(e) {
				if (!zoomMeetingModal || zoomMeetingModal.hidden || e.key !== 'Tab') return;
				const focusables = getZoomModalFocusables();
				if (!focusables.length) return;
				const first = focusables[0];
				const last = focusables[focusables.length - 1];
				if (e.shiftKey && document.activeElement === first) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			}

			function openZoomMeetingModal(roomURL, passcode) {
				populateZoomMeetingUrlRow(roomURL);
				populateZoomMeetingPasscodeRow(passcode);
				zoomMeetingTriggerEl = document.activeElement;
				if (zoomMeetingModal) zoomMeetingModal.hidden = false;
				requestAnimationFrame(function () {
					if (zoomMeetingCloseBtn) zoomMeetingCloseBtn.focus();
				});
			}

			function closeZoomMeetingModal() {
				if (zoomMeetingModal) zoomMeetingModal.hidden = true;
				if (zoomMeetingTriggerEl && typeof zoomMeetingTriggerEl.focus === 'function') {
					zoomMeetingTriggerEl.focus();
				}
				zoomMeetingTriggerEl = null;
			}

			function getFormStudentEl() {
				if (lockTeacher) {
					return scheduleModalForm ? scheduleModalForm.querySelector('[name="student"]') : document.getElementById('student');
				}
				return document.getElementById('schedule_student');
			}

			function getFormTeacherEl() {
				if (lockTeacher) {
					return scheduleModalForm ? scheduleModalForm.querySelector('[name="teacher"]') : document.getElementById('modal_teacher');
				}
				return document.getElementById('schedule_teacher');
			}

			function buildScheduleFormData() {
				const params = new URLSearchParams();
				const studentEl = getFormStudentEl();
				const teacherEl = getFormTeacherEl();
				const currencyEl = document.getElementById('currency');
				const rateEl = document.getElementById('rate');

				params.append('scheduled_date', scheduledDateInput ? scheduledDateInput.value : '');
				if (studentEl && studentEl.value) {
					if (lockTeacher) {
						params.append('student', studentEl.value);
					} else {
						params.append('schedule_student', studentEl.value);
					}
				}
				if (teacherEl && teacherEl.value) {
					if (lockTeacher) {
						params.append('teacher', teacherEl.value);
					} else {
						params.append('schedule_teacher', teacherEl.value);
					}
				}
				params.append('start_time', startTimeInput ? startTimeInput.value : '');
				params.append('end_time', endTimeInput ? endTimeInput.value : '');
				params.append('rate', rateEl ? rateEl.value : '');
				params.append('currency', currencyEl ? currencyEl.value : '');
				const form = document.getElementById('scheduleModalForm');
				if (form) {
					form.querySelectorAll('input[name="learning_material_ids"]').forEach(function (input) {
						if (input.value) {
							params.append('learning_material_ids', input.value);
						}
					});
				}
				return params;
			}

			let calendarMonth = new Date();
			calendarMonth.setDate(1);
			let activeDate = '';
			let monthRecordsByDate = {};
			let monthRecordsFlat = [];
			let modalTriggerEl = null;
			let calendarLoadingCount = 0;

			const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

			function getBaseURL() {
				const banner = document.getElementById('errorBanner');
				if (banner && banner.dataset.basePath) {
					return banner.dataset.basePath.replace(/\/$/, '');
				}
				const pathname = window.location.pathname;
				const cleanPath = pathname.replace(/\/$/, '');
				const parts = cleanPath.split('/').filter(p => p !== '');
				if (parts.length === 0 || cleanPath.endsWith('.html')) {
					return cleanPath.includes('/zion-english-admin') ? '/zion-english-admin' : '';
				}
				if (parts.length === 1) return '/' + parts[0];
				return '/' + parts.slice(0, -1).join('/');
			}

			const baseURL = getBaseURL();
			function buildURL(path) { return baseURL + path; }

			function formatDate(date) {
				const y = date.getFullYear();
				const m = String(date.getMonth() + 1).padStart(2, '0');
				const d = String(date.getDate()).padStart(2, '0');
				return y + '-' + m + '-' + d;
			}

			function formatDisplayDate(dateStr) {
				const [y, m, d] = dateStr.split('-').map(Number);
				const dt = new Date(y, m - 1, d);
				return dt.toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
			}

			function parseTimeToMinutes(value) {
				if (!value) return null;
				const parts = value.split(':');
				return parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
			}

			function canLoadCalendar() {
				const teacherId = getTeacherId();
				return showAllTeachers || lockTeacher || (teacherId !== '' && teacherId !== null);
			}

			const todayListStart = document.getElementById('todayListStart');
			const todayListEnd = document.getElementById('todayListEnd');
			const dayListStart = document.getElementById('dayListStart');
			const dayListEnd = document.getElementById('dayListEnd');

			function refreshTodayList() {
				const todayStr = formatDate(new Date());
				if (todayDateLabel) {
					todayDateLabel.textContent = formatDisplayDate(todayStr);
				}
				if (!canLoadCalendar()) {
					if (todayScheduleList) {
						todayScheduleList.innerHTML = '<p class="day-classes-empty">Select a teacher to view today\'s schedule.</p>';
					}
					return;
				}
				if (todayListStart) todayListStart.value = todayStr;
				if (todayListEnd) todayListEnd.value = todayStr;
				if (typeof htmx !== 'undefined') {
					htmx.trigger(todayScheduleList, 'scheduleRefresh');
				}
			}

			function setCalendarLoading(active) {
				if (!calendarLoading) return;
				calendarLoadingCount += active ? 1 : -1;
				if (calendarLoadingCount < 0) calendarLoadingCount = 0;
				calendarLoading.hidden = calendarLoadingCount === 0;
			}

			function showFormMessage(text, isError) {
				if (!modalFormOutput) return;
				modalFormOutput.textContent = text || '';
				modalFormOutput.classList.toggle('is-error', Boolean(isError && text));
				modalFormOutput.classList.toggle('is-success', Boolean(!isError && text));
			}

			function getModalFocusables() {
				if (!scheduleModal) return [];
				return Array.from(scheduleModal.querySelectorAll(
					'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
				)).filter(el => !el.hidden && el.offsetParent !== null);
			}

			function trapModalFocus(e) {
				if (!scheduleModal || scheduleModal.hidden || e.key !== 'Tab') return;
				if (zoomMeetingModal && !zoomMeetingModal.hidden) return;
				const focusables = getModalFocusables();
				if (!focusables.length) return;
				const first = focusables[0];
				const last = focusables[focusables.length - 1];
				if (e.shiftKey && document.activeElement === first) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			}
			function getTeacherId() {
				return listTeacher ? listTeacher.value : '';
			}

			async function loadMonthData() {
				if (!canLoadCalendar()) {
					monthRecordsByDate = {};
					monthRecordsFlat = [];
					return;
				}

				const year = calendarMonth.getFullYear();
				const month = calendarMonth.getMonth();
				const start = formatDate(new Date(year, month, 1));
				const end = formatDate(new Date(year, month + 1, 0));

				const params = new URLSearchParams({
					teacherId: getTeacherId() || '0',
					startDate: start,
					endDate: end,
					page: '1',
					pageSize: '500',
					status: 'scheduled',
				});

				setCalendarLoading(true);
				try {
					const response = await fetch(buildURL('/api/scheduled-classes?' + params.toString()));
					const data = await response.json();
					if (!response.ok) throw new Error(data.message || 'Failed to load schedule');

					monthRecordsByDate = {};
					monthRecordsFlat = data.records || [];
					monthRecordsFlat.forEach(record => {
						const key = record.scheduledDate;
						if (!monthRecordsByDate[key]) monthRecordsByDate[key] = [];
						monthRecordsByDate[key].push(record);
					});
				} catch (err) {
					console.error(err);
					showErrorBanner(err.message);
					monthRecordsByDate = {};
					monthRecordsFlat = [];
				} finally {
					setCalendarLoading(false);
				}
			}

			function renderCalendar() {
				if (!calendarGrid || !calMonthLabel) return;

				const year = calendarMonth.getFullYear();
				const month = calendarMonth.getMonth();
				calMonthLabel.textContent = monthNames[month] + ' ' + year;
				calendarGrid.innerHTML = '';

				if (!canLoadCalendar()) {
					const msg = document.createElement('p');
					msg.className = 'calendar-empty-msg';
					msg.textContent = 'Select a teacher to view the calendar.';
					calendarGrid.appendChild(msg);
					return;
				}

				const firstDay = new Date(year, month, 1).getDay();
				const daysInMonth = new Date(year, month + 1, 0).getDate();
				const todayStr = formatDate(new Date());

				for (let i = 0; i < firstDay; i++) {
					const empty = document.createElement('span');
					empty.className = 'calendar-day is-empty';
					empty.setAttribute('aria-hidden', 'true');
					calendarGrid.appendChild(empty);
				}

				for (let day = 1; day <= daysInMonth; day++) {
					const dateStr = formatDate(new Date(year, month, day));
					const count = (monthRecordsByDate[dateStr] || []).length;
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'calendar-day';
					btn.dataset.date = dateStr;

					const num = document.createElement('span');
					num.className = 'calendar-day-num';
					num.textContent = String(day);
					btn.appendChild(num);

					if (count > 0) {
						btn.classList.add('has-scheduled');
						const badge = document.createElement('span');
						badge.className = 'badge-count badge-count--primary';
						badge.textContent = String(count);
						btn.appendChild(badge);
					} else {
						btn.classList.add('is-vacant');
					}

					if (dateStr === todayStr) btn.classList.add('is-today');
					if (dateStr < todayStr) btn.classList.add('is-past');
					if (dateStr === activeDate) btn.classList.add('is-active');

					btn.setAttribute('aria-label', formatDisplayDate(dateStr) + (count ? ', ' + count + ' scheduled' : ', vacant'));
					btn.addEventListener('click', () => {
						modalTriggerEl = btn;
						openDayModal(dateStr);
					});
					calendarGrid.appendChild(btn);
				}
			}

			function openDayModal(dateStr) {
				activeDate = dateStr;
				if (scheduledDateInput) scheduledDateInput.value = dateStr;
				if (modalDateTitle) modalDateTitle.textContent = formatDisplayDate(dateStr);
				showFormMessage('', false);
				if (dayListStart) dayListStart.value = dateStr;
				if (dayListEnd) dayListEnd.value = dateStr;
				if (typeof htmx !== 'undefined') {
					htmx.trigger(document.body, 'scheduleDayOpen');
				}
				renderCalendar();

				const todayStr = formatDate(new Date());
				const formSection = scheduleModalForm;
				const isPast = dateStr < todayStr;
				if (formSection) formSection.style.display = isPast ? 'none' : '';
				if (modalSubmitBtn) modalSubmitBtn.disabled = isPast;

				scheduleModal.hidden = false;
				document.body.classList.add('modal-open');
				requestAnimationFrame(() => {
					const focusables = getModalFocusables();
					if (focusables.length) focusables[0].focus();
				});
			}

			function closeModal() {
				scheduleModal.hidden = true;
				document.body.classList.remove('modal-open');
				activeDate = '';
				if (scheduleModalForm) scheduleModalForm.reset();
				if (!lockTeacher) {
					loadStudentsForTeacher('');
				}
				updateTimeRangePreview();
				showFormMessage('', false);
				if (modalSubmitBtn) {
					modalSubmitBtn.disabled = false;
					modalSubmitBtn.classList.remove('is-loading');
				}
				renderCalendar();
				if (modalTriggerEl && typeof modalTriggerEl.focus === 'function') {
					modalTriggerEl.focus();
				}
				modalTriggerEl = null;
			}

			async function refreshCalendar() {
				await loadMonthData();
				refreshTodayList();
				renderCalendar();
			}
			window.refreshCalendar = refreshCalendar;

			async function loadStudentsForTeacher(teacherId) {
				const studentEl = getFormStudentEl();
				if (!studentEl) return;
				if (!teacherId) {
					studentEl.innerHTML = '<option value="">-- Select teacher first --</option>';
					studentEl.value = '';
					return;
				}
				try {
					const response = await fetch(buildURL('/api/students?teacher=' + encodeURIComponent(teacherId)));
					const html = await response.text();
					if (!response.ok) throw new Error(html);
					studentEl.innerHTML = html;
					studentEl.value = '';
				} catch (err) {
					showErrorBanner(err.message || 'Failed to load students');
					studentEl.innerHTML = '<option value="">-- Select teacher first --</option>';
					studentEl.value = '';
				}
			}

			function wireTeacherStudentDropdown() {
				const teacherEl = getFormTeacherEl();
				if (!teacherEl || lockTeacher) return;
				teacherEl.addEventListener('change', () => {
					loadStudentsForTeacher(teacherEl.value);
				});
			}

			if (calToday) {
				calToday.addEventListener('click', async () => {
					calendarMonth = new Date();
					calendarMonth.setDate(1);
					await refreshCalendar();
				});
			}
			if (calPrev) {
				calPrev.addEventListener('click', async () => {
					calendarMonth.setMonth(calendarMonth.getMonth() - 1);
					await refreshCalendar();
				});
			}
			if (calNext) {
				calNext.addEventListener('click', async () => {
					calendarMonth.setMonth(calendarMonth.getMonth() + 1);
					await refreshCalendar();
				});
			}
			if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
			if (scheduleModal) {
				scheduleModal.addEventListener('click', (e) => {
					if (e.target === scheduleModal) closeModal();
				});
			}
			if (zoomMeetingCloseBtn) zoomMeetingCloseBtn.addEventListener('click', closeZoomMeetingModal);
			if (zoomMeetingModal) {
				zoomMeetingModal.addEventListener('click', (e) => {
					if (e.target === zoomMeetingModal) closeZoomMeetingModal();
				});
			}
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					if (zoomMeetingModal && !zoomMeetingModal.hidden) {
						closeZoomMeetingModal();
						return;
					}
					if (scheduleModal && !scheduleModal.hidden) {
						closeModal();
					}
				}
				trapZoomModalFocus(e);
				trapModalFocus(e);
			});

			function updateTimeRangePreview() {
				if (window.initTimeRangePreview) initTimeRangePreview();
			}

			if (startTimeInput) startTimeInput.addEventListener('change', updateTimeRangePreview);
			if (endTimeInput) endTimeInput.addEventListener('change', updateTimeRangePreview);

			if (scheduleModalForm) {
				scheduleModalForm.addEventListener('change', (e) => {
					const target = e.target;
					if (!target || (target.id !== 'schedule_student' && target.id !== 'student')) return;
					const opt = target.options[target.selectedIndex];
					if (!opt || !opt.value) return;
					const rate = opt.getAttribute('data-rate');
					const currency = opt.getAttribute('data-currency');
					const rateEl = document.getElementById('rate');
					const currencyEl = document.getElementById('currency');
					if (rate && rateEl) rateEl.value = rate;
					if (currency && currencyEl) currencyEl.value = currency;
				});
			}

			if (listTeacher && listTeacher.tagName === 'SELECT') {
				listTeacher.addEventListener('change', refreshCalendar);
			}

			if (scheduleModalForm) {
				scheduleModalForm.addEventListener('submit', async (e) => {
					e.preventDefault();
					const studentEl = getFormStudentEl();
					const teacherEl = getFormTeacherEl();
					if (!lockTeacher) {
						if (!teacherEl || !teacherEl.value) {
							showFormMessage('Please select a teacher', true);
							if (teacherEl) teacherEl.focus();
							return;
						}
					}
					if (!studentEl || !studentEl.value) {
						showFormMessage('Please select a student', true);
						if (studentEl) studentEl.focus();
						return;
					}
					if (!scheduledDateInput || !scheduledDateInput.value) {
						showFormMessage('No date selected', true);
						return;
					}
					if (!startTimeInput.value || !endTimeInput.value) {
						showFormMessage('Please set start and end times', true);
						if (!startTimeInput.value) startTimeInput.focus();
						else endTimeInput.focus();
						return;
					}
					if (window.validateTimeRange) {
						const rangeCheck = validateTimeRange();
						if (!rangeCheck.ok) {
							showFormMessage(rangeCheck.message, true);
							return;
						}
					}
					const rateEl = document.getElementById('rate');
					if (!rateEl || rateEl.value <= 0) {
						showFormMessage('Please enter a valid rate', true);
						if (rateEl) rateEl.focus();
						return;
					}

					const formData = buildScheduleFormData();
					if (modalSubmitBtn) {
						modalSubmitBtn.disabled = true;
						modalSubmitBtn.classList.add('is-loading');
					}
					try {
						const response = await fetch(buildURL('/schedule'), {
							method: 'POST',
							headers: Object.assign({ 'Content-Type': 'application/x-www-form-urlencoded' }, window.getCSRFHeaders ? window.getCSRFHeaders() : {}),
							body: formData.toString(),
						});
						const text = await response.text();
						if (!response.ok) {
							showFormMessage(text, true);
							showErrorBanner(text);
							return;
						}
						showSuccessBanner('Class scheduled');
						showFormMessage(text, false);
						scheduleModalForm.reset();
						if (!lockTeacher) {
							loadStudentsForTeacher('');
						}
						if (scheduledDateInput) scheduledDateInput.value = activeDate;
						if (window.initTimeRangePreview) initTimeRangePreview();
						await refreshCalendar();
					} catch (err) {
						showFormMessage(err.message, true);
						showErrorBanner(err.message);
					} finally {
						if (modalSubmitBtn) {
							modalSubmitBtn.disabled = false;
							modalSubmitBtn.classList.remove('is-loading');
						}
					}
				});
			}

			document.addEventListener('click', function (e) {
				const zoomBtn = e.target.closest('.zoom-meeting-btn[data-room-url]');
				if (zoomBtn) {
					openZoomMeetingModal(zoomBtn.dataset.roomUrl, zoomBtn.dataset.passcode || '');
				}
			});

			refreshCalendar();
			updateTimeRangePreview();
			updateScheduleZoomWarning();
			if (startTimeInput) {
				startTimeInput.addEventListener('change', updateScheduleZoomWarning);
				startTimeInput.addEventListener('input', updateScheduleZoomWarning);
			}
			if (endTimeInput) {
				endTimeInput.addEventListener('change', updateScheduleZoomWarning);
				endTimeInput.addEventListener('input', updateScheduleZoomWarning);
			}
			if (window.attachTimeRangeFormValidation) attachTimeRangeFormValidation();
			wireTeacherStudentDropdown();
			if (!lockTeacher) {
				loadStudentsForTeacher('');
			}
		</script>
		@ScrTimeRangeInit()
	</body>
	</html>
}

templ ScheduleModalFields() {
	@TimeRangeFields("", "", false)
	<div id="zoomDurationWarning" class="form-warning" role="status" hidden></div>
	@ClassLearningMaterialPicker(nil)
	<div class="form-row">
		@CurrencyDropdown()
		<div class="form-group">
			<label for="rate">Rate *</label>
			<input type="number" id="rate" name="rate" required min="0" step="0.01" placeholder="0.00"/>
		</div>
	</div>
}
