package frontend

templ GlobalIncludes() {
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Fira+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
	<style>
		:root {
			/* Zion logo palette: z=coral, i=amber, o=green, n=blue */
			--color-primary: #90C020;
			--color-primary-hover: #7A9F18;
			--color-primary-light: #EEF6D8;
			--color-on-primary: #FFFFFF;
			--color-secondary: #F0B030;
			--color-tertiary: #F06060;
			--color-accent: #20A0E0;
			--color-accent-hover: #1A8AC4;
			--color-background: #FAFAF7;
			--color-surface: #FFFFFF;
			--color-foreground: #2D2D2D;
			--color-muted: #F3F1EC;
			--color-muted-foreground: #6B6560;
			--color-border: #E5E2DA;
			--color-border-subtle: #F0EDE6;
			--color-destructive: #E04545;
			--color-destructive-hover: #C73A3A;
			--color-success: #7A9F18;
			--color-success-bg: #EEF6D8;
			--color-warning: #F0B030;
			--color-warning-bg: #FEF6E0;
			--color-info: #20A0E0;
			--color-info-bg: #E5F4FC;
			--color-error-bg: #FDE8E8;
			--color-ring: #90C020;
			--color-log-bg: #2D2D2D;
			--color-log-text: #F0EDE6;

			--radius-sm: 6px;
			--radius-md: 8px;
			--radius-lg: 12px;
			--radius-full: 9999px;

			--shadow-sm: 0 1px 2px rgba(45, 45, 45, 0.06);
			--shadow-md: 0 4px 12px rgba(45, 45, 45, 0.08);
			--shadow-lg: 0 8px 24px rgba(45, 45, 45, 0.12);

			--transition-fast: 150ms ease;
			--transition-base: 200ms ease;

			--space-1: 4px;
			--space-2: 8px;
			--space-3: 12px;
			--space-4: 16px;
			--space-5: 20px;
			--space-6: 24px;
			--space-8: 32px;
			--space-10: 40px;
		}

		@media (prefers-reduced-motion: reduce) {
			*, *::before, *::after {
				animation-duration: 0.01ms !important;
				animation-iteration-count: 1 !important;
				transition-duration: 0.01ms !important;
			}

			.modal-overlay,
			.modal-dialog {
				animation: none;
			}
		}

		* {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		body {
			font-family: 'Fira Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			background-color: var(--color-background);
			color: var(--color-foreground);
			padding: var(--space-5);
			line-height: 1.6;
			-webkit-font-smoothing: antialiased;
		}

		.container {
			max-width: 1200px;
			margin: 0 auto;
			background: var(--color-surface);
			padding: var(--space-8);
			border-radius: var(--radius-lg);
			box-shadow: var(--shadow-md);
			border: 1px solid var(--color-border-subtle);
		}

		/* ============================= */
		/* Typography                    */
		/* ============================= */

		h1, h2, h3 {
			color: var(--color-foreground);
			font-weight: 600;
			line-height: 1.3;
		}

		h1 { font-size: 1.75rem; }
		h2 { font-size: 1.375rem; }
		h3 { font-size: 1.125rem; }

		a {
			color: var(--color-accent);
			transition: color var(--transition-fast);
		}

		a:hover {
			color: var(--color-accent-hover);
		}

		/* ============================= */
		/* Forms                         */
		/* ============================= */

		.form-group {
			margin-bottom: var(--space-5);
		}

		label {
			display: block;
			margin-bottom: var(--space-1);
			color: var(--color-foreground);
			font-weight: 500;
			font-size: 0.875rem;
		}

		input[type="text"],
		input[type="number"],
		input[type="date"],
		input[type="time"],
		input[type="email"],
		input[type="tel"],
		input[type="password"],
		input[type="url"],
		select,
		textarea {
			width: 100%;
			padding: 10px 12px;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			font-size: 14px;
			font-family: inherit;
			color: var(--color-foreground);
			background: var(--color-surface);
			transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
		}

		input[type="text"]:focus,
		input[type="number"]:focus,
		input[type="date"]:focus,
		input[type="time"]:focus,
		input[type="email"]:focus,
		input[type="tel"]:focus,
		input[type="password"]:focus,
		input[type="url"]:focus,
		select:focus,
		textarea:focus {
			outline: none;
			border-color: var(--color-primary);
			box-shadow: 0 0 0 3px rgba(144, 192, 32, 0.2);
		}

		input[type="color"] {
			width: 60px;
			height: 40px;
			padding: 2px;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			cursor: pointer;
		}

		input:disabled,
		input[readonly],
		select:disabled {
			background-color: var(--color-muted);
			cursor: not-allowed;
			opacity: 0.7;
		}

		input:invalid:not(:focus):not(:placeholder-shown) {
			border-color: var(--color-destructive);
		}

		.error-message {
			color: var(--color-destructive);
			font-size: 12px;
			margin-top: var(--space-1);
			display: none;
		}

		.field-hint {
			color: var(--color-muted-foreground);
			font-size: 0.8125rem;
			margin-top: var(--space-1);
			margin-bottom: var(--space-2);
			line-height: 1.4;
		}

		.error-message.show {
			display: block;
		}

		/* ============================= */
		/* Buttons                       */
		/* ============================= */

		button, .btn {
			background-color: var(--color-primary);
			color: var(--color-on-primary);
			padding: 10px 24px;
			border: none;
			border-radius: var(--radius-sm);
			cursor: pointer;
			font-size: 15px;
			font-weight: 500;
			font-family: inherit;
			text-decoration: none;
			display: inline-block;
			margin-top: var(--space-5);
			transition: background-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
		}

		button:hover, .btn:hover {
			background-color: var(--color-primary-hover);
		}

		button:focus-visible, .btn:focus-visible,
		a:focus-visible, .nav-link:focus-visible {
			outline: 2px solid var(--color-ring);
			outline-offset: 2px;
		}

		button:disabled, .btn:disabled, .btn.is-disabled {
			background-color: var(--color-muted);
			color: var(--color-muted-foreground);
			cursor: not-allowed;
			opacity: 0.6;
			pointer-events: none;
		}

		button:active:not(:disabled):not(.password-toggle), .btn:active:not(:disabled) {
			transform: scale(0.98);
		}

		.btn-accent, .refresh-btn {
			background-color: var(--color-secondary);
			color: var(--color-foreground);
		}

		.btn-accent:hover, .refresh-btn:hover {
			background-color: #D99A20;
		}

		.btn-info, .download-btn, .export-btn {
			background-color: var(--color-info);
		}

		.btn-info:hover, .download-btn:hover, .export-btn:hover {
			background-color: var(--color-accent-hover);
		}

		.btn-danger, .clear-btn {
			background-color: var(--color-destructive);
		}

		.btn-danger:hover, .clear-btn:hover {
			background-color: var(--color-destructive-hover);
		}

		.btn-secondary {
			background-color: var(--color-surface);
			color: var(--color-foreground);
			border: 1px solid var(--color-border);
		}

		.btn-secondary:hover {
			background-color: var(--color-muted);
		}

		.btn-sm {
			padding: 5px 12px;
			font-size: 0.8125rem;
		}

		.btn.is-loading {
			position: relative;
			color: transparent;
			pointer-events: none;
		}

		.btn.is-loading::after {
			content: '';
			position: absolute;
			left: 50%;
			top: 50%;
			width: 1rem;
			height: 1rem;
			margin: -0.5rem 0 0 -0.5rem;
			border: 2px solid rgba(255, 255, 255, 0.35);
			border-top-color: var(--color-on-primary);
			border-radius: 50%;
			animation: btn-spin 0.65s linear infinite;
		}

		.btn-secondary.is-loading::after,
		.btn-danger.is-loading::after {
			border-color: rgba(45, 45, 45, 0.2);
			border-top-color: var(--color-foreground);
		}

		@keyframes btn-spin {
			to { transform: rotate(360deg); }
		}

		.add-btn {
			background-color: var(--color-primary);
			color: var(--color-on-primary);
			padding: 10px 20px;
			border: none;
			border-radius: var(--radius-sm);
			cursor: pointer;
			font-size: 14px;
			font-weight: 500;
			font-family: inherit;
			text-decoration: none;
			display: inline-block;
			margin-top: 0;
			transition: background-color var(--transition-fast);
		}

		.add-btn:hover {
			background-color: var(--color-primary-hover);
		}

		.approve-btn,
		.unapprove-btn {
			border: none;
			padding: 6px 14px;
			border-radius: var(--radius-sm);
			cursor: pointer;
			font-size: 13px;
			font-weight: 500;
			font-family: inherit;
			margin-top: 0;
			transition: background-color var(--transition-fast);
		}

		.approve-btn {
			background-color: var(--color-primary);
			color: var(--color-on-primary);
		}

		.approve-btn:hover {
			background-color: var(--color-primary-hover);
		}

		.unapprove-btn {
			background-color: var(--color-warning);
			color: var(--color-on-primary);
		}

		.unapprove-btn:hover {
			background-color: #D99A20;
		}

		/* ============================= */
		/* Tables                        */
		/* ============================= */

		.table-wrapper {
			overflow-x: auto;
			margin-bottom: var(--space-5);
			-webkit-overflow-scrolling: touch;
			border-radius: var(--radius-md);
			border: 1px solid var(--color-border-subtle);
		}

		.table-wrapper table {
			width: 100%;
			margin-bottom: 0;
		}

		.table-wrapper table.table-stack-mobile {
			min-width: 0;
		}

		@media (min-width: 769px) {
			.table-wrapper table.table-stack-mobile {
				min-width: 640px;
			}
		}

		table {
			width: 100%;
			border-collapse: collapse;
			margin-bottom: var(--space-5);
		}

		th, td {
			padding: 12px 16px;
			text-align: left;
			border-bottom: 1px solid var(--color-border-subtle);
		}

		th {
			background-color: var(--color-primary);
			color: var(--color-on-primary);
			font-weight: 600;
			font-size: 0.8125rem;
			text-transform: uppercase;
			letter-spacing: 0.03em;
			white-space: nowrap;
		}

		tr:last-child td {
			border-bottom: none;
		}

		tbody tr {
			transition: background-color var(--transition-fast);
		}

		tbody tr:hover {
			background-color: var(--color-primary-light);
		}

		.empty-state {
			text-align: center;
			padding: var(--space-10);
			color: var(--color-muted-foreground);
		}

		.empty-state p + p {
			margin-top: var(--space-2);
			font-size: 0.875rem;
		}

		/* ============================= */
		/* Header & Navigation           */
		/* ============================= */

		.header-section {
			margin-bottom: var(--space-8);
			padding-bottom: var(--space-5);
			border-bottom: 2px solid var(--color-border-subtle);
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
		}

		.header-top {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: var(--space-4);
		}

		.header-section h3 {
			color: var(--color-muted-foreground);
			font-weight: 400;
			font-size: 0.9375rem;
		}

		.header-bottom {
			display: flex;
			align-items: flex-start;
			gap: var(--space-4);
		}

		.header-left {
			display: flex;
			align-items: center;
			gap: var(--space-4);
			flex: 1;
			min-width: 0;
		}

		.header-account-tools {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			flex-shrink: 0;
			overflow: visible;
		}

		.header-account-tools .header-avatar-link,
		.header-account-tools .header-avatar-slot {
			display: inline-flex;
			align-items: center;
			align-self: center;
		}

		.header-account-tools .notification-bell-wrap {
			align-self: center;
		}

		.header-right {
			flex-shrink: 0;
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			gap: var(--space-2);
			overflow: visible;
		}

		.header-right .notification-bell-wrap {
			align-self: flex-end;
		}

		.notification-bell-wrap {
			position: relative;
			overflow: visible;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			align-self: center;
			flex-shrink: 0;
			width: 48px;
			height: 48px;
		}

		.notification-bell {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: 100%;
			padding: 0;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			background: var(--color-surface);
			color: var(--color-foreground);
			cursor: pointer;
			flex-shrink: 0;
		}

		.notification-bell:hover {
			background: var(--color-muted);
		}

		.notification-bell-svg {
			display: block;
			flex-shrink: 0;
		}

		.notification-badge-host {
			position: absolute;
			top: 5px;
			right: 5px;
			z-index: 2;
			line-height: 0;
			pointer-events: none;
		}

		.notification-badge {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-width: 17px;
			height: 17px;
			padding: 0 4px;
			border-radius: 999px;
			border: 2px solid var(--color-surface);
			background: var(--color-destructive);
			color: #fff;
			font-size: 0.625rem;
			font-weight: 700;
			line-height: 1;
			box-shadow: var(--shadow-sm);
		}

		.notification-panel-host {
			position: absolute;
			top: calc(100% + var(--space-2));
			left: 0;
			right: auto;
			z-index: 2000;
			width: min(380px, calc(100vw - 2rem));
		}

		.notification-panel {
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			box-shadow: var(--shadow-lg);
			overflow: hidden;
			width: 100%;
		}

		.notification-panel-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-3);
			padding: var(--space-3) var(--space-4);
			border-bottom: 1px solid var(--color-border);
			background: var(--color-surface);
		}

		.notification-panel-header h3 {
			margin: 0;
			font-size: 1rem;
			line-height: 1.25;
		}

		.notification-mark-all,
		.notification-mark-all-page {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			margin: 0;
			padding: var(--space-2) var(--space-3);
			border-radius: var(--radius-md);
			border: 1px solid var(--color-primary);
			background: var(--color-primary-light);
			color: var(--color-primary-hover);
			font-family: inherit;
			font-size: 0.85rem;
			font-weight: 500;
			line-height: 1.25;
			white-space: nowrap;
			flex-shrink: 0;
			cursor: pointer;
			transition: background-color var(--transition-fast), border-color var(--transition-fast);
		}

		.notification-mark-all:hover,
		.notification-mark-all-page:hover {
			background: color-mix(in srgb, var(--color-primary-light) 70%, var(--color-primary));
			border-color: var(--color-primary-hover);
		}

		.notification-filter-bar .notification-mark-all-page {
			margin-left: auto;
		}

		.notification-panel-list {
			list-style: none;
			margin: 0;
			padding: 0;
			max-height: 360px;
			overflow-y: auto;
			background: var(--color-surface);
		}

		.notification-panel-item {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
			gap: var(--space-3);
			padding: var(--space-3) var(--space-4);
			border-bottom: 1px solid var(--color-border);
			background: var(--color-surface);
		}

		.notification-panel-item.is-unread {
			background: var(--color-primary-light);
		}

		.notification-item-body {
			min-width: 0;
		}

		.notification-item-message {
			margin: 0 0 var(--space-1);
			font-size: 0.9rem;
			color: var(--color-foreground);
			white-space: normal;
			overflow-wrap: anywhere;
			word-break: break-word;
		}

		.notification-item-meta {
			margin: 0;
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
			font-size: 0.75rem;
			color: var(--color-muted-foreground);
		}

		.notification-mark-read {
			flex-shrink: 0;
			justify-self: end;
		}

		.notification-panel-empty {
			margin: 0;
			padding: var(--space-4);
			color: var(--color-muted-foreground);
			text-align: center;
			background: var(--color-surface);
		}

		.notification-panel-footer {
			padding: var(--space-3) var(--space-4);
			border-top: 1px solid var(--color-border);
			text-align: center;
			background: var(--color-surface);
		}

		.notification-view-all {
			font-size: 0.9rem;
			font-weight: 600;
		}

		.notification-filter-bar {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			margin-bottom: var(--space-4);
		}

		.notification-filter-link {
			padding: var(--space-2) var(--space-3);
			border-radius: var(--radius-md);
			text-decoration: none;
			color: var(--color-muted-foreground);
			border: 1px solid transparent;
		}

		.notification-filter-link.is-active {
			color: var(--color-primary);
			border-color: var(--color-primary);
			background: color-mix(in srgb, var(--color-primary) 8%, transparent);
		}

		.notification-list-item.is-unread td {
			font-weight: 600;
		}

		.notification-status-unread {
			color: var(--color-primary);
			font-weight: 600;
		}

		.notification-status-read {
			color: var(--color-muted-foreground);
		}

		.notification-table .notification-message-cell {
			white-space: normal;
			overflow-wrap: anywhere;
			word-break: break-word;
			max-width: 36rem;
		}

		.notification-table .notification-actions-cell {
			width: 1%;
			white-space: nowrap;
			vertical-align: middle;
		}

		.notification-table .table-actions {
			justify-content: flex-end;
		}

		.header-right > button {
			margin-top: 0;
		}

		.nav-links {
			display: flex;
			align-items: center;
			flex-wrap: wrap;
			gap: var(--space-1);
		}

		.nav-link {
			color: var(--color-foreground);
			text-decoration: none;
			font-weight: 500;
			font-size: 0.875rem;
			padding: 6px 12px;
			border-radius: var(--radius-full);
			transition: background-color var(--transition-fast), color var(--transition-fast);
		}

		.nav-link:hover {
			background-color: var(--color-primary-light);
			color: var(--color-primary-hover);
			text-decoration: none;
		}

		.header-section h1 {
			margin: 0;
		}

		.header-section h1 a {
			color: inherit;
			text-decoration: none;
			display: inline-block;
		}

		.header-logo {
			max-height: 48px;
			width: auto;
		}

		.made-by {
			color: var(--color-muted-foreground);
			margin: 0;
			font-size: 13px;
		}

		.made-by a {
			color: var(--color-accent);
			text-decoration: none;
			font-weight: 500;
		}

		.made-by a:hover {
			text-decoration: underline;
		}

		.digital-clock {
			font-family: 'Fira Code', monospace;
			font-variant-numeric: tabular-nums;
			color: var(--color-muted-foreground);
		}

		.digital-clock--hero {
			display: block;
			margin-top: var(--space-2);
			font-size: clamp(1.75rem, 4vw, 2.25rem);
			letter-spacing: 0.05em;
		}

		.digital-clock--compact {
			flex-shrink: 0;
			font-size: 1rem;
			text-align: right;
		}

		/* ============================= */
		/* Layout helpers                */
		/* ============================= */

		.form-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-4);
		}

		.form-row-3 {
			display: grid;
			grid-template-columns: 1fr 1fr 1fr;
			gap: var(--space-4);
		}

		@media (max-width: 1024px) {
			.form-row-3 {
				grid-template-columns: 1fr 1fr;
			}
		}

		.student-search {
			position: relative;
		}

		.student-search-results {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			z-index: 20;
			margin-top: var(--space-1);
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			box-shadow: var(--shadow-md);
			max-height: 220px;
			overflow-y: auto;
		}

		.student-search-item {
			display: block;
			width: 100%;
			padding: var(--space-3) var(--space-4);
			border: none;
			background: none;
			text-align: left;
			font: inherit;
			color: var(--color-foreground);
			cursor: pointer;
		}

		.student-search-item:hover,
		.student-search-item:focus {
			background: var(--color-primary-light);
			outline: none;
		}

		.button-group {
			margin-bottom: var(--space-5);
			display: flex;
			gap: var(--space-3);
			flex-wrap: wrap;
		}

		.column-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-4);
			margin-bottom: var(--space-4);
		}

		.toolbar {
			display: flex;
			gap: var(--space-5);
			align-items: flex-end;
			margin-bottom: var(--space-5);
			flex-wrap: wrap;
			padding: var(--space-4);
			background: var(--color-muted);
			border-radius: var(--radius-md);
			border: 1px solid var(--color-border-subtle);
		}

		.toolbar .form-group {
			margin-bottom: 0;
			min-width: 150px;
			flex: 1 1 150px;
		}

		.toolbar label {
			margin-bottom: var(--space-1);
		}

		.toolbar button {
			margin-top: 0;
		}

		.info-display {
			display: flex;
			gap: var(--space-4);
			margin-bottom: var(--space-5);
			flex-wrap: wrap;
		}

		.info-display > div {
			flex: 1;
			min-width: 140px;
			background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
			color: var(--color-on-primary);
			padding: var(--space-4);
			border-radius: var(--radius-md);
			font-size: 1.125rem;
			font-weight: 600;
			text-align: center;
			box-shadow: var(--shadow-sm);
		}

		.total-section {
			margin-left: auto;
			padding: 10px 20px;
			background-color: var(--color-primary);
			color: var(--color-on-primary);
			border-radius: var(--radius-sm);
			font-weight: 600;
			white-space: nowrap;
		}

		/* ============================= */
		/* Status badges                 */
		/* ============================= */

		.status-active,
		.status-conducted {
			color: var(--color-success);
			font-weight: 600;
		}

		.status-inactive,
		.status-cancelled {
			color: var(--color-destructive);
			font-weight: 600;
		}

		.status-rescheduled {
			color: var(--color-warning);
			font-weight: 600;
		}

		.status-scheduled {
			color: var(--color-accent);
			font-weight: 600;
		}

		.status-pending {
			color: var(--color-warning);
			font-weight: 600;
		}

		.status-approved {
			color: var(--color-success);
			font-weight: 600;
		}

		/* ============================= */
		/* Color utilities               */
		/* ============================= */

		.color-cell {
			display: flex;
			align-items: center;
			gap: var(--space-3);
		}

		.color-box {
			width: 24px;
			height: 24px;
			border-radius: var(--radius-sm);
			border: 1px solid var(--color-border);
		}

		.color-group {
			display: flex;
			align-items: center;
			gap: var(--space-4);
		}

		.color-preview {
			width: 40px;
			height: 40px;
			border-radius: var(--radius-sm);
			border: 1px solid var(--color-border);
		}

		.currency-cell,
		.date-cell {
			white-space: nowrap;
		}

		.rate-cell {
			white-space: nowrap;
			font-family: 'Fira Code', 'Courier New', monospace;
			font-size: 0.875rem;
		}

		.email-cell {
			color: var(--color-accent);
		}

		/* ============================= */
		/* Banners & alerts              */
		/* ============================= */

		html.is-dev::before {
			content: 'DEV';
			position: fixed;
			top: 18px;
			right: -34px;
			z-index: 10000;
			background: var(--color-destructive);
			color: #fff;
			font-family: 'Fira Sans', sans-serif;
			font-weight: 700;
			font-size: 11px;
			letter-spacing: 0.15em;
			padding: 6px 48px;
			transform: rotate(45deg);
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
			pointer-events: none;
		}

		.success-banner,
		.error-banner {
			position: fixed;
			top: var(--space-5);
			left: 50%;
			transform: translateX(-50%);
			padding: 14px 28px;
			border-radius: var(--radius-md);
			box-shadow: var(--shadow-lg);
			z-index: 1000;
			opacity: 0;
			transition: opacity var(--transition-base);
			font-weight: 500;
			max-width: calc(100% - 40px);
			text-align: center;
		}

		.success-banner {
			background-color: var(--color-success);
			color: var(--color-on-primary);
		}

		.error-banner {
			background-color: var(--color-destructive);
			color: var(--color-on-primary);
		}

		.success-banner.show,
		.error-banner.show {
			opacity: 1;
		}

		.alert-success,
		.login-success,
		.forgot-message,
		.reset-banner {
			background: var(--color-success-bg);
			border: 1px solid #C5E08A;
			color: #4A6610;
			padding: 12px 16px;
			border-radius: var(--radius-sm);
			margin-bottom: var(--space-5);
			font-size: 0.875rem;
		}

		.alert-error,
		.login-error,
		.forgot-error,
		.reset-error {
			background: var(--color-error-bg);
			border: 1px solid #F5B0B0;
			color: #A03030;
			padding: 12px 16px;
			border-radius: var(--radius-sm);
			margin-bottom: var(--space-5);
			font-size: 0.875rem;
		}

		.login-error.show,
		.login-error:not(:empty),
		.forgot-error.show,
		.forgot-error:not(:empty),
		.reset-error.show,
		.reset-error:not(:empty),
		.forgot-message.show {
			display: block;
		}

		.login-error,
		.login-success,
		.forgot-message,
		.forgot-error,
		.reset-error {
			display: none;
		}

		.login-success.show {
			display: block;
		}

		/* ============================= */
		/* Logs & code blocks            */
		/* ============================= */

		.logs-section {
			margin-top: var(--space-8);
			padding: var(--space-4);
			background-color: var(--color-muted);
			border-radius: var(--radius-md);
			border: 1px solid var(--color-border-subtle);
		}

		.logs-section h3 {
			margin-bottom: var(--space-3);
		}

		#logOutput {
			background-color: var(--color-log-bg);
			color: var(--color-log-text);
			padding: var(--space-4);
			border-radius: var(--radius-sm);
			font-family: 'Fira Code', 'Courier New', monospace;
			font-size: 12px;
			max-height: 200px;
			overflow-y: auto;
			white-space: pre-wrap;
			word-wrap: break-word;
		}

		.log-error {
			color: var(--color-destructive);
			background-color: var(--color-error-bg);
			padding: 12px 16px;
			border-radius: var(--radius-sm);
			margin-bottom: var(--space-3);
			font-size: 0.875rem;
		}

		.log-success {
			color: #4A6610;
			background-color: var(--color-success-bg);
			padding: 12px 16px;
			border-radius: var(--radius-sm);
			margin-bottom: var(--space-3);
			font-size: 0.875rem;
		}

		/* ============================= */
		/* Process page                  */
		/* ============================= */

		.results-section {
			margin-top: var(--space-8);
		}

		.results-section h3 {
			margin-bottom: var(--space-4);
		}

		.column-mapping {
			background-color: var(--color-muted);
			padding: var(--space-5);
			border-radius: var(--radius-md);
			margin-top: var(--space-3);
			border: 1px solid var(--color-border-subtle);
		}

		.column-mapping h3 {
			margin-bottom: var(--space-4);
			font-size: 1rem;
			color: var(--color-foreground);
		}

		.column-error {
			color: var(--color-destructive);
			font-size: 12px;
			margin-top: var(--space-1);
			display: none;
		}

		.total-row {
			font-weight: 600;
			background-color: var(--color-primary-light) !important;
		}

		.row-cancelled {
			background-color: var(--color-error-bg) !important;
		}

		.row-rescheduled {
			background-color: var(--color-warning-bg) !important;
		}

		/* ============================= */
		/* Teachers page                 */
		/* ============================= */

		.student-inactive {
			background-color: var(--color-warning-bg) !important;
		}

		.teacher-pending {
			background-color: var(--color-warning-bg) !important;
		}

		.teacher-deleted {
			background-color: var(--color-error-bg) !important;
		}

		.copyable-cell {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			max-width: 220px;
		}

		.copyable-text {
			flex: 1;
			min-width: 0;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.copy-btn {
			flex-shrink: 0;
			background: none;
			border: none;
			padding: 4px;
			margin: 0;
			cursor: pointer;
			color: var(--color-muted-foreground);
			border-radius: var(--radius-sm);
			display: inline-flex;
			align-items: center;
			justify-content: center;
			transition: background-color var(--transition-fast), color var(--transition-fast);
		}

		.copy-btn:hover {
			background-color: var(--color-primary-light);
			color: var(--color-primary);
		}

		.copy-btn.copied {
			color: var(--color-success);
		}

		.open-btn {
			flex-shrink: 0;
			background: none;
			border: none;
			padding: 4px;
			margin: 0;
			cursor: pointer;
			color: var(--color-muted-foreground);
			border-radius: var(--radius-sm);
			display: inline-flex;
			align-items: center;
			justify-content: center;
			text-decoration: none;
			transition: background-color var(--transition-fast), color var(--transition-fast);
		}

		.open-btn:hover {
			background-color: var(--color-info-bg);
			color: var(--color-accent);
		}

		.form-warning {
			margin-top: var(--space-3);
			padding: var(--space-3) var(--space-4);
			border-radius: var(--radius-md);
			background: var(--color-warning-bg);
			color: var(--color-foreground);
			font-size: 0.875rem;
			line-height: 1.5;
			border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
		}

		.day-class-meeting {
			margin-top: var(--space-2);
		}

		.day-class-meeting-warning {
			margin-top: var(--space-2);
			font-size: 0.8125rem;
			line-height: 1.45;
			color: var(--color-muted-foreground);
		}

		.meeting-link-cell {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			max-width: 100%;
		}

		.meeting-passcode {
			margin-top: var(--space-1);
			font-size: 0.8125rem;
			color: var(--color-muted-foreground);
		}
			width: 48px;
			text-align: center;
			color: var(--color-muted-foreground);
		}

		.table-actions {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--space-2);
		}

		.avatar-col {
			width: 3.5rem;
			text-align: center;
		}

		.inactive-reason-group {
			display: none;
		}

		.inactive-reason-group.is-visible {
			display: block;
		}

		.table-actions .edit-btn,
		.table-actions .view-btn,
		.table-actions .approve-btn,
		.table-actions .unapprove-btn,
		.table-actions .delete-btn,
		.table-actions .warning-btn,
		.table-actions .btn {
			margin-top: 0;
		}

		.table-actions .view-btn,
		.table-actions .btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			line-height: 1.25;
			vertical-align: middle;
		}

		.table-actions .view-btn {
			padding: 5px 12px;
			font-size: 0.8125rem;
		}

		.icon-action-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 36px;
			height: 36px;
			padding: var(--space-1);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			background: var(--color-surface);
			color: var(--color-foreground);
			text-decoration: none;
			font-family: inherit;
			cursor: pointer;
			transition: background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
		}

		.icon-action-btn svg {
			display: block;
			flex-shrink: 0;
			stroke: currentColor;
		}

		.icon-action-btn:hover {
			background: var(--color-info-bg);
			border-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
			box-shadow: var(--shadow-sm);
		}

		.icon-action-btn:focus-visible {
			outline: 2px solid var(--color-ring);
			outline-offset: 2px;
		}

		.icon-action-btn--conduct {
			color: var(--color-success);
			border-color: color-mix(in srgb, var(--color-success) 35%, var(--color-border));
		}

		.icon-action-btn--conduct:hover {
			background: var(--color-success-bg);
			border-color: var(--color-success);
		}

		.icon-action-btn--cancel {
			color: var(--color-destructive);
			border-color: color-mix(in srgb, var(--color-destructive) 35%, var(--color-border));
		}

		.icon-action-btn--cancel:hover {
			background: var(--color-error-bg);
			border-color: var(--color-destructive);
		}

		.icon-action-btn--edit {
			color: var(--color-accent);
		}

		.icon-action-btn--view,
		.icon-action-btn--mark-read {
			color: var(--color-primary-hover);
			border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
		}

		.icon-action-btn--view:hover,
		.icon-action-btn--mark-read:hover {
			background: var(--color-primary-light);
			border-color: var(--color-primary);
		}

		.icon-action-btn--approve {
			color: var(--color-success);
			border-color: color-mix(in srgb, var(--color-success) 35%, var(--color-border));
		}

		.icon-action-btn--approve:hover {
			background: var(--color-success-bg);
			border-color: var(--color-success);
		}

		.icon-action-btn--delete,
		.icon-action-btn--reject {
			color: var(--color-destructive);
			border-color: color-mix(in srgb, var(--color-destructive) 35%, var(--color-border));
		}

		.icon-action-btn--delete:hover,
		.icon-action-btn--reject:hover {
			background: var(--color-error-bg);
			border-color: var(--color-destructive);
		}

		.icon-action-btn--unapprove,
		.icon-action-btn--warning {
			color: #7A4E00;
			border-color: color-mix(in srgb, var(--color-warning) 35%, var(--color-border));
		}

		.icon-action-btn--unapprove:hover,
		.icon-action-btn--warning:hover {
			background: var(--color-warning-bg);
			border-color: var(--color-warning);
		}

		.icon-action-btn.is-disabled {
			opacity: 0.45;
			cursor: not-allowed;
			pointer-events: none;
		}

		[data-tooltip] {
			position: relative;
		}

		[data-tooltip]::after {
			content: attr(data-tooltip);
			position: absolute;
			bottom: calc(100% + 6px);
			left: 50%;
			transform: translateX(-50%);
			padding: 0.35rem 0.55rem;
			border-radius: var(--radius-sm);
			background: var(--color-foreground);
			color: var(--color-surface);
			font-size: 0.75rem;
			font-weight: 500;
			line-height: 1.2;
			white-space: nowrap;
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			z-index: 200;
			transition: opacity var(--transition-fast), visibility var(--transition-fast);
		}

		[data-tooltip]:hover::after,
		[data-tooltip]:focus-visible::after {
			opacity: 1;
			visibility: visible;
		}

		@media (prefers-reduced-motion: reduce) {
			[data-tooltip]::after {
				transition: none;
			}
		}

		.table-actions .icon-action-btn {
			margin-top: 0;
			flex-shrink: 0;
		}

		.day-class-actions .icon-action-btn {
			flex-shrink: 0;
		}

		.download-report-wrap {
			display: inline-flex;
			align-items: center;
		}

		/* ============================= */
		/* Logs page                     */
		/* ============================= */

		.error-cell {
			color: var(--color-destructive);
			max-width: 200px;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.error-cell:hover {
			white-space: normal;
			word-break: break-word;
		}

		.success-cell {
			color: var(--color-success);
		}

		.loading {
			text-align: center;
			padding: var(--space-10);
			color: var(--color-muted-foreground);
		}

		/* ============================= */
		/* Auth pages                    */
		/* ============================= */

		body.auth-page {
			min-height: 100vh;
			display: flex;
			justify-content: center;
			align-items: center;
			padding: var(--space-5);
			background: linear-gradient(160deg, var(--color-background) 0%, var(--color-primary-light) 50%, var(--color-info-bg) 100%);
		}

		.auth-card {
			background: var(--color-surface);
			border-radius: var(--radius-lg);
			box-shadow: var(--shadow-lg);
			padding: var(--space-10);
			width: 100%;
			max-width: 420px;
			border: 1px solid var(--color-border-subtle);
		}

		.auth-logo {
			display: block;
			max-width: 200px;
			height: auto;
			margin: 0 auto var(--space-8);
		}

		.auth-title {
			text-align: center;
			margin-bottom: var(--space-8);
			color: var(--color-foreground);
		}

		.auth-links {
			text-align: center;
			margin-top: var(--space-5);
			font-size: 0.875rem;
		}

		.auth-links a {
			text-decoration: none;
			font-weight: 500;
		}

		.auth-links a:hover {
			text-decoration: underline;
		}

		.auth-footer {
			margin-top: var(--space-8);
			text-align: center;
		}

		.auth-card button {
			width: 100%;
			margin-top: 0;
		}

		.auth-card .form-group:last-of-type {
			text-align: center;
		}

		/* ============================= */
		/* Home page                     */
		/* ============================= */

		.home-container {
			max-width: 960px;
			margin: 0 auto;
			padding: var(--space-10) var(--space-5);
		}

		.home-title {
			text-align: center;
			margin-bottom: var(--space-3);
		}

		.home-logo {
			max-width: 280px;
			height: auto;
		}

		.home-welcome {
			text-align: center;
			margin-bottom: var(--space-8);
			color: var(--color-muted-foreground);
			font-size: 1.0625rem;
		}

		.home-top-bar {
			display: flex;
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			gap: var(--space-3);
			width: 100%;
			margin-bottom: var(--space-5);
			overflow: visible;
		}

		.home-top-bar-left {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			overflow: visible;
		}

		.home-top-bar-left .header-avatar-link {
			display: inline-flex;
			align-items: center;
			align-self: center;
		}

		.home-top-bar .notification-bell-wrap {
			display: inline-flex;
			align-items: center;
			align-self: center;
		}

		.home-top-bar button {
			margin-top: 0;
		}

		.cards-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
			gap: var(--space-5);
		}

		.dashboard-stats {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
			gap: var(--space-4);
			margin-bottom: var(--space-6);
		}

		.stat-card {
			background: var(--color-surface);
			border: 1px solid var(--color-border-subtle);
			border-radius: var(--radius-md);
			padding: var(--space-4);
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		.stat-label {
			font-size: 0.85rem;
			color: var(--color-muted-foreground);
			font-weight: 500;
		}

		.stat-value {
			font-size: 1.35rem;
			font-weight: 600;
			font-variant-numeric: tabular-nums;
			line-height: 1.2;
		}

		.stat-sub {
			font-size: 0.8rem;
			color: var(--color-muted-foreground);
		}

		.stat-card {
			transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
		}

		.stat-card:hover {
			border-color: var(--color-border);
			box-shadow: var(--shadow-sm);
		}

		a.stat-card {
			text-decoration: none;
			color: inherit;
			cursor: pointer;
		}

		.stat-card-accent {
			border-top: 3px solid var(--color-accent);
		}

		.dashboard-section-title {
			font-size: 0.8125rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.04em;
			color: var(--color-muted-foreground);
			margin: 0 0 var(--space-4);
		}

		.card-feature::before {
			opacity: 1;
		}

		.hub-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-4);
			margin-bottom: var(--space-4);
		}

		.hub-title {
			margin: 0;
		}

		.schedule-section {
			margin-bottom: var(--space-6);
			padding: var(--space-4);
			background: var(--color-surface);
			border-radius: var(--radius-md);
			border: 1px solid var(--color-border-subtle);
		}

		.schedule-section h3 {
			margin-top: 0;
			margin-bottom: var(--space-4);
		}

		.form-message {
			margin-bottom: var(--space-3);
			color: var(--color-success);
			font-size: 0.875rem;
			padding: var(--space-2) var(--space-3);
			border-radius: var(--radius-sm);
		}

		.form-message:empty {
			display: none;
			margin: 0;
			padding: 0;
		}

		.form-message.is-success {
			background: var(--color-success-bg);
			color: var(--color-success);
			border: 1px solid var(--color-primary-light);
		}

		.form-message.is-error {
			background: var(--color-error-bg);
			color: var(--color-destructive);
			border: 1px solid rgba(224, 69, 69, 0.25);
		}

		.schedule-layout {
			display: grid;
			grid-template-columns: minmax(260px, 320px) 1fr;
			gap: var(--space-5);
			align-items: start;
		}

		.schedule-section-head {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-3);
			margin-bottom: var(--space-3);
		}

		.schedule-section-head h3 {
			margin: 0;
		}

		.action-link {
			color: var(--color-accent);
			text-decoration: none;
			font-weight: 500;
		}

		.action-link:hover {
			text-decoration: underline;
		}

		.action-btn {
			background: none;
			border: none;
			color: var(--color-accent);
			cursor: pointer;
			font-size: inherit;
			padding: 0;
			font-weight: 500;
		}

		.action-btn:hover {
			text-decoration: underline;
		}

		.schedule-calendar-full {
			max-width: 100%;
		}

		.schedule-calendar-section {
			padding: var(--space-4);
		}

		.schedule-today-section {
			margin-bottom: 0;
			max-height: 28rem;
			overflow-y: auto;
		}

		.schedule-today-section h3 {
			margin: 0 0 var(--space-3);
			font-size: 1.1rem;
		}

		.schedule-today-date {
			margin: 0 0 var(--space-3);
			font-size: 0.9rem;
			color: var(--color-muted-foreground);
		}

		.schedule-toolbar {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-3);
			align-items: flex-end;
			margin-bottom: var(--space-4);
		}

		.calendar-legend {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-4);
			margin-bottom: var(--space-3);
			font-size: 0.875rem;
			color: var(--color-muted-foreground);
		}

		.legend-item {
			display: inline-flex;
			align-items: center;
			gap: var(--space-2);
		}

		.legend-swatch {
			width: 1rem;
			height: 1rem;
			border-radius: var(--radius-sm);
			border: 1px solid var(--color-border);
		}

		.legend-vacant {
			background: var(--color-surface);
		}

		.legend-scheduled {
			background: var(--color-primary-light);
			border-color: var(--color-primary);
		}

		.legend-today {
			background: var(--color-surface);
			border-color: var(--color-accent);
			box-shadow: inset 0 0 0 2px var(--color-accent);
		}

		.calendar-grid-full {
			gap: 6px;
		}

		.calendar-grid-full .calendar-day {
			aspect-ratio: auto;
			min-height: 4.5rem;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: flex-start;
			padding: 0.35rem 0.25rem;
			position: relative;
		}

		.calendar-day-num {
			font-weight: 600;
			font-size: 0.95rem;
			line-height: 1.2;
		}

		.calendar-day-badge {
			margin-top: 0.25rem;
			font-size: 0.7rem;
			font-weight: 600;
			line-height: 1;
			padding: 0.15rem 0.4rem;
			border-radius: 999px;
			background: var(--color-primary);
			color: var(--color-on-primary);
		}

		.calendar-day.has-scheduled {
			background: var(--color-primary-light);
			border-color: var(--color-primary);
		}

		.calendar-day.has-scheduled:hover {
			background: color-mix(in srgb, var(--color-primary-light) 85%, var(--color-primary));
		}

		.calendar-day.is-vacant {
			background: var(--color-surface);
			border-color: var(--color-border-subtle);
		}

		.calendar-day.is-vacant:hover {
			background: var(--color-muted);
			border-color: var(--color-border);
		}

		.calendar-day.is-active {
			box-shadow: inset 0 0 0 2px var(--color-accent);
		}

		.calendar-day.is-past {
			opacity: 0.55;
		}

		.calendar-day.is-past.has-scheduled {
			opacity: 0.85;
		}

		.schedule-calendar-full .calendar-day {
			border: 1px solid transparent;
			border-radius: var(--radius-sm);
			background: var(--color-surface);
			color: var(--color-foreground);
			font-size: 0.875rem;
			cursor: pointer;
			transition: background 150ms ease, border-color 150ms ease, color 150ms ease, opacity 150ms ease;
		}

		.schedule-calendar-full .calendar-day:hover:not(:disabled) {
			border-color: var(--color-border);
		}

		.schedule-calendar-full .calendar-day.has-scheduled:hover {
			border-color: var(--color-primary);
		}

		.schedule-calendar-full .calendar-day.is-vacant:hover {
			border-color: var(--color-border);
		}

		.schedule-calendar-full .calendar-day.is-past {
			cursor: pointer;
		}

		.calendar-empty-msg {
			grid-column: 1 / -1;
			text-align: center;
			color: var(--color-muted-foreground);
			padding: var(--space-6);
		}

		body.modal-open {
			overflow: hidden;
		}

		.modal-overlay {
			position: fixed;
			inset: 0;
			background: rgba(15, 23, 42, 0.5);
			display: flex;
			align-items: center;
			justify-content: center;
			padding: var(--space-4);
			z-index: 1000;
			animation: modal-overlay-in 200ms ease;
		}

		@keyframes modal-overlay-in {
			from { opacity: 0; }
			to { opacity: 1; }
		}

		.modal-overlay[hidden] {
			display: none;
		}

		.modal-dialog {
			background: var(--color-surface);
			border-radius: var(--radius-lg);
			border: 1px solid var(--color-border);
			width: min(100%, 32rem);
			max-height: min(90vh, 720px);
			overflow: hidden;
			display: flex;
			flex-direction: column;
			box-shadow: var(--shadow-lg);
			animation: modal-dialog-in 220ms ease;
		}

		.modal-dialog-schedule {
			width: min(100%, 40rem);
		}

		.modal-dialog-profile {
			width: min(100%, 56rem);
		}

		@keyframes modal-dialog-in {
			from {
				opacity: 0;
				transform: translateY(12px) scale(0.98);
			}
			to {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
		}

		.modal-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-3);
			padding: var(--space-4);
			border-bottom: 1px solid var(--color-border-subtle);
		}

		.modal-header h3 {
			margin: 0;
			font-size: 1.1rem;
		}

		.modal-close {
			width: 2rem;
			height: 2rem;
			margin-top: 0;
			padding: 0;
			border: none;
			background: transparent;
			font-size: 1.5rem;
			line-height: 1;
			cursor: pointer;
			color: var(--color-muted-foreground);
			border-radius: var(--radius-sm);
			display: inline-flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
		}

		.modal-close:hover {
			background: var(--color-muted);
			color: var(--color-foreground);
		}

		.modal-close:focus-visible {
			outline: 2px solid var(--color-ring);
			outline-offset: 2px;
		}

		.modal-body {
			padding: var(--space-4);
			display: flex;
			flex-direction: column;
			gap: var(--space-4);
			overflow-y: auto;
			flex: 1;
			min-height: 0;
		}

		.modal-section {
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
		}

		.modal-section-title {
			margin: 0;
			font-size: 0.8125rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.04em;
			color: var(--color-muted-foreground);
		}

		.modal-footer {
			display: flex;
			justify-content: flex-end;
			padding-top: var(--space-2);
		}

		.modal-footer .btn {
			min-width: 9rem;
		}

		/* Teacher view modal tabs */
		#teacherViewModal .profile-tablist {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
			margin-bottom: var(--space-4);
			border-bottom: 1px solid var(--color-border-subtle);
			padding-bottom: var(--space-2);
		}

		#teacherViewModal .profile-tab {
			margin: 0;
			margin-top: 0;
			padding: var(--space-2) var(--space-3);
			border: none;
			border-radius: var(--radius-sm);
			background: transparent;
			color: var(--color-muted-foreground);
			font-size: 0.875rem;
			font-weight: 500;
			width: auto;
			display: inline-block;
			cursor: pointer;
		}

		#teacherViewModal .profile-tab:hover {
			background: var(--color-surface);
			color: var(--color-foreground);
		}

		#teacherViewModal .profile-tab.is-active {
			background: var(--color-primary-light);
			color: var(--color-primary-hover);
		}

		#teacherViewModal .profile-tab-panel {
			display: none;
		}

		#teacherViewModal .profile-tab-panel.is-active {
			display: block;
		}

		.cancel-confirm-panel {
			padding: var(--space-4);
			background: var(--color-error-bg);
			border: 1px solid rgba(224, 69, 69, 0.2);
			border-radius: var(--radius-md);
		}

		.cancel-confirm-title {
			margin: 0 0 var(--space-2);
			font-weight: 600;
			color: var(--color-destructive);
		}

		.cancel-confirm-actions {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
			justify-content: flex-end;
			margin-top: var(--space-3);
		}

		.cancel-confirm-panel .form-group {
			margin-bottom: 0;
		}

		.day-classes-list {
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		.day-classes-empty {
			margin: 0;
			color: var(--color-muted-foreground);
			font-size: 0.9rem;
		}

		.day-classes-items {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		.day-class-item {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-3);
			padding: var(--space-3);
			background: var(--color-surface);
			border-radius: var(--radius-md);
			border: 1px solid var(--color-border-subtle);
			transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
		}

		.day-class-item:hover {
			border-color: var(--color-border);
			box-shadow: var(--shadow-sm);
		}

		.day-class-info {
			display: flex;
			flex-direction: column;
			gap: 0.15rem;
			min-width: 0;
		}

		.day-class-header {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			min-width: 0;
		}

		.day-class-avatar {
			flex-shrink: 0;
		}

		.day-class-info strong {
			font-size: 0.9375rem;
			line-height: 1.3;
			min-width: 0;
		}

		.day-class-info span {
			font-size: 0.85rem;
			color: var(--color-muted-foreground);
			font-variant-numeric: tabular-nums;
		}

		.day-class-time {
			font-size: 0.9rem;
			font-weight: 600;
			color: var(--color-foreground);
		}

		.day-class-actions {
			display: flex;
			flex-wrap: nowrap;
			align-items: center;
			gap: var(--space-2);
			flex-shrink: 0;
		}

		.schedule-today-section .day-class-actions {
			flex-direction: row;
			align-items: center;
		}

		.day-class-actions .btn {
			margin-top: 0;
			padding: 6px 14px;
			font-size: 0.875rem;
			white-space: nowrap;
		}

		@media (max-width: 480px) {
			.day-class-item {
				flex-direction: column;
				align-items: stretch;
			}

			.day-class-actions {
				justify-content: flex-end;
			}
		}

		.schedule-modal-form {
			border-top: 1px solid var(--color-border-subtle);
			padding-top: var(--space-4);
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
		}

		.schedule-modal-form .form-group {
			margin-bottom: 0;
		}

		.schedule-plot-layout {
			display: grid;
			grid-template-columns: minmax(260px, 320px) 1fr;
			gap: var(--space-5);
			align-items: start;
		}

		@media (max-width: 768px) {
			.schedule-plot-layout {
				grid-template-columns: 1fr;
			}
		}

		.schedule-calendar {
			background: var(--color-muted);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			padding: var(--space-3);
		}

		.calendar-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: var(--space-3);
			gap: var(--space-2);
			flex-wrap: wrap;
		}

		.calendar-today-btn {
			padding: 0.4rem 0.75rem;
			margin-top: 0;
			font-size: 0.8125rem;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			background: var(--color-surface);
			color: var(--color-accent);
			cursor: pointer;
			font-weight: 500;
			transition: background var(--transition-fast), border-color var(--transition-fast);
		}

		.calendar-today-btn:hover {
			background: var(--color-info-bg);
			border-color: var(--color-accent);
		}

		.calendar-today-btn:focus-visible {
			outline: 2px solid var(--color-ring);
			outline-offset: 2px;
		}

		.calendar-grid-wrap {
			position: relative;
			min-height: 12rem;
		}

		.calendar-loading {
			position: absolute;
			inset: 0;
			z-index: 2;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: var(--space-2);
			background: rgba(255, 255, 255, 0.82);
			border-radius: var(--radius-sm);
			font-size: 0.875rem;
			color: var(--color-muted-foreground);
		}

		.calendar-loading[hidden] {
			display: none;
		}

		.loading-spinner {
			width: 1.125rem;
			height: 1.125rem;
			border: 2px solid var(--color-border);
			border-top-color: var(--color-primary);
			border-radius: 50%;
			animation: btn-spin 0.65s linear infinite;
		}

		.calendar-month-label {
			font-weight: 600;
			font-size: 1rem;
			color: var(--color-foreground);
			flex: 1;
			text-align: center;
		}

		.calendar-nav-btn {
			width: 2.25rem;
			height: 2.25rem;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			background: var(--color-surface);
			color: var(--color-foreground);
			cursor: pointer;
			font-size: 1.25rem;
			line-height: 1;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			transition: background 150ms ease, border-color 150ms ease;
		}

		.calendar-nav-btn:hover {
			background: var(--color-primary-light);
			border-color: var(--color-primary);
		}

		.calendar-nav-btn:focus-visible {
			outline: 2px solid var(--color-ring);
			outline-offset: 2px;
		}

		.calendar-weekdays {
			display: grid;
			grid-template-columns: repeat(7, 1fr);
			gap: 2px;
			margin-bottom: var(--space-2);
		}

		.calendar-weekday {
			text-align: center;
			font-size: 0.75rem;
			font-weight: 600;
			color: var(--color-muted-foreground);
			padding: var(--space-1) 0;
		}

		.calendar-grid {
			display: grid;
			grid-template-columns: repeat(7, 1fr);
			gap: 4px;
		}

		.calendar-day {
			aspect-ratio: 1;
			min-height: 2.25rem;
			border: 1px solid transparent;
			border-radius: var(--radius-sm);
			background: var(--color-surface);
			color: var(--color-foreground);
			font-size: 0.875rem;
			cursor: pointer;
			transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
		}

		.schedule-plot-layout .calendar-day:hover:not(:disabled) {
			border-color: var(--color-primary);
			background: var(--color-primary-light);
		}

		.calendar-day:focus-visible {
			outline: 2px solid var(--color-ring);
			outline-offset: 1px;
		}

		.calendar-day.is-today {
			border-color: var(--color-accent);
			font-weight: 600;
		}

		.schedule-plot-layout .calendar-day.is-selected {
			background: var(--color-primary);
			border-color: var(--color-primary);
			color: var(--color-on-primary);
			font-weight: 600;
		}

		.schedule-plot-layout .calendar-day.is-past {
			color: var(--color-muted-foreground);
			background: transparent;
			cursor: not-allowed;
			opacity: 0.45;
		}

		.calendar-day.is-empty {
			visibility: hidden;
			pointer-events: none;
		}

		.calendar-selected-label {
			margin-top: var(--space-3);
			font-size: 0.875rem;
			color: var(--color-muted-foreground);
		}

		.calendar-selected-label strong {
			color: var(--color-foreground);
		}

		.schedule-plot-details {
			display: flex;
			flex-direction: column;
			gap: var(--space-4);
		}

		.time-range-fields {
			display: flex;
			flex-direction: column;
			gap: var(--space-4);
		}

		.time-range-group {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-4);
			align-items: start;
		}

		.time-range-separator {
			padding-bottom: 0.65rem;
			color: var(--color-muted-foreground);
			font-weight: 500;
			text-align: center;
		}

		.time-input-wrap input[type="time"] {
			width: 100%;
			font-size: 1rem;
			padding: 0.65rem 0.75rem;
		}

		.duration-preview[hidden] {
			display: none;
		}

		.duration-preview {
			display: inline-flex;
			align-items: center;
			gap: var(--space-2);
			margin-bottom: var(--space-4);
			padding: 0.5rem 0.75rem;
			background: var(--color-primary-light);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			font-size: 0.875rem;
			color: var(--color-foreground);
			min-height: 2.5rem;
		}

		.duration-preview.is-invalid {
			background: #fef2f2;
			border-color: var(--color-destructive);
			color: var(--color-destructive);
		}

		.list-toolbar {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-3);
			align-items: flex-end;
			margin-bottom: var(--space-4);
			padding: var(--space-4);
			background: var(--color-surface);
			border-radius: var(--radius-md);
			border: 1px solid var(--color-border-subtle);
		}

		.list-toolbar .form-group {
			margin-bottom: 0;
			min-width: 140px;
			flex: 1 1 140px;
		}

		.list-toolbar .list-toolbar-action {
			flex: 0 0 auto;
			min-width: auto;
		}

		.list-toolbar .list-toolbar-action label {
			visibility: hidden;
		}

		.pagination-bar {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: var(--space-4);
			margin: var(--space-4) 0;
		}

		.pagination-btn {
			padding: var(--space-2) var(--space-4);
			border-radius: var(--radius-sm);
			background: var(--color-primary);
			color: white;
			text-decoration: none;
			border: none;
			cursor: pointer;
		}

		.pagination-btn.disabled {
			opacity: 0.5;
			cursor: not-allowed;
			background: var(--color-border);
		}

		.pagination-info {
			font-size: 0.9rem;
			color: var(--color-text-muted);
		}

		.edit-btn {
			display: inline-block;
			padding: var(--space-1) var(--space-3);
			border-radius: var(--radius-sm);
			background: var(--color-surface-elevated);
			border: 1px solid var(--color-border);
			text-decoration: none;
			font-size: 0.85rem;
		}

		.delete-btn {
			display: inline-block;
			padding: var(--space-1) var(--space-3);
			border-radius: var(--radius-sm);
			background: var(--color-error-bg);
			border: 1px solid color-mix(in srgb, var(--color-destructive) 35%, transparent);
			color: var(--color-destructive);
			font-size: 0.85rem;
			font-family: inherit;
			font-weight: 500;
			cursor: pointer;
			transition: background-color var(--transition-fast), border-color var(--transition-fast);
		}

		.delete-btn:hover {
			background: color-mix(in srgb, var(--color-error-bg) 70%, var(--color-destructive));
			border-color: var(--color-destructive);
		}

		.warning-btn {
			display: inline-block;
			padding: var(--space-1) var(--space-3);
			border-radius: var(--radius-sm);
			background: var(--color-warning-bg);
			border: 1px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
			color: #7A4E00;
			font-size: 0.85rem;
			font-family: inherit;
			font-weight: 500;
			cursor: pointer;
			transition: background-color var(--transition-fast), border-color var(--transition-fast);
		}

		.warning-btn:hover {
			background: color-mix(in srgb, var(--color-warning-bg) 70%, var(--color-warning));
			border-color: var(--color-warning);
		}

		.table-action-form {
			display: inline-flex;
			margin: 0;
		}

		.view-btn {
			display: inline-block;
			padding: var(--space-1) var(--space-3);
			border-radius: var(--radius-sm);
			background: var(--color-primary-light);
			border: 1px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
			color: var(--color-primary-hover);
			font-size: 0.85rem;
			cursor: pointer;
		}

		.view-btn:hover {
			background: color-mix(in srgb, var(--color-primary-light) 80%, var(--color-primary));
		}

		.name-link {
			margin: 0;
			padding: 0;
			border: none;
			background: none;
			color: var(--color-accent);
			font: inherit;
			font-weight: 500;
			text-align: left;
			cursor: pointer;
			text-decoration: underline;
			text-underline-offset: 2px;
		}

		.name-link:hover {
			color: var(--color-accent-hover);
		}

		.teacher-assign-rows {
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		.teacher-assign-row {
			display: flex;
			gap: var(--space-2);
			align-items: center;
		}

		.teacher-assign-row select {
			flex: 1;
		}

		.teacher-assign-add,
		.teacher-assign-remove {
			flex-shrink: 0;
			width: 36px;
			height: 36px;
			padding: 0;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			background: var(--color-surface);
			color: var(--color-foreground);
			font-size: 18px;
			font-weight: 500;
			line-height: 1;
			cursor: pointer;
			font-family: inherit;
			transition: background-color var(--transition-fast), border-color var(--transition-fast);
		}

		.teacher-assign-add {
			margin-top: var(--space-2);
			background-color: var(--color-primary);
			border-color: var(--color-primary);
			color: var(--color-on-primary);
		}

		.teacher-assign-add:hover {
			background-color: var(--color-primary-hover);
			border-color: var(--color-primary-hover);
		}

		.teacher-assign-remove:hover {
			background: var(--color-muted);
			border-color: var(--color-muted-foreground);
		}

		.checkbox-group {
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		.checkbox-label {
			display: flex;
			align-items: center;
			gap: var(--space-2);
		}

		textarea {
			width: 100%;
			min-height: 80px;
			padding: var(--space-3);
			border-radius: var(--radius-sm);
			border: 1px solid var(--color-border);
			font-family: inherit;
		}

		.card {
			background: var(--color-surface);
			border-radius: var(--radius-lg);
			padding: var(--space-6);
			box-shadow: var(--shadow-sm);
			border: 1px solid var(--color-border-subtle);
			transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
			text-decoration: none;
			display: block;
			position: relative;
			overflow: hidden;
		}

		.card::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 3px;
			background: linear-gradient(90deg, var(--color-tertiary), var(--color-secondary), var(--color-primary), var(--color-accent));
			opacity: 0;
			transition: opacity var(--transition-base);
		}

		.card:hover {
			transform: translateY(-3px);
			box-shadow: var(--shadow-lg);
			border-color: var(--color-border);
			text-decoration: none;
		}

		.card:hover::before {
			opacity: 1;
		}

		.card h2 {
			margin: 0 0 var(--space-3) 0;
			font-size: 1.25rem;
			color: var(--color-foreground);
		}

		.card p {
			margin: 0;
			color: var(--color-muted-foreground);
			font-size: 0.875rem;
			line-height: 1.5;
		}

		/* ============================= */
		/* Password toggle               */
		/* ============================= */

		.password-group {
			display: flex;
			gap: var(--space-3);
			align-items: center;
		}

		.password-group input {
			flex: 1;
		}

		/* ============================= */
		/* Responsive tables (mobile cards)*/
		/* ============================= */

		@media (max-width: 768px) {
			.table-wrapper:has(.table-stack-mobile) {
				overflow-x: visible;
				border: none;
				background: transparent;
				margin-bottom: var(--space-4);
			}

			.table-stack-mobile {
				display: block;
				min-width: 0;
				width: 100%;
			}

			.table-stack-mobile thead {
				display: none;
			}

			.table-stack-mobile tbody {
				display: block;
			}

			.table-stack-mobile tbody tr {
				display: block;
				border: 1px solid var(--color-border-subtle);
				border-radius: var(--radius-md);
				margin-bottom: var(--space-3);
				padding: var(--space-3);
				background: var(--color-surface);
				box-shadow: var(--shadow-sm);
			}

			.table-stack-mobile tbody tr.teacher-pending,
			.table-stack-mobile tbody tr.student-inactive {
				background: var(--color-warning-bg);
			}

			.table-stack-mobile tbody tr.teacher-deleted,
			.table-stack-mobile tbody tr.row-cancelled {
				background: var(--color-error-bg);
			}

			.table-stack-mobile tbody tr.row-rescheduled {
				background: var(--color-warning-bg);
			}

			.table-stack-mobile tbody tr:hover {
				background-color: var(--color-surface);
			}

			.table-stack-mobile tbody tr.teacher-pending:hover,
			.table-stack-mobile tbody tr.student-inactive:hover,
			.table-stack-mobile tbody tr.row-rescheduled:hover {
				background: var(--color-warning-bg);
			}

			.table-stack-mobile tbody tr.teacher-deleted:hover,
			.table-stack-mobile tbody tr.row-cancelled:hover {
				background: var(--color-error-bg);
			}

			.table-stack-mobile td {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: var(--space-3);
				padding: var(--space-2) 0;
				border-bottom: 1px solid var(--color-border-subtle);
				text-align: right;
				word-break: break-word;
				white-space: normal;
			}

			.table-stack-mobile td:last-child {
				border-bottom: none;
			}

			.table-stack-mobile td::before {
				content: attr(data-label);
				font-weight: 600;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.03em;
				color: var(--color-muted-foreground);
				text-align: left;
				flex-shrink: 0;
				min-width: 36%;
				max-width: 44%;
				line-height: 1.4;
			}

			.table-stack-mobile td[data-label="Name"],
			.table-stack-mobile td[data-label="Title"],
			.table-stack-mobile td[data-label="Teacher"] {
				display: block;
				border-bottom: 1px solid var(--color-border-subtle);
				padding-bottom: var(--space-3);
				margin-bottom: var(--space-1);
				text-align: left;
				font-weight: 600;
				font-size: 1rem;
				line-height: 1.35;
				color: var(--color-foreground);
			}

			.table-stack-mobile td[data-label="Name"]::before,
			.table-stack-mobile td[data-label="Title"]::before,
			.table-stack-mobile td[data-label="Teacher"]::before {
				content: none;
				display: none;
			}

			.table-stack-mobile td[data-label="Name"] .name-link {
				font-size: 1rem;
				font-weight: 600;
			}

			.table-stack-mobile td[data-label="Actions"] {
				display: block;
				border-top: 1px solid var(--color-border-subtle);
				margin-top: var(--space-2);
				padding-top: var(--space-3);
				padding-bottom: 0;
				border-bottom: none;
			}

			.table-stack-mobile td[data-label="Actions"]::before {
				content: none;
				display: none;
			}

			.table-stack-mobile td[data-label="Total Rate/Earnings"] {
				flex-direction: column;
				align-items: flex-end;
				gap: var(--space-1);
			}

			.table-stack-mobile td[colspan],
			.table-stack-mobile td.empty-state {
				display: block;
				text-align: center;
				padding: var(--space-6) var(--space-3);
			}

			.table-stack-mobile td[colspan]::before,
			.table-stack-mobile td.empty-state::before {
				content: none;
				display: none;
			}

			.table-stack-mobile .date-cell,
			.table-stack-mobile .rate-cell {
				white-space: normal;
			}

			.table-stack-mobile .copyable-cell {
				max-width: none;
				justify-content: flex-end;
				flex: 1;
				min-width: 0;
			}

			.table-stack-mobile .copy-btn {
				min-width: 44px;
				min-height: 44px;
				flex-shrink: 0;
			}

			.table-stack-mobile .table-actions {
				display: flex;
				flex-direction: row;
				flex-wrap: wrap;
				align-items: center;
				justify-content: flex-end;
				gap: var(--space-2);
			}

			.table-stack-mobile .table-actions .icon-action-btn {
				min-width: 44px;
				min-height: 44px;
				width: 44px;
				height: 44px;
				flex-shrink: 0;
			}

			.table-stack-mobile .table-action-form {
				display: inline-flex;
			}

			.table-stack-mobile .error-cell {
				max-width: none;
				white-space: normal;
				overflow: visible;
				text-overflow: unset;
			}

			.table-stack-mobile .announcement-schedule {
				display: block;
				text-align: right;
				line-height: 1.4;
			}
		}

		/* ============================= */
		/* Responsive                    */
		/* ============================= */

		@media (max-width: 1024px) {
			.container {
				max-width: 100%;
				padding: var(--space-6);
			}

			.header-bottom {
				flex-direction: column;
				gap: var(--space-3);
				align-items: flex-start;
			}

			.header-left {
				flex-wrap: wrap;
			}

			table {
				font-size: 14px;
			}
		}

		@media (max-width: 768px) {
			body {
				padding: var(--space-3);
			}

			.container {
				padding: var(--space-4);
				max-width: 100%;
				border-radius: var(--radius-md);
			}

			.form-row,
			.form-row-3,
			.column-row {
				grid-template-columns: 1fr;
			}

			.button-group {
				flex-direction: column;
				align-items: stretch;
			}

			form > button[type="submit"],
			.button-group > button,
			.button-group > .btn,
			.button-group > a.btn,
			.button-group > a.add-btn,
			.list-toolbar-action button,
			.hub-header .add-btn,
			.header-right > button,
			.header-right > .btn,
			.toolbar > button,
			.modal-footer .btn,
			.cancel-confirm-actions button,
			.schedule-toolbar button,
			.home-top-bar button,
			.profile-upload-form button,
			.profile-form-actions button {
				width: 100%;
				text-align: center;
				margin-left: 0 !important;
			}

			.password-wrapper .password-toggle,
			.copy-btn,
			.approve-btn,
			.unapprove-btn,
			.edit-btn,
			.pagination-btn,
			.calendar-nav-btn,
			.calendar-today-btn,
			.modal-close,
			.action-btn,
			#teacherViewModal .profile-tab {
				width: auto;
				margin-top: 0;
			}

			.header-section {
				align-items: flex-start;
			}

			.digital-clock--compact {
				font-size: 0.875rem;
			}

			.header-bottom {
				width: 100%;
			}

			.header-logo {
				max-height: 40px;
			}

			.header-left {
				flex-direction: column;
				gap: var(--space-2);
				width: 100%;
			}

			.header-right {
				width: 100%;
				align-items: stretch;
			}

			.header-right button {
				width: 100%;
			}

			.nav-links {
				width: 100%;
				flex-wrap: nowrap;
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
				padding-bottom: var(--space-2);
				scrollbar-width: thin;
			}

			.hub-header {
				flex-direction: column;
				align-items: stretch;
				gap: var(--space-3);
			}

			.list-toolbar {
				flex-direction: column;
				align-items: stretch;
				gap: var(--space-3);
			}

			.list-toolbar .form-group {
				flex: 1 1 100%;
				min-width: 0;
				width: 100%;
			}

			.list-toolbar-action {
				flex: 1 1 100%;
				width: 100%;
			}

			.list-toolbar-action button {
				width: 100%;
				min-height: 44px;
			}

			.list-toolbar-action label {
				display: none;
			}

			.pagination-bar {
				flex-wrap: wrap;
				gap: var(--space-2);
			}

			.pagination-info {
				order: -1;
				width: 100%;
				text-align: center;
				font-size: 0.8125rem;
			}

			.pagination-btn {
				flex: 1;
				text-align: center;
				min-width: 0;
				padding: var(--space-2) var(--space-3);
			}

			.time-range-group {
				grid-template-columns: 1fr;
			}

			.time-range-separator {
				display: none;
			}

			.toolbar {
				flex-direction: column;
				align-items: stretch;
			}

			.toolbar .form-group {
				width: 100%;
				min-width: 0;
			}

			.toolbar .total-section {
				margin-left: 0;
				width: 100%;
				text-align: center;
			}

			.info-display {
				flex-direction: column;
			}

			.info-display > div {
				width: 100%;
				font-size: 1rem;
			}

			.color-group {
				flex-wrap: wrap;
			}

			.password-group {
				flex-direction: column;
				align-items: stretch;
			}

			th, td {
				padding: 10px 12px;
				word-break: break-word;
			}

			#logOutput {
				max-height: 150px;
				font-size: 11px;
			}

			.success-banner,
			.error-banner {
				width: calc(100% - 40px);
				left: 20px;
				transform: none;
			}

			.home-container {
				padding: var(--space-5) var(--space-3);
			}

			.home-logo {
				max-width: 220px;
			}

			.cards-grid {
				grid-template-columns: 1fr;
				gap: var(--space-4);
			}

			.schedule-layout {
				grid-template-columns: 1fr;
			}

			.calendar-grid-full .calendar-day {
				min-height: 3.25rem;
				padding: 0.25rem;
			}

			.calendar-day-num {
				font-size: 0.85rem;
			}

			.calendar-day-badge {
				font-size: 0.65rem;
				padding: 0.1rem 0.3rem;
			}

			.modal-dialog-schedule {
				width: 100%;
				max-height: 92vh;
			}

			.calendar-header {
				justify-content: center;
			}

			.calendar-month-label {
				order: -1;
				width: 100%;
				margin-bottom: var(--space-2);
			}

			.calendar-today-btn {
				flex: 1;
			}

			.card {
				padding: var(--space-5);
			}

			.card h2 {
				font-size: 1.125rem;
			}

			.home-top-bar {
				flex-direction: column;
				gap: var(--space-3);
				align-items: center;
			}

			body.auth-page {
				align-items: flex-start;
				padding-top: var(--space-10);
			}

			.auth-card {
				padding: var(--space-6);
			}

			.auth-logo {
				max-width: 160px;
				margin-bottom: var(--space-5);
			}

			.clear-btn {
				margin-left: 0;
				margin-top: var(--space-3);
			}

			.column-mapping {
				padding: var(--space-4);
			}
		}

		@media (max-width: 480px) {
			body {
				font-size: 14px;
			}

			input,
			select {
				font-size: 14px;
			}

			h1 {
				font-size: 1.375rem;
			}

			th, td {
				font-size: 13px;
				padding: 8px 10px;
			}

			.home-logo {
				max-width: 180px;
			}

			.auth-title {
				font-size: 1.375rem;
				margin-bottom: var(--space-5);
			}

			.password-wrapper input {
				padding-right: 44px;
			}
		}
	</style>
	if ShowDevBanner() {
		<script>document.documentElement.classList.add('is-dev')</script>
	}
	@ScrHTMX()
	@ScrHyperscript()
	@ScrClock()
	@SuccessBannerHandlers()
	@CsrfHandlers()
	@ErrorBannerHandlers()
	@ScrClipboardHelpers()
}
