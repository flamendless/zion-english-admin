package frontend

templ GlobalIncludes() {
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Fira+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
	<style>
		:root {
			/* Zion logo palette: z=coral, i=amber, o=green, n=blue */
			--color-primary: #90C020;
			--color-primary-hover: #7A9F18;
			--color-primary-light: #EEF6D8;
			--color-on-primary: #FFFFFF;
			--color-secondary: #F0B030;
			--color-tertiary: #F06060;
			--color-accent: #20A0E0;
			--color-accent-hover: #1A8AC4;
			--color-background: #FAFAF7;
			--color-surface: #FFFFFF;
			--color-foreground: #2D2D2D;
			--color-muted: #F3F1EC;
			--color-muted-foreground: #6B6560;
			--color-border: #E5E2DA;
			--color-border-subtle: #F0EDE6;
			--color-destructive: #E04545;
			--color-destructive-hover: #C73A3A;
			--color-success: #7A9F18;
			--color-success-bg: #EEF6D8;
			--color-warning: #F0B030;
			--color-warning-bg: #FEF6E0;
			--color-info: #20A0E0;
			--color-info-bg: #E5F4FC;
			--color-error-bg: #FDE8E8;
			--color-ring: #90C020;
			--color-log-bg: #2D2D2D;
			--color-log-text: #F0EDE6;

			--radius-sm: 6px;
			--radius-md: 8px;
			--radius-lg: 12px;
			--radius-full: 9999px;

			--shadow-sm: 0 1px 2px rgba(45, 45, 45, 0.06);
			--shadow-md: 0 4px 12px rgba(45, 45, 45, 0.08);
			--shadow-lg: 0 8px 24px rgba(45, 45, 45, 0.12);

			--transition-fast: 150ms ease;
			--transition-base: 200ms ease;

			--space-1: 4px;
			--space-2: 8px;
			--space-3: 12px;
			--space-4: 16px;
			--space-5: 20px;
			--space-6: 24px;
			--space-8: 32px;
			--space-10: 40px;
		}

		@media (prefers-reduced-motion: reduce) {
			*, *::before, *::after {
				animation-duration: 0.01ms !important;
				animation-iteration-count: 1 !important;
				transition-duration: 0.01ms !important;
			}
		}

		* {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		body {
			font-family: 'Fira Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			background-color: var(--color-background);
			color: var(--color-foreground);
			padding: var(--space-5);
			line-height: 1.6;
			-webkit-font-smoothing: antialiased;
		}

		.container {
			max-width: 1200px;
			margin: 0 auto;
			background: var(--color-surface);
			padding: var(--space-8);
			border-radius: var(--radius-lg);
			box-shadow: var(--shadow-md);
			border: 1px solid var(--color-border-subtle);
		}

		/* ============================= */
		/* Typography                    */
		/* ============================= */

		h1, h2, h3 {
			color: var(--color-foreground);
			font-weight: 600;
			line-height: 1.3;
		}

		h1 { font-size: 1.75rem; }
		h2 { font-size: 1.375rem; }
		h3 { font-size: 1.125rem; }

		a {
			color: var(--color-accent);
			transition: color var(--transition-fast);
		}

		a:hover {
			color: var(--color-accent-hover);
		}

		/* ============================= */
		/* Forms                         */
		/* ============================= */

		.form-group {
			margin-bottom: var(--space-5);
		}

		label {
			display: block;
			margin-bottom: var(--space-1);
			color: var(--color-foreground);
			font-weight: 500;
			font-size: 0.875rem;
		}

		input[type="text"],
		input[type="number"],
		input[type="date"],
		input[type="email"],
		input[type="password"],
		select,
		textarea {
			width: 100%;
			padding: 10px 12px;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			font-size: 14px;
			font-family: inherit;
			color: var(--color-foreground);
			background: var(--color-surface);
			transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
		}

		input[type="text"]:focus,
		input[type="number"]:focus,
		input[type="date"]:focus,
		input[type="email"]:focus,
		input[type="password"]:focus,
		select:focus,
		textarea:focus {
			outline: none;
			border-color: var(--color-primary);
			box-shadow: 0 0 0 3px rgba(144, 192, 32, 0.2);
		}

		input[type="color"] {
			width: 60px;
			height: 40px;
			padding: 2px;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			cursor: pointer;
		}

		input:disabled,
		select:disabled {
			background-color: var(--color-muted);
			cursor: not-allowed;
			opacity: 0.7;
		}

		input:invalid:not(:focus):not(:placeholder-shown) {
			border-color: var(--color-destructive);
		}

		.error-message {
			color: var(--color-destructive);
			font-size: 12px;
			margin-top: var(--space-1);
			display: none;
		}

		.field-hint {
			color: var(--color-muted-foreground);
			font-size: 0.8125rem;
			margin-top: var(--space-1);
			margin-bottom: var(--space-2);
			line-height: 1.4;
		}

		.error-message.show {
			display: block;
		}

		/* ============================= */
		/* Buttons                       */
		/* ============================= */

		button, .btn {
			background-color: var(--color-primary);
			color: var(--color-on-primary);
			padding: 10px 24px;
			border: none;
			border-radius: var(--radius-sm);
			cursor: pointer;
			font-size: 15px;
			font-weight: 500;
			font-family: inherit;
			text-decoration: none;
			display: inline-block;
			margin-top: var(--space-5);
			transition: background-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
		}

		button:hover, .btn:hover {
			background-color: var(--color-primary-hover);
		}

		button:focus-visible, .btn:focus-visible,
		a:focus-visible, .nav-link:focus-visible {
			outline: 2px solid var(--color-ring);
			outline-offset: 2px;
		}

		button:disabled, .btn:disabled {
			background-color: var(--color-muted);
			color: var(--color-muted-foreground);
			cursor: not-allowed;
			opacity: 0.6;
		}

		button:active:not(:disabled):not(.password-toggle), .btn:active:not(:disabled) {
			transform: scale(0.98);
		}

		.btn-accent, .refresh-btn {
			background-color: var(--color-secondary);
			color: var(--color-foreground);
		}

		.btn-accent:hover, .refresh-btn:hover {
			background-color: #D99A20;
		}

		.btn-info, .download-btn, .export-btn {
			background-color: var(--color-info);
		}

		.btn-info:hover, .download-btn:hover, .export-btn:hover {
			background-color: var(--color-accent-hover);
		}

		.btn-danger, .clear-btn {
			background-color: var(--color-destructive);
		}

		.btn-danger:hover, .clear-btn:hover {
			background-color: var(--color-destructive-hover);
		}

		.add-btn {
			background-color: var(--color-primary);
			color: var(--color-on-primary);
			padding: 10px 20px;
			border: none;
			border-radius: var(--radius-sm);
			cursor: pointer;
			font-size: 14px;
			font-weight: 500;
			font-family: inherit;
			text-decoration: none;
			display: inline-block;
			margin-top: 0;
			transition: background-color var(--transition-fast);
		}

		.add-btn:hover {
			background-color: var(--color-primary-hover);
		}

		.approve-btn,
		.unapprove-btn {
			border: none;
			padding: 6px 14px;
			border-radius: var(--radius-sm);
			cursor: pointer;
			font-size: 13px;
			font-weight: 500;
			font-family: inherit;
			margin-top: 0;
			transition: background-color var(--transition-fast);
		}

		.approve-btn {
			background-color: var(--color-primary);
			color: var(--color-on-primary);
		}

		.approve-btn:hover {
			background-color: var(--color-primary-hover);
		}

		.unapprove-btn {
			background-color: var(--color-warning);
			color: var(--color-on-primary);
		}

		.unapprove-btn:hover {
			background-color: #D99A20;
		}

		/* ============================= */
		/* Tables                        */
		/* ============================= */

		.table-wrapper {
			overflow-x: auto;
			margin-bottom: var(--space-5);
			-webkit-overflow-scrolling: touch;
			border-radius: var(--radius-md);
			border: 1px solid var(--color-border-subtle);
		}

		.table-wrapper table {
			min-width: 640px;
			margin-bottom: 0;
		}

		table {
			width: 100%;
			border-collapse: collapse;
			margin-bottom: var(--space-5);
		}

		th, td {
			padding: 12px 16px;
			text-align: left;
			border-bottom: 1px solid var(--color-border-subtle);
		}

		th {
			background-color: var(--color-primary);
			color: var(--color-on-primary);
			font-weight: 600;
			font-size: 0.8125rem;
			text-transform: uppercase;
			letter-spacing: 0.03em;
			white-space: nowrap;
		}

		tr:last-child td {
			border-bottom: none;
		}

		tbody tr {
			transition: background-color var(--transition-fast);
		}

		tbody tr:hover {
			background-color: var(--color-primary-light);
		}

		.empty-state {
			text-align: center;
			padding: var(--space-10);
			color: var(--color-muted-foreground);
		}

		.empty-state p + p {
			margin-top: var(--space-2);
			font-size: 0.875rem;
		}

		/* ============================= */
		/* Header & Navigation           */
		/* ============================= */

		.header-section {
			margin-bottom: var(--space-8);
			padding-bottom: var(--space-5);
			border-bottom: 2px solid var(--color-border-subtle);
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
		}

		.header-section h3 {
			color: var(--color-muted-foreground);
			font-weight: 400;
			font-size: 0.9375rem;
		}

		.header-bottom {
			display: flex;
			align-items: flex-start;
			gap: var(--space-4);
		}

		.header-left {
			display: flex;
			align-items: baseline;
			gap: var(--space-5);
			flex: 1;
		}

		.header-right {
			flex-shrink: 0;
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			gap: var(--space-2);
		}

		.nav-links {
			display: flex;
			align-items: center;
			flex-wrap: wrap;
			gap: var(--space-1);
		}

		.nav-link {
			color: var(--color-foreground);
			text-decoration: none;
			font-weight: 500;
			font-size: 0.875rem;
			padding: 6px 12px;
			border-radius: var(--radius-full);
			transition: background-color var(--transition-fast), color var(--transition-fast);
		}

		.nav-link:hover {
			background-color: var(--color-primary-light);
			color: var(--color-primary-hover);
			text-decoration: none;
		}

		.header-section h1 {
			margin: 0;
		}

		.header-section h1 a {
			color: inherit;
			text-decoration: none;
			display: inline-block;
		}

		.header-logo {
			max-height: 48px;
			width: auto;
		}

		.made-by {
			color: var(--color-muted-foreground);
			margin: 0;
			font-size: 13px;
		}

		.made-by a {
			color: var(--color-accent);
			text-decoration: none;
			font-weight: 500;
		}

		.made-by a:hover {
			text-decoration: underline;
		}

		/* ============================= */
		/* Layout helpers                */
		/* ============================= */

		.form-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-4);
		}

		.form-row-3 {
			display: grid;
			grid-template-columns: 1fr 1fr 1fr;
			gap: var(--space-4);
		}

		.button-group {
			margin-bottom: var(--space-5);
			display: flex;
			gap: var(--space-3);
			flex-wrap: wrap;
		}

		.column-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-4);
			margin-bottom: var(--space-4);
		}

		.toolbar {
			display: flex;
			gap: var(--space-5);
			align-items: flex-end;
			margin-bottom: var(--space-5);
			flex-wrap: wrap;
			padding: var(--space-4);
			background: var(--color-muted);
			border-radius: var(--radius-md);
			border: 1px solid var(--color-border-subtle);
		}

		.toolbar .form-group {
			margin-bottom: 0;
			min-width: 150px;
			flex: 1 1 150px;
		}

		.toolbar label {
			margin-bottom: var(--space-1);
		}

		.toolbar button {
			margin-top: 0;
		}

		.info-display {
			display: flex;
			gap: var(--space-4);
			margin-bottom: var(--space-5);
			flex-wrap: wrap;
		}

		.info-display > div {
			flex: 1;
			min-width: 140px;
			background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
			color: var(--color-on-primary);
			padding: var(--space-4);
			border-radius: var(--radius-md);
			font-size: 1.125rem;
			font-weight: 600;
			text-align: center;
			box-shadow: var(--shadow-sm);
		}

		.total-section {
			margin-left: auto;
			padding: 10px 20px;
			background-color: var(--color-primary);
			color: var(--color-on-primary);
			border-radius: var(--radius-sm);
			font-weight: 600;
			white-space: nowrap;
		}

		/* ============================= */
		/* Status badges                 */
		/* ============================= */

		.status-active,
		.status-conducted {
			color: var(--color-success);
			font-weight: 600;
		}

		.status-inactive,
		.status-cancelled {
			color: var(--color-destructive);
			font-weight: 600;
		}

		.status-rescheduled {
			color: var(--color-warning);
			font-weight: 600;
		}

		.status-pending {
			color: var(--color-warning);
			font-weight: 600;
		}

		.status-approved {
			color: var(--color-success);
			font-weight: 600;
		}

		/* ============================= */
		/* Color utilities               */
		/* ============================= */

		.color-cell {
			display: flex;
			align-items: center;
			gap: var(--space-3);
		}

		.color-box {
			width: 24px;
			height: 24px;
			border-radius: var(--radius-sm);
			border: 1px solid var(--color-border);
		}

		.color-group {
			display: flex;
			align-items: center;
			gap: var(--space-4);
		}

		.color-preview {
			width: 40px;
			height: 40px;
			border-radius: var(--radius-sm);
			border: 1px solid var(--color-border);
		}

		.currency-cell,
		.date-cell {
			white-space: nowrap;
		}

		.rate-cell {
			white-space: nowrap;
			font-family: 'Fira Code', 'Courier New', monospace;
			font-size: 0.875rem;
		}

		.email-cell {
			color: var(--color-accent);
		}

		/* ============================= */
		/* Banners & alerts              */
		/* ============================= */

		.success-banner,
		.error-banner {
			position: fixed;
			top: var(--space-5);
			left: 50%;
			transform: translateX(-50%);
			padding: 14px 28px;
			border-radius: var(--radius-md);
			box-shadow: var(--shadow-lg);
			z-index: 1000;
			opacity: 0;
			transition: opacity var(--transition-base);
			font-weight: 500;
			max-width: calc(100% - 40px);
			text-align: center;
		}

		.success-banner {
			background-color: var(--color-success);
			color: var(--color-on-primary);
		}

		.error-banner {
			background-color: var(--color-destructive);
			color: var(--color-on-primary);
		}

		.success-banner.show,
		.error-banner.show {
			opacity: 1;
		}

		.alert-success,
		.login-success,
		.forgot-message,
		.reset-banner {
			background: var(--color-success-bg);
			border: 1px solid #C5E08A;
			color: #4A6610;
			padding: 12px 16px;
			border-radius: var(--radius-sm);
			margin-bottom: var(--space-5);
			font-size: 0.875rem;
		}

		.alert-error,
		.login-error,
		.forgot-error,
		.reset-error {
			background: var(--color-error-bg);
			border: 1px solid #F5B0B0;
			color: #A03030;
			padding: 12px 16px;
			border-radius: var(--radius-sm);
			margin-bottom: var(--space-5);
			font-size: 0.875rem;
		}

		.login-error.show,
		.login-error:not(:empty),
		.forgot-error.show,
		.forgot-error:not(:empty),
		.reset-error.show,
		.reset-error:not(:empty),
		.forgot-message.show {
			display: block;
		}

		.login-error,
		.login-success,
		.forgot-message,
		.forgot-error,
		.reset-error {
			display: none;
		}

		.login-success.show {
			display: block;
		}

		/* ============================= */
		/* Logs & code blocks            */
		/* ============================= */

		.logs-section {
			margin-top: var(--space-8);
			padding: var(--space-4);
			background-color: var(--color-muted);
			border-radius: var(--radius-md);
			border: 1px solid var(--color-border-subtle);
		}

		.logs-section h3 {
			margin-bottom: var(--space-3);
		}

		#logOutput {
			background-color: var(--color-log-bg);
			color: var(--color-log-text);
			padding: var(--space-4);
			border-radius: var(--radius-sm);
			font-family: 'Fira Code', 'Courier New', monospace;
			font-size: 12px;
			max-height: 200px;
			overflow-y: auto;
			white-space: pre-wrap;
			word-wrap: break-word;
		}

		.log-error {
			color: var(--color-destructive);
			background-color: var(--color-error-bg);
			padding: 12px 16px;
			border-radius: var(--radius-sm);
			margin-bottom: var(--space-3);
			font-size: 0.875rem;
		}

		.log-success {
			color: #4A6610;
			background-color: var(--color-success-bg);
			padding: 12px 16px;
			border-radius: var(--radius-sm);
			margin-bottom: var(--space-3);
			font-size: 0.875rem;
		}

		/* ============================= */
		/* Process page                  */
		/* ============================= */

		.results-section {
			margin-top: var(--space-8);
		}

		.results-section h3 {
			margin-bottom: var(--space-4);
		}

		.column-mapping {
			background-color: var(--color-muted);
			padding: var(--space-5);
			border-radius: var(--radius-md);
			margin-top: var(--space-3);
			border: 1px solid var(--color-border-subtle);
		}

		.column-mapping h3 {
			margin-bottom: var(--space-4);
			font-size: 1rem;
			color: var(--color-foreground);
		}

		.column-error {
			color: var(--color-destructive);
			font-size: 12px;
			margin-top: var(--space-1);
			display: none;
		}

		.total-row {
			font-weight: 600;
			background-color: var(--color-primary-light) !important;
		}

		.row-cancelled {
			background-color: var(--color-error-bg) !important;
		}

		/* ============================= */
		/* Teachers page                 */
		/* ============================= */

		.teacher-pending {
			background-color: var(--color-warning-bg) !important;
		}

		.copyable-cell {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			max-width: 220px;
		}

		.copyable-text {
			flex: 1;
			min-width: 0;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.copy-btn {
			flex-shrink: 0;
			background: none;
			border: none;
			padding: 4px;
			margin: 0;
			cursor: pointer;
			color: var(--color-muted-foreground);
			border-radius: var(--radius-sm);
			display: inline-flex;
			align-items: center;
			justify-content: center;
			transition: background-color var(--transition-fast), color var(--transition-fast);
		}

		.copy-btn:hover {
			background-color: var(--color-primary-light);
			color: var(--color-primary);
		}

		.copy-btn.copied {
			color: var(--color-success);
		}

		.num-cell {
			width: 48px;
			text-align: center;
			color: var(--color-muted-foreground);
		}

		/* ============================= */
		/* Logs page                     */
		/* ============================= */

		.error-cell {
			color: var(--color-destructive);
			max-width: 200px;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.error-cell:hover {
			white-space: normal;
			word-break: break-word;
		}

		.success-cell {
			color: var(--color-success);
		}

		.loading {
			text-align: center;
			padding: var(--space-10);
			color: var(--color-muted-foreground);
		}

		/* ============================= */
		/* Auth pages                    */
		/* ============================= */

		body.auth-page {
			min-height: 100vh;
			display: flex;
			justify-content: center;
			align-items: center;
			padding: var(--space-5);
			background: linear-gradient(160deg, var(--color-background) 0%, var(--color-primary-light) 50%, var(--color-info-bg) 100%);
		}

		.auth-card {
			background: var(--color-surface);
			border-radius: var(--radius-lg);
			box-shadow: var(--shadow-lg);
			padding: var(--space-10);
			width: 100%;
			max-width: 420px;
			border: 1px solid var(--color-border-subtle);
		}

		.auth-logo {
			display: block;
			max-width: 200px;
			height: auto;
			margin: 0 auto var(--space-8);
		}

		.auth-title {
			text-align: center;
			margin-bottom: var(--space-8);
			color: var(--color-foreground);
		}

		.auth-links {
			text-align: center;
			margin-top: var(--space-5);
			font-size: 0.875rem;
		}

		.auth-links a {
			text-decoration: none;
			font-weight: 500;
		}

		.auth-links a:hover {
			text-decoration: underline;
		}

		.auth-footer {
			margin-top: var(--space-8);
			text-align: center;
		}

		.auth-card button {
			width: 100%;
			margin-top: 0;
		}

		.auth-card .form-group:last-of-type {
			text-align: center;
		}

		/* ============================= */
		/* Home page                     */
		/* ============================= */

		.home-container {
			max-width: 960px;
			margin: 0 auto;
			padding: var(--space-10) var(--space-5);
		}

		.home-title {
			text-align: center;
			margin-bottom: var(--space-3);
		}

		.home-logo {
			max-width: 280px;
			height: auto;
		}

		.home-welcome {
			text-align: center;
			margin-bottom: var(--space-8);
			color: var(--color-muted-foreground);
			font-size: 1.0625rem;
		}

		.home-top-bar {
			display: flex;
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			width: 100%;
			margin-bottom: var(--space-5);
		}

		.home-top-bar button {
			margin-top: 0;
		}

		.cards-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
			gap: var(--space-5);
		}

		.card {
			background: var(--color-surface);
			border-radius: var(--radius-lg);
			padding: var(--space-6);
			box-shadow: var(--shadow-sm);
			border: 1px solid var(--color-border-subtle);
			transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
			text-decoration: none;
			display: block;
			position: relative;
			overflow: hidden;
		}

		.card::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 3px;
			background: linear-gradient(90deg, var(--color-tertiary), var(--color-secondary), var(--color-primary), var(--color-accent));
			opacity: 0;
			transition: opacity var(--transition-base);
		}

		.card:hover {
			transform: translateY(-3px);
			box-shadow: var(--shadow-lg);
			border-color: var(--color-border);
			text-decoration: none;
		}

		.card:hover::before {
			opacity: 1;
		}

		.card h2 {
			margin: 0 0 var(--space-3) 0;
			font-size: 1.25rem;
			color: var(--color-foreground);
		}

		.card p {
			margin: 0;
			color: var(--color-muted-foreground);
			font-size: 0.875rem;
			line-height: 1.5;
		}

		/* ============================= */
		/* Password toggle               */
		/* ============================= */

		.password-group {
			display: flex;
			gap: var(--space-3);
			align-items: center;
		}

		.password-group input {
			flex: 1;
		}

		/* ============================= */
		/* Responsive                    */
		/* ============================= */

		@media (max-width: 1024px) {
			.container {
				max-width: 100%;
				padding: var(--space-6);
			}

			.header-bottom {
				flex-direction: column;
				gap: var(--space-3);
				align-items: flex-start;
			}

			.header-left {
				flex-wrap: wrap;
			}

			table {
				font-size: 14px;
			}
		}

		@media (max-width: 768px) {
			body {
				padding: var(--space-3);
			}

			.container {
				padding: var(--space-4);
				max-width: 100%;
				border-radius: var(--radius-md);
			}

			.form-row,
			.form-row-3,
			.column-row {
				grid-template-columns: 1fr;
			}

			.button-group {
				flex-direction: column;
				align-items: stretch;
			}

			button,
			.btn,
			.add-btn {
				width: 100%;
				text-align: center;
				margin-left: 0 !important;
			}

			.password-wrapper .password-toggle {
				width: auto;
				margin-top: 0;
			}

			.header-section {
				align-items: flex-start;
			}

			.header-bottom {
				width: 100%;
			}

			.header-logo {
				max-height: 40px;
			}

			.header-left {
				flex-direction: column;
				gap: var(--space-2);
				width: 100%;
			}

			.header-right {
				width: 100%;
				align-items: stretch;
			}

			.header-right button {
				width: 100%;
			}

			.nav-links {
				width: 100%;
			}

			.toolbar {
				flex-direction: column;
				align-items: stretch;
			}

			.toolbar .form-group {
				width: 100%;
				min-width: 0;
			}

			.toolbar .total-section {
				margin-left: 0;
				width: 100%;
				text-align: center;
			}

			.info-display {
				flex-direction: column;
			}

			.info-display > div {
				width: 100%;
				font-size: 1rem;
			}

			.color-group {
				flex-wrap: wrap;
			}

			.password-group {
				flex-direction: column;
				align-items: stretch;
			}

			th, td {
				padding: 10px 12px;
				word-break: break-word;
			}

			#logOutput {
				max-height: 150px;
				font-size: 11px;
			}

			.success-banner,
			.error-banner {
				width: calc(100% - 40px);
				left: 20px;
				transform: none;
			}

			.home-container {
				padding: var(--space-5) var(--space-3);
			}

			.home-logo {
				max-width: 220px;
			}

			.cards-grid {
				grid-template-columns: 1fr;
				gap: var(--space-4);
			}

			.card {
				padding: var(--space-5);
			}

			.card h2 {
				font-size: 1.125rem;
			}

			.home-top-bar {
				flex-direction: column;
				gap: var(--space-3);
				align-items: center;
			}

			body.auth-page {
				align-items: flex-start;
				padding-top: var(--space-10);
			}

			.auth-card {
				padding: var(--space-6);
			}

			.auth-logo {
				max-width: 160px;
				margin-bottom: var(--space-5);
			}

			.clear-btn {
				margin-left: 0;
				margin-top: var(--space-3);
			}

			.column-mapping {
				padding: var(--space-4);
			}
		}

		@media (max-width: 480px) {
			body {
				font-size: 14px;
			}

			input,
			select {
				font-size: 14px;
			}

			h1 {
				font-size: 1.375rem;
			}

			th, td {
				font-size: 13px;
				padding: 8px 10px;
			}

			.home-logo {
				max-width: 180px;
			}

			.auth-title {
				font-size: 1.375rem;
				margin-bottom: var(--space-5);
			}

			.password-wrapper input {
				padding-right: 44px;
			}
		}
	</style>
	@ScrHTMX()
	@ScrHyperscript()
	@SuccessBannerHandlers()
	@ErrorBannerHandlers()
}
