package frontend

import "zion-english/internal/constants"
import "zion-english/internal/utils"

type MyStudentsData struct {
	Students       []StudentItem
	Query          string
	Status         constants.StudentStatus
	SortBy         string
	SortOrder      string
	PageNumber     int
	PageTotalPages int
	PageTotal      int64
	PrevURL        string
	NextURL        string
	HasPrev        bool
	HasNext        bool
	FilterPath     string
}

templ MyStudentsTableRows(students []StudentItem) {
	for _, s := range students {
		<tr>
			<td data-label="Name">
				@StudentNameCell(s.Name, s.StudentNumber, s.Avatar)
			</td>
			<td data-label="Contact">{ getDisplayValue(s.Contact) }</td>
			<td data-label="Parent">{ getDisplayValue(s.ParentName) }</td>
			<td class="rate-cell" data-label="Rate">{ formatRate(s.RatePerClass, s.Currency) }</td>
			<td data-label="Status">
				@StatusPill(capitalizeStatus(s.Status), StudentStatusPillTone(s.Status), false)
			</td>
			<td data-label="Actions">
				<div class="table-actions">
					@IconActionLink(utils.URL("/students/" + s.ID + "/edit"), "Edit", IconKindEdit)
				</div>
			</td>
		</tr>
	}
}

templ MyStudentsListPartial(students []StudentItem, emptyMessage string, page PaginationData, partialsURL string, includeSelector string, targetSelector string, paginationOOBID string) {
	if len(students) == 0 {
		<tr>
			<td colspan="6" class="empty-state">{ emptyMessage }</td>
		</tr>
	} else {
		@MyStudentsTableRows(students)
	}
	<div id={ paginationOOBID } hx-swap-oob={ HxSwapInnerHTML }>
		@PaginationBarHTMX(partialsURL, includeSelector, targetSelector, page)
	</div>
}

templ MyStudents(data MyStudentsData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		@AdminPageHead("My Students - Zion English Admin")
		@AvatarStyles()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@HubHeader("My Students", "Register Student", utils.URL("/students/register"), true)

			@ListFilterForm(data.FilterPath, data.Query, string(data.Status), ListFilterKindStudent, "", "", "", "", "", "", false, false, false, false, true, "", false, "", false, false, false, false, data.SortBy, data.SortOrder, ListSortKindMyStudent, false, "", "", "", "", "", false)

			if len(data.Students) > 0 {
				<div class="table-wrapper data-list-view-root">
					<table class="table-stack-mobile">
						<thead>
							<tr>
								<th>Name</th>
								<th>Contact</th>
								<th>Parent</th>
								<th>Rate</th>
								<th>Status</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							@MyStudentsTableRows(data.Students)
						</tbody>
					</table>
				</div>
				@PaginationBar(data.HasPrev, data.PrevURL, data.HasNext, data.NextURL, data.PageNumber, data.PageTotalPages, data.PageTotal)
			} else {
				<div class="empty-state">
					<p>No students assigned to you.</p>
				</div>
			}
		</div>
	@LayoutEnd()
	</body>
	</html>
}
