package frontend

import "zion-english/internal/constants"
import "zion-english/internal/utils"

type MyStudentsData struct {
	Students       []StudentItem
	Query          string
	Status         constants.StudentStatus
	PageNumber     int
	PageTotalPages int
	PageTotal      int64
	PrevURL        string
	NextURL        string
	HasPrev        bool
	HasNext        bool
	FilterPath     string
}

templ MyStudents(data MyStudentsData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>My Students - Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@HubHeader("My Students", "Register Student", utils.URL("/students/register"), true)

			@ListFilterForm(data.FilterPath, data.Query, string(data.Status), ListFilterKindStudent, "", "", "", "", "", false, false, false, false, true)

			if len(data.Students) > 0 {
				<div class="table-wrapper">
					<table class="table-stack-mobile">
						<thead>
							<tr>
								<th>Name</th>
								<th>Contact</th>
								<th>Parent</th>
								<th>Rate</th>
								<th>Status</th>
								<th>Color</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range data.Students {
								<tr>
									<td data-label="Name">{ s.Name }</td>
									<td data-label="Contact">{ getDisplayValue(s.Contact) }</td>
									<td data-label="Parent">{ getDisplayValue(s.ParentName) }</td>
									<td class="rate-cell" data-label="Rate">{ formatRate(s.RatePerClass, s.Currency) }</td>
									<td data-label="Status">
										@StatusPill(capitalizeStatus(s.Status), StudentStatusPillTone(s.Status), false)
									</td>
									<td data-label="Color">
										<div class="color-cell">
											<div class="color-box" style={ "background-color: " + s.AssignedColor }></div>
										</div>
									</td>
									<td data-label="Actions">
										<div class="table-actions">
											@IconActionLink(utils.URL("/students/" + s.ID + "/edit"), "Edit", IconKindEdit)
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				@PaginationBar(data.HasPrev, data.PrevURL, data.HasNext, data.NextURL, data.PageNumber, data.PageTotalPages, data.PageTotal)
			} else {
				<div class="empty-state">
					<p>No students assigned to you.</p>
				</div>
			}
		</div>
	</body>
	</html>
}
