package frontend

import "zion-english/internal/utils"

type MyStudentsData struct {
	Students       []StudentItem
	Query          string
	Status         string
	PageNumber     int
	PageTotalPages int
	PageTotal      int64
	PrevURL        string
	NextURL        string
	HasPrev        bool
	HasNext        bool
	FilterPath     string
}

templ MyStudents(data MyStudentsData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>My Students - Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@HubHeader("My Students", "", "", false)

			@ListFilterForm(data.FilterPath, data.Query, data.Status, "", "", "", "", "", false, false, false, false)

			if len(data.Students) > 0 {
				<div class="table-wrapper">
					<table>
						<thead>
							<tr>
								<th>Name</th>
								<th>Contact</th>
								<th>Parent</th>
								<th>Rate</th>
								<th>Status</th>
								<th>Color</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range data.Students {
								<tr>
									<td>{ s.Name }</td>
									<td>{ getDisplayValue(s.Contact) }</td>
									<td>{ getDisplayValue(s.ParentName) }</td>
									<td class="rate-cell">{ formatRate(s.RatePerClass, s.Currency) }</td>
									<td class={ getStatusClass(s.Status) }>{ s.Status }</td>
									<td>
										<div class="color-cell">
											<div class="color-box" style={ "background-color: " + s.AssignedColor }></div>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				@PaginationBar(data.HasPrev, data.PrevURL, data.HasNext, data.NextURL, data.PageNumber, data.PageTotalPages, data.PageTotal)
			} else {
				<div class="empty-state">
					<p>No students assigned to you.</p>
				</div>
			}
		</div>
	</body>
	</html>
}
