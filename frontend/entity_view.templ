package frontend

import "fmt"

func formatDurationMinutes(minutes int64) string {
	if minutes <= 0 {
		return "-"
	}
	if minutes == 1 {
		return "1 min"
	}
	return fmt.Sprintf("%d min", minutes)
}

func classStatusAccentClass(status string) string {
	switch status {
	case "conducted":
		return "entity-view-hero--success"
	case "cancelled", "deleted":
		return "entity-view-hero--error"
	case "rescheduled":
		return "entity-view-hero--warning"
	default:
		return "entity-view-hero--neutral"
	}
}

templ EntityViewStatCard(label, value string) {
	<div class="entity-view-stat">
		<span class="entity-view-stat-label">{ label }</span>
		<span class="entity-view-stat-value">{ value }</span>
	</div>
}

templ EntityViewMetaChip(label, value string) {
	<span class="entity-view-meta-chip">
		<span class="entity-view-meta-chip-label">{ label }</span>
		<span class="entity-view-meta-chip-value">{ value }</span>
	</span>
}

templ EntityViewSection(title string) {
	<section class="entity-view-section">
		<h4 class="entity-view-section-title">{ title }</h4>
		<div class="entity-view-section-body">
			{ children... }
		</div>
	</section>
}

templ EntityViewNotePanel(title, content, tone string) {
	<div class={ "entity-view-note entity-view-note--" + tone }>
		<span class="entity-view-note-title">{ title }</span>
		<p class="entity-view-note-content">{ content }</p>
	</div>
}

templ EntityViewTeacherList(teachers []TeacherListItem) {
	if len(teachers) > 0 {
		<ul class="entity-view-teacher-list">
			for _, teacher := range teachers {
				<li class="entity-view-teacher-item">
					@TeacherNameCell(teacher.Name, teacher.Avatar)
				</li>
			}
		</ul>
	}
}

templ EntityViewTeacherStat(teacher TeacherListItem) {
	<div class="entity-view-stat entity-view-stat--teacher">
		<span class="entity-view-stat-label">Teacher</span>
		@TeacherNameCell(teacher.Name, teacher.Avatar)
	</div>
}

templ EntityViewRelationshipList(items []StudentRelationshipItem) {
	if len(items) > 0 {
		<ul class="entity-view-relationships">
			for _, rel := range items {
				<li class="entity-view-relationship">
					<span class="entity-view-relationship-name">{ rel.RelatedStudentName }</span>
					if rel.Relationship != "" {
						<span class="entity-view-relationship-type">{ rel.Relationship }</span>
					}
				</li>
			}
		</ul>
	}
}

templ EntityViewModalStyles() {
	<style>
		.entity-view-body {
			padding: var(--space-4);
			display: flex;
			flex-direction: column;
			gap: var(--space-4);
			overflow-y: auto;
		}

		.entity-view-layout {
			display: grid;
			gap: var(--space-4);
		}

		@media (min-width: 640px) {
			.entity-view-layout--split {
				grid-template-columns: 220px 1fr;
				align-items: start;
			}
		}

		.entity-view-card {
			background: var(--color-muted);
			border: 1px solid var(--color-border-subtle);
			border-radius: var(--radius-lg);
			padding: var(--space-4);
		}

		.entity-view-hero {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: var(--space-4);
			padding: var(--space-4);
			border-radius: var(--radius-lg);
			border: 1px solid var(--color-border-subtle);
			background: linear-gradient(
				135deg,
				color-mix(in srgb, var(--hero-accent, var(--color-primary)) 10%, var(--color-surface)) 0%,
				var(--color-muted) 100%
			);
			border-left: 4px solid var(--hero-accent, var(--color-primary));
		}

		.entity-view-hero--success {
			--hero-accent: var(--color-success);
		}

		.entity-view-hero--warning {
			--hero-accent: var(--color-warning);
		}

		.entity-view-hero--error {
			--hero-accent: var(--color-destructive);
		}

		.entity-view-hero--neutral {
			--hero-accent: var(--color-accent);
		}

		.entity-view-eyebrow {
			margin: 0 0 var(--space-1);
			font-size: 0.6875rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: var(--color-muted-foreground);
		}

		.entity-view-hero h2 {
			margin: 0 0 var(--space-2);
			font-size: 1.25rem;
			line-height: 1.3;
		}

		.entity-view-meta-row {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
		}

		.entity-view-meta-chip {
			display: inline-flex;
			align-items: center;
			gap: var(--space-2);
			padding: var(--space-1) var(--space-2);
			border-radius: var(--radius-full);
			background: color-mix(in srgb, var(--color-surface) 88%, transparent);
			border: 1px solid var(--color-border-subtle);
			font-size: 0.8125rem;
			font-variant-numeric: tabular-nums;
		}

		.entity-view-meta-chip-label {
			font-weight: 600;
			color: var(--color-muted-foreground);
			font-size: 0.6875rem;
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.entity-view-meta-chip-value {
			color: var(--color-foreground);
			font-weight: 500;
		}

		.entity-view-stats {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
			gap: var(--space-3);
		}

		.entity-view-stat {
			display: flex;
			flex-direction: column;
			gap: var(--space-1);
			padding: var(--space-3);
			border-radius: var(--radius-md);
			background: var(--color-muted);
			border: 1px solid var(--color-border-subtle);
		}

		.entity-view-stat-label {
			font-size: 0.6875rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--color-muted-foreground);
		}

		.entity-view-stat-value {
			font-size: 1rem;
			font-weight: 600;
			color: var(--color-foreground);
			font-variant-numeric: tabular-nums;
			word-break: break-word;
		}

		.entity-view-stat-value--rate {
			font-size: 1.125rem;
		}

		.entity-view-stat-value--rate .entity-view-rate-currency {
			margin-left: var(--space-1);
			font-size: 0.8125rem;
			font-weight: 500;
			color: var(--color-muted-foreground);
		}

		.entity-view-section-title {
			margin: 0 0 var(--space-3);
			font-size: 0.75rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--color-muted-foreground);
		}

		.entity-view-section-body {
			display: grid;
			gap: var(--space-3);
		}

		.entity-view-detail-grid {
			display: grid;
			gap: var(--space-4);
		}

		@media (min-width: 480px) {
			.entity-view-detail-grid {
				grid-template-columns: 1fr 1fr;
			}
		}

		.entity-view-note {
			padding: var(--space-3) var(--space-4);
			border-radius: var(--radius-md);
			border: 1px solid var(--color-border-subtle);
		}

		.entity-view-note-title {
			display: block;
			margin-bottom: var(--space-1);
			font-size: 0.6875rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--color-muted-foreground);
		}

		.entity-view-note-content {
			margin: 0;
			font-size: 0.9375rem;
			line-height: 1.55;
			color: var(--color-foreground);
			white-space: pre-wrap;
			word-break: break-word;
		}

		.entity-view-note--info {
			background: var(--color-info-bg);
			border-color: color-mix(in srgb, var(--color-info) 22%, transparent);
		}

		.entity-view-note--warning {
			background: var(--color-warning-bg);
			border-color: color-mix(in srgb, var(--color-warning) 22%, transparent);
		}

		.entity-view-identity {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: var(--space-3);
		}

		.entity-view-color-swatch {
			width: 72px;
			height: 72px;
			border-radius: var(--radius-lg);
			border: 3px solid var(--color-surface);
			box-shadow: var(--shadow-md);
			flex-shrink: 0;
		}

		.entity-view-identity h2 {
			margin: 0;
			font-size: 1.0625rem;
			line-height: 1.3;
		}

		.entity-view-rate-highlight {
			display: inline-flex;
			align-items: baseline;
			gap: var(--space-1);
			padding: var(--space-1) var(--space-3);
			border-radius: var(--radius-full);
			background: var(--color-surface);
			border: 1px solid var(--color-border-subtle);
			font-variant-numeric: tabular-nums;
		}

		.entity-view-rate-block {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-1);
		}

		.entity-view-rate-caption {
			font-size: 0.6875rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--color-muted-foreground);
		}

		.entity-view-rate-highlight-amount {
			font-size: 1rem;
			font-weight: 700;
			color: var(--color-foreground);
		}

		.entity-view-rate-highlight-currency {
			font-size: 0.75rem;
			font-weight: 600;
			color: var(--color-muted-foreground);
			letter-spacing: 0.03em;
		}

		.entity-view-teacher-list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		.entity-view-teacher-item {
			padding: var(--space-2) var(--space-3);
			border-radius: var(--radius-md);
			background: var(--color-surface);
			border: 1px solid var(--color-border-subtle);
		}

		.entity-view-stat--teacher .teacher-name-cell {
			margin-top: var(--space-1);
		}

		.entity-view-relationships {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: var(--space-2);
		}

		.entity-view-relationship {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-3);
			padding: var(--space-2) var(--space-3);
			border-radius: var(--radius-md);
			background: var(--color-surface);
			border: 1px solid var(--color-border-subtle);
		}

		.entity-view-relationship-name {
			font-size: 0.875rem;
			font-weight: 500;
			color: var(--color-foreground);
		}

		.entity-view-relationship-type {
			font-size: 0.75rem;
			font-weight: 600;
			color: var(--color-muted-foreground);
			text-transform: capitalize;
		}

		.entity-view-card .profile-details {
			display: grid;
			gap: var(--space-4);
		}

		.entity-view-card .entity-view-section + .entity-view-section {
			margin-top: var(--space-4);
			padding-top: var(--space-4);
			border-top: 1px solid var(--color-border-subtle);
		}

		@media (min-width: 480px) {
			.entity-view-card .profile-details {
				grid-template-columns: 1fr 1fr;
			}
		}

		.entity-view-card .profile-detail {
			display: flex;
			flex-direction: column;
			gap: var(--space-1);
		}

		.entity-view-card .profile-detail-label {
			font-size: 0.6875rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--color-muted-foreground);
		}

		.entity-view-card .profile-detail-value {
			font-size: 0.9375rem;
			color: var(--color-foreground);
			word-break: break-word;
		}

		.modal-dialog-entity {
			max-width: 36rem;
		}
	</style>
}

templ EntityViewRateStat(amount float64, currency string) {
	<div class="entity-view-stat">
		<span class="entity-view-stat-label">Rate</span>
		<span class="entity-view-stat-value entity-view-stat-value--rate">
			{ fmt.Sprintf("%.2f", amount) }
			<span class="entity-view-rate-currency">{ currency }</span>
		</span>
	</div>
}
