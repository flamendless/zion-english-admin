package frontend

import "fmt"
import "zion-english/internal/utils"

type StudentData struct {
	Students       []StudentItem
	Query          string
	Status         string
	TeacherID      string
	PageNumber     int
	PageTotalPages int
	PageTotal      int64
	PrevURL        string
	NextURL        string
	HasPrev        bool
	HasNext        bool
	FilterPath     string
}

type StudentItem struct {
	ID               string
	Name             string
	Currency         string
	Contact          string
	RatePerClass     float64
	ParentName       string
	AssignedColor    string
	Status           string
	RelatedToDisplay string
	CreatedAt        string
	UpdatedAt        string
}

func getStatusClass(status string) string {
	if status == "active" {
		return "status-active"
	}
	return "status-inactive"
}

templ Students(data StudentData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Students - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@HubHeader("Students", "New Student", utils.URL("/students/register"), true)

			@ListFilterForm(data.FilterPath, data.Query, data.Status, data.TeacherID, "", "", "", "", true, false, false, false)

			if len(data.Students) > 0 {
				<div class="table-wrapper">
					<table id="studentsTable">
						<thead>
							<tr>
								<th>Name</th>
								<th>Currency</th>
								<th>Contact</th>
								<th>Rate Per Class</th>
								<th>Parent Name</th>
								<th>Related To</th>
								<th>Color</th>
								<th>Status</th>
								<th>Created At</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, student := range data.Students {
								<tr>
									<td>{ student.Name }</td>
									<td class="currency-cell">{ student.Currency }</td>
									<td>{ getDisplayValue(student.Contact) }</td>
									<td class="rate-cell">{ formatRate(student.RatePerClass, student.Currency) }</td>
									<td>{ getDisplayValue(student.ParentName) }</td>
									<td>{ getDisplayValue(student.RelatedToDisplay) }</td>
									<td>
										<div class="color-cell">
											<div class="color-box" style={ "background-color: " + student.AssignedColor }></div>
											<span>{ student.AssignedColor }</span>
										</div>
									</td>
									<td class={ getStatusClass(student.Status) }>{ student.Status }</td>
									<td>{ student.CreatedAt }</td>
									<td>
										<a href={ utils.URL("/students/" + student.ID + "/edit") } class="edit-btn">Edit</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				@PaginationBar(data.HasPrev, data.PrevURL, data.HasNext, data.NextURL, data.PageNumber, data.PageTotalPages, data.PageTotal)
			} else {
				<div class="empty-state">
					<p>No students found.</p>
				</div>
			}
		</div>
	</body>
	</html>
}

func formatRate(rate float64, currency string) string {
	return fmt.Sprintf("%.2f %s", rate, currency)
}
