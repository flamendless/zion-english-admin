package frontend

import "fmt"
import "zion-english/internal/utils"

type StudentData struct {
	Students       []StudentItem
	Query          string
	Status         string
	TeacherID      string
	PageNumber     int
	PageTotalPages int
	PageTotal      int64
	PrevURL        string
	NextURL        string
	HasPrev        bool
	HasNext        bool
	FilterPath     string
}

type StudentItem struct {
	ID               string
	Name             string
	Currency         string
	Contact          string
	RatePerClass     float64
	ParentName       string
	AssignedColor    string
	Status           string
	TeacherDisplay   string
	RelatedToDisplay string
	CreatedAt        string
	UpdatedAt        string
}

func getStudentRowClass(status string) string {
	if status == "inactive" {
		return "student-inactive"
	}
	return ""
}

templ Students(data StudentData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Students - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
	</head>
	<body>
		<div class="container">
			@HeaderSimple()
			@HubHeader("Students", "New Student", utils.URL("/students/register"), true)

			@ListFilterForm(data.FilterPath, data.Query, data.Status, "student", data.TeacherID, "", "", "", "", true, false, false, false, true)

			if len(data.Students) > 0 {
				<div class="table-wrapper">
					<table id="studentsTable" class="table-stack-mobile">
						<thead>
							<tr>
								<th>Name</th>
								<th>Parent</th>
								<th>Teacher</th>
								<th>Rate Per Class</th>
								<th>Related To</th>
								<th>Status</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, student := range data.Students {
								<tr class={ getStudentRowClass(student.Status) }>
									<td data-label="Name">{ student.Name }</td>
									<td data-label="Parent">{ getDisplayValue(student.ParentName) }</td>
									<td data-label="Teacher">{ getDisplayValue(student.TeacherDisplay) }</td>
									<td class="rate-cell" data-label="Rate">{ formatRate(student.RatePerClass, student.Currency) }</td>
									<td data-label="Related To">{ getDisplayValue(student.RelatedToDisplay) }</td>
									<td data-label="Status">
										@StatusPill(capitalizeStatus(student.Status), StudentStatusPillTone(student.Status), false)
									</td>
									<td data-label="Actions">
										<div class="table-actions">
											@IconActionLink(utils.URL("/students/" + student.ID + "/view"), "View", IconKindView)
											@IconActionLink(utils.URL("/students/" + student.ID + "/edit"), "Edit", IconKindEdit)
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				@PaginationBar(data.HasPrev, data.PrevURL, data.HasNext, data.NextURL, data.PageNumber, data.PageTotalPages, data.PageTotal)
			} else {
				<div class="empty-state">
					<p>No students found.</p>
				</div>
			}
		</div>
	</body>
	</html>
}

func formatRate(rate float64, currency string) string {
	return fmt.Sprintf("%.2f %s", rate, currency)
}
