package frontend

import "fmt"
import "zion-english/internal/utils"

type StudentData struct {
	Students []StudentItem
}

type StudentItem struct {
	ID            string
	Name          string
	Currency      string
	Contact       string
	RatePerClass  float64
	ParentName    string
	AssignedColor string
	Status        string
	CreatedAt     string
	UpdatedAt     string
}

func getStatusClass(status string) string {
	if status == "active" {
		return "status-active"
	}
	return "status-inactive"
}

templ Students(data StudentData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Students - Zion English Admin Tool</title>
		<link rel="icon" type="image/x-icon" id="favicon">
		<style>
			.add-btn {
				background-color: var(--color-primary);
				color: white;
				padding: 10px 20px;
				border: none;
				border-radius: 4px;
				cursor: pointer;
				font-size: 14px;
				font-weight: 500;
				text-decoration: none;
				display: inline-block;
			}

			.add-btn:hover {
				opacity: 0.9;
			}

			table {
				width: 100%;
				border-collapse: collapse;
				margin-bottom: 20px;
			}

			.color-cell {
				display: flex;
				align-items: center;
				gap: 10px;
			}

			.color-box {
				width: 24px;
				height: 24px;
				border-radius: 4px;
				border: 1px solid #ddd;
			}

			.status-active {
				color: #28a745;
				font-weight: 500;
			}

			.status-inactive {
				color: #dc3545;
				font-weight: 500;
			}

			.empty-state {
				text-align: center;
				padding: 40px;
				color: #666;
			}

			.currency-cell {
				white-space: nowrap;
			}

			.rate-cell {
				white-space: nowrap;
				font-family: 'Courier New', monospace;
			}

			.table-wrapper {
				overflow-x: auto;
				margin-bottom: 20px;
			}
		</style>
	</head>
	<body>
		<div class="container">
			@HeaderSimple()

			<div class="button-group">
				<a href={utils.URL("/students/register")} class="add-btn">Register New Student</a>
			</div>

			if len(data.Students) > 0 {
				<div class="table-wrapper">
					<table id="studentsTable">
						<thead>
							<tr>
								<th>Name</th>
								<th>Currency</th>
								<th>Contact</th>
								<th>Rate Per Class</th>
								<th>Parent Name</th>
								<th>Color</th>
								<th>Status</th>
								<th>Created At</th>
							</tr>
						</thead>
						<tbody>
							for _, student := range data.Students {
								<tr>
									<td>{ student.Name }</td>
									<td class="currency-cell">{ student.Currency }</td>
									<td>{ getDisplayValue(student.Contact) }</td>
									<td class="rate-cell">{ formatRate(student.RatePerClass, student.Currency) }</td>
									<td>{ getDisplayValue(student.ParentName) }</td>
									<td>
										<div class="color-cell">
											<div class="color-box" style={ "background-color: " + student.AssignedColor }></div>
											<span>{ student.AssignedColor }</span>
										</div>
									</td>
									<td class={ getStatusClass(student.Status) }>{ student.Status }</td>
									<td>{ student.CreatedAt }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<div class="empty-state">
					<p>No students registered yet.</p>
					<p>Click "Register New Student" to add one.</p>
				</div>
			}
		</div>

		<script>
			const favicon = document.getElementById('favicon');

			function getBaseURL() {
				const pathname = window.location.pathname;
				const cleanPath = pathname.replace(/\/$/, '');
				const parts = cleanPath.split('/').filter(p => p !== '');

				if (parts.length === 0 || cleanPath.endsWith('.html')) {
					if (cleanPath.includes('/zion-english-admin')) {
						return '/zion-english-admin';
					}
					return '';
				}

				if (parts.length === 1) {
					return '/' + parts[0];
				}

				return '/' + parts.slice(0, -1).join('/');
			}

			const baseURL = getBaseURL();

			function buildURL(path) {
				return baseURL + path;
			}

			if (favicon) {
				favicon.href = buildURL('/static/favicon.ico');
			}
		</script>
	</body>
	</html>
}

func formatRate(rate float64, currency string) string {
	return fmt.Sprintf("%.2f %s", rate, currency)
}
