package frontend

import (
	"fmt"
	"strings"
	"zion-english/internal/constants"
	"zion-english/internal/utils"
)

type ScheduleRepeatDatePickerConfig struct {
	TodayPHT      string
	Hint          string
	MinDates      int
	InitialDates  []string
	SubmitMessage string
}

func joinCalendarInitialDates(dates []string) string {
	return strings.Join(dates, ",")
}

type ScheduleRepeatData struct {
	IsSuperuser bool
	LockTeacher bool
	TeacherID   string
	TeacherName string
	TodayPHT    string
}

type ScheduleRepeatPreviewRow struct {
	Date    string
	Ready   bool
	Message string
}

type ScheduleRepeatFormSnapshot struct {
	TeacherID    string
	StudentID    string
	StartTime    string
	EndTime      string
	Rate         float64
	Currency     string
	IsTrialClass bool
	LockTeacher  bool
}

type ScheduleRepeatPreviewData struct {
	Base                ScheduleRepeatFormSnapshot
	Rows                []ScheduleRepeatPreviewRow
	LearningMaterialIDs []int64
}

type ScheduleSeriesEditPreviewRow struct {
	Date    string
	Action  string
	Ready   bool
	Message string
}

type ScheduleSeriesEditPreviewData struct {
	ScheduleID          string
	Scope               string
	From                string
	LockTeacher         bool
	Base                ScheduleRepeatFormSnapshot
	Rows                []ScheduleSeriesEditPreviewRow
	LearningMaterialIDs []int64
}

templ ScheduleRepeat(data ScheduleRepeatData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Schedule Repeating Classes - Zion English Admin</title>
		<link rel="icon" type="image/x-icon" href={ utils.URL("/static/favicon.ico") }/>
		@GlobalIncludes()
		@ScrTimeRangeJS()
		@ScrScheduleRepeatCalendarJS()
	</head>
	<body>
		<div class="container schedule-repeat-page" data-lock-teacher={ fmt.Sprintf("%t", data.LockTeacher) } data-today-pht={ data.TodayPHT }>
			@HeaderSimple()
			@SuccessBanner()
			@ErrorBanner()

			<h2>Schedule Repeating Classes</h2>
			<p class="field-hint schedule-repeat-intro">Pick multiple future dates with the same time, student, and rate. You will review conflicts before classes are created.</p>
			<p class="field-hint"><a href={ utils.URL("/schedule/record") }>Need just one date?</a> Use schedule a single class instead.</p>

			if data.LockTeacher {
				<form
					id="scheduleRepeatForm"
					hx-post={ utils.URL("/schedule/repeat/preview") }
					hx-target="#repeatPreviewPanel"
					hx-swap="innerHTML"
					hx-indicator="#repeatPreviewBtn"
				>
					<input type="hidden" id="modal_teacher" name="teacher" value={ data.TeacherID }/>
					<div class="form-row">
						<div class="form-group">
							<label>Teacher</label>
							<input type="text" value={ data.TeacherName } disabled/>
						</div>
						@TeacherStudentsDropdown()
					</div>
					@ScheduleRepeatDatePicker(ScheduleRepeatDatePickerConfig{
						TodayPHT: data.TodayPHT,
						Hint: "Click dates on the calendar to add or remove them. Select at least two future dates.",
						MinDates: 2,
						SubmitMessage: "Select at least two future dates, or use Schedule a Class for a single date.",
					})
					@ScheduleModalFields()
					<button type="submit" class="btn" id="repeatPreviewBtn">Review Dates</button>
				</form>
			} else {
				<form
					id="scheduleRepeatForm"
					hx-post={ utils.URL("/schedule/repeat/preview") }
					hx-target="#repeatPreviewPanel"
					hx-swap="innerHTML"
					hx-indicator="#repeatPreviewBtn"
				>
					<div class="form-row">
						@ScheduleModalTeacherDropdown()
						@ScheduleModalStudentDropdown()
					</div>
					@ScheduleRepeatDatePicker(ScheduleRepeatDatePickerConfig{
						TodayPHT: data.TodayPHT,
						Hint: "Click dates on the calendar to add or remove them. Select at least two future dates.",
						MinDates: 2,
						SubmitMessage: "Select at least two future dates, or use Schedule a Class for a single date.",
					})
					@ScheduleModalFields()
					<button type="submit" class="btn" id="repeatPreviewBtn">Review Dates</button>
				</form>
			}

			<div id="repeatPreviewPanel" class="schedule-repeat-preview-panel"></div>

			<div class="logs-section">
				<h3>Logs and Errors</h3>
				<div id="logOutput">Select dates and review before creating classes.</div>
			</div>
		</div>
		@ScheduleRepeatPageScript()
		@ScheduleRepeatDatePickerStyles()
		@ScrTimeRangeInit()
		@ScrTrialClassJS()
	</body>
	</html>
}

templ ScheduleRepeatDatePicker(cfg ScheduleRepeatDatePickerConfig) {
	<div
		class="form-group schedule-repeat-dates"
		data-schedule-repeat-calendar
		data-today-pht={ cfg.TodayPHT }
		data-min-dates={ fmt.Sprintf("%d", cfg.MinDates) }
		data-initial-dates={ joinCalendarInitialDates(cfg.InitialDates) }
		data-submit-message={ cfg.SubmitMessage }
	>
		<label>Dates *</label>
		<p class="field-hint">{ cfg.Hint }</p>
		<div class="schedule-repeat-calendar">
			<div class="schedule-repeat-calendar-nav">
				<button type="button" class="btn btn-secondary btn-sm" data-cal-prev aria-label="Previous month">&larr;</button>
				<span data-cal-month-label class="schedule-repeat-calendar-label"></span>
				<button type="button" class="btn btn-secondary btn-sm" data-cal-next aria-label="Next month">&rarr;</button>
			</div>
			<div class="schedule-repeat-calendar-grid" data-cal-grid role="grid" aria-label="Select class dates"></div>
		</div>
		<div data-cal-selected class="schedule-repeat-selected-dates" aria-live="polite"></div>
		<div data-cal-inputs></div>
	</div>
}

templ ScheduleRepeatDatePickerStyles() {
	<style>
		.schedule-repeat-intro {
			max-width: 42rem;
			margin-bottom: var(--space-3);
		}
		.schedule-repeat-calendar {
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			background: var(--color-surface);
			padding: var(--space-3);
			max-width: 24rem;
		}
		.schedule-repeat-calendar-nav {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-2);
			margin-bottom: var(--space-3);
		}
		.schedule-repeat-calendar-label {
			font-weight: 600;
			font-size: 0.9375rem;
		}
		.schedule-repeat-calendar-grid {
			display: grid;
			grid-template-columns: repeat(7, 1fr);
			gap: 0.25rem;
		}
		.schedule-repeat-weekday {
			text-align: center;
			font-size: 0.75rem;
			color: var(--color-muted-foreground);
			padding: 0.25rem 0;
		}
		.schedule-repeat-day {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 2rem;
			border: 1px solid transparent;
			border-radius: var(--radius-sm);
			background: transparent;
			color: inherit;
			font-size: 0.875rem;
			cursor: pointer;
			padding: 0;
			margin: 0;
			margin-top: 0;
		}
		.schedule-repeat-day.is-empty {
			visibility: hidden;
			pointer-events: none;
		}
		.schedule-repeat-day.is-disabled {
			color: var(--color-muted-foreground);
			cursor: not-allowed;
			opacity: 0.45;
		}
		.schedule-repeat-day.is-selected {
			background: var(--color-primary-light);
			border-color: var(--color-primary);
			font-weight: 600;
		}
		.schedule-repeat-day:not(.is-disabled):not(.is-empty):hover {
			background: var(--color-muted);
		}
		.schedule-repeat-selected-dates {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
			margin-top: var(--space-3);
			min-height: 1.5rem;
		}
		.schedule-repeat-date-chip {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			padding: 0.25rem 0.5rem;
			border: var(--pill-border);
			border-radius: var(--radius-full);
			background: var(--color-surface);
			font-size: 0.8125rem;
		}
		.schedule-repeat-preview-panel {
			margin-top: var(--space-5);
		}
		.schedule-repeat-preview-table {
			width: 100%;
			border-collapse: collapse;
			margin-bottom: var(--space-4);
		}
		.schedule-repeat-preview-table th,
		.schedule-repeat-preview-table td {
			padding: var(--space-2) var(--space-3);
			border-bottom: 1px solid var(--color-border-subtle);
			text-align: left;
			vertical-align: top;
		}
		.schedule-repeat-preview-table th {
			font-size: 0.8125rem;
			color: var(--color-muted-foreground);
		}
		.schedule-repeat-status-ready {
			color: var(--color-success);
		}
		.schedule-repeat-status-conflict {
			color: var(--color-destructive);
		}
	</style>
}

templ ScheduleRepeatPreview(data ScheduleRepeatPreviewData) {
	<div class="schedule-repeat-preview">
		<h3>Review selected dates</h3>
		<p class="field-hint">Uncheck any dates you do not want to create. Conflicting dates are unchecked by default.</p>
		<form
			id="scheduleRepeatConfirmForm"
			hx-post={ utils.URL("/schedule/repeat") }
			hx-swap="none"
			hx-indicator="#repeatConfirmBtn"
		>
			if data.Base.LockTeacher {
				<input type="hidden" name="teacher" value={ data.Base.TeacherID }/>
				<input type="hidden" name="student" value={ data.Base.StudentID }/>
			} else {
				<input type="hidden" name="schedule_teacher" value={ data.Base.TeacherID }/>
				<input type="hidden" name="schedule_student" value={ data.Base.StudentID }/>
			}
			<input type="hidden" name="start_time" value={ data.Base.StartTime }/>
			<input type="hidden" name="end_time" value={ data.Base.EndTime }/>
			<input type="hidden" name="rate" value={ formatFloat(data.Base.Rate) }/>
			<input type="hidden" name="currency" value={ data.Base.Currency }/>
			if data.Base.IsTrialClass {
				<input type="hidden" name="is_trial_class" value="on"/>
			}
			for _, materialID := range data.LearningMaterialIDs {
				<input type="hidden" name="learning_material_ids" value={ fmt.Sprintf("%d", materialID) }/>
			}
			<table class="schedule-repeat-preview-table">
				<thead>
					<tr>
						<th>Date</th>
						<th>Status</th>
						<th>Include</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Rows {
						<tr>
							<td>{ FormatScheduledClassDateDisplay(row.Date) }</td>
							if row.Ready {
								<td class="schedule-repeat-status-ready">{ row.Message }</td>
							} else {
								<td class="schedule-repeat-status-conflict">{ row.Message }</td>
							}
							<td>
								<input
									type="checkbox"
									name="confirm_dates"
									value={ row.Date }
									checked?={ row.Ready }
								/>
							</td>
						</tr>
					}
				</tbody>
			</table>
			<button type="submit" class="btn" id="repeatConfirmBtn">Create classes</button>
		</form>
	</div>
}

templ ScheduleSeriesEditPreview(data ScheduleSeriesEditPreviewData) {
	<div class="schedule-repeat-preview">
		<h3>Review date changes</h3>
		<p class="field-hint">Uncheck any added or updated dates you do not want to apply. Removed sessions are dropped automatically.</p>
		<form
			id="editSeriesConfirmForm"
			hx-post={ utils.URL("/schedule/" + data.ScheduleID + "/edit") }
			hx-swap="none"
			hx-indicator="#editSeriesConfirmBtn"
		>
			<input type="hidden" name="edit_scope" value={ data.Scope }/>
			<input type="hidden" name="from" value={ data.From }/>
			if data.LockTeacher {
				<input type="hidden" name="teacher" value={ data.Base.TeacherID }/>
				<input type="hidden" name="student" value={ data.Base.StudentID }/>
			} else {
				<input type="hidden" name="schedule_teacher" value={ data.Base.TeacherID }/>
				<input type="hidden" name="schedule_student" value={ data.Base.StudentID }/>
			}
			<input type="hidden" name="start_time" value={ data.Base.StartTime }/>
			<input type="hidden" name="end_time" value={ data.Base.EndTime }/>
			<input type="hidden" name="rate" value={ formatFloat(data.Base.Rate) }/>
			<input type="hidden" name="currency" value={ data.Base.Currency }/>
			if data.Base.IsTrialClass {
				<input type="hidden" name="is_trial_class" value="on"/>
			}
			for _, materialID := range data.LearningMaterialIDs {
				<input type="hidden" name="learning_material_ids" value={ fmt.Sprintf("%d", materialID) }/>
			}
			<table class="schedule-repeat-preview-table">
				<thead>
					<tr>
						<th>Date</th>
						<th>Change</th>
						<th>Status</th>
						<th>Include</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Rows {
						<tr>
							<td>{ FormatScheduledClassDateDisplay(row.Date) }</td>
							<td>{ row.Action }</td>
							if row.Ready {
								<td class="schedule-repeat-status-ready">{ row.Message }</td>
							} else {
								<td class="schedule-repeat-status-conflict">{ row.Message }</td>
							}
							<td>
								if row.Action == "Remove" {
									<span class="field-hint">Removed</span>
								} else {
									<input
										type="checkbox"
										name="confirm_dates"
										value={ row.Date }
										checked?={ row.Ready }
									/>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			<button type="submit" class="btn" id="editSeriesConfirmBtn">Save Changes</button>
		</form>
	</div>
}

templ SeriesScopeFields(scopeName string, totalCount int64, futureCount int64) {
	if totalCount > 1 {
		<fieldset class="series-scope-fieldset">
			<legend>Apply to</legend>
			<label class="series-scope-option">
				<input type="radio" name={ scopeName } value={ string(constants.SeriesScopeSingle) } checked/>
				This class only
			</label>
			<label class="series-scope-option">
				<input
					type="radio"
					name={ scopeName }
					value={ string(constants.SeriesScopeFuture) }
					disabled?={ futureCount <= 1 }
				/>
				if futureCount > 1 {
					This and { fmt.Sprintf("%d", futureCount) } scheduled classes in this series (including this date)
				} else {
					This and future classes in this series
				}
			</label>
		</fieldset>
	}
}

templ ScheduleRepeatPageScript() {
	<script>
		(function () {
			const pageRoot = document.querySelector('.schedule-repeat-page');
			if (!pageRoot) return;
			if (window.bootScheduleRepeatCalendars) window.bootScheduleRepeatCalendars();

			const lockTeacher = pageRoot.dataset.lockTeacher === 'true';
			function getTeacherEl() {
				return lockTeacher ? document.getElementById('modal_teacher') : document.getElementById('schedule_teacher');
			}
			function getStudentEl() {
				return lockTeacher ? document.getElementById('student') : document.getElementById('schedule_student');
			}
			async function loadStudentsForTeacher(teacherId) {
				const studentEl = getStudentEl();
				if (!studentEl || lockTeacher) return;
				if (!teacherId) {
					studentEl.innerHTML = '<option value="">-- Select teacher first --</option>';
					studentEl.value = '';
					return;
				}
				try {
					const banner = document.getElementById('errorBanner');
					const basePath = banner && banner.dataset.basePath ? banner.dataset.basePath.replace(/\/$/, '') : '';
					const response = await fetch(basePath + '/api/students?teacher=' + encodeURIComponent(teacherId));
					const html = await response.text();
					if (!response.ok) throw new Error(html);
					studentEl.innerHTML = html;
					studentEl.value = '';
				} catch (err) {
					if (typeof showErrorBanner === 'function') {
						showErrorBanner(err.message || 'Failed to load students');
					}
				}
			}
			const teacherEl = getTeacherEl();
			if (teacherEl && !lockTeacher) {
				teacherEl.addEventListener('change', () => loadStudentsForTeacher(teacherEl.value));
				loadStudentsForTeacher('');
			}
			const studentEl = getStudentEl();
			if (studentEl) {
				studentEl.addEventListener('change', () => {
					if (typeof applyStudentRateToForm === 'function') applyStudentRateToForm();
				});
			}
		})();
	</script>
}
